<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Widget-laajennuksen ainoa oikeus: pääsy samaan App Groupiin kuin
	  sovelluksella. Ilman tätä widget kääntyy ja asentuu, mutta lukee
	  tyhjää varastoa ja näyttää ikuisesti "Matka ei ole alkanut".

	  Widget EI tarvitse iCloudia, Game Centeriä eikä pushia: se ei
	  verkota, ei kirjaudu eikä ilmoita mistään.
	-->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.fi.matkakirja.peli</string>
	</array>
</dict>
</plist>
