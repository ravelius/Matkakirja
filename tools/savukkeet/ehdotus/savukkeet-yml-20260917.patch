+        with:
+          name: savukkeet-mac-${{ github.run_id }}
+          path: ${{ env.TULOKSET }}
+          retention-days: 3
+          if-no-files-found: warn
+      - name: Siivoa tuloskansio
+        if: always()
+        run: rm -rf "$TULOKSET"
+
