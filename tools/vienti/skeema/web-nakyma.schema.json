{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://matkakirja.app/vienti/1/web-nakyma.schema.json",
  "title": "Matkakirja-vienti: web-näkymän riippuvuudet",
  "description": "Web-näkymä (esim. lehti), jonka natiivi peli näyttää WKWebView-kuoressa (skeema 1.3). moduulit ja tyylit ovat näkymän koodi; tiedostot ja kansiot ovat paikallisia kuvia ja dataa, jotka näkymä hakee ajon aikana juuriUrl:n alta. Polut ovat suhteessa juuriUrl:iin; sha256 kertoo, mitä versiota paketti vastaa.",
  "type": "object",
  "required": ["$skeema", "nimi", "kuvaus", "juuriUrl", "juuret", "tavuja", "moduulit", "tyylit", "tiedostot", "kansiot"],
  "properties": {
    "$skeema": { "const": "matkakirja-vienti/1/web-nakyma" },
    "nimi": { "type": "string" },
    "kuvaus": { "type": "string" },
    "juuriUrl": { "type": "string", "format": "uri" },
    "juuret": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "tavuja": {
      "type": "object",
      "required": ["koodi", "tiedostot", "kansiot"],
      "properties": {
        "koodi": { "type": "integer", "minimum": 0 },
        "tiedostot": { "type": "integer", "minimum": 0 },
        "kansiot": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "moduulit": { "type": "array", "items": { "$ref": "#/$defs/tiedosto" } },
    "tyylit": { "type": "array", "items": { "$ref": "#/$defs/tiedosto" } },
    "tiedostot": { "type": "array", "items": { "$ref": "#/$defs/tiedosto" } },
    "kansiot": {
      "type": "array",
      "description": "Kansiot, joista näkymä muodostaa polun ajon aikana (esim. assets/liput/${koodi}.svg)",
      "items": {
        "type": "object",
        "required": ["polku", "tiedostoja", "tavuja"],
        "properties": {
          "polku": { "type": "string", "pattern": "/$" },
          "tiedostoja": { "type": "integer", "minimum": 0 },
          "tavuja": { "type": "integer", "minimum": 0 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "tiedosto": {
      "type": "object",
      "required": ["polku", "tavuja", "sha256"],
      "properties": {
        "polku": { "type": "string" },
        "tavuja": { "type": "integer", "minimum": 0 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "dynaaminen": { "const": true, "description": "tuodaan import()-kutsulla vasta tarvittaessa" }
      },
      "additionalProperties": false
    }
  }
}
