{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://matkakirja.app/vienti/1/manifest.schema.json",
  "title": "Matkakirja-vienti: manifest",
  "description": "Viennin sisällysluettelo. Tuoja tarkistaa tästä, että sai kaiken: jokaisen moduulin exportit lukumäärineen, tiedostojen sha256-tiivisteet ja koot tavuina (tavuja, skeema 1.2) sekä laskennat.",
  "type": "object",
  "required": ["$skeema", "skeemaversio", "mediaJuuri", "laskennat", "media", "kokoelmat", "moduulit"],
  "properties": {
    "$skeema": { "const": "matkakirja-vienti/1/manifest" },
    "skeemaversio": { "type": "string", "pattern": "^1\\.[0-9]+$" },
    "kuvaus": { "type": "string" },
    "mediaJuuri": { "type": "string", "format": "uri" },
    "laskennat": { "type": "object" },
    "media": { "type": "object", "required": ["tiedosto", "sha256", "tavuja"] },
    "lisatiedostot": {
      "type": "array",
      "items": { "type": "object", "required": ["lahde", "tiedosto", "sha256", "tavuja"] }
    },
    "kokoelmat": {
      "type": "array",
      "items": { "type": "object", "required": ["nimi", "tiedosto", "lahde", "lkm", "sha256", "tavuja"] }
    },
    "webNakymat": {
      "type": "array",
      "description": "Web-näkymien riippuvuuslistat (skeema 1.3), ks. web-nakyma.schema.json",
      "items": { "type": "object", "required": ["nimi", "tiedosto", "sha256", "tavuja"] }
    },
    "logiikka": {
      "type": "array",
      "description": "Jokainen paketin funktio ({ $funktio } raakakerroksessa) luokiteltuna: mistä natiivi saa sen tuloksen (skeema 1.5, tools/vienti/logiikka.mjs). Lähdetekstiä ei ajeta.",
      "items": {
        "type": "object",
        "required": ["kohta", "luokka"],
        "properties": {
          "kohta": { "type": "string", "pattern": "^[^#]+#.+$" },
          "luokka": { "enum": ["media", "esilaskettu", "saanto", "logiikka", "kuollut"] },
          "tunniste": { "type": "string" },
          "saanto": { "type": "string" },
          "esilaskettu": { "type": "string" },
          "media": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "moduulit": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["moduuli", "tiedosto", "lahdeSha256", "sha256", "tavuja", "exportit"],
        "properties": {
          "exportit": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["nimi", "laji", "lkm", "funktioita", "mediaviitteita"],
              "properties": {
                "laji": { "enum": ["taulukko", "olio", "map", "set", "funktio", "merkkijono", "luku", "totuusarvo", "null"] },
                "lkm": { "type": ["integer", "null"] }
              }
            }
          }
        }
      }
    }
  }
}
