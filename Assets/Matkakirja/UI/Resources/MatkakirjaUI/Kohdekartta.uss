/* Kohdekartta: kaupungin nähtävyyskartta (UI/Kohdekartta.cs). */

/* --- nähtävyysnäkymä: tiivis lehtiarkki (Nahtavyysnakyma.cs; web .tiivis-lehtiarkki) ---- */

.mk-nahtavyydet {
    width: 100%;
    max-width: 760px;
    max-height: 92%;
    flex-shrink: 1;
    padding: 12px 16px 16px 16px;
    border-width: 1px;
    border-color: rgba(70, 51, 31, 0.3);
    background-color: #f5f0e2;
    color: rgba(58, 42, 26, 0.95);
}

.mk-nahtavyydet__yla {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    padding-bottom: 6px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(70, 51, 31, 0.25);
}

.mk-nahtavyydet__yla {
    justify-content: center;
}

/* Web .tiivis-lehtiarkki .lehti-nimio: clamp(1.2rem, 4.5vw, 1.6rem), letter-spacing 0.1em (UITK: em/100 → 10),
 * versaalit keskellä, #16130f. */
.mk-nahtavyydet__otsikko {
    flex-grow: 1;
    font-size: 19.2px;
    letter-spacing: 10px;
    -unity-text-align: middle-center;
    color: #16130f;
    margin: 0 36px;
}

.mk-nahtavyydet__sulje {
    position: absolute;
    right: 0;
}

.mk-nahtavyydet__vieritys {
    flex-shrink: 1;
}

.mk-nahtavyydet__nappirivi {
    flex-direction: row;
    justify-content: flex-end;
    margin: 8px 0 6px 0;
}

.mk-nahtavyydet__kokoruutu {
    min-height: 32px;
    padding: 3px 12px;
    border-width: 1px;
    border-color: rgba(70, 51, 31, 0.45);
    border-radius: 3px;
    background-color: rgba(255, 252, 242, 0.5);
    color: #46331f;
}

.mk-nahtavyydet__kokoruutu .mk-nappi__teksti {
    font-size: 12.5px;
}

.mk-nahtavyydet__esittely {
    margin-top: 10px;
    font-size: 16px;
    white-space: normal;
}

.mk-nahtavyydet__luelisaa {
    margin-top: 4px;
}

/* --- kohdekartta (KohdekarttaNakyma.cs; web piirraKaupunkiKartta, css/styles.css .kartta-kehys, .kohde-*).
 * Löydös 63: näkymällä ei ollut tyylejä lainkaan, joten kuva jäi mitoitta, ja kyltti ja nimi piirtyivät päällekkäin. */
.mk-kohdekartta {
    flex-shrink: 0;
}

.mk-kohdekartta__tyokalut {
    flex-direction: row;
    justify-content: flex-end;
    margin-bottom: 6px;
}

/* Web .kartta-tyokalut button.kartta-kokoruutu-nappi: vaalea pilleri (padding 0.2rem 0.6rem, 0.66rem versaalit,
 * letter-spacing 0.12em, reunus rgba(70,51,31,0.35)). Ilman tätä nappi sai oletusnapin tumman kultapohjan. */
.mk-kohdekartta__kokoruutu {
    min-height: 0;
    height: auto;
    padding: 3.2px 9.6px;
    border-width: 1px;
    border-color: rgba(70, 51, 31, 0.35);
    border-radius: 999px;
    background-color: rgba(255, 250, 238, 0.6);
    color: rgba(70, 51, 31, 0.85);
}

.mk-kohdekartta__kokoruutu .mk-nappi__teksti {
    font-size: 10.6px;
    letter-spacing: 12px; /* web 0.12em */
    color: rgba(70, 51, 31, 0.85);
}

.mk-kohdekartta__kokoruutu .mk-ikoni {
    width: 11px;
    height: 11px;
    margin-right: 5px;
}

.mk-kohdekartta__kehys {
    position: relative;
    overflow: hidden;
    margin: 4.8px 0 8.8px 0;
    border-width: 1px;
    border-color: rgba(70, 51, 31, 0.4);
    border-radius: 2px;
    background-color: #efe6cf;
}

.mk-kohdekartta__lava {
    position: absolute;
}

.mk-kohdekartta__kuva {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    -unity-background-scale-mode: stretch-to-fill;
}

.mk-kohdekartta__lahde {
    margin-top: 1.6px;
    font-size: 9.3px;
    color: rgba(90, 74, 51, 0.8);
}

/* Piirros 40 × 40 (web .maakartta-piste.kohde-numero.kohde-piirros), keskitetty pisteeseen. */
.mk-kohdekartta__piirros {
    position: absolute;
    width: 40px;
    height: 40px;
    translate: -50% -50%;
    overflow: visible;
}

.mk-kohdekartta__piirroskuva {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    -unity-background-scale-mode: scale-to-fit;
}

/* Löydös 178: aukio ja luonto rakennusta keveämpinä (web .maakartta-piste.kohde-kevyt .kohde-piirros-kuva). */
.mk-kohdekartta__piirros--kevyt > .mk-kohdekartta__piirroskuva {
    scale: 0.72 0.72;
    opacity: 0.78;
}

/* Kyltti vain valitulla (web .kohde-kyltti display none, .valittu block). */
.mk-kohdekartta__kyltti {
    display: none;
    position: absolute;
    left: 50%;
    translate: -50% 0;
    padding: 3.2px 8.8px;
    white-space: nowrap;
    font-size: 15.2px;
    color: #2c1e07;
    background-color: #f5f0e2;
    border-width: 1px;
    border-color: rgba(70, 51, 31, 0.55);
    border-radius: 3px;
}

.mk-kohdekartta__piirros--valittu .mk-kohdekartta__kyltti {
    display: flex;
}

/* Nimi näkyy vasta zoomattuna (web .kohde-nimi opacity 0, .zoomattu 1). */
.mk-kohdekartta__nimi {
    position: absolute;
    left: 50%;
    width: 104px;
    margin-left: -52px;
    font-size: 9.6px;
    white-space: normal;
    -unity-text-align: upper-center;
    color: #16130f;
    text-shadow: 0 0 3px rgba(247, 239, 220, 0.95);
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.35s;
}

.mk-kohdekartta--zoomattu .mk-kohdekartta__nimi {
    opacity: 1;
    font-size: 11.5px;
}

.mk-kohdekartta__ankkuri {
    position: absolute;
    width: 0;
    height: 0;
    overflow: visible;
}

/* Numeroympyrä 26 × 26 (web .kohde-numeroympyra). */
.mk-kohdekartta__ympyra {
    position: absolute;
    left: -13px;
    top: -13px;
    width: 26px;
    height: 26px;
    align-items: center;
    justify-content: center;
    border-width: 2px;
    border-color: #2c2318;
    border-radius: 13px;
    background-color: #f3e2b8;
}

.mk-kohdekartta__numero {
    font-size: 13px;
    color: #2c2318;
    -unity-text-align: middle-center;
}

.mk-kohdekartta__nimi--ympyra {
    top: 15px;
}

/* Löydös 63 (web .kartta-mittajana): ohut vaakaviiva, päissä pystyviivat, vaalea kaista alaosassa; teksti 0,58rem
   Kone keskellä janan yllä vaalealla pohjalla. Paikka ja leveys C#:ssa (KohdekarttaNakyma). */
.mk-kohdekartta__mittajana {
    position: absolute;
    height: 6px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-color: rgb(55, 46, 35);
    background-color: rgba(0, 0, 0, 0);
}

.mk-kohdekartta__mittajanakaista {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 60%;
    background-color: rgba(247, 240, 222, 0.55);
}

.mk-kohdekartta__mittajanateksti {
    position: absolute;
    left: 50%;
    bottom: 7px;
    translate: -50% 0;
    padding: 0 3px;
    margin: 0;
    font-size: 9.3px;
    white-space: nowrap;
    -unity-text-align: middle-center;
    color: rgb(47, 38, 27);
    background-color: rgba(247, 240, 222, 0.72);
    border-radius: 2px;
}


/* --- Löydös 94 (omistaja, build 13): kohdekartan KOKORUUTU (web avaaKarttaSuurennos, css/styles.css
 * .postikortti.kulttuuri-suurennos.kartta-suurennos 17865–18062). Tyylit puuttuivat kokonaan, joten näkymä aukesi
 * tyylittömänä vasempaan yläkulmaan. Koko ruudun pohja #0b0805 (::before), kortti ilman omaa taustaa keskellä
 * (leveys koodista: min(98 % ruudusta, 85 % korkeudesta × kartan suhde)), rasti kortin oikeassa yläkulmassa,
 * vaaleat kohdenimet ja lähderivi kartan alla. Pohjan napautus ei sulje (web: vain rasti, omistaja 21.8.2026). --- */
.mk-kohdekartta-kokoruutu {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: #0b0805;
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.2s;
}

.mk-kohdekartta-kokoruutu.mk-auki {
    opacity: 1;
}

.mk-kohdekartta-kokoruutu__kortti {
    position: relative;
    flex-shrink: 0;
    max-width: 98%;
}

.mk-kohdekartta--kokoruutu {
    width: 100%;
}

.mk-kohdekartta--kokoruutu .mk-kohdekartta__kehys {
    margin: 0;
    border-width: 0;
}

/* Web .dialog .kartta-suurennos button.uutinen-sulku: 2rem, top 0.35rem, right 0.4rem, paperinen neliö. */
.mk-kohdekartta-kokoruutu__sulku {
    position: absolute;
    top: 5.6px;
    right: 6.4px;
    width: 32px;
    height: 32px;
    min-height: 32px;
    padding: 0;
    border-width: 1px;
    border-color: rgba(70, 51, 31, 0.45);
    border-radius: 3px;
    background-color: rgba(247, 240, 222, 0.88);
    align-items: center;
    justify-content: center;
}

.mk-kohdekartta-kokoruutu__sulku .mk-nappi__teksti {
    font-size: 20px;
    -unity-text-align: middle-center;
    color: #2c2318;
}

.mk-kohdekartta-kokoruutu__sulku:active {
    background-color: rgba(255, 250, 238, 0.98);
    border-color: rgba(70, 51, 31, 0.75);
}

/* Web .kartta-suurennos-selitteet: rivitetty keskitetty luettelo (gap 0.3rem 1rem), margin-top 0.45rem, sivut 0.5rem,
 * enintään 20 % korkeudesta (koodi). */
.mk-kohdekartta-kokoruutu__selitteet {
    flex-shrink: 1;
    margin-top: 7.2px;
    padding: 0 8px;
}

/* Web .dialog .kartta-suurennos .kartta-selitteet .kartta-selite: Kone 0.78rem, harvennus 0.03em, vaalea. */
.mk-kohdekartta-kokoruutu__selite {
    min-height: 0;
    margin: 0 8px 4.8px 8px;
    padding: 1.6px 0;
    border-width: 0;
    border-radius: 0;
    background-color: rgba(0, 0, 0, 0);
    font-size: 12.5px;
    letter-spacing: 3px; /* web 0.03em */
    color: #e4dccb; /* web rgba(247, 239, 220, 0.92) pohjalla #0b0805 */
    white-space: normal;
}

.mk-kohdekartta-kokoruutu__selite .mk-nappi__teksti {
    font-size: 12.5px;
    letter-spacing: 3px; /* web 0.03em */
    color: #e4dccb; /* web rgba(247, 239, 220, 0.92) pohjalla #0b0805 */
}

.mk-kohdekartta-kokoruutu__selite--nappi:active .mk-nappi__teksti {
    color: #f0d9a4;
}

/* Web .postikortti.kulttuuri-suurennos .kuvalahde: 0.6rem, vaalea 0,62, keskitetty, margin-top 0.3rem. */
.mk-kohdekartta-kokoruutu__lahde {
    margin-top: 4.8px;
    font-size: 9.6px;
    -unity-text-align: middle-center;
    white-space: normal;
    color: #9d978a; /* web rgba(247, 239, 220, 0.62) pohjalla #0b0805 */
}

.mk-kohdekartta-kokoruutu__kortti--levitetty .mk-kohdekartta-kokoruutu__selitteet,
.mk-kohdekartta-kokoruutu__kortti--levitetty .mk-kohdekartta-kokoruutu__lahde {
    display: none;
}

/* --- KAUPUNGIN AVAUSKORTTI (web v2296 css/kaupunkinosto.css .kaupunkipopup-avaus, Avauskortti.cs) -------------- */

.mk-avauskortti-alue {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

/* Web .kaupunkipopup + -avaus: #f5f0e2, reuna rgba(122,85,20,.32), kulma 16, varjo; ei sisäreunusta. */
.mk-avauskortti {
    position: absolute;
    flex-direction: column;
    overflow: hidden;
    border-width: 1px;
    border-color: rgba(122, 85, 20, 0.32);
    border-radius: 16px;
    background-color: #f5f0e2;
    color: #211d18;
}

.mk-avauskortti__vieritys {
    flex-shrink: 1;
}

.mk-avauskortti__vieritys > .unity-scroll-view__content-viewport > .unity-scroll-view__content-container {
    padding-bottom: 13.6px;
}

/* Hero: 16 % ruudun korkeudesta (Avauskortti.Mitoita), pohja #d9ccb0 kunnes kuva saapuu, cover. */
.mk-avauskortti__hero {
    flex-shrink: 0;
    overflow: hidden;
    background-color: #d9ccb0;
}

.mk-avauskortti__herokuva {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    -unity-background-scale-mode: scale-and-crop;
    transition-property: opacity;
    transition-duration: 0.12s;
}

/* Web .avauskortti-nimi: 600 1.9rem Luku, #fff8ec, text-shadow 0 2px 8px rgba(0,0,0,.65), vasen 0.9rem ala 0.45rem. */
.mk-avauskortti__nimi {
    position: absolute;
    left: 14.4px;
    bottom: 7.2px;
    margin: 0;
    padding: 0;
    font-size: 30.4px;
    color: #fff8ec;
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.65);
}

/* Web .avauskortti-esittely: padding 0.65rem 0.9rem 0.5rem. */
.mk-avauskortti__esittely {
    padding: 10.4px 14.4px 8px 14.4px;
    align-items: flex-start;
}

.mk-avauskortti__teksti {
    margin: 0;
    padding: 0;
    font-size: 15.5px;
    white-space: normal;
    color: #211d18;
}

/* Web .avauskortti-lehti: 0.9rem type-kirjasin #b03a2b, alaviiva 1 px, ei nappipohjaa. */
.mk-avauskortti__lehti {
    min-height: 0;
    margin: 4.8px 0 0 0;
    padding: 0 0 1px 0;
    border-width: 0 0 1px 0;
    border-radius: 0;
    border-color: #b03a2b;
    background-color: rgba(0, 0, 0, 0);
    justify-content: flex-start;
}

.mk-avauskortti__lehti .mk-nappi__teksti {
    font-size: 14.4px;
    color: #b03a2b;
}

/* Web .avauskortti-kartta: margin 0 0.9rem, reuna rgba(122,85,20,.35), kulma 8, korkeus 35svh (Mitoita). */
.mk-avauskortti__kartta {
    flex-shrink: 0;
    overflow: hidden;
    margin: 0 14.4px;
    border-width: 1px;
    border-color: rgba(122, 85, 20, 0.35);
    border-radius: 8px;
}

/* Pelkkä kartta (web .kaupunkikartta-pelkka): täyttää kaistan, ei kehyksen omaa reunaa, lähde kulmassa kartan päällä. */
.mk-kohdekartta--pelkka {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    overflow: hidden;
}

.mk-kohdekartta--pelkka > .mk-kohdekartta__kehys {
    flex-shrink: 0;
    margin: 0;
    border-width: 0;
    border-radius: 0;
}

.mk-kohdekartta--pelkka .mk-kohdekartta__kyltti,
.mk-kohdekartta--pelkka .mk-kohdekartta__nimi {
    display: none;
}

.mk-kohdekartta--pelkka > .mk-kohdekartta__lahde {
    position: absolute;
    left: 0;
    bottom: 0;
    margin: 0;
    padding: 2.4px 6.4px;
    font-size: 11.5px;
    border-top-right-radius: 6px;
    background-color: rgba(245, 240, 226, 0.85);
}

/* Web .avauskortti-opas: margin 0.65rem 0.9rem 0, padding 0.5rem, #efe1c2, kulma 8, rako 0.65rem. */
.mk-avauskortti__opas {
    flex-direction: row;
    align-items: stretch;
    justify-content: flex-start;
    min-height: 0;
    margin: 10.4px 14.4px 0 14.4px;
    padding: 8px;
    border-width: 0;
    border-radius: 8px;
    background-color: #efe1c2;
}

.mk-avauskortti__opaskuva {
    flex-shrink: 0;
    width: 84px;
    height: 84px;
    margin-right: 10.4px;
    border-radius: 6px;
    -unity-background-scale-mode: scale-and-crop;
}

.mk-avauskortti__opastekstit {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}

.mk-avauskortti__oppaanlaji {
    margin: 0;
    padding: 0;
    font-size: 11.5px;
    letter-spacing: 7.7px; /* web 0.08em */
    color: #8a6114;
}

.mk-avauskortti__oppaanotsikko {
    margin: 1.6px 0;
    padding: 0;
    font-size: 15.5px;
    white-space: normal;
    color: #211d18;
}

.mk-avauskortti__oppaanteksti {
    margin: 0;
    padding: 0;
    font-size: 13.8px;
    white-space: normal;
    color: #211d18;
}

/* Web .kaupunkipopup-avaus > .kaupunkipopup-sulje: 2.1rem ympyrä rgba(245,240,226,.92), × 1.1rem #3a2f24. */
.mk-avauskortti__sulku {
    position: absolute;
    top: 8px;
    right: 8.8px;
    width: 33.6px;
    height: 33.6px;
    min-height: 33.6px;
    padding: 0;
    border-width: 0;
    border-radius: 16.8px;
    background-color: rgba(245, 240, 226, 0.92);
    align-items: center;
    justify-content: center;
}

.mk-avauskortti__sulku .mk-nappi__teksti {
    font-size: 22px;
    color: #3a2f24;
}

/* Suurennos kortista (web .kartta-suurennos-kortista): huntu rgba(29,22,16,.35) (+ KuvaSumea), kortti #f5f0e2
   kulma 14, padding 2.6rem 0.6rem 0.6rem, kartta keskellä; × ympyränä; − + oikeassa alakulmassa. */
.mk-kohdekartta-kokoruutu--kortista {
    background-color: rgba(29, 22, 16, 0.35);
}

.mk-kohdekartta-kokoruutu--kortista > .mk-kohdekartta-kokoruutu__kortti {
    justify-content: center;
    padding: 41.6px 9.6px 9.6px 9.6px;
    border-radius: 14px;
    background-color: #f5f0e2;
    max-width: 94%;
}

.mk-kohdekartta-kokoruutu--kortista .mk-kohdekartta__kehys {
    border-radius: 6px;
}

.mk-kohdekartta-kokoruutu--kortista .mk-kohdekartta-kokoruutu__sulku {
    top: 7.2px;
    right: 7.2px;
    width: 33.6px;
    height: 33.6px;
    min-height: 33.6px;
    border-color: rgba(122, 85, 20, 0.3);
    border-radius: 16.8px;
    background-color: rgba(245, 240, 226, 0.94);
}

.mk-kohdekartta-kokoruutu__tyokalut {
    position: absolute;
    right: 14.4px;
    bottom: 14.4px;
    flex-direction: row;
}

.mk-kohdekartta-kokoruutu__zoom {
    width: 38px;
    height: 38px;
    min-height: 38px;
    margin-left: 6.4px;
    padding: 0;
    border-width: 1px;
    border-color: rgba(122, 85, 20, 0.35);
    border-radius: 8px;
    background-color: #efe1c2;
    align-items: center;
    justify-content: center;
}

.mk-kohdekartta-kokoruutu__zoom .mk-nappi__teksti {
    font-size: 20px;
    color: #3a2f24;
}

/* --- AVAUSKORTIN KUTSU (web .kaupunkikortin-kutsu, Kutsuminiatyyri.cs) ------------------------------------------- */

.mk-kutsu {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

/* Web .kaupunkikortin-kutsu-kortti: 64 × 64, reuna 2 px #f5f0e2, kulma 9, pohja #d9ccb0. */
.mk-kutsu__kortti {
    position: absolute;
    width: 64px;
    height: 64px;
    min-height: 64px;
    margin: 0;
    padding: 0;
    overflow: hidden;
    border-width: 2px;
    border-color: #f5f0e2;
    border-radius: 9px;
    background-color: #d9ccb0;
    justify-content: flex-end;
    align-items: stretch;
}

.mk-kutsu__kuva {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    -unity-background-scale-mode: scale-and-crop;
}

/* Web .kaupunkikortin-kutsu-nimi: 600 10px Luku, #fff8ec pohjalla rgba(33,29,24,.72), yksi rivi, keskitetty. */
.mk-kutsu__nimi {
    margin: 0;
    padding: 1px 3px 2px 3px;
    font-size: 10px;
    color: #fff8ec;
    background-color: rgba(33, 29, 24, 0.72);
    -unity-text-align: middle-center;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}
