/* Kohdekartta: kaupungin nähtävyyskartta (UI/Kohdekartta.cs). */

/* --- nähtävyysnäkymä: tiivis lehtiarkki (Nahtavyysnakyma.cs; web .tiivis-lehtiarkki) ---- */

.mk-nahtavyydet {
    width: 100%;
    max-width: 760px;
    max-height: 92%;
    flex-shrink: 1;
    padding: 12px 16px 16px 16px;
    border-width: 1px;
    border-color: var(--tk-paperi-reunus);
    background-color: var(--tk-paperi-pinta);
    color: var(--map-ink-95);
}

.mk-nahtavyydet__yla {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    padding-bottom: 6px;
    border-bottom-width: 1px;
    border-bottom-color: var(--map-ink-25);
}

.mk-nahtavyydet__yla {
    justify-content: center;
}

/* Web .tiivis-lehtiarkki .lehti-nimio: clamp(1.2rem, 4.5vw, 1.6rem), letter-spacing 0.1em (UITK: em/100 → 10),
 * versaalit keskellä, #16130f. */
.mk-nahtavyydet__otsikko {
    flex-grow: 1;
    font-size: 19.2px; /* fonttipoikkeus: 19.2 px, asteikossa pienempi 18 px; tekstiä ei pienennetä luettavuuden takia (Päätoimittaja 8.10.2026) */
    letter-spacing: 52.08px; /* web 10px */
    -unity-text-align: middle-center;
    color: var(--bg);
    margin: 0 36px;
}

.mk-nahtavyydet__sulje {
    position: absolute;
    right: 0;
}

.mk-nahtavyydet__vieritys {
    flex-shrink: 1;
}

.mk-nahtavyydet__nappirivi {
    flex-direction: row;
    justify-content: flex-end;
    margin: 8px 0 6px 0;
}

.mk-nahtavyydet__kokoruutu {
    min-height: 32px;
    padding: 3px 12px;
    border-width: 1px;
    border-color: var(--map-ink-45);
    border-radius: var(--tk-kulma-hius);
    background-color: var(--tk-kuulto-paperi-pinta-50);
    color: var(--map-ink);
}

.mk-nahtavyydet__kokoruutu .mk-nappi__teksti {
    font-size: var(--tk-koko-kapiteeli);
}

.mk-nahtavyydet__esittely {
    margin-top: 10px;
    font-size: var(--tk-koko-leipa);
    white-space: normal;
}

.mk-nahtavyydet__luelisaa {
    margin-top: 4px;
}

/* --- kohdekartta (KohdekarttaNakyma.cs; web piirraKaupunkiKartta, css/styles.css .kartta-kehys, .kohde-*).
 * Löydös 63: näkymällä ei ollut tyylejä lainkaan, joten kuva jäi mitoitta, ja kyltti ja nimi piirtyivät päällekkäin. */
.mk-kohdekartta {
    flex-shrink: 0;
}

.mk-kohdekartta__tyokalut {
    flex-direction: row;
    justify-content: flex-end;
    margin-bottom: 6px;
}

/* Web .kartta-tyokalut button.kartta-kokoruutu-nappi: vaalea pilleri (padding 0.2rem 0.6rem, 0.66rem versaalit,
 * letter-spacing 0.12em, reunus rgba(70,51,31,0.35)). Ilman tätä nappi sai oletusnapin tumman kultapohjan. */
.mk-kohdekartta__kokoruutu {
    min-height: 0;
    height: auto;
    padding: 3.2px 9.6px;
    border-width: 1px;
    border-color: var(--map-ink-35);
    border-radius: var(--tk-kulma-nappi);
    background-color: var(--tk-kuulto-paperi-pinta-60);
    color: var(--map-ink-85);
}

.mk-kohdekartta__kokoruutu .mk-nappi__teksti {
    font-size: var(--tk-koko-kapiteeli);
    letter-spacing: 12px; /* web 0.12em */
    color: var(--map-ink-85);
}

.mk-kohdekartta__kokoruutu .mk-ikoni {
    width: 11px;
    height: 11px;
    margin-right: 5px;
}

.mk-kohdekartta__kehys {
    position: relative;
    overflow: hidden;
    margin: 4.8px 0 8.8px 0;
    border-width: 1px;
    border-color: var(--map-ink-40);
    border-radius: var(--tk-kulma-hius);
    background-color: var(--tk-tumma-muste);
}

.mk-kohdekartta__lava {
    position: absolute;
}

.mk-kohdekartta__kuva {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    -unity-background-scale-mode: stretch-to-fill;
}

.mk-kohdekartta__lahde {
    margin-top: 1.6px;
    font-size: 9.3px; /* fonttipoikkeus: 9.3 px, lähin asteikon koko 12 px (ero 2.7 px näkyisi; Päätoimittaja 8.10.2026) */
    color: var(--tk-kuulto-paperi-muste-pehmea-80);
}

/* Piirros 40 × 40 (web .maakartta-piste.kohde-numero.kohde-piirros), keskitetty pisteeseen. */
.mk-kohdekartta__piirros {
    position: absolute;
    width: 40px;
    height: 40px;
    translate: -50% -50%;
    overflow: visible;
}

.mk-kohdekartta__piirroskuva {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    -unity-background-scale-mode: scale-to-fit;
}

/* Löydös 178: aukio ja luonto rakennusta keveämpinä (web .maakartta-piste.kohde-kevyt .kohde-piirros-kuva). */
.mk-kohdekartta__piirros--kevyt > .mk-kohdekartta__piirroskuva {
    scale: 0.72 0.72;
    opacity: 0.78;
}

/* Kyltti vain valitulla (web .kohde-kyltti display none, .valittu block). */
.mk-kohdekartta__kyltti {
    display: none;
    position: absolute;
    left: 50%;
    translate: -50% 0;
    padding: 3.2px 8.8px;
    white-space: nowrap;
    font-size: 15.2px;
    color: var(--tk-lasi-pinta-peitto);
    background-color: var(--tk-paperi-pinta);
    border-width: 1px;
    border-color: var(--map-ink-55);
    border-radius: var(--tk-kulma-hius);
}

.mk-kohdekartta__piirros--valittu .mk-kohdekartta__kyltti {
    display: flex;
}

/* Nimi näkyy vasta zoomattuna (web .kohde-nimi opacity 0, .zoomattu 1). */
.mk-kohdekartta__nimi {
    position: absolute;
    left: 50%;
    width: 104px;
    margin-left: -52px;
    font-size: 9.6px; /* fonttipoikkeus: 9.6 px, lähin asteikon koko 12 px (ero 2.4 px näkyisi; Päätoimittaja 8.10.2026) */
    white-space: normal;
    -unity-text-align: upper-center;
    color: var(--bg);
    text-shadow: 0 0 3px rgba(247, 239, 220, 0.95);
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.22s; /* UI-siirtymä ≤ 250 ms (pohjavahti 8.10., oli 0.35s) */
}

.mk-kohdekartta--zoomattu .mk-kohdekartta__nimi {
    opacity: 1;
    font-size: var(--tk-koko-kapiteeli);
}

.mk-kohdekartta__ankkuri {
    position: absolute;
    width: 0;
    height: 0;
    overflow: visible;
}

/* Numeroympyrä 26 × 26 (web .kohde-numeroympyra). */
.mk-kohdekartta__ympyra {
    position: absolute;
    left: -13px;
    top: -13px;
    width: 26px;
    height: 26px;
    align-items: center;
    justify-content: center;
    border-width: 2px;
    border-color: var(--panel);
    border-radius: 13px;
    background-color: var(--paper);
}

.mk-kohdekartta__numero {
    font-size: 13px; /* fonttipoikkeus: 13 px, asteikossa pienempi 12 px; tekstiä ei pienennetä luettavuuden takia (Päätoimittaja 8.10.2026) */
    color: var(--panel);
    -unity-text-align: middle-center;
}

.mk-kohdekartta__nimi--ympyra {
    top: 15px;
}

/* Löydös 63 (web .kartta-mittajana): ohut vaakaviiva, päissä pystyviivat, vaalea kaista alaosassa; teksti 0,58rem
   Kone keskellä janan yllä vaalealla pohjalla. Paikka ja leveys C#:ssa (KohdekarttaNakyma). */
.mk-kohdekartta__mittajana {
    position: absolute;
    height: 6px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-color: var(--panel-2);
    background-color: var(--lapinakyva);
}

.mk-kohdekartta__mittajanakaista {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 60%;
    background-color: var(--tk-kuulto-paperi-pinta-55);
}

.mk-kohdekartta__mittajanateksti {
    position: absolute;
    left: 50%;
    bottom: 7px;
    translate: -50% 0;
    padding: 0 3px;
    margin: 0;
    font-size: 9.3px; /* fonttipoikkeus: 9.3 px, lähin asteikon koko 12 px (ero 2.7 px näkyisi; Päätoimittaja 8.10.2026) */
    white-space: nowrap;
    -unity-text-align: middle-center;
    color: var(--tk-lasi-pinta-peitto);
    background-color: var(--tk-kuulto-paperi-pinta-72);
    border-radius: var(--tk-kulma-hius);
}


/* --- Löydös 94 (omistaja, build 13): kohdekartan KOKORUUTU (web avaaKarttaSuurennos, css/styles.css
 * .postikortti.kulttuuri-suurennos.kartta-suurennos 17865–18062). Tyylit puuttuivat kokonaan, joten näkymä aukesi
 * tyylittömänä vasempaan yläkulmaan. Koko ruudun pohja #0b0805 (::before), kortti ilman omaa taustaa keskellä
 * (leveys koodista: min(98 % ruudusta, 85 % korkeudesta × kartan suhde)), rasti kortin oikeassa yläkulmassa,
 * vaaleat kohdenimet ja lähderivi kartan alla. Pohjan napautus ei sulje (web: vain rasti, omistaja 21.8.2026). --- */
.mk-kohdekartta-kokoruutu {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: var(--tk-kuulto-himmennys-tumma-100);
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.2s;
}

.mk-kohdekartta-kokoruutu.mk-auki {
    opacity: 1;
}

.mk-kohdekartta-kokoruutu__kortti {
    position: relative;
    flex-shrink: 0;
    max-width: 98%;
}

.mk-kohdekartta--kokoruutu {
    width: 100%;
}

.mk-kohdekartta--kokoruutu .mk-kohdekartta__kehys {
    margin: 0;
    border-width: 0;
}

/* Web .dialog .kartta-suurennos button.uutinen-sulku: 2rem, top 0.35rem, right 0.4rem, paperinen neliö. */
.mk-kohdekartta-kokoruutu__sulku {
    position: absolute;
    top: 5.6px;
    right: 6.4px;
    width: 32px;
    height: 32px;
    min-height: 32px;
    padding: 0;
    border-width: 1px;
    border-color: var(--map-ink-45);
    border-radius: var(--tk-kulma-hius);
    background-color: var(--tk-kuulto-paperi-pinta-88);
    align-items: center;
    justify-content: center;
}

.mk-kohdekartta-kokoruutu__sulku .mk-nappi__teksti {
    font-size: var(--tk-koko-otsikko);
    -unity-text-align: middle-center;
    color: var(--panel);
}

.mk-kohdekartta-kokoruutu__sulku:active {
    background-color: var(--tk-paperi-pinta);
    border-color: var(--map-ink-75);
}

/* Web .kartta-suurennos-selitteet: rivitetty keskitetty luettelo (gap 0.3rem 1rem), margin-top 0.45rem, sivut 0.5rem,
 * enintään 20 % korkeudesta (koodi). */
.mk-kohdekartta-kokoruutu__selitteet {
    flex-shrink: 1;
    margin-top: 7.2px;
    padding: 0 8px;
}

/* Web .dialog .kartta-suurennos .kartta-selitteet .kartta-selite: Kone 0.78rem, harvennus 0.03em, vaalea. */
.mk-kohdekartta-kokoruutu__selite {
    min-height: 0;
    margin: 0 8px 4.8px 8px;
    padding: 1.6px 0;
    border-width: 0;
    border-radius: 0;
    background-color: var(--lapinakyva);
    font-size: var(--tk-koko-kapiteeli);
    letter-spacing: 3px; /* web 0.03em */
    color: var(--tk-tumma-muste); /* web rgba(247, 239, 220, 0.92) pohjalla #0b0805 */
    white-space: normal;
}

.mk-kohdekartta-kokoruutu__selite .mk-nappi__teksti {
    font-size: var(--tk-koko-kapiteeli);
    letter-spacing: 3px; /* web 0.03em */
    color: var(--tk-tumma-muste); /* web rgba(247, 239, 220, 0.92) pohjalla #0b0805 */
}

.mk-kohdekartta-kokoruutu__selite--nappi:active .mk-nappi__teksti {
    color: var(--tk-paperi-pergamentti);
}

/* Web .postikortti.kulttuuri-suurennos .kuvalahde: 0.6rem, vaalea 0,62, keskitetty, margin-top 0.3rem. */
.mk-kohdekartta-kokoruutu__lahde {
    margin-top: 4.8px;
    font-size: 9.6px; /* fonttipoikkeus: 9.6 px, lähin asteikon koko 12 px (ero 2.4 px näkyisi; Päätoimittaja 8.10.2026) */
    -unity-text-align: middle-center;
    white-space: normal;
    color: #9d978a; /* väripoikkeus: lämmin sävy, lähin token neutraali harmaa tk-harmaa-reunus (ΔE 8.6) (Päätoimittaja 8.10.2026) */ /* web rgba(247, 239, 220, 0.62) pohjalla #0b0805 */
}

.mk-kohdekartta-kokoruutu__kortti--levitetty .mk-kohdekartta-kokoruutu__selitteet,
.mk-kohdekartta-kokoruutu__kortti--levitetty .mk-kohdekartta-kokoruutu__lahde {
    display: none;
}

/* --- KAUPUNGIN AVAUSKORTTI (web v2296 css/kaupunkinosto.css .kaupunkipopup-avaus, Avauskortti.cs) -------------- */

.mk-avauskortti-alue {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

/* Web .kaupunkipopup + -avaus: #f5f0e2, reuna rgba(122,85,20,.32), kulma 16, varjo; ei sisäreunusta. */
.mk-avauskortti {
    /* NOSTOKORTTI-pohja (omistaja 1.10.2026): paikka koodista (Avauskortti.Mitoita), värit ja kulma tyylikirjasta. */
    position: absolute;
    flex-direction: column;
    overflow: hidden;
    padding-top: 22px; /* vetokahvan tila (KAPEA) */
    border-width: 1px;
    border-color: var(--tk-paperi-reunus);
    border-radius: var(--tk-kulma-kortti);
    background-color: var(--tk-paperi-pinta);
    color: var(--tk-paperi-muste);
}

.mk-avauskortti__vieritys {
    flex-shrink: 1;
}

.mk-avauskortti__loppu {
    flex-shrink: 0;
    height: 13.6px;
}

/* Hero: 16 % ruudun korkeudesta (Avauskortti.Mitoita), pohja #d9ccb0 kunnes kuva saapuu, cover. */
.mk-avauskortti__hero {
    flex-shrink: 0;
    overflow: hidden;
    background-color: var(--tk-paperi-pergamentti);
}

.mk-avauskortti__herokuva {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    -unity-background-scale-mode: scale-and-crop;
    transition-property: opacity;
    transition-duration: 0.12s;
}

/* Web .avauskortti-nimi: 600 1.9rem Luku, #fff8ec, text-shadow 0 2px 8px rgba(0,0,0,.65), vasen 0.9rem ala 0.45rem. */
.mk-avauskortti__nimi {
    position: absolute;
    left: 14.4px;
    bottom: 7.2px;
    margin: 0;
    padding: 0;
    font-size: 30.4px; /* fonttipoikkeus: 30.4 px, lähin asteikon koko 34 px (ero 3.6 px näkyisi; Päätoimittaja 8.10.2026) */
    color: var(--tk-paperi-pinta);
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.65);
}

/* Web .avauskortti-esittely: padding 0.65rem 0.9rem 0.5rem. */
.mk-avauskortti__esittely {
    padding: 10.4px 14.4px 8px 14.4px;
    align-items: flex-start;
}

.mk-avauskortti__teksti {
    margin: 0;
    padding: 0;
    font-size: var(--tk-koko-leipa);
    white-space: normal;
    color: var(--tk-paperi-muste);
}

/* Web .avauskortti-lehti: 0.9rem type-kirjasin #b03a2b, alaviiva 1 px, ei nappipohjaa. */
.mk-avauskortti__lehti {
    min-height: 0;
    margin: 4.8px 0 0 0;
    padding: 0 0 1px 0;
    border-width: 0 0 1px 0;
    border-radius: 0;
    border-color: var(--mark);
    background-color: var(--lapinakyva);
    justify-content: flex-start;
}

.mk-avauskortti__lehti .mk-nappi__teksti {
    font-size: var(--tk-koko-apuri);
    color: var(--mark);
}

/* Web .avauskortti-kartta: margin 0 0.9rem, reuna rgba(122,85,20,.35), kulma 8, korkeus 35svh (Mitoita). */
.mk-avauskortti__kartta {
    flex-shrink: 0;
    overflow: hidden;
    margin: 0 14.4px;
    border-width: 1px;
    border-color: var(--tk-kuulto-paperi-korostus-35);
    border-radius: var(--tk-kulma-keski);
}

/* Pelkkä kartta (web .kaupunkikartta-pelkka): täyttää kaistan, ei kehyksen omaa reunaa, lähde kulmassa kartan päällä. */
.mk-kohdekartta--pelkka {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    overflow: hidden;
}

.mk-kohdekartta--pelkka > .mk-kohdekartta__kehys {
    flex-shrink: 0;
    margin: 0;
    border-width: 0;
    border-radius: 0;
}

.mk-kohdekartta--pelkka .mk-kohdekartta__kyltti,
.mk-kohdekartta--pelkka .mk-kohdekartta__nimi {
    display: none;
}

.mk-kohdekartta--pelkka > .mk-kohdekartta__lahde {
    position: absolute;
    left: 0;
    bottom: 0;
    margin: 0;
    padding: 2.4px 6.4px;
    font-size: var(--tk-koko-kapiteeli);
    border-top-right-radius: var(--tk-kulma-pieni);
    background-color: var(--tk-kuulto-paperi-pinta-85);
}

/* Web .avauskortti-opas: margin 0.65rem 0.9rem 0, padding 0.5rem, #efe1c2, kulma 8, rako 0.65rem. */
.mk-avauskortti__opas {
    flex-direction: row;
    align-items: stretch;
    justify-content: flex-start;
    min-height: 0;
    margin: 10.4px 14.4px 0 14.4px;
    padding: 8px;
    border-width: 0;
    border-radius: var(--tk-kulma-keski);
    background-color: var(--paper);
}

.mk-avauskortti__opaskuva {
    flex-shrink: 0;
    width: 84px;
    height: 84px;
    margin-right: 10.4px;
    border-radius: var(--tk-kulma-pieni);
    -unity-background-scale-mode: scale-and-crop;
}

.mk-avauskortti__opastekstit {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}

.mk-avauskortti__oppaanlaji {
    margin: 0;
    padding: 0;
    font-size: var(--tk-koko-kapiteeli);
    letter-spacing: 7.7px; /* web 0.08em */
    color: var(--accent-dark);
}

.mk-avauskortti__oppaanotsikko {
    margin: 1.6px 0;
    padding: 0;
    font-size: var(--tk-koko-leipa);
    white-space: normal;
    color: var(--tk-paperi-muste);
}

.mk-avauskortti__oppaanteksti {
    margin: 0;
    padding: 0;
    font-size: var(--tk-koko-apuri);
    white-space: normal;
    color: var(--tk-paperi-muste);
}

/* Web .kaupunkipopup-avaus > .kaupunkipopup-sulje: 2.1rem ympyrä rgba(245,240,226,.92), × 1.1rem #3a2f24. */
.mk-avauskortti__sulku {
    position: absolute;
    top: 8px;
    right: 8.8px;
    width: 33.6px;
    height: 33.6px;
    min-height: 33.6px;
    padding: 0;
    border-width: 0;
    border-radius: 16.8px;
    background-color: var(--tk-kuulto-paperi-pinta-92);
    align-items: center;
    justify-content: center;
}

.mk-avauskortti__sulku .mk-nappi__teksti {
    font-size: 22px; /* fonttipoikkeus: 22 px, asteikossa pienempi 21 px; tekstiä ei pienennetä luettavuuden takia (Päätoimittaja 8.10.2026) */
    color: var(--panel-2);
}

/* Suurennos kortista (web .kartta-suurennos-kortista): huntu rgba(29,22,16,.35) (+ KuvaSumea), kortti #f5f0e2
   kulma 14, padding 2.6rem 0.6rem 0.6rem, kartta keskellä; × ympyränä; − + oikeassa alakulmassa. */
.mk-kohdekartta-kokoruutu--kortista {
    background-color: var(--tk-himmennys-kevyt);
}

.mk-kohdekartta-kokoruutu--kortista > .mk-kohdekartta-kokoruutu__kortti {
    justify-content: center;
    padding: 41.6px 9.6px 9.6px 9.6px;
    border-radius: 14px;
    background-color: var(--tk-paperi-pinta);
    max-width: 94%;
}

.mk-kohdekartta-kokoruutu--kortista .mk-kohdekartta__kehys {
    border-radius: var(--tk-kulma-pieni);
}

.mk-kohdekartta-kokoruutu--kortista .mk-kohdekartta-kokoruutu__sulku {
    top: 7.2px;
    right: 7.2px;
    width: 33.6px;
    height: 33.6px;
    min-height: 33.6px;
    border-color: var(--tk-kuulto-paperi-korostus-30);
    border-radius: 16.8px;
    background-color: var(--tk-kuulto-paperi-pinta-94);
}

.mk-kohdekartta-kokoruutu__tyokalut {
    position: absolute;
    right: 14.4px;
    bottom: 14.4px;
    flex-direction: row;
}

.mk-kohdekartta-kokoruutu__zoom {
    width: 38px;
    height: 38px;
    min-height: 38px;
    margin-left: 6.4px;
    padding: 0;
    border-width: 1px;
    border-color: var(--tk-kuulto-paperi-korostus-35);
    border-radius: var(--tk-kulma-keski);
    background-color: var(--paper);
    align-items: center;
    justify-content: center;
}

.mk-kohdekartta-kokoruutu__zoom .mk-nappi__teksti {
    font-size: var(--tk-koko-otsikko);
    color: var(--panel-2);
}

/* --- AVAUSKORTIN KUTSU (web .kaupunkikortin-kutsu, Kutsuminiatyyri.cs) ------------------------------------------- */

.mk-kutsu {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

/* Web .kaupunkikortin-kutsu-kortti: 64 × 64, reuna 2 px #f5f0e2, kulma 9, pohja #d9ccb0. */
.mk-kutsu__kortti {
    position: absolute;
    width: 64px;
    height: 64px;
    min-height: 64px;
    margin: 0;
    padding: 0;
    overflow: hidden;
    border-width: 2px;
    border-color: var(--tk-paperi-pinta);
    border-radius: var(--tk-kulma-keski);
    background-color: var(--tk-paperi-pergamentti);
    flex-direction: column;
    justify-content: flex-end;
    align-items: stretch;
}

.mk-kutsu__kuva {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    -unity-background-scale-mode: scale-and-crop;
}

/* Web .kaupunkikortin-kutsu-nimi: 600 10px Luku, #fff8ec pohjalla rgba(33,29,24,.72), yksi rivi, keskitetty. */
.mk-kutsu__nimi {
    flex-shrink: 0;
    width: 100%;
    margin: 0;
    padding: 1px 3px 2px 3px;
    font-size: 10px; /* fonttipoikkeus: 10 px, lähin asteikon koko 12 px (ero 2 px näkyisi; Päätoimittaja 8.10.2026) */
    color: var(--tk-paperi-pinta);
    background-color: var(--tk-himmennys-tumma);
    -unity-text-align: middle-center;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

/* Pariteetti 2 rivi 9: Matkakirjan ihmeen tähti (web .kohde-ihmetahti ja .nostosym-tahti, css/styles.css): 15 × 15
   merkin 40 × 40 -laatikon yläreunaan (top −6, right −3); täyttö --sym-ihme, ääriviiva --sym-muste 1,2 (viewBox 24),
   varjo drop-shadow(0 1px 1px rgba(0, 0, 0, 0.3)) siirrettynä täyttökerroksena. */
.mk-kohdekartta__ihmetahti {
    position: absolute;
    top: -6px;
    right: -3px;
    width: 15px;
    height: 15px;
    overflow: visible;
}

.mk-kohdekartta__ihmetahti > .mk-ikoni {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
}

.mk-kohdekartta__ihmetahti-varjo {
    color: var(--tk-himmennys-kevyt);
    translate: 0 1px;
}

.mk-kohdekartta__ihmetahti-kulta {
    color: var(--tk-erikois-ihme-3);
}

.mk-kohdekartta__ihmetahti-muste {
    color: var(--map-ink);
    --mk-ikoni-viiva: 1.2;
}

.mk-kohdekartta__piirros--valittu > .mk-kohdekartta__ihmetahti {
    display: none;
}
