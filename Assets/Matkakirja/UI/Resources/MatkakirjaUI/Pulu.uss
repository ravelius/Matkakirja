/* PULU (Natiivi-UI, erä 5): Livian näyttämö ja puhekuplat (webin css/styles.css
 * .livia-kasvot-pinta ~28163–28220 ja .pollo-vihje / .pollo-kuplapino ~21173–21667). */

.mk-pulu {
    position: absolute;
    width: 152px;
    height: 304px;
    transform-origin: right bottom;
    transition-property: bottom, scale;
    transition-duration: 0.22s, 0.2s; /* UI-siirtymä ≤ 250 ms (pohjavahti 8.10., oli 0.28s, 0.2s) */
    transition-timing-function: ease-out-back, ease-out;
}

/* Modaalinen dialogi auki: pulu pienenee kuten webin lehden aikana. */
.mk-pulu.mk-pulu--pieni {
    scale: 0.72 0.72;
}

.mk-pulu__nayttamo {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.mk-pulu__kuva {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

/* Linnun lepopaikka: jalat (128, 302), mittakaava 0,56 → lintu x ≈ 96–150, y ≈ 224–302. */
.mk-pulu__kosketus {
    position: absolute;
    width: 62px;
    height: 82px;
    bottom: 0;
    left: 90px;
    background-color: var(--lapinakyva);
}

/* --- kuplat ------------------------------------------------------------- */

.mk-kuplapino {
    position: absolute;
    right: 4px;
    bottom: 86px;
    width: 272px;
    max-height: 224px;
    align-items: flex-end;
}

.mk-kuplapino.mk-kuplapino--avaus {
    width: 336px;
}

.mk-kuplapino__vieritys {
    max-height: 224px;
    flex-shrink: 1;
}

.mk-kuplapino__vieritys .unity-scroll-view__content-container {
    align-items: flex-end;
    padding-bottom: 9px;
}

.mk-kupla {
    max-width: 272px;
    margin-top: 8px;
    padding: 8px 11px 8px 11px;
    border-width: 1px;
    border-color: var(--tk-kuulto-paperi-korostus-32);
    border-radius: var(--tk-kulma-nappi);
    background-color: var(--tk-tumma-muste);
    color: var(--tk-paperi-muste);
    opacity: 0;
    translate: 0 8px;
    transition-property: opacity, translate;
    transition-duration: 0.22s;
    transition-timing-function: ease-out;
}

.mk-kupla.mk-auki {
    opacity: 1;
    translate: 0 0;
}

.mk-kupla.mk-kupla--vanha.mk-auki {
    opacity: 0.55;
}

.mk-kupla__kappale {
    font-size: 14.7px; /* fonttipoikkeus: 14.7 px, asteikossa pienempi 14 px; tekstiä ei pienennetä luettavuuden takia (Päätoimittaja 8.10.2026) */
    white-space: normal;
    margin-bottom: 4px;
}

/* Livian avauskupla (web .pollo-vihje-maadoitus + .pollo-vihje-lause 0,88 rem / 1,4): leveämpi kaista. */
.mk-kupla.mk-kupla--avaus {
    max-width: 336px;
    padding: 8.8px 12px 9.6px 12px;
}

.mk-kupla--avaus .mk-kupla__kappale {
    font-size: var(--tk-koko-apuri);
    margin-bottom: 0;
}

/* Opaslupauksen muotokuvakupla samassa kaistassa (web .pollo-vihje-muotokuva width min(21rem, 100vw − 1,6rem),
 * kuvasarake clamp(4,5rem, 24vw, 5,6rem) → 89,6 px iPhone 17:llä ja iPadilla, 2:3). */
.mk-kupla.mk-kupla--avaus.mk-kupla--muotokuva {
    width: 336px;
}

.mk-kupla--avaus .mk-kupla__muotokuva {
    width: 89.6px;
    height: 134.4px;
}

/* Ohita (web .pollo-vihje-ohita, Livian uuden matkan lyhyt tervehdys, iPad 834 mitattu): tekstinappi oikeassa
 * alakulmassa ilman kehystä, 12,48 px alleviivattuna, kuplan muste, opacity 0,75, kosketusala ≥ 32 px. */
.mk-kupla__ohita {
    align-self: flex-end;
    min-height: 32px;
    margin: 3.2px -5.6px -4.8px 0;
    padding: 4px 7.2px;
    border-width: 0;
    background-color: var(--lapinakyva);
    opacity: 0.75;
}

.mk-kupla__ohita > .mk-nappi__teksti {
    font-size: var(--tk-koko-kapiteeli);
    color: var(--tk-paperi-muste);
    letter-spacing: 0;
}

.mk-kupla__hanta {
    display: none;
    position: absolute;
    width: 12px;
    height: 12px;
    right: 18px;
    bottom: -7px;
    rotate: 45deg;
    background-color: var(--tk-tumma-muste);
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-color: var(--tk-kuulto-paperi-korostus-32);
}

.mk-kupla.mk-kupla--viimeinen .mk-kupla__hanta {
    display: flex;
}

/* Viisaan Pöllön muotokuva avausesittelyn opaslupauksessa (webin .pollo-vihje-muotokuva:
 * kuvasarake clamp(4,5rem, 24vw, 5,6rem), 2:3, väli 0,7rem). Kupla pysyy pinon levyisenä. */
.mk-kupla.mk-kupla--muotokuva {
    flex-direction: row;
    align-items: center;
    width: 272px;
}

.mk-kupla__muotokuva {
    width: 76px;
    height: 114px;
    flex-shrink: 0;
    margin-right: 11px;
    border-radius: 4.8px;
    background-color: var(--map-ink-07);
    -unity-background-scale-mode: scale-and-crop;
}

.mk-kupla__puhe {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}

/* --- pulun kuvakortti (webin dialog.pollo-kuvatausta / .pollo-kuvakortti, js/pollo.js
 * avaaKuvapopup): nähtävyysjutun kuva, pitkä kuvateksti · lähde ja "Avaa juttu". --- */

.mk-pulukuva {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    padding: 16px;
    background-color: var(--tk-kuulto-himmennys-tumma-55);
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.2s;
}

.mk-pulukuva.mk-auki {
    opacity: 1;
}

.mk-pulukuva__kortti {
    width: 100%;
    max-width: 640px;
    padding: 9.6px;
    border-width: 1px;
    border-color: var(--tk-kuulto-paperi-korostus-32);
    border-radius: var(--tk-kulma-keski);
    background-color: var(--tk-paperi-pinta);
    color: var(--tk-paperi-muste);
}

.mk-pulukuva__kuva {
    width: 100%;
    height: 240px;
    border-radius: var(--tk-kulma-pieni);
    -unity-background-scale-mode: scale-to-fit;
}

.mk-pulukuva__teksti {
    margin-top: 8px;
    font-size: var(--tk-koko-apuri);
    white-space: normal;
    color: var(--raja-muste);
}

.mk-pulukuva__nappi {
    align-self: flex-start;
    margin: 8px 0 0 0;
    min-height: 0;
    padding: 5.6px 11.2px;
    border-width: 1px;
    border-color: var(--tk-paperi-korostus);
    border-radius: var(--tk-kulma-keski);
    background-color: var(--lapinakyva);
    color: var(--tk-paperi-korostus);
    font-size: var(--tk-koko-apuri);
}

.mk-pulukuva__nappi:hover,
.mk-pulukuva__nappi:active {
    background-color: var(--map-ink-12);
}

/* --- matkakirjakortti (webin .fact-card, css/styles.css 4755–4910, 9698–9900) --- */

.mk-matkakirja {
    position: absolute;
    left: 10px;
    width: 340px;
    max-width: 62%;
    max-height: 60%;
    /* WEBIN KERMAPAPERI (omistaja 30.9.2026: "Tee isoisän matkakirjan tekstistä ja taustasta samanlainen natiiviin";
     * css/styles.css body[data-mode] .fact-card ja ::before): ei reunaa, pehmeä läpikuultava kermavalo (Matkakirjakortti
     * KermaValo), jonka läpi kartta kuultaa; tekstien alla vaalea varjo. Pehmuste 0,2 / 0,35 rem kuten webissä. */
    padding: 3.2px 5.6px 5.6px 5.6px;
    border-width: 0;
    border-color: var(--tk-kuulto-paperi-korostus-32);
    border-radius: var(--tk-kulma-kortti);
    background-color: var(--lapinakyva);
    text-shadow: 0 1px 2px rgba(247, 237, 216, 0.9); /* väripoikkeus: text-shadow: varjon väri shorthandissa (var() text-shadow-arvossa testaamatta natiivissa) (Päätoimittaja 8.10.2026) */
    overflow: hidden;
    /* Löydös 139 (omistaja, build 16): avattu matkakirja samalla vaalealla pohjalla kuin pienennetty lappu
     * (.mk-matkakirja--pieni rgba(244, 231, 202)), ei tummana nahkapaneelina. Teeman muuttujat määritellään kortin
     * sisällä uudelleen, joten kaikki kortin tekstit vaihtuvat tummiksi; tumma liukumakuva peitetään sävyllä. */
    --panel: rgba(244, 231, 202, 0.94); /* väripoikkeus: pinnan oma muuttuja (paikallinen teemamäärittely, käyttöpaikat var()-viittauksia) (Päätoimittaja 8.10.2026) */
    --line: rgba(122, 85, 20, 0.32); /* väripoikkeus: pinnan oma muuttuja (paikallinen teemamäärittely, käyttöpaikat var()-viittauksia) (Päätoimittaja 8.10.2026) */
    --ink-light: #46331f; /* väripoikkeus: pinnan oma muuttuja (paikallinen teemamäärittely, käyttöpaikat var()-viittauksia) (Päätoimittaja 8.10.2026) */   /* web --map-ink */
    --muted: #8a6c46; /* väripoikkeus: pinnan oma muuttuja (paikallinen teemamäärittely, käyttöpaikat var()-viittauksia) (Päätoimittaja 8.10.2026) */       /* web --map-ink-soft */
    --accent: var(--tk-paperi-korostus);
    -unity-background-image-tint-color: var(--valkoinen);
    -unity-background-scale-mode: stretch-to-fill;
}

/* Puhelin (web @media max-width 560 px): kortti min(340, ruutu − 12,8), pienemmät koot. */
.mk-matkakirja.mk-matkakirja--puhelin {
    max-width: 97%;
}

/* Offline-pillerin vuoro samassa kulmassa: lappu häipyy (ristihäivytys, OfflineTilaUi.Vuorottele). */
.mk-matkakirja {
    transition-property: opacity;
    transition-duration: 0.22s; /* UI-siirtymä ≤ 250 ms (pohjavahti 8.10., oli 0.4s) */
}

.mk-matkakirja.mk-matkakirja--vaistyy,
.mk-matkakirja.mk-matkakirja--selite {
    opacity: 0;
}

.mk-matkakirja__ylarivi {
    flex-direction: row;
    align-items: center;
    min-height: 24px;
}

.mk-matkakirja__otsikko {
    flex-grow: 1;
    flex-shrink: 1;
    font-size: var(--tk-koko-kapiteeli);
    letter-spacing: 9.6px; /* web 1.2px */
    color: var(--accent);
    white-space: normal;
}

.mk-matkakirja__otsikko--paikka {
    font-size: var(--tk-koko-apuri);
    letter-spacing: 2px; /* web 0.02em */
    color: var(--accent);
}

.mk-matkakirja--puhelin .mk-matkakirja__otsikko--paikka {
    font-size: var(--tk-koko-kapiteeli);
}

.mk-matkakirja__lyhyt {
    display: none;
}

.mk-matkakirja__tunnelma {
    font-size: var(--tk-koko-kapiteeli);
    -unity-font-style: italic;
    letter-spacing: 1px; /* web 0.01em */
    color: var(--muted);
    opacity: 0.85;
    white-space: normal;
    margin: 0 0 2.4px 0;
}

.mk-matkakirja--puhelin .mk-matkakirja__tunnelma {
    font-size: var(--tk-koko-kapiteeli);
}

.mk-matkakirja__teksti {
    font-size: var(--tk-koko-apuri);
    color: var(--ink-light);
    white-space: normal;
}

.mk-matkakirja--puhelin .mk-matkakirja__teksti {
    font-size: var(--tk-koko-kapiteeli);
}

.mk-matkakirja .mk-matkakirja__piilo {
    display: none;
}

/* Tavallinen paikkarivi (web .fact-place): kaupunki tai "Matkalla — X", ei kursiivia. */
.mk-matkakirja__tunnelma.mk-matkakirja__tunnelma--paikka {
    font-size: 12.8px; /* fonttipoikkeus: 12.8 px, asteikossa pienempi 12 px; tekstiä ei pienennetä luettavuuden takia (Päätoimittaja 8.10.2026) */
    -unity-font-style: bold;
    letter-spacing: 3.91px; /* web 0.5px */
    margin: 0 0 4px 0;
}

/* Lähderivi tekstin perään (web .source-line: 0.78rem, --muted; otsikko versaalein). */
.mk-matkakirja__lahteet {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    margin-top: 5px;
}

.mk-matkakirja__lahdeotsikko {
    font-size: var(--tk-koko-kapiteeli);
    letter-spacing: 11.93px; /* web 1.3px */
    color: var(--muted);
    opacity: 0.75;
    margin-right: 5px;
}

.mk-matkakirja__lahde {
    font-size: var(--tk-koko-kapiteeli);
    color: var(--muted);
    white-space: normal;
}

.mk-matkakirja__lahdelinkki {
    padding: 0;
    margin: 0;
    min-height: 0;
    border-width: 0;
    border-bottom-width: 1px;
    border-color: var(--tk-kuulto-paperi-korostus-40); /* löydös 139: vaalealla pohjalla */
    background-color: var(--lapinakyva);
    font-size: var(--tk-koko-kapiteeli);
    color: var(--muted);
}

.mk-matkakirja__lahdelinkki:hover {
    color: var(--accent);
}

/* Pieni kuvaikoni "Katso kuva" (web .fact-image-btn): vasen reuna tekstin alla. */
.mk-matkakirja__kuva {
    align-self: flex-start;
    width: 28px;
    height: 28px;
    min-height: 28px;
    padding: 4px;
    margin-top: 5px;
    border-width: 0;
    background-color: var(--lapinakyva);
    color: var(--accent);
}

.mk-matkakirja__kuva:hover {
    color: var(--accent-dark); /* löydös 139: vaalealla pohjalla */
}

.mk-matkakirja__kuvaikoni {
    width: 20px;
    height: 20px;
}

.mk-matkakirja__pikkukuvat {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 8px;
    padding: 2px 0 0 2px;
}

.mk-matkakirja__pikkukuva {
    /* Web .fact-pikkukuva: 3,1 × 2,3 rem (napin min-korkeus 42), vaalea 2 px kehys, pieni kierto (koodissa ±1,4°). */
    width: 49.6px;
    height: 42px;
    margin: 0 5.6px 5.6px 0;
    border-width: 2px;
    border-color: var(--tk-paperi-pinta);
    border-radius: var(--tk-kulma-hius);
    background-color: var(--tk-tumma-muste);
    -unity-background-scale-mode: scale-and-crop;
}

/* Pieni: yhden rivin lappu (napautus avaa) WEBIN KAISTALEENA (omistaja 30.9.2026: "Pienennettynä pitää olla saman
   värinen" = webin malli; css/styles.css body[data-mode] .fact-card.pieni): pergamenttikaistale rgba(244, 231, 202, 0.86)
   ilman kermavaloa (kuva peittyy sävyllä), kulmat 6 px, pehmuste 0,2rem / 0,5em, lihavoitu otsikko ja kaiutin.
   Rivin korkeus 1,5 × --pieni-rivi (iPad 0,8rem = 12,8 px, puhelin 0,7rem = 11,2 px). Webin varjo (box-shadow) puuttuu
   UI Toolkitista. */
.mk-matkakirja.mk-matkakirja--pieni {
    padding: 3.2px 6.4px 3.2px 6.4px;
    max-height: none;
    background-color: var(--tk-kuulto-tumma-muste-86);
    border-width: 0;
    border-radius: var(--tk-kulma-pieni);
    -unity-background-image-tint-color: var(--lapinakyva);
}

.mk-matkakirja--pieni.mk-matkakirja--puhelin {
    padding: 3.2px 5.6px 3.2px 5.6px;
}

.mk-matkakirja--pieni .mk-matkakirja__ylarivi {
    min-height: 0;
}

.mk-matkakirja--pieni .mk-matkakirja__otsikko,
.mk-matkakirja--pieni .mk-matkakirja__tunnelma,
.mk-matkakirja--pieni .mk-matkakirja__teksti,
.mk-matkakirja--pieni .mk-matkakirja__pikkukuvat,
.mk-matkakirja--pieni .mk-matkakirja__lahteet,
.mk-matkakirja--pieni .mk-matkakirja__kuva {
    display: none;
}

/* Linssipariteetti rivi 31 (iPad): webin lapussa 🔊 näkyy tekstin perässä ("Marseille, syyskuussa 1873 🔊"), rivin
   korkuisena. Piilo merkinnän mukaan (Piiloon, inline) voittaa. */
.mk-matkakirja--pieni .mk-matkakirja__kaiutin {
    width: 18px;
    height: 18px;
    min-height: 18px;
    margin-left: 5px;
    color: var(--accent);
}

.mk-matkakirja--pieni.mk-matkakirja--puhelin .mk-matkakirja__kaiutin {
    width: 16px;
    height: 16px;
    min-height: 16px;
}

/* Lappu sisältönsä levyinen (web width: max-content; max-width: 100 %). */
.mk-matkakirja.mk-matkakirja--nimi {
    width: auto;
    max-width: 96%;
}

.mk-matkakirja--nimi .mk-matkakirja__lyhyt {
    flex-grow: 0;
}

/* Löydös 68: vaakamuodossa lappu häviää yläpalkin mukana. */
.mk-matkakirja.mk-matkakirja--palkinpiilo {
    opacity: 0;
}

.mk-matkakirja--pieni .mk-matkakirja__lyhyt {
    display: flex;
    flex-grow: 1;
    font-size: 12.8px; /* fonttipoikkeus: 12.8 px, asteikossa pienempi 12 px; tekstiä ei pienennetä luettavuuden takia (Päätoimittaja 8.10.2026) */
    min-height: 19.2px;
    letter-spacing: 2px; /* web h2 0.02em */
    -unity-text-align: middle-left;
    color: var(--accent);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.mk-matkakirja--pieni.mk-matkakirja--puhelin .mk-matkakirja__lyhyt {
    font-size: var(--tk-koko-kapiteeli);
    min-height: 16.8px;
}

.mk-matkakirja__kaiutin {
    width: 30px;
    height: 30px;
    min-height: 30px;
    padding: 0;
    margin-left: 6px;
    border-width: 0;
    background-color: var(--lapinakyva);
    color: var(--ink-light);
}

.mk-kaiutin {
    width: 20px;
    height: 20px;
}

.mk-kaiutin__osa {
    position: absolute;
    left: 0;
    top: 0;
    width: 20px;
    height: 20px;
    margin-right: 0;
}

.mk-kaiutin__kaari {
    opacity: 0.2;
}

.mk-kaiutin__vinoviiva {
    display: none;
    position: absolute;
    left: 9px;
    top: -1px;
    width: 2px;
    height: 22px;
    rotate: -45deg;
    background-color: var(--ink-light);
}

.mk-mykistetty .mk-kaiutin__vinoviiva {
    display: flex;
}

.mk-mykistetty .mk-kaiutin__kaari {
    opacity: 0.2;
}

/* --- luentakuvat (webin .fokusvirta-isokuva) ------------------------------- */

.mk-kuvapakka {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
}

.mk-kuvakortti {
    position: absolute;
    width: 78%; /* koodi asettaa webin mitan (Luentakuvasarja.Leveys, löydös 90) */
    /* Löydös 138 (omistaja, build 16): isoisän ja pulun kuvista paperikehys pois (ja kuvateksti, Luentakuvasarja). */
    padding: 0;
    background-color: var(--lapinakyva);
    border-width: 0;
    opacity: 0;
    transition-property: opacity, translate;
    transition-duration: 0.22s, 0.22s; /* UI-siirtymä ≤ 250 ms (pohjavahti 8.10., oli 0.4s, 0.6s) */
    transition-timing-function: ease-out, ease-in;
}

.mk-kuvakortti.mk-auki {
    opacity: 1;
}

.mk-kuvakortti.mk-kuvakortti--lahtee {
    opacity: 0;
    translate: -40% -60%;
}

.mk-kuvakortti__kuva {
    width: 100%;
    -unity-background-scale-mode: scale-to-fit;
}

.mk-kuvakortti__teksti {
    font-size: var(--tk-koko-kapiteeli);
    color: var(--panel-2);
    white-space: normal;
    -unity-text-align: middle-center;
    padding: 5px 4px 6px 4px;
}

.mk-ohita {
    position: absolute;
    bottom: 110px;
    left: 50%;
    translate: -50% 0;
    min-height: 34px;
    padding: 4px 16px;
    border-color: var(--map-ink-50);
    background-color: var(--tk-kuulto-paperi-pinta-92);
    color: var(--map-ink);
}

.mk-ohita .mk-nappi__teksti {
    font-size: var(--tk-koko-apuri);
    letter-spacing: 7.41px; /* web 1px */
}

/* --- suurennos ------------------------------------------------------------ */

.mk-suurennos {
    flex-direction: column;
}

.mk-suurennos__kuva {
    width: 100%;
    height: 62%;
    -unity-background-scale-mode: scale-to-fit;
}

.mk-suurennos__teksti {
    max-width: 520px;
    margin-top: 12px;
    font-size: 15px; /* fonttipoikkeus: 15 px, asteikossa pienempi 14 px; tekstiä ei pienennetä luettavuuden takia (Päätoimittaja 8.10.2026) */
    color: var(--ink-light);
    white-space: normal;
    -unity-text-align: middle-center;
}

.mk-suurennos__lahde {
    margin-top: 6px;
    font-size: var(--tk-koko-kapiteeli);
    color: var(--muted);
    -unity-text-align: middle-center;
}

/* --- pulun keskustelu (webin .pollo-paneeli, css/styles.css ~21651–22903) --- */

.mk-chat {
    position: absolute;
    height: 62%;
    max-height: 608px;
    min-height: 224px;
    padding: 0;
    border-width: 1px;
    border-color: var(--tk-kuulto-paperi-korostus-32);
    border-radius: var(--tk-kulma-kortti);
    background-color: var(--tk-paperi-pinta);
    color: var(--tk-paperi-muste);
    /* Avaus ja sulku: Ponnahdus (PuluChat.Avaa/Sulje), web pollo.js animoiAvaus 220/200 ms. */
}

/* LINSSITILA (omistaja 30.9.2026 klo 23.5x: "tee pululle aina samat napit kaikkialle peliin"): sama chat, teemana entisen
   minipulun kortin tumma lasi ja vihreä reuna (Linssit.uss .mk-minipuluKortti). Napit ja järjestys ennallaan. */
.mk-chat.mk-chat--linssi {
    border-color: var(--tk-lasi-avaruus-reunus);
    background-color: var(--tk-lasi-avaruus-pinta);
    color: var(--tk-lasi-avaruus-muste);
}

.mk-chat--linssi .mk-chat__viesti,
.mk-chat--linssi .mk-chat__livia {
    color: var(--tk-lasi-avaruus-muste);
}

/* ISS-CHATIN LAATIKOT ILMAN TÄYTTÖÄ (omistaja 4.10.2026 klo 13.54: "Poista laatikoiden vihreä pohjaväri. Riittää että teksti ja
   kehys on vihreä"): kysytty kysymys, kysymyspillerit, kenttä sekä näppäimistö- ja mikrofoninappi läpinäkyvinä, vihreä kehys ja teksti. */
.mk-chat--linssi .mk-chat__pelaaja {
    border-width: 1px;
    border-color: var(--tk-lasi-avaruus-korostus);
    background-color: var(--lapinakyva);
    color: var(--tk-lasi-avaruus-korostus);
}

.mk-chat--linssi .mk-chat__odottaa,
.mk-chat--linssi .mk-chat__paikkarivi {
    color: var(--tk-kuulto-lasi-avaruus-muste-65);
}

/* Valmiin vastauksen lähderivi lasiteemoissa (laite 4.10.: paperin ruskea ja korostus hukkuivat tummaan lasiin). */
.mk-chat--linssi .mk-chat__valmislahde {
    color: var(--tk-kuulto-lasi-avaruus-muste-65);
}

.mk-chat--linssi .mk-chat__valmislinkki .mk-nappi__teksti {
    color: var(--tk-lasi-avaruus-korostus);
}

.mk-chat--linssi .mk-chat__siru {
    border-color: var(--tk-lasi-avaruus-korostus);
    background-color: var(--lapinakyva);
    color: var(--tk-lasi-avaruus-korostus);
}

.mk-chat--linssi .mk-chat__siru:active {
    background-color: var(--tk-lasi-avaruus-reunus);
}

.mk-chat--linssi .mk-chat__ikoninappi,
.mk-chat--linssi .mk-lukija,
.mk-chat--linssi .mk-chat__nappula,
.mk-chat--linssi .mk-chat__laheta {
    color: var(--tk-lasi-avaruus-korostus);
    -unity-background-image-tint-color: var(--tk-lasi-avaruus-korostus);
}

.mk-chat--linssi .mk-chat__kentta {
    color: var(--tk-lasi-avaruus-muste);
}

/* Alarivin napit ja kenttä lasille (1.10. simulaattorikuva: napit jäivät paperinvärisiksi). */
.mk-chat--linssi .mk-chat__nappula,
.mk-chat--linssi .mk-chat__kentta,
.mk-chat--linssi .mk-chat__laheta {
    background-color: var(--lapinakyva);
    border-color: var(--tk-lasi-avaruus-korostus);
}

.mk-chat--linssi .mk-chat__syote {
    border-color: var(--tk-kuulto-lasi-avaruus-korostus-20);
}

/* Tuore keskustelu: korkeus sisällön mukaan (webin .pollo-alku). */
.mk-chat.mk-chat--alku {
    height: auto;
    max-height: 66%;
}

.mk-chat__virta {
    flex-grow: 1;
    flex-shrink: 1;
    padding: 11px 10px 6px 10px;
}

.mk-chat__viesti {
    margin-bottom: 9px;
    font-size: var(--tk-koko-apuri);
    white-space: normal;
}

.mk-chat__livia {
    font-size: 15px; /* fonttipoikkeus: 15 px, asteikossa pienempi 14 px; tekstiä ei pienennetä luettavuuden takia (Päätoimittaja 8.10.2026) */
}

/* Löydös 91 (web .pollo-kayttaja): koko levyinen lohko, --pollo-paperi-2, 8 px, Kone 0,85rem. */
.mk-chat__pelaaja {
    align-self: stretch;
    padding: 5.6px 8px;
    border-radius: var(--tk-kulma-keski);
    background-color: var(--tk-tumma-muste);
    color: var(--tk-paperi-muste);
    font-size: var(--tk-koko-apuri);
}

.mk-chat__odottaa {
    -unity-font-style: italic;
    color: var(--tk-kuulto-paperi-muste-60);
    font-size: var(--tk-koko-apuri);
}

.mk-chat__paikkarivi {
    -unity-font-style: italic;
    color: var(--tk-kuulto-paperi-muste-60);
    font-size: 13px; /* fonttipoikkeus: 13 px, asteikossa pienempi 12 px; tekstiä ei pienennetä luettavuuden takia (Päätoimittaja 8.10.2026) */
}

.mk-chat__sirut {
    flex-direction: column;
    align-items: flex-start;
    margin-bottom: 8px;
}

/* Kysymyssirut kiinni syöttökentän yläpuolella (Päätoimittaja 5.10.2026): ei vieritä, ei kutistu; tyhjänä ei vie tilaa. */
.mk-chat__sirualue {
    flex-shrink: 0;
    padding: 6px 12px 0 12px;
}

.mk-chat__sirualue > .mk-chat__sirut {
    margin-bottom: 2px;
}

/* Pulun valmiit kysymykset (omistaja 9.10.2026): sama sirusarake, kaksi näkyy ja loput vierittämällä; kolmannen yläreuna vihjaa jatkosta. */
.mk-chat__sirut--vieritys {
    max-height: 112px;
}

.mk-chat__siru {
    min-height: 34px;
    margin-bottom: 6px;
    padding: 5px 11px 5px 11px;
    border-color: var(--tk-kuulto-paperi-korostus-45);
    border-radius: 16px;
    background-color: var(--lapinakyva);
    color: var(--tk-paperi-korostus);
}

.mk-chat__siru:active {
    background-color: var(--map-ink-12);
}

.mk-chat__siru .mk-nappi__teksti {
    font-size: 13px; /* fonttipoikkeus: 13 px, asteikossa pienempi 12 px; tekstiä ei pienennetä luettavuuden takia (Päätoimittaja 8.10.2026) */
    white-space: normal;
}

.mk-chat__rivi {
    flex-direction: row;
    align-items: center;
    padding: 8px 8px 9px 8px;
    border-top-width: 1px;
    border-color: var(--tk-kuulto-paperi-korostus-25);
}

.mk-chat__kentta {
    flex-grow: 1;
    flex-shrink: 1;
    margin: 0 6px 0 0;
    font-size: var(--tk-koko-leipa);
}

.mk-chat__kentta > .unity-base-text-field__input {
    min-height: 38px;
    padding: 4px 10px 4px 10px;
    border-width: 1px;
    border-color: var(--tk-kuulto-paperi-korostus-35);
    border-radius: var(--tk-kulma-nappi);
    background-color: var(--tk-paperi-pinta);
    color: var(--tk-paperi-muste);
}

.mk-chat__laheta {
    width: 42px;
    height: 38px;
    min-height: 38px;
    padding: 0;
    margin-left: 4px;
    border-color: var(--tk-kuulto-paperi-korostus-45);
    background-color: var(--lapinakyva);
    color: var(--tk-paperi-korostus);
}

.mk-chat__laheta .mk-nappi__teksti {
    font-size: var(--tk-koko-valiotsikko);
    -unity-text-align: middle-center;
}

.mk-chat__palaa {
    position: absolute;
    right: 10px;
    min-height: 34px;
    padding: 4px 12px 4px 12px;
    border-color: var(--map-ink-50);
    background-color: var(--tk-kuulto-paperi-pinta-94);
    color: var(--map-ink);
}

.mk-chat__palaa .mk-nappi__teksti {
    font-size: 13px; /* fonttipoikkeus: 13 px, asteikossa pienempi 12 px; tekstiä ei pienennetä luettavuuden takia (Päätoimittaja 8.10.2026) */
}

/* --- saapumistraileri (webin css/saapumistraileri.css) ------------------- */

.mk-traileri {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: var(--tk-kuulto-musta-72);
    opacity: 1;
    transition-property: opacity;
    transition-duration: 0.2s;
}

.mk-traileri.mk-traileri--ohitettu {
    opacity: 0;
}

.mk-traileri__kuvat {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
}

.mk-traileri__kuva {
    position: absolute;
    width: 90%;
    height: 60%;
    border-radius: 18px;
    -unity-background-scale-mode: scale-to-fit;
    opacity: 0;
    transition-property: translate, opacity;
    transition-duration: 0.7s, 0.26s; /* ympäristöanimaatio (pohjavahdin poikkeus 8.10.) */
    transition-timing-function: ease-out-cubic, ease;
}

.mk-traileri__kuva.mk-traileri__kuva--keskella {
    opacity: 1;
}

.mk-traileri__kuva.mk-traileri__kuva--ulos {
    opacity: 0;
    transition-duration: 0.6s, 0.6s; /* ympäristöanimaatio (pohjavahdin poikkeus 8.10.) */
    transition-timing-function: ease-in-cubic, ease-in-cubic;
}

.mk-traileri__teksti {
    align-items: center;
    justify-content: center;
    max-width: 96%;
}

.mk-traileri__nimi {
    flex-direction: row;
    justify-content: center;
    font-size: 48px; /* fonttipoikkeus: 48 px, lähin asteikon koko 34 px (ero 14 px näkyisi; Päätoimittaja 8.10.2026) */
    color: var(--valkoinen);
}

.mk-traileri__kirjain {
    color: var(--valkoinen);
    text-shadow: 0 2px 18px rgba(0, 0, 0, 0.55); /* väripoikkeus: text-shadow: varjon väri shorthandissa (var() text-shadow-arvossa testaamatta natiivissa) (Päätoimittaja 8.10.2026) */
    opacity: 0;
    scale: 0.05 0.05;
    transition-property: opacity, scale, translate;
    transition-duration: 0.65s; /* ympäristöanimaatio (pohjavahdin poikkeus 8.10.) */
    transition-timing-function: ease-out-cubic;
}

.mk-traileri__kirjain.mk-auki {
    opacity: 1;
    scale: 1 1;
}

/* Syöksy katsojan ohi: kasvaa ja häipyy. */
.mk-traileri__kirjain.mk-traileri__kirjain--ulos {
    opacity: 0;
    scale: 2.4 2.4;
    transition-duration: 0.45s; /* ympäristöanimaatio (pohjavahdin poikkeus 8.10.) */
    transition-timing-function: ease-in-cubic;
}

.mk-traileri__iskulause {
    margin-top: 10px;
    max-width: 92%;
    font-size: 19px; /* fonttipoikkeus: 19 px, asteikossa pienempi 18 px; tekstiä ei pienennetä luettavuuden takia (Päätoimittaja 8.10.2026) */
    letter-spacing: 5.26px; /* web 1px */
    color: var(--valkoinen);
    text-shadow: 0 2px 14px rgba(0, 0, 0, 0.55); /* väripoikkeus: text-shadow: varjon väri shorthandissa (var() text-shadow-arvossa testaamatta natiivissa) (Päätoimittaja 8.10.2026) */
    white-space: normal;
    -unity-text-align: middle-center;
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.6s; /* ympäristöanimaatio (pohjavahdin poikkeus 8.10.) */
}

.mk-traileri__iskulause.mk-auki {
    opacity: 1;
}

.mk-chat__laheta {
    justify-content: center;
}

.mk-chat__laheta > .mk-ikoni {
    width: 18px;
    height: 18px;
    margin-right: 0;
    --mk-ikoni-viiva: 2;
}

/* Vastauksen kuva kuplan oikeaan yläkulmaan (web .pollo-vastauskuva: float right, 5,2 rem). */
/* Vastaus ja sen kuva (PuluChat.Kuvallinen): kuva kääreen oikeassa laidassa, teksti sen vasemmalla. */
.mk-chat__kuvallinen {
    flex-shrink: 0;
    min-height: 99px;
    padding-right: 92px;
}

.mk-chat__vastauskuva {
    position: absolute;
    top: 2px;
    right: 0;
    width: 83px;
    height: 83px;
    border-width: 1px;
    border-color: var(--map-ink-45);
    border-radius: var(--tk-kulma-pieni);
    -unity-background-scale-mode: scale-and-crop;
}

/* Chatin ylärivi (omistaja 29.9.2026): vasemmalla Näytä puhekuplat- ja Ehdota-kuvakkeet (34 pt kuten lukijan
   kaiutin), oikealla nostokortin lukijarivi [valikko][kaiutin] (KortinLukija, Matkakirja.uss .mk-lukija). */
.mk-chat__ylarivi {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    padding: 4px 6px 0 6px;
}

.mk-chat__ikoninappi {
    width: 34px;
    height: 34px;
    min-height: 34px;
    padding: 0;
    border-width: 0;
    background-color: var(--lapinakyva);
    color: var(--tk-paperi-korostus);
    justify-content: center;
    align-items: center;
}

.mk-chat__ikoninappi > .mk-ikoni {
    width: 20px;
    height: 20px;
    margin-right: 0;
}

.mk-chat__ylarivi-vali {
    flex-grow: 1;
}

/* Pöllöpoiminta vastauksen perässä (web .pollo-poimintarivi, -nappi, -tila). */
.mk-chat__poimintarivi {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    flex-shrink: 0;
    margin: 2px 0 6px 0;
}

.mk-chat__poimintanappi {
    min-height: 0;
    margin-right: 6px;
    padding: 3px 10px;
    border-width: 1px;
    border-color: var(--tk-paperi-reunus);
    border-radius: var(--tk-kulma-kortti);
    background-color: var(--tk-tumma-muste);
    color: var(--tk-paperi-muste);
}

.mk-chat__poimintanappi .mk-nappi__teksti {
    font-size: var(--tk-koko-kapiteeli);
}

.mk-chat__poimintanappi:disabled {
    opacity: 0.5;
}

.mk-chat__poimintatila {
    font-size: var(--tk-koko-kapiteeli);
    color: var(--tk-paperi-muste);
    opacity: 0.8;
}

/* Syöte: sanelun tilarivi, kirjoitusrivi ja nappirivi (web .pollo-syote, .pollo-sanelu-tila, .pollo-sanelu). */
.mk-chat__syote {
    flex-shrink: 0;
    padding: 8px 8px 9px 8px;
    border-top-width: 1px;
    border-color: var(--tk-kuulto-paperi-korostus-25);
}

.mk-chat__syote > .mk-chat__rivi {
    padding: 0 0 6px 0;
    border-top-width: 0;
}

.mk-chat__sanelutila {
    margin-bottom: 6px;
    font-size: 13px; /* fonttipoikkeus: 13 px, asteikossa pienempi 12 px; tekstiä ei pienennetä luettavuuden takia (Päätoimittaja 8.10.2026) */
    color: var(--tk-kuulto-paperi-muste-62);
    -unity-text-align: middle-center;
    white-space: normal;
}

/* Pulun äänikeskustelun koenappi (vain kehittäjätilassa): alarivin nappula näppäimistön ja mikrofonin rinnalla samalla tyylillä
   (omistaja 2.10.2026 klo 13.53, ei ovaalia; web #3849 button.pollo-realtime-koe { flex: 2 1 0 }). Päällä korostusreuna ja
   pergamenttipohja (web .paalla: --pollo-korostus, --pollo-paperi-2). */
.mk-chat__nappula.mk-chat__realtime {
    flex-grow: 2;
}

.mk-chat__realtime .mk-nappi__teksti {
    font-size: var(--tk-koko-apuri);
    color: var(--tk-paperi-korostus);
    -unity-text-align: middle-center;
    white-space: normal;
}

.mk-chat__realtime--paalla {
    border-color: var(--tk-paperi-korostus);
    background-color: var(--tk-paperi-pergamentti);
}

.mk-chat__nappirivi {
    flex-direction: row;
}

.mk-chat__nappula {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
    height: 36px;
    min-height: 36px;
    margin: 0 3px;
    padding: 2px 5px;
    justify-content: center;
    align-items: center;
    border-width: 1px;
    border-color: var(--tk-kuulto-paperi-korostus-45);
    border-radius: var(--tk-kulma-keski);
    background-color: var(--tk-paperi-pinta);
    color: var(--tk-paperi-korostus);
}

.mk-chat__nappula > .mk-ikoni {
    width: 18px;
    height: 18px;
    margin-right: 0;
}

.mk-chat__mikki {
    flex-grow: 2;
    flex-direction: row;
}

.mk-chat__mikki--kuuntelee {
    background-color: var(--tk-paperi-korostus);
    border-color: var(--tk-paperi-korostus);
    color: var(--tk-paperi-pinta);
}

.mk-chat__mikkiteksti {
    margin-left: 6px;
    font-size: var(--tk-koko-kapiteeli);
    color: var(--tk-paperi-pinta);
}

/* Matkakirjalinkit vastauksen alla (web .pollo-matkakirja: pienempi ja himmeämpi kuin puhe). */
.mk-chat__matkakirja {
    margin-top: -4px;
    font-size: 13px; /* fonttipoikkeus: 13 px, asteikossa pienempi 12 px; tekstiä ei pienennetä luettavuuden takia (Päätoimittaja 8.10.2026) */
    color: var(--tk-kuulto-paperi-muste-85);
    white-space: normal;
}

/* Pöllöpoimintojen pillerit artikkelin lopussa (web .pollo-poiminnat, .pollo-pilleri). */
.mk-poiminnat {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    margin-top: 14px;
    padding-top: 10px;
    border-top-width: 1px;
    border-color: var(--map-ink-18);
}

.mk-poiminnat__nimio {
    margin-right: 6px;
    font-size: var(--tk-koko-kapiteeli);
    letter-spacing: 9.09px; /* web 1px */
    color: var(--map-ink-62);
}

.mk-poiminnat__pilleri {
    min-height: 0;
    margin: 3px 6px 3px 0;
    padding: 5px 11px;
    border-width: 1px;
    border-color: var(--map-ink-35);
    border-radius: 14px;
    background-color: var(--tk-kuulto-paperi-pinta-70);
    color: var(--overlay-card);
}

.mk-poiminnat__pilleri .mk-nappi__teksti {
    font-size: 13px; /* fonttipoikkeus: 13 px, asteikossa pienempi 12 px; tekstiä ei pienennetä luettavuuden takia (Päätoimittaja 8.10.2026) */
    white-space: normal;
}

/* Laitteen oma pari (web .pollo-pilleri.oma: katkoviiva; UI Toolkitissa ei dashed-reunaa → himmeämpi, läpinäkyvä). */
.mk-poiminnat__pilleri--oma {
    border-color: var(--map-ink-22);
    background-color: var(--tk-kuulto-paperi-pinta-25);
}

/* Kehittäjän poistorivi minipopupissa (web .minipopup-poistorivi). */
.mk-minipopup__poistorivi {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    margin-top: 14px;
}

.mk-minipopup__poista {
    min-height: 32px;
    margin-right: 8px;
    padding: 0 12px;
    border-width: 1px;
    border-radius: var(--tk-kulma-keski);
    border-color: var(--tk-kuulto-paperi-korostus-55);
    background-color: var(--tk-kuulto-paperi-pinta-70);
}

.mk-minipopup__poista .mk-nappi__teksti {
    font-size: var(--tk-koko-kapiteeli);
    color: var(--tk-paperi-korostus);
}

/* Linssin valmis vastaus ja sen lähderivi (web .pollo-valmisvastaus, .pollo-valmislahteet). */
.mk-chat__valmislahteet {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    margin: -4px 0 9px 0;
}

.mk-chat__valmislahde {
    margin-right: 4px;
    font-size: var(--tk-koko-kapiteeli);
    color: var(--tk-paperi-muste-pehmea);
}

.mk-chat__valmislinkki {
    min-height: 26px;
    margin-right: 8px;
    padding: 0;
    border-width: 0;
    background-color: var(--lapinakyva);
}

.mk-chat__valmislinkki .mk-nappi__teksti {
    font-size: var(--tk-koko-kapiteeli);
    color: var(--tk-paperi-korostus);
}

/* iPhonen kaupunkipilleri (löydös 20): rahapillerin (.mk-ylapalkki--kelluva .mk-pilleri) alla samaa tyyliä. */
/* iPhonen lappu webin kaistaleena kuten iPadilla (omistaja 30.9.2026: webin malli; ennen löydöksen 20 pilleri 36 pt,
   pyöreä, kaupungin nimi keskellä). Kaiutin on VU-mittari kuten ennen (löydös 21); piilo-luokka voittaa. */
.mk-matkakirja--pilleri.mk-matkakirja--pieni .mk-matkakirja__kaiutin {
    display: flex;
}

.mk-matkakirja--pilleri.mk-matkakirja--pieni .mk-matkakirja__kaiutin.mk-matkakirja__piilo {
    display: none;
}
