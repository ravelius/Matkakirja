/* PULU (Natiivi-UI, erä 5): Livian näyttämö ja puhekuplat (webin css/styles.css
 * .livia-kasvot-pinta ~28163–28220 ja .pollo-vihje / .pollo-kuplapino ~21173–21667). */

.mk-pulu {
    position: absolute;
    width: 152px;
    height: 304px;
    transform-origin: right bottom;
    transition-property: bottom, scale;
    transition-duration: 0.28s, 0.2s;
    transition-timing-function: ease-out-back, ease-out;
}

/* Modaalinen dialogi auki: pulu pienenee kuten webin lehden aikana. */
.mk-pulu.mk-pulu--pieni {
    scale: 0.72 0.72;
}

.mk-pulu__nayttamo {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.mk-pulu__kuva {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

/* Linnun lepopaikka: jalat (128, 302), mittakaava 0,56 → lintu x ≈ 96–150, y ≈ 224–302. */
.mk-pulu__kosketus {
    position: absolute;
    width: 62px;
    height: 82px;
    bottom: 0;
    left: 90px;
    background-color: rgba(0, 0, 0, 0);
}

/* --- kuplat ------------------------------------------------------------- */

.mk-kuplapino {
    position: absolute;
    right: 4px;
    bottom: 86px;
    width: 272px;
    max-height: 224px;
    align-items: flex-end;
}

.mk-kuplapino__vieritys {
    max-height: 224px;
    flex-shrink: 1;
}

.mk-kuplapino__vieritys .unity-scroll-view__content-container {
    align-items: flex-end;
    padding-bottom: 9px;
}

.mk-kupla {
    max-width: 272px;
    margin-top: 8px;
    padding: 8px 11px 8px 11px;
    border-width: 1px;
    border-color: rgba(122, 85, 20, 0.32);
    border-radius: 9.6px;
    background-color: #f4e7ca;
    color: #211d18;
    opacity: 0;
    translate: 0 8px;
    transition-property: opacity, translate;
    transition-duration: 0.22s;
    transition-timing-function: ease-out;
}

.mk-kupla.mk-auki {
    opacity: 1;
    translate: 0 0;
}

.mk-kupla.mk-kupla--vanha.mk-auki {
    opacity: 0.55;
}

.mk-kupla__kappale {
    font-size: 14.7px;
    white-space: normal;
    margin-bottom: 4px;
}

.mk-kupla__hanta {
    display: none;
    position: absolute;
    width: 12px;
    height: 12px;
    right: 18px;
    bottom: -7px;
    rotate: 45deg;
    background-color: #f4e7ca;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-color: rgba(122, 85, 20, 0.32);
}

.mk-kupla.mk-kupla--viimeinen .mk-kupla__hanta {
    display: flex;
}

/* Viisaan Pöllön muotokuva avausesittelyn opaslupauksessa (webin .pollo-vihje-muotokuva:
 * kuvasarake clamp(4,5rem, 24vw, 5,6rem), 2:3, väli 0,7rem). Kupla pysyy pinon levyisenä. */
.mk-kupla.mk-kupla--muotokuva {
    flex-direction: row;
    align-items: center;
    width: 272px;
}

.mk-kupla__muotokuva {
    width: 76px;
    height: 114px;
    flex-shrink: 0;
    margin-right: 11px;
    border-radius: 4.8px;
    background-color: rgba(90, 62, 31, 0.08);
    -unity-background-scale-mode: scale-and-crop;
}

.mk-kupla__puhe {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}

/* --- pulun kuvakortti (webin dialog.pollo-kuvatausta / .pollo-kuvakortti, js/pollo.js
 * avaaKuvapopup): nähtävyysjutun kuva, pitkä kuvateksti · lähde ja "Avaa juttu". --- */

.mk-pulukuva {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    padding: 16px;
    background-color: rgba(20, 16, 10, 0.55);
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.2s;
}

.mk-pulukuva.mk-auki {
    opacity: 1;
}

.mk-pulukuva__kortti {
    width: 100%;
    max-width: 640px;
    padding: 9.6px;
    border-width: 1px;
    border-color: rgba(122, 85, 20, 0.32);
    border-radius: 8px;
    background-color: #f5f0e2;
    color: #211d18;
}

.mk-pulukuva__kuva {
    width: 100%;
    height: 240px;
    border-radius: 6px;
    -unity-background-scale-mode: scale-to-fit;
}

.mk-pulukuva__teksti {
    margin-top: 8px;
    font-size: 13.1px;
    white-space: normal;
    color: #6b5a45;
}

.mk-pulukuva__nappi {
    align-self: flex-start;
    margin: 8px 0 0 0;
    min-height: 0;
    padding: 5.6px 11.2px;
    border-width: 1px;
    border-color: #7a5514;
    border-radius: 8px;
    background-color: rgba(0, 0, 0, 0);
    color: #7a5514;
    font-size: 13.1px;
}

.mk-pulukuva__nappi:hover,
.mk-pulukuva__nappi:active {
    background-color: rgba(122, 85, 20, 0.12);
}

/* --- matkakirjakortti (webin .fact-card, css/styles.css 4755–4910, 9698–9900) --- */

.mk-matkakirja {
    position: absolute;
    left: 10px;
    width: 340px;
    max-width: 62%;
    max-height: 60%;
    padding: 9px 12px 11px 12px;
    border-width: 1px;
    border-color: var(--line);
    border-radius: 12px;
    background-color: var(--panel);
    overflow: hidden;
}

.mk-matkakirja__ylarivi {
    flex-direction: row;
    align-items: center;
    min-height: 24px;
}

.mk-matkakirja__otsikko {
    flex-grow: 1;
    flex-shrink: 1;
    font-size: 12.5px;
    letter-spacing: 1.2px;
    color: var(--accent);
    white-space: normal;
}

.mk-matkakirja__otsikko--paikka {
    font-size: 13.8px;
    letter-spacing: 0;
    color: var(--ink-light);
}

.mk-matkakirja__lyhyt {
    display: none;
}

.mk-matkakirja__tunnelma {
    font-size: 11.8px;
    -unity-font-style: italic;
    color: var(--muted);
    white-space: normal;
    margin: 1px 0 6px 0;
}

.mk-matkakirja__teksti {
    font-size: 13.5px;
    color: var(--ink-light);
    white-space: normal;
}

.mk-matkakirja .mk-matkakirja__piilo {
    display: none;
}

/* Tavallinen paikkarivi (web .fact-place): kaupunki tai "Matkalla — X", ei kursiivia. */
.mk-matkakirja__tunnelma.mk-matkakirja__tunnelma--paikka {
    font-size: 12.8px;
    -unity-font-style: bold;
    letter-spacing: 0.5px;
    margin: 0 0 4px 0;
}

/* Lähderivi tekstin perään (web .source-line: 0.78rem, --muted; otsikko versaalein). */
.mk-matkakirja__lahteet {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    margin-top: 5px;
}

.mk-matkakirja__lahdeotsikko {
    font-size: 10.9px;
    letter-spacing: 1.3px;
    color: var(--muted);
    opacity: 0.75;
    margin-right: 5px;
}

.mk-matkakirja__lahde {
    font-size: 12.5px;
    color: var(--muted);
    white-space: normal;
}

.mk-matkakirja__lahdelinkki {
    padding: 0;
    margin: 0;
    min-height: 0;
    border-width: 0;
    border-bottom-width: 1px;
    border-color: rgba(179, 156, 125, 0.6);
    background-color: rgba(0, 0, 0, 0);
    font-size: 12.5px;
    color: var(--muted);
}

.mk-matkakirja__lahdelinkki:hover {
    color: var(--accent);
}

/* Pieni kuvaikoni "Katso kuva" (web .fact-image-btn): vasen reuna tekstin alla. */
.mk-matkakirja__kuva {
    align-self: flex-start;
    width: 28px;
    height: 28px;
    min-height: 28px;
    padding: 4px;
    margin-top: 5px;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    color: var(--accent);
}

.mk-matkakirja__kuva:hover {
    color: #e7b865;
}

.mk-matkakirja__kuvaikoni {
    width: 20px;
    height: 20px;
}

.mk-matkakirja__pikkukuvat {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 8px;
}

.mk-matkakirja__pikkukuva {
    width: 54px;
    height: 40px;
    margin: 0 6px 4px 0;
    border-width: 1px;
    border-color: rgba(247, 241, 226, 0.6);
    border-radius: 3px;
    -unity-background-scale-mode: scale-and-crop;
}

/* Pieni: yhden rivin pergamenttikaistale (napautus avaa). */
.mk-matkakirja.mk-matkakirja--pieni {
    padding: 4px 10px 4px 10px;
    max-height: 34px;
    background-color: rgba(244, 231, 202, 0.86);
    border-color: rgba(122, 85, 20, 0.32);
    -unity-background-image-tint-color: rgba(0, 0, 0, 0);
}

.mk-matkakirja--pieni .mk-matkakirja__otsikko,
.mk-matkakirja--pieni .mk-matkakirja__tunnelma,
.mk-matkakirja--pieni .mk-matkakirja__teksti,
.mk-matkakirja--pieni .mk-matkakirja__pikkukuvat,
.mk-matkakirja--pieni .mk-matkakirja__lahteet,
.mk-matkakirja--pieni .mk-matkakirja__kuva,
.mk-matkakirja--pieni .mk-matkakirja__kaiutin {
    display: none;
}

.mk-matkakirja--pieni .mk-matkakirja__lyhyt {
    display: flex;
    flex-grow: 1;
    font-size: 12.5px;
    color: #211d18;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.mk-matkakirja__kaiutin {
    width: 30px;
    height: 30px;
    min-height: 30px;
    padding: 0;
    margin-left: 6px;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    color: var(--ink-light);
}

.mk-kaiutin {
    width: 20px;
    height: 20px;
}

.mk-kaiutin__osa {
    position: absolute;
    left: 0;
    top: 0;
    width: 20px;
    height: 20px;
    margin-right: 0;
}

.mk-kaiutin__kaari {
    opacity: 0.2;
}

.mk-kaiutin__vinoviiva {
    display: none;
    position: absolute;
    left: 9px;
    top: -1px;
    width: 2px;
    height: 22px;
    rotate: -45deg;
    background-color: var(--ink-light);
}

.mk-mykistetty .mk-kaiutin__vinoviiva {
    display: flex;
}

.mk-mykistetty .mk-kaiutin__kaari {
    opacity: 0.2;
}

/* --- luentakuvat (webin .fokusvirta-isokuva) ------------------------------- */

.mk-kuvapakka {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
}

.mk-kuvakortti {
    position: absolute;
    width: 78%;
    max-width: 420px;
    padding: 7px 7px 0 7px;
    background-color: #f7f1e2;
    border-width: 1px;
    border-color: rgba(70, 51, 31, 0.35);
    opacity: 0;
    transition-property: opacity, translate;
    transition-duration: 0.4s, 0.6s;
    transition-timing-function: ease-out, ease-in;
}

.mk-kuvakortti.mk-auki {
    opacity: 1;
}

.mk-kuvakortti.mk-kuvakortti--lahtee {
    opacity: 0;
    translate: -40% -60%;
}

.mk-kuvakortti__kuva {
    width: 100%;
    -unity-background-scale-mode: scale-to-fit;
}

.mk-kuvakortti__teksti {
    font-size: 11.5px;
    color: #3a2a1c;
    white-space: normal;
    -unity-text-align: middle-center;
    padding: 5px 4px 6px 4px;
}

.mk-ohita {
    position: absolute;
    bottom: 110px;
    left: 50%;
    translate: -50% 0;
    min-height: 34px;
    padding: 4px 16px;
    border-color: rgba(70, 51, 31, 0.5);
    background-color: rgba(247, 241, 226, 0.92);
    color: var(--map-ink);
}

.mk-ohita .mk-nappi__teksti {
    font-size: 13.5px;
    letter-spacing: 1px;
}

/* --- suurennos ------------------------------------------------------------ */

.mk-suurennos {
    flex-direction: column;
}

.mk-suurennos__kuva {
    width: 100%;
    height: 62%;
    -unity-background-scale-mode: scale-to-fit;
}

.mk-suurennos__teksti {
    max-width: 520px;
    margin-top: 12px;
    font-size: 15px;
    color: var(--ink-light);
    white-space: normal;
    -unity-text-align: middle-center;
}

.mk-suurennos__lahde {
    margin-top: 6px;
    font-size: 11px;
    color: var(--muted);
    -unity-text-align: middle-center;
}

/* --- pulun keskustelu (webin .pollo-paneeli, css/styles.css ~21651–22903) --- */

.mk-chat {
    position: absolute;
    height: 62%;
    max-height: 608px;
    min-height: 224px;
    padding: 0;
    border-width: 1px;
    border-color: rgba(122, 85, 20, 0.32);
    border-radius: 12px;
    background-color: #f5f0e2;
    color: #211d18;
    opacity: 0;
    translate: 0 10px;
    transition-property: opacity, translate;
    transition-duration: 0.2s;
    transition-timing-function: ease-out;
}

.mk-chat.mk-auki {
    opacity: 1;
    translate: 0 0;
}

/* Tuore keskustelu: korkeus sisällön mukaan (webin .pollo-alku). */
.mk-chat.mk-chat--alku {
    height: auto;
    max-height: 66%;
}

.mk-chat__virta {
    flex-grow: 1;
    flex-shrink: 1;
    padding: 11px 10px 6px 10px;
}

.mk-chat__viesti {
    margin-bottom: 9px;
    font-size: 14.5px;
    white-space: normal;
}

.mk-chat__livia {
    font-size: 15px;
}

.mk-chat__pelaaja {
    align-self: flex-end;
    max-width: 86%;
    padding: 5px 10px 5px 10px;
    border-radius: 10px;
    background-color: #e9dfc8;
    font-size: 13.5px;
}

.mk-chat__odottaa {
    -unity-font-style: italic;
    color: rgba(33, 29, 24, 0.6);
    font-size: 13.5px;
}

.mk-chat__paikkarivi {
    -unity-font-style: italic;
    color: rgba(33, 29, 24, 0.6);
    font-size: 13px;
}

.mk-chat__sirut {
    flex-direction: column;
    align-items: flex-start;
    margin-bottom: 8px;
}

.mk-chat__siru {
    min-height: 34px;
    margin-bottom: 6px;
    padding: 5px 11px 5px 11px;
    border-color: rgba(122, 85, 20, 0.45);
    border-radius: 16px;
    background-color: rgba(0, 0, 0, 0);
    color: #7a5514;
}

.mk-chat__siru:active {
    background-color: rgba(122, 85, 20, 0.12);
}

.mk-chat__siru .mk-nappi__teksti {
    font-size: 13px;
    white-space: normal;
}

.mk-chat__rivi {
    flex-direction: row;
    align-items: center;
    padding: 8px 8px 9px 8px;
    border-top-width: 1px;
    border-color: rgba(122, 85, 20, 0.25);
}

.mk-chat__kentta {
    flex-grow: 1;
    flex-shrink: 1;
    margin: 0 6px 0 0;
    font-size: 16px;
}

.mk-chat__kentta > .unity-base-text-field__input {
    min-height: 38px;
    padding: 4px 10px 4px 10px;
    border-width: 1px;
    border-color: rgba(122, 85, 20, 0.35);
    border-radius: 10px;
    background-color: #fffaf0;
    color: #211d18;
}

.mk-chat__laheta,
.mk-chat__kaiutin {
    width: 42px;
    height: 38px;
    min-height: 38px;
    padding: 0;
    margin-left: 4px;
    border-color: rgba(122, 85, 20, 0.45);
    background-color: rgba(0, 0, 0, 0);
    color: #7a5514;
}

.mk-chat__laheta .mk-nappi__teksti {
    font-size: 18px;
    -unity-text-align: middle-center;
}

.mk-chat__kaiutin > .mk-ikoni {
    margin-right: 0;
}

.mk-chat__kaiutin.mk-valittu {
    background-color: #d9a13b;
    color: #2c1e07;
}

.mk-chat__palaa {
    position: absolute;
    right: 10px;
    min-height: 34px;
    padding: 4px 12px 4px 12px;
    border-color: rgba(70, 51, 31, 0.5);
    background-color: rgba(247, 241, 226, 0.94);
    color: var(--map-ink);
}

.mk-chat__palaa .mk-nappi__teksti {
    font-size: 13px;
}

/* --- saapumistraileri (webin css/saapumistraileri.css) ------------------- */

.mk-traileri {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(8, 12, 18, 0.72);
    opacity: 1;
    transition-property: opacity;
    transition-duration: 0.2s;
}

.mk-traileri.mk-traileri--ohitettu {
    opacity: 0;
}

.mk-traileri__kuvat {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
}

.mk-traileri__kuva {
    position: absolute;
    width: 90%;
    height: 60%;
    border-radius: 18px;
    -unity-background-scale-mode: scale-to-fit;
    opacity: 0;
    transition-property: translate, opacity;
    transition-duration: 0.7s, 0.26s;
    transition-timing-function: ease-out-cubic, ease;
}

.mk-traileri__kuva.mk-traileri__kuva--keskella {
    opacity: 1;
}

.mk-traileri__kuva.mk-traileri__kuva--ulos {
    opacity: 0;
    transition-duration: 0.6s, 0.6s;
    transition-timing-function: ease-in-cubic, ease-in-cubic;
}

.mk-traileri__teksti {
    align-items: center;
    justify-content: center;
    max-width: 96%;
}

.mk-traileri__nimi {
    flex-direction: row;
    justify-content: center;
    font-size: 48px;
    color: #ffffff;
}

.mk-traileri__kirjain {
    color: #ffffff;
    text-shadow: 0 2px 18px rgba(0, 0, 0, 0.55);
    opacity: 0;
    scale: 0.05 0.05;
    transition-property: opacity, scale, translate;
    transition-duration: 0.65s;
    transition-timing-function: ease-out-cubic;
}

.mk-traileri__kirjain.mk-auki {
    opacity: 1;
    scale: 1 1;
}

/* Syöksy katsojan ohi: kasvaa ja häipyy. */
.mk-traileri__kirjain.mk-traileri__kirjain--ulos {
    opacity: 0;
    scale: 2.4 2.4;
    transition-duration: 0.45s;
    transition-timing-function: ease-in-cubic;
}

.mk-traileri__iskulause {
    margin-top: 10px;
    max-width: 92%;
    font-size: 19px;
    letter-spacing: 1px;
    color: #ffffff;
    text-shadow: 0 2px 14px rgba(0, 0, 0, 0.55);
    white-space: normal;
    -unity-text-align: middle-center;
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.6s;
}

.mk-traileri__iskulause.mk-auki {
    opacity: 1;
}

.mk-chat__laheta {
    justify-content: center;
}

.mk-chat__laheta > .mk-ikoni {
    width: 18px;
    height: 18px;
    margin-right: 0;
    --mk-ikoni-viiva: 2;
}

/* Vastauksen kuva kuplan oikeaan yläkulmaan (web .pollo-vastauskuva: float right, 5,2 rem). */
.mk-chat__livia--kuva {
    min-height: 90px;
    padding-right: 92px;
}

.mk-chat__vastauskuva {
    position: absolute;
    top: 2px;
    right: 0;
    width: 83px;
    height: 83px;
    border-width: 1px;
    border-color: rgba(70, 51, 31, 0.45);
    border-radius: 6px;
    -unity-background-scale-mode: scale-and-crop;
}

/* Chatin ylärivi (web .pollo-ylarivi, .pollo-naytakuplat: pikkupilleri). */
.mk-chat__ylarivi {
    flex-direction: row;
    justify-content: flex-end;
    flex-shrink: 0;
    padding: 6px 9px 0 9px;
}

.mk-chat__pilleri {
    min-height: 0;
    margin-left: 6px;
    padding: 2px 9px;
    border-width: 1px;
    border-color: rgba(70, 51, 31, 0.3);
    border-radius: 12px;
    background-color: #efe5cf;
    color: #7a4a1c;
}

.mk-chat__pilleri .mk-nappi__teksti {
    font-size: 11.5px;
}

/* Pöllöpoiminta vastauksen perässä (web .pollo-poimintarivi, -nappi, -tila). */
.mk-chat__poimintarivi {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    flex-shrink: 0;
    margin: 2px 0 6px 0;
}

.mk-chat__poimintanappi {
    min-height: 0;
    margin-right: 6px;
    padding: 3px 10px;
    border-width: 1px;
    border-color: rgba(70, 51, 31, 0.3);
    border-radius: 12px;
    background-color: #efe5cf;
    color: #211d18;
}

.mk-chat__poimintanappi .mk-nappi__teksti {
    font-size: 12px;
}

.mk-chat__poimintanappi:disabled {
    opacity: 0.5;
}

.mk-chat__poimintatila {
    font-size: 11.5px;
    color: #211d18;
    opacity: 0.8;
}

/* Syöte: sanelun tilarivi, kirjoitusrivi ja nappirivi (web .pollo-syote, .pollo-sanelu-tila, .pollo-sanelu). */
.mk-chat__syote {
    flex-shrink: 0;
    padding: 8px 8px 9px 8px;
    border-top-width: 1px;
    border-color: rgba(122, 85, 20, 0.25);
}

.mk-chat__syote > .mk-chat__rivi {
    padding: 0 0 6px 0;
    border-top-width: 0;
}

.mk-chat__sanelutila {
    margin-bottom: 6px;
    font-size: 13px;
    color: rgba(33, 29, 24, 0.62);
    -unity-text-align: middle-center;
    white-space: normal;
}

.mk-chat__nappirivi {
    flex-direction: row;
}

.mk-chat__nappula {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
    height: 36px;
    min-height: 36px;
    margin: 0 3px;
    padding: 2px 5px;
    justify-content: center;
    align-items: center;
    border-width: 1px;
    border-color: rgba(122, 85, 20, 0.45);
    border-radius: 8px;
    background-color: #f5f0e2;
    color: #7a5514;
}

.mk-chat__nappula > .mk-ikoni {
    width: 18px;
    height: 18px;
    margin-right: 0;
}

.mk-chat__nappirivi > .mk-chat__kaiutin {
    width: auto;
    height: 36px;
    min-height: 36px;
    margin-left: 3px;
    background-color: #f5f0e2;
}

.mk-chat__mikki {
    flex-grow: 2;
    flex-direction: row;
}

.mk-chat__mikki--kuuntelee {
    background-color: #7a5514;
    border-color: #7a5514;
    color: #f7f1e2;
}

.mk-chat__mikkiteksti {
    margin-left: 6px;
    font-size: 12.5px;
    color: #f7f1e2;
}

/* Matkakirjalinkit vastauksen alla (web .pollo-matkakirja: pienempi ja himmeämpi kuin puhe). */
.mk-chat__matkakirja {
    margin-top: -4px;
    font-size: 13px;
    color: rgba(33, 29, 24, 0.85);
    white-space: normal;
}
