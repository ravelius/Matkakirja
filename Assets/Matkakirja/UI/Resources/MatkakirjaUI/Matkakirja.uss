/* MATKAKIRJA UI (Natiivi-UI, 23.9.2026): verkkopelin css/styles.css:n ilme UI Toolkitille.
 * Tokenit (:root, styles.css 72–239):
 *   --bg #1d1610 · --panel #2a1f16 · --panel-2 #35271a · --line #4b3826
 *   --ink-light #f3e6d0 · --muted #b39c7d · --accent #d9a13b · --accent-dark #8a6114
 *   --kulta #eab84e (määrittelemätön webissä, varaväri on käytössä oleva arvo)
 *   --map-ink #46331f · --map-ink-soft #8a6c46 · --mark #b03a2b
 * Liukuvärit ja pergamentti tulevat koodista (Kuviot.cs), fontit järjestelmästä
 * (Kirjasimet.cs); tämän tiedoston -unity-font on varafontti.
 * Siirtymät: USS ei tue cubic-bezieriä, joten lähin nimetty käyrä.
 */

:root {
    --bg: #1d1610;
    --panel: #2a1f16;
    --panel-2: #35271a;
    --line: #4b3826;
    --ink-light: #f3e6d0;
    --muted: #b39c7d;
    --accent: #d9a13b;
    --accent-dark: #8a6114;
    --kulta: #eab84e;
    --map-ink: #46331f;
    --map-ink-soft: #8a6c46;
    --rivi-tausta: rgba(53, 39, 26, 0.55);
}

.mk-juuri {
    -unity-font-definition: url("../../../Fontit/EBGaramond.ttf");
    font-size: 15px;
    color: var(--ink-light);
}

/* Oletusteeman .unity-label-reunat pois; sama tarkkuus, myöhempi sääntö voittaa,
 * ja .mk-*-luokkien omat marginaalit ohittavat tämän. */
.unity-label {
    margin: 0;
    padding: 0;
}

.mk-turva {
    position: absolute;
}

/* --- ikonit ------------------------------------------------------------ */

.mk-ikoni {
    width: 19px;
    height: 19px;
    flex-shrink: 0;
    --mk-ikoni-viiva: 1.7;
}

/* --- napit (button, button.primary, button.ghost) ----------------------- */

.mk-nappi {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    min-height: 42px;
    margin: 0;
    padding: 8px 13px;
    border-width: 1px;
    border-color: var(--line);
    border-radius: 10px;
    background-color: var(--panel-2);
    color: var(--ink-light);
    transition-property: background-color, border-color, color, -unity-background-image-tint-color;
    transition-duration: 0.12s;
}

.mk-nappi:active {
    background-color: #43331f;
}

.mk-nappi:disabled {
    opacity: 0.45;
}

.mk-nappi > .mk-ikoni {
    margin-right: 7px;
}

.mk-nappi__teksti {
    font-size: 15px;
    -unity-text-align: middle-left;
    white-space: nowrap;
}

.mk-nappi--kulta {
    background-color: var(--accent);
    border-color: var(--accent-dark);
    color: #2c1e07;
    -unity-background-image-tint-color: rgb(255, 255, 255);
}

.mk-nappi--kulta:active {
    background-color: var(--accent);
    -unity-background-image-tint-color: rgb(232, 226, 214);
}

.mk-nappi--haamu {
    background-color: rgba(0, 0, 0, 0);
    min-height: 38px;
    padding: 6px 12px;
    border-color: rgba(70, 51, 31, 0.5);
    color: var(--map-ink);
}

.mk-nappi--haamu:active {
    background-color: rgba(70, 51, 31, 0.12);
}

/* --- yläpalkki (.topbar) ja tilapilleri (.turn-pill) --------------------- */

.mk-ylapalkki {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    flex-direction: row;
    align-items: center;
    border-bottom-width: 1px;
    border-color: var(--line);
    background-color: #2f2217;
}

/* Vaaka-asento (web css/styles.css .ylapalkki-nappi, body.ylapalkki-auki .topbar): palkki liukuu
 * oman korkeutensa verran ylös piiloon ja palaa väkäsnapista muun sisällön päälle (0,18 s). */
.mk-ylapalkki--piilossa {
    translate: 0 -100%;
    transition-property: translate;
    transition-duration: 0.18s;
    transition-timing-function: ease;
}

.mk-ylapalkki--piilossa.mk-ylapalkki--auki {
    translate: 0 0;
}

.mk-vakasnappi {
    position: absolute;
    top: 8px;
    right: 10px;
    width: 40px;
    height: 40px;
    min-height: 40px;
    padding: 0;
    border-width: 1px;
    border-radius: 12px;
    border-color: rgba(70, 51, 31, 0.35);
    background-color: rgba(239, 220, 180, 0.9);
    color: var(--map-ink);
    justify-content: center;
    transition-property: opacity;
    transition-duration: 0.18s;
}

.mk-vakasnappi:active {
    background-color: rgba(245, 231, 200, 0.95);
}

/* Auki olevan palkin alta nappi väistyy kokonaan (sulku napauttamalla palkin ulkopuolelle). */
.mk-vakasnappi--auki {
    opacity: 0;
}

.mk-vakasnappi > .mk-ikoni {
    width: 20px;
    height: 20px;
    margin-right: 0;
    --mk-ikoni-viiva: 1.6;
}

.mk-logo {
    width: 96px;
    height: 24px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
    background-position-x: left;
}

.mk-pilleri {
    flex-shrink: 1;
    min-width: 0;
    min-height: 30px;
    height: 30px;
    margin: 0 6px;
    padding: 0 10px;
    border-radius: 15px;
    background-color: var(--panel);
    border-color: var(--line);
    font-size: 13.5px;
}

.mk-pilleri:active {
    border-color: var(--kulta);
    background-color: var(--panel);
}

.mk-pilleri > .mk-ikoni {
    width: 17px;
    height: 17px;
    margin-right: 6px;
    color: var(--ink-light);
}

.mk-pilleri__raha {
    flex-shrink: 0;
    white-space: nowrap;
}

.mk-pilleri__kello {
    flex-shrink: 1;
    min-width: 0;
    margin-left: 6px;
    color: var(--muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    transition-property: color;
    transition-duration: 0.7s;
    transition-timing-function: ease-out;
}

/* aika-valahdys: päivän vaihtuessa kello syttyy kultaiseksi ja himmenee takaisin */
.mk-pilleri__kello.mk-valahdys {
    color: var(--kulta);
    transition-duration: 0.15s;
}

.mk-ylapalkki__napit {
    flex-direction: row;
    margin-left: auto;
    flex-shrink: 0;
}

.mk-ikoninappi {
    width: 40px;
    height: 40px;
    min-height: 40px;
    padding: 0;
    margin-left: 7px;
    border-radius: 10px;
    background-color: rgba(0, 0, 0, 0.12);
}

.mk-ikoninappi > .mk-ikoni {
    margin-right: 0;
    width: 18px;
    height: 18px;
}

.mk-ikoninappi.mk-valittu {
    border-color: var(--accent);
    color: var(--accent);
    background-color: var(--panel);
}

/* iPhonen kelluva yläosa (Ylapalkki.Kelluva, omistaja 24.9.2026): ei palkkia eikä logoa; pilleri ja ☰
 * puoliläpinäkyvällä pergamentilla kuten karttaselitteen nappi (.mk-seliteNappi). */
.mk-ylapalkki--kelluva {
    border-bottom-width: 0;
    background-color: rgba(0, 0, 0, 0);
}

.mk-ylapalkki--kelluva .mk-pilleri {
    height: 36px;
    min-height: 36px;
    margin: 0;
    padding: 0 12px;
    border-width: 1px;
    border-radius: 18px;
    border-color: rgba(70, 51, 31, 0.35);
    background-color: rgba(239, 220, 180, 0.82);
    color: var(--map-ink);
    font-size: 15px;
}

.mk-ylapalkki--kelluva .mk-pilleri:active {
    background-color: rgba(225, 204, 160, 0.95);
}

.mk-ylapalkki--kelluva .mk-pilleri > .mk-ikoni {
    color: var(--map-ink);
}

.mk-ylapalkki--kelluva .mk-pilleri__kello {
    margin-left: 8px;
    color: rgba(70, 51, 31, 0.75);
}

.mk-ylapalkki--kelluva .mk-ikoninappi {
    border-width: 1px;
    border-radius: 12px;
    border-color: rgba(70, 51, 31, 0.35);
    background-color: rgba(239, 220, 180, 0.82);
    color: var(--map-ink);
}

.mk-ylapalkki--kelluva .mk-ikoninappi:active {
    background-color: rgba(225, 204, 160, 0.95);
}

/* Saaririvi (omistaja 24.9.2026): pilleri ja napit Dynamic Islandin korkeudelle (37 pt) sen kummallekin
 * puolelle; pilleri tiiviimpi, jotta "300£ 1/80" mahtuu saaren vasemmalle puolelle. */
.mk-ylapalkki--saari .mk-pilleri {
    padding: 0 10px;
    font-size: 14px;
    overflow: hidden;
}

.mk-ylapalkki--saari .mk-pilleri__kello {
    margin-left: 6px;
}

.mk-ylapalkki--saari .mk-ikoninappi {
    width: 36px;
    height: 36px;
    min-height: 36px;
    border-radius: 18px;
}

/* Löydös 20: karttaselitteen nappi ☰:n vieressä saaren rivillä (Ylapalkki.Vieras). */
.mk-ylapalkki__napit > .mk-ylapalkki__vieras {
    position: relative;
    top: auto;
    right: auto;
    margin-left: 7px;
}

.mk-ylapalkki--saari .mk-ylapalkki__napit > .mk-ylapalkki__vieras {
    width: 36px;
    height: 36px;
    min-height: 36px;
    border-width: 1px;
    border-radius: 18px;
    border-color: rgba(70, 51, 31, 0.35);
    background-color: rgba(239, 220, 180, 0.82);
}

/* --- hetkellinen viesti (.event-toast) ----------------------------------- */

.mk-ilmoitus {
    position: absolute;
    top: 16%;
    left: 50%;
    max-width: 340px;
    padding: 12px 18px;
    border-width: 1px;
    border-color: var(--accent);
    border-radius: 14px;
    background-color: rgba(38, 27, 16, 0.96);
    opacity: 0;
    translate: -50% 14px;
    transition-property: opacity, translate;
    transition-duration: 0.28s;
    transition-timing-function: ease-out-back;
}

.mk-ilmoitus.mk-auki {
    opacity: 1;
    translate: -50% 0;
}

.mk-ilmoitus__teksti {
    font-size: 16.8px;
    white-space: normal;
    -unity-text-align: middle-center;
    color: var(--ink-light);
}

/* --- himmennys ja pergamenttikortti (.dialog, .dialog-card) --------------- */

.mk-himmennys {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    padding: 16px;
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.25s;
}

.mk-himmennys.mk-auki {
    opacity: 1;
}

.mk-himmennys--tumma {
    background-color: rgba(14, 9, 4, 0.72);
}

.mk-himmennys--kevyt {
    background-color: rgba(14, 9, 4, 0.35);
    justify-content: flex-end;
}

.mk-kortti-kehys {
    width: 100%;
    max-width: 420px;
    translate: 0 16px;
    rotate: -1.2deg;
    scale: 0.97 0.97;
    transition-property: translate, rotate, scale;
    transition-duration: 0.32s;
    transition-timing-function: ease-out-back;
}

.mk-himmennys.mk-auki .mk-kortti-kehys,
.mk-kaupunkikortti-alue.mk-auki .mk-kortti-kehys {
    translate: 0 0;
    rotate: 0deg;
    scale: 1 1;
}

.mk-kortti__varjo {
    position: absolute;
    left: 6px;
    right: 6px;
    top: 16px;
    bottom: -12px;
    background-color: rgba(0, 0, 0, 0.32);
    border-top-left-radius: 26px;
    border-top-right-radius: 16px;
    border-bottom-right-radius: 24px;
    border-bottom-left-radius: 18px;
}

.mk-kortti__katkoviiva {
    position: absolute;
    left: -6px;
    right: -6px;
    top: -6px;
    bottom: -6px;
    rotate: -0.45deg;
    border-color: rgba(70, 51, 31, 0.32);
}

.mk-kortti {
    padding: 18px 21px 16px 21px;
    border-width: 1px;
    border-color: rgba(70, 51, 31, 0.45);
    border-top-left-radius: 22px;
    border-top-right-radius: 12px;
    border-bottom-right-radius: 20px;
    border-bottom-left-radius: 14px;
    background-color: #ecd8ae;
    color: var(--map-ink);
}

.mk-kortti__otsikko {
    font-size: 23px;
    white-space: normal;
    margin-bottom: 4px;
}

.mk-kortti__alaotsikko {
    font-size: 14.5px;
    color: var(--map-ink-soft);
    white-space: normal;
    margin-bottom: 14px;
}

.mk-kortti__teksti {
    font-size: 16px;
    white-space: normal;
    margin-bottom: 12px;
}

.mk-kortti__napit {
    flex-direction: row;
    justify-content: flex-end;
    margin-top: 6px;
}

.mk-kortti__napit > .mk-nappi {
    margin-left: 10px;
}

/* --- matkavalinta ------------------------------------------------------- */

.mk-matkavalinta {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.2s;
}

.mk-matkavalinta.mk-auki {
    opacity: 1;
}

/* E5 (web .actions + .ikoni-teksti.wide): leveät napit kartan päällä, väli 0,4rem. */
.mk-matkavalinta__rivit {
    position: absolute;
    left: 50%;
    translate: -50% 0;
    flex-direction: column;
}

.mk-valintarivi {
    justify-content: flex-start;
    min-height: 58px;
    margin-bottom: 8px;
    padding: 8px 14px 8px 12px;
}

.mk-valintarivi > .mk-ikoni {
    width: 26px;
    height: 26px;
    margin-right: 13px;
    color: var(--accent);
}

.mk-matkavalinta__rivit .mk-valintarivi {
    flex-direction: row;
    justify-content: center;
    align-items: center;
    height: 44px;
    min-height: 44px;
    margin: 6.4px 0 0 0;
    padding: 0 12.8px;
    border-width: 1px;
    border-color: rgba(122, 85, 20, 0.35);
    border-radius: 10px;
    background-color: rgba(250, 243, 226, 0.72);
    color: #46331f;
}

.mk-matkavalinta__rivit .mk-valintarivi > .mk-ikoni {
    width: 22px;
    height: 22px;
    margin-right: 7.2px;
    color: #46331f;
}

.mk-matkavalinta__rivit .mk-valintarivi--takaisin > .mk-ikoni {
    margin-right: 0;
}

.mk-matkavalinta__rivit .mk-valintarivi__nimi {
    font-size: 18.4px;
    color: #46331f;
}

.mk-matkavalinta__rivit .mk-valintarivi__selite {
    margin: 0 0 0 7.2px;
    font-size: 12px;
    color: rgba(70, 51, 31, 0.7);
}

.mk-valintarivi__tekstit {
    flex-direction: column;
    flex-shrink: 1;
    flex-grow: 1;
}

.mk-valintarivi__nimi {
    font-size: 17px;
    color: var(--ink-light);
}

.mk-valintarivi__selite {
    font-size: 12.5px;
    color: var(--muted);
    white-space: normal;
    margin-top: 2px;
}

.mk-toimintonappi {
    position: absolute;
    left: 50%;
    translate: -50% 0;
    min-width: 230px;
    height: 52px;
    padding: 0 22px;
    border-radius: 12px;
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.2s;
}

.mk-toimintonappi.mk-auki {
    opacity: 1;
}

.mk-toimintonappi > .mk-ikoni {
    width: 22px;
    height: 22px;
    margin-right: 10px;
    color: #2c1e07;
}

.mk-toimintonappi .mk-nappi__teksti {
    font-size: 18px;
}

/* "Vaihda matkustustapa" heittonapin oikealla (web iconButton('nuoli')). */
.mk-vaihtonappi {
    position: absolute;
    right: -58px;
    top: 4px;
    width: 44px;
    height: 44px;
    padding: 0;
    justify-content: center;
    align-items: center;
    border-width: 1px;
    border-color: rgba(70, 51, 31, 0.5);
    border-radius: 12px;
    background-color: #f5f0e2;
    color: #46331f;
}

.mk-vaihtonappi > .mk-ikoni {
    width: 20px;
    height: 20px;
    margin-right: 0;
    color: #46331f;
}

/* Liiku ja kulkutapaliuku (web .monitoimi-nappi, .toimintorivi-liuku: ikonit, flex 1). */
.mk-liiku {
    position: absolute;
    left: 50%;
    translate: -50% 0;
    align-items: center;
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.2s;
}

.mk-liiku.mk-auki {
    opacity: 1;
}

.mk-liiku__nappi {
    flex-direction: row;
    align-items: center;
    height: 44px;
    padding: 0 18px;
    border-width: 1px;
    border-color: rgba(70, 51, 31, 0.5);
    border-radius: 22px;
    background-color: #f5f0e2;
    color: #2c1e07;
}

.mk-liiku__nappi > .mk-ikoni {
    width: 20px;
    height: 20px;
    margin-right: 8px;
    color: #7a5514;
}

.mk-liiku__nappi .mk-nappi__teksti {
    font-size: 16px;
}

/* iPhone (omistaja 24.9.2026, löydökset 6 ja 18): Liiku pienempi ja läpinäkyvä — vain teksti, kompassi ja kevyt
 * reuna, ei taustaa. Kevyt vaalea hehku tekstin ympärillä pitää sen luettavana tummalla kartalla. */
.mk-liiku--puhelin .mk-liiku__nappi {
    height: 38px;
    padding: 0 15px;
    border-radius: 19px;
    border-color: rgba(70, 51, 31, 0.4);
    background-color: rgba(0, 0, 0, 0);
    text-shadow: 0 0 3px rgba(245, 240, 226, 0.85);
}

.mk-liiku--puhelin .mk-liiku__nappi:active {
    background-color: rgba(245, 240, 226, 0.35);
}

.mk-liiku--puhelin .mk-liiku__nappi .mk-nappi__teksti {
    font-size: 14.5px;
}

.mk-liiku--puhelin .mk-liiku__nappi > .mk-ikoni {
    width: 18px;
    height: 18px;
}

/* Maan kortti auki (web body.infotaulu-auki): Liiku väistyy. */
/* Nappiin eikä kääreeseen: kääreen opacity on Rakenne.Naytan inline-arvo, joka voittaa luokan. */
.mk-liiku--vaistyy .mk-liiku__nappi {
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.18s;
}

.mk-liiku__nappi.mk-valittu {
    background-color: #d9a13b;
    border-color: #7a5514;
}

/* iPhone (löydös 18 tarkennus, Fable 24.9.): kulkutapavalitsin auki → kultainen reuna ja teksti, läpikuultava
 * kultatäyttö noin 20 %, ei umpikultaa. */
.mk-liiku--puhelin .mk-liiku__nappi.mk-valittu {
    background-color: rgba(217, 161, 59, 0.2);
    border-color: #d9a13b;
    color: #b07d1e;
}

.mk-liiku--puhelin .mk-liiku__nappi.mk-valittu > .mk-ikoni,
.mk-liiku--puhelin .mk-liiku__nappi.mk-valittu .mk-nappi__teksti {
    color: #b07d1e;
}

.mk-liiku__nappi:disabled {
    opacity: 0.45;
}

.mk-liiku__liuku {
    flex-direction: row;
    width: 300px;
    margin-bottom: 8px;
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.18s;
}

.mk-liiku__liuku.mk-auki {
    opacity: 1;
}

.mk-liiku__tapa {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
    height: 48px;
    margin: 0 3px;
    padding: 0;
    justify-content: center;
    align-items: center;
    border-width: 1px;
    border-color: rgba(70, 51, 31, 0.5);
    border-radius: 12px;
    background-color: #f5f0e2;
    color: #46331f;
}

.mk-liiku__tapa > .mk-ikoni {
    width: 24px;
    height: 24px;
    margin-right: 0;
    color: #46331f;
}

.mk-liiku__tapa--korostettu {
    background-color: #d9a13b;
    border-color: #7a5514;
}

.mk-liiku__tapa--estetty {
    opacity: 0.4;
}

/* --- pudotuspaneelit (.paavalikko, .kehittaja-valikko) ------------------ */

.mk-sulkija {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0);
}

.mk-pudotus {
    position: absolute;
    width: 300px;
    max-width: 88%;
    padding: 8px 12px 10px 12px;
    background-color: var(--panel);
    border-width: 1px;
    border-color: var(--line);
    border-radius: 10px;
    opacity: 0;
    translate: 0 -6px;
    transition-property: opacity, translate;
    transition-duration: 0.18s;
    transition-timing-function: ease-out;
}

.mk-pudotus.mk-auki {
    opacity: 1;
    translate: 0 0;
}

.mk-paavalikko {
    width: 320px;
}

.mk-pudotus__vieritys {
    flex-shrink: 1;
}

.mk-pudotus__otsikko {
    font-size: 11.5px;
    letter-spacing: 2.4px;
    color: var(--accent);
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    margin: 8px 0 9px 0;
}

.mk-kytkinrivi {
    justify-content: flex-start;
    min-height: 44px;
    margin-bottom: 7px;
    padding: 0 12px;
    border-width: 1.2px;
    border-radius: 8px;
    background-color: var(--rivi-tausta);
    color: rgba(230, 214, 184, 0.62);
}

.mk-kytkinrivi > .mk-ikoni {
    margin-right: 12px;
    opacity: 0.7;
}

.mk-kytkinrivi.mk-valittu {
    background-color: var(--panel-2);
    border-color: var(--accent-dark);
    color: var(--accent);
}

.mk-kytkinrivi.mk-valittu > .mk-ikoni {
    opacity: 1;
}

.mk-kytkinrivi__nimi {
    flex-grow: 1;
    font-size: 13.5px;
    letter-spacing: 0.8px;
}

.mk-kytkinrivi__tila {
    font-size: 11.5px;
    letter-spacing: 1.5px;
    opacity: 0.8;
}

.mk-pudotus__erotin {
    height: 1px;
    margin: 8px 0 12px 0;
    background-color: var(--line);
}

.mk-komentorivi {
    min-height: 44px;
    margin-bottom: 7px;
    border-width: 1.2px;
    border-radius: 8px;
    border-color: var(--accent-dark);
    background-color: var(--rivi-tausta);
    color: var(--accent);
}

.mk-komentorivi:active {
    background-color: var(--panel-2);
    color: var(--ink-light);
}

.mk-komentorivi .mk-nappi__teksti {
    font-size: 14.5px;
    letter-spacing: 0.6px;
    -unity-text-align: middle-center;
}

.mk-pudotus__pohjarivi {
    flex-direction: row;
    justify-content: flex-end;
    margin-top: 4px;
}

.mk-pudotus__versio {
    font-size: 12px;
    color: var(--muted);
}

/* --- äänentasot (liukusäätimet) ------------------------------------------- */

.mk-saadinrivi {
    flex-direction: row;
    align-items: center;
    min-height: 38px;
    padding: 0 2px;
}

.mk-saadinrivi__nimi {
    width: 118px;
    flex-shrink: 0;
    font-size: 13.5px;
    color: var(--ink-light);
}

.mk-saadinrivi__arvo {
    width: 48px;
    flex-shrink: 0;
    font-size: 13px;
    color: var(--kulta);
    -unity-text-align: middle-right;
}

.mk-saadin {
    flex-grow: 1;
    flex-shrink: 1;
    height: 30px;
    margin: 0 4px;
}

.mk-saadin .unity-base-slider__input {
    height: 30px;
}

.mk-saadin #unity-drag-container {
    height: 30px;
}

.mk-saadin #unity-tracker {
    position: absolute;
    top: 50%;
    left: 0;
    right: 0;
    height: 5px;
    margin-top: -2.5px;
    border-width: 0;
    border-radius: 3px;
    background-color: var(--line);
}

.mk-saadin .unity-base-slider__fill {
    background-color: var(--kulta);
    border-radius: 3px;
}

.mk-saadin #unity-dragger {
    position: absolute;
    top: 50%;
    width: 18px;
    height: 18px;
    margin-top: -9px;
    border-width: 0;
    border-radius: 9px;
    background-color: var(--kulta);
}

.mk-saadin #unity-dragger-border {
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
}

/* --- offline-lataus ------------------------------------------------------ */

.mk-offline {
    margin-top: 10px;
    padding-top: 4px;
    border-top-width: 1px;
    border-color: var(--line);
}

.mk-offline__selite {
    font-size: 11.5px;
    color: var(--muted);
    white-space: normal;
    -unity-text-align: middle-center;
    margin-bottom: 8px;
}

.mk-offline-rivi {
    flex-direction: row;
    align-items: center;
    min-height: 50px;
    margin-bottom: 6px;
    padding: 6px 8px 6px 12px;
    border-width: 1.2px;
    border-radius: 8px;
    border-color: var(--line);
    background-color: var(--rivi-tausta);
}

.mk-offline-rivi.mk-valittu {
    border-color: var(--accent-dark);
}

.mk-offline-rivi.mk-virhe {
    border-color: #d9705f;
}

.mk-offline-rivi__tiedot {
    flex-grow: 1;
    flex-shrink: 1;
}

.mk-offline-rivi__nimi {
    font-size: 14px;
    color: var(--ink-light);
}

.mk-offline-rivi__tieto {
    font-size: 11.5px;
    color: var(--muted);
    white-space: normal;
    margin-top: 1px;
}

.mk-edistyminen {
    height: 4px;
    margin-top: 5px;
    border-radius: 2px;
    background-color: var(--line);
    overflow: hidden;
}

.mk-edistyminen__taytto {
    height: 100%;
    width: 0;
    background-color: var(--kulta);
}

.mk-pikkunappi {
    min-height: 32px;
    padding: 4px 10px;
    margin-left: 8px;
    border-color: var(--accent-dark);
    background-color: rgba(0, 0, 0, 0);
    color: var(--accent);
}

.mk-pikkunappi .mk-nappi__teksti {
    font-size: 12.5px;
}

.mk-offline__vapaa {
    font-size: 11.5px;
    color: var(--muted);
    -unity-text-align: middle-right;
    margin-top: 4px;
}

/* --- kaupunkikortti (kaupunkiliuska + lehden masto) ---------------------- */

.mk-kaupunkikortti-alue {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: flex-end;
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.22s;
}

.mk-kaupunkikortti-alue.mk-auki {
    opacity: 1;
}

.mk-kaupunkikortti {
    max-height: 62%;
}

.mk-kaupunkikortti > .mk-kortti {
    flex-shrink: 1;
    padding: 14px 18px 14px 18px;
}

.mk-kaupunkikortti__vieritys {
    flex-shrink: 1;
}

.mk-masto {
    align-items: center;
    margin-bottom: 10px;
}

.mk-masto__ylarivi {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    min-height: 16px;
}

.mk-masto__lippu {
    height: 15px;
    width: 22px;
    margin-right: 7px;
    border-width: 0.5px;
    border-color: rgba(70, 51, 31, 0.35);
    -unity-background-scale-mode: stretch-to-fill;
}

.mk-masto__maa {
    font-size: 10.5px;
    letter-spacing: 3.2px;
    color: rgba(70, 51, 31, 0.7);
}

.mk-masto__nimio {
    font-size: 30px;
    letter-spacing: 3px;
    -unity-text-align: middle-center;
    white-space: normal;
    color: var(--map-ink);
    margin-top: 2px;
}

.mk-masto__viiva {
    height: 1px;
    width: 72%;
    margin-top: 6px;
    background-color: rgba(70, 51, 31, 0.45);
}

.mk-kansikuva {
    margin-bottom: 10px;
}

.mk-kansikuva__kuva {
    height: 168px;
    border-radius: 6px;
    border-width: 1px;
    border-color: rgba(70, 51, 31, 0.3);
    -unity-background-scale-mode: scale-and-crop;
    background-color: rgba(70, 51, 31, 0.08);
}

.mk-kansikuva__teksti {
    font-size: 13px;
    white-space: normal;
    color: var(--map-ink-soft);
    margin-top: 5px;
}

.mk-kansikuva__lahde {
    font-size: 9.5px;
    white-space: normal;
    color: rgba(70, 51, 31, 0.55);
    margin-top: 2px;
}

.mk-kaupunkikortti__johdanto {
    font-size: 15.5px;
    white-space: normal;
    margin-bottom: 12px;
}

.mk-kaupunkikortti__rivit {
    flex-direction: column;
}

/* Nostokategoriat haitarina (web kaupunkiliuska: hiusviiva, väripallo, sisennetyt kohteet). */
.mk-liuska__hiusviiva {
    height: 1px;
    width: 46%;
    margin: 4px 0 6px 12px;
    background-color: rgba(70, 51, 31, 0.35);
}

.mk-liuska__rivi {
    justify-content: flex-start;
    min-height: 40px;
    margin: 0 0 2px 0;
    padding: 6px 12px 6px 12px;
    border-width: 0;
    border-radius: 8px;
    background-color: rgba(0, 0, 0, 0);
    color: var(--map-ink);
}

.mk-liuska__rivi:active {
    background-color: rgba(70, 51, 31, 0.12);
}

.mk-liuska__rivi--auki {
    background-color: rgba(70, 51, 31, 0.08);
}

.mk-liuska__kohde {
    min-height: 36px;
    padding-left: 34px;
}

.mk-liuska__pallo {
    width: 8px;
    height: 8px;
    border-radius: 4px;
    margin-right: 12px;
    flex-shrink: 0;
}

.mk-liuska__nimi {
    font-size: 15.5px;
    white-space: normal;
    flex-shrink: 1;
    -unity-text-align: middle-left;
}

.mk-liuska__kohde > .mk-liuska__nimi {
    font-size: 14.5px;
    color: var(--map-ink-soft);
}

/* Kelausrivit (web "▲ edelliset" / "▼ lisää"): kortin reunoilla, vierityksen ulkopuolella. */
.mk-liuska__kelaus {
    flex-shrink: 0;
    min-height: 32px;
    padding: 4px 12px;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    color: var(--map-ink-soft);
}

.mk-liuska__kelaus:active {
    background-color: rgba(70, 51, 31, 0.12);
}

.mk-liuska__kelaus > .mk-ikoni {
    width: 15px;
    height: 15px;
    margin-right: 6px;
}

.mk-liuska__kelaus > .mk-nappi__teksti {
    font-size: 12.5px;
    letter-spacing: 1px;
}

/* --- tekijätiedot ja lähteet --------------------------------------------- */

.mk-tietoja {
    max-height: 86%;
}

.mk-tietoja > .mk-kortti {
    flex-shrink: 1;
}

.mk-tietoja__vieritys {
    flex-shrink: 1;
    margin-top: 6px;
}

/* Lähdeluettelo (web .lahteet-*): nimikilpi, kappaleet, ryhmät ja rivit. */
.mk-tietoja__kilpi {
    align-items: center;
    flex-shrink: 0;
    margin-bottom: 10px;
    padding: 12px 14px;
    border-width: 1px;
    border-color: rgba(70, 51, 31, 0.45);
    border-radius: 10px;
    background-color: #2f2217;
}

.mk-tietoja__logo {
    width: 100%;
    max-width: 224px;
    height: 55px;
    -unity-background-scale-mode: scale-to-fit;
}

.mk-tietoja__kappale {
    margin-bottom: 7px;
    font-size: 13px;
}

.mk-tietoja__alaotsikko {
    -unity-font-style: italic;
    color: rgba(70, 51, 31, 0.7);
}

.mk-tietoja__otsikko {
    margin-top: 12px;
    margin-bottom: 5px;
    padding-top: 10px;
    border-top-width: 1px;
    border-color: rgba(70, 51, 31, 0.45);
    font-size: 13px;
    letter-spacing: 1px;
}

.mk-tietoja__ryhma {
    margin-top: 12px;
    margin-bottom: 2px;
    font-size: 13.5px;
    letter-spacing: 0.5px;
}

.mk-tietoja__johdanto {
    margin-bottom: 6px;
    font-size: 13px;
    -unity-font-style: italic;
    color: rgba(70, 51, 31, 0.7);
    white-space: normal;
}

.mk-tietoja__rivi {
    margin-bottom: 8px;
    padding-left: 10px;
    border-left-width: 2px;
    border-color: rgba(70, 51, 31, 0.22);
}

.mk-tietoja__rivi > Label {
    white-space: normal;
}

.mk-tietoja__nimi {
    font-size: 13px;
}

.mk-tietoja__tekija {
    font-size: 12.5px;
    color: rgba(70, 51, 31, 0.8);
}

.mk-tietoja__lisenssi {
    font-size: 12.5px;
    color: rgba(70, 51, 31, 0.62);
}

.mk-tietoja__lisenssi--epaselva {
    color: #8a4a1c;
    -unity-font-style: italic;
}

.mk-tietoja__huom {
    font-size: 12px;
    -unity-font-style: italic;
    color: rgba(70, 51, 31, 0.7);
}

.mk-tietoja__lopetus {
    margin-top: 12px;
    font-size: 12.5px;
    color: rgba(70, 51, 31, 0.7);
}

/* Kukkaron välähdys (Ylapalkki: raha muuttui) kuten kellon aika-valahdys. */
.mk-pilleri__raha {
    transition-property: color;
    transition-duration: 1.2s;
}

.mk-pilleri__raha.mk-valahdys {
    color: var(--kulta);
    transition-duration: 0.15s;
}

/* --- Matkalaukku (webin .passport-card): paperi nahkakehyksessä pillerin alla --- */

.mk-pudotus.mk-laukku {
    padding: 0 20px 0 20px;
    border-width: 0 12px 12px 12px;
    border-color: #2b2015;
    border-radius: 0 0 12px 12px;
    color: #2b2116;
}

.mk-laukku .mk-pudotus__vieritys {
    padding: 14px 0 16px 0;
}

.mk-laukku__osio {
    margin: 8px 0 5px 0;
    font-size: 11.5px;
    letter-spacing: 2px;
    color: #9a6c16;
}

.mk-laukku__rivit {
    flex-direction: column;
}

.mk-laukku__rivi,
.mk-laukku__tavara,
.mk-laukku__aarre {
    flex-direction: row;
    align-items: center;
    min-height: 26px;
    margin-bottom: 4px;
}

.mk-laukku__teksti,
.mk-laukku__aarrenimi {
    flex-shrink: 1;
    font-size: 14px;
    white-space: normal;
}

.mk-laukku__aarrenimi {
    flex-grow: 1;
}

.mk-laukku__arvo {
    margin-left: auto;
    padding-left: 10px;
    font-size: 14px;
    -unity-font-style: bold;
}

.mk-laukku__muotokuva {
    width: 36px;
    height: 36px;
    margin-right: 8px;
    border-radius: 18px;
    border-width: 1px;
    border-color: rgba(122, 85, 20, 0.55);
    background-color: rgba(255, 255, 255, 0.35);
    -unity-background-scale-mode: scale-and-crop;
}

.mk-laukku__palkki {
    height: 4.5px;
    margin: 4px 0 2px 0;
    border-radius: 3px;
    background-color: rgba(70, 51, 31, 0.16);
    overflow: hidden;
}

.mk-laukku__palkkitayte {
    height: 100%;
    border-radius: 3px;
    transition-property: width;
    transition-duration: 0.4s;
}

.mk-laukku__seuraava {
    -unity-text-align: middle-right;
    font-size: 11px;
    -unity-font-style: italic;
    color: rgba(70, 51, 31, 0.6);
    margin-bottom: 4px;
}

.mk-laukku__lohkonappi {
    flex-direction: row;
    justify-content: flex-start;
    align-items: center;
    min-height: 34px;
    margin-top: 4px;
    padding: 0;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
}

.mk-laukku__lohkonappi .mk-laukku__osio {
    margin: 0;
}

.mk-laukku__vakanen {
    margin-left: 8px;
    font-size: 16px;
    color: #9a6c16;
    transition-property: rotate;
    transition-duration: 0.2s;
}

.mk-laukku__lohkonappi.mk-auki .mk-laukku__vakanen {
    rotate: 90deg;
}

.mk-laukku__lohko {
    flex-direction: column;
}

.mk-laukku__aarre {
    opacity: 0.62;
}

.mk-laukku__aarre.mk-loytynyt {
    opacity: 1;
}

.mk-laukku__aarre.mk-loytynyt .mk-laukku__aarrenimi {
    -unity-font-style: bold;
}

.mk-laukku__aarremerkki {
    width: 16px;
    margin-right: 8px;
    color: #d9a13b;
    -unity-text-align: middle-center;
}

.mk-laukku__aarretila {
    font-size: 10.5px;
    letter-spacing: 1.2px;
    color: rgba(70, 51, 31, 0.7);
}

.mk-laukku__tavaraikoni {
    width: 44px;
    height: 44px;
    margin-right: 10px;
    flex-shrink: 0;
}

.mk-laukku__tyhja {
    font-size: 13.5px;
    -unity-font-style: italic;
    color: rgba(70, 51, 31, 0.7);
    white-space: normal;
}

.mk-laukku__julisteet {
    flex-direction: row;
    align-items: center;
    margin-top: 10px;
    padding: 6px 8px;
    border-width: 1px;
    border-color: rgba(122, 85, 20, 0.3);
    border-radius: 8px;
    background-color: rgba(255, 252, 242, 0.5);
}

.mk-laukku__julistenimio {
    font-size: 11.5px;
    letter-spacing: 2px;
    color: #9a6c16;
    margin-right: 10px;
}

.mk-laukku__vedokset {
    flex-direction: row;
}

.mk-laukku__vedos {
    width: 26px;
    height: 36px;
    margin-right: 4px;
    border-width: 1px;
    border-color: rgba(70, 51, 31, 0.35);
    -unity-background-scale-mode: scale-and-crop;
}

/* --- Aloitusnäkymä (webin .start-gate, #intro, .intro-juliste, .intro-arkki) ------------- */

.mk-aloitus {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    transition-property: opacity;
    transition-duration: 0.9s;
}

.mk-aloitus__intro {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    flex-direction: column;
    transition-property: opacity;
    transition-duration: 0.9s;
}

.mk-aloitus__ylaosa {
    height: 44%;
    align-items: center;
    justify-content: center;
    padding-top: 24px;
}

.mk-juliste {
    align-items: center;
    width: 86%;
    max-width: 560px;
    color: var(--map-ink);
}

.mk-juliste__rivi {
    -unity-text-align: middle-center;
    color: var(--map-ink);
    white-space: normal;
    margin-bottom: 6px;
}

.mk-juliste__nimi {
    font-size: 44px;
    letter-spacing: 10px;
}

.mk-juliste__yla {
    font-size: 22px;
    letter-spacing: 5px;
}

.mk-juliste__ala {
    font-size: 17px;
    letter-spacing: 4px;
}

.mk-juliste__osa {
    margin-top: 6px;
    font-size: 13px;
    letter-spacing: 5.5px;
    color: #9c3a26;
}

.mk-juliste__viiva {
    flex-direction: row;
    align-items: center;
    width: 70%;
    max-width: 290px;
    margin: 6px 0 10px 0;
    color: rgba(70, 51, 31, 0.7);
}

.mk-juliste__vaakaviiva {
    flex-grow: 1;
    height: 4px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-top-color: rgba(70, 51, 31, 0.55);
    border-bottom-color: rgba(70, 51, 31, 0.26);
}

.mk-juliste__merkki {
    margin: 0 8px;
    font-size: 12px;
    color: rgba(70, 51, 31, 0.7);
}

.mk-aloitus__arkki {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    padding: 20px 16px 36px 16px;
    border-top-width: 1px;
    border-top-color: rgba(70, 51, 31, 0.3);
    transition-property: opacity;
    transition-duration: 0.9s;
}

/* Aloituskaava: avausteksti lennon aikana pallon päällä — ei verhoa eikä julistetta, arkki
 * kaistaleena alareunassa (napautus kirjoittaa loppuun). */
.mk-aloitus__intro--lento {
    justify-content: flex-end;
}

.mk-aloitus__intro--lento > .mk-aloitus__ylaosa {
    display: none;
}

.mk-aloitus__intro--lento > .mk-aloitus__arkki {
    flex-grow: 0;
    max-height: 34%;
    padding: 10px 16px 18px 16px;
    opacity: 0.94;
}

/* Lennolla kaistale on matala, jotta kone ja savujana näkyvät (Natiivisepän huomio 24.9.):
 * leveämpi palsta, pienempi teksti; vaakaruudulla vielä matalampi (--vaaka). */
.mk-aloitus__intro--lento .mk-aloitus__palsta {
    width: 92%;
    max-width: 720px;
}

.mk-aloitus__intro--lento .mk-aloitus__paikka {
    margin-bottom: 6px;
    font-size: 13px;
}

.mk-aloitus__intro--lento .mk-aloitus__runko {
    font-size: 16px;
}

.mk-aloitus__intro--vaaka > .mk-aloitus__arkki {
    max-height: 30%;
    padding: 6px 16px 10px 16px;
}

.mk-aloitus__intro--vaaka .mk-aloitus__runko {
    font-size: 14px;
}

.mk-aloitus__palsta {
    width: 86%;
    max-width: 560px;
}

.mk-aloitus__paikka {
    margin-bottom: 14px;
    font-size: 14.5px;
    letter-spacing: 1px;
    color: var(--map-ink);
    -unity-text-align: middle-center;
}

.mk-aloitus__runko {
    font-size: 18px;
    color: var(--map-ink);
    white-space: normal;
    -unity-text-align: upper-center;
    -unity-paragraph-spacing: 4px;
}

.mk-aloitus__valinta {
    align-self: center;
    min-height: 44px;
    margin-top: 22px;
    padding: 8px 22px;
    border-width: 1.5px;
    border-color: rgba(70, 51, 31, 0.75);
    border-radius: 2px;
    background-color: rgba(247, 237, 216, 0.55);
    color: var(--map-ink);
    transition-property: opacity;
    transition-duration: 0.8s;
}

.mk-aloitus__valinta .mk-nappi__teksti {
    font-size: 15px;
    letter-spacing: 4px;
}

.mk-aloitus__valinta:active {
    background-color: rgba(247, 237, 216, 0.85);
    border-color: var(--map-ink);
}

.mk-aloitus__portti {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0);
    transition-property: opacity;
    transition-duration: 0.35s;
}

.mk-aloitus__porttireuna {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    -unity-background-scale-mode: stretch-to-fill;
}

.mk-aloitus__keskus {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
}

/* Portin yläosa: sama juliste kuin avauksessa ja pelin kuvauslause (ensikokemus 23.9.). */
.mk-aloitus__porttiyla {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
}

.mk-aloitus__porttilause {
    width: 86%;
    max-width: 480px;
    margin-top: 4px;
    font-size: 17px;
    white-space: normal;
    -unity-text-align: middle-center;
    color: var(--map-ink);
}

/* Keskus portin alaosaan (juliste vie ylimmät 44 %). */
.mk-aloitus__portti > .mk-aloitus__keskus {
    top: 44%;
}

/* Kehystetty äänet-nappi (ennen pelkkä teksti, joka ei erottunut kosketettavaksi). */
.mk-aloitus__aanet {
    flex-direction: row;
    align-items: center;
    min-height: 40px;
    margin-bottom: 14px;
    padding: 7px 16px;
    border-width: 1px;
    border-color: rgba(232, 214, 172, 0.75);
    border-radius: 20px;
    background-color: rgba(36, 26, 18, 0.55);
    color: #e8d6ac;
}

.mk-aloitus__aanet.mk-valittu {
    border-color: var(--accent);
    color: var(--kulta);
}

.mk-aloitus__aanet.mk-valittu .mk-aloitus__aaniteksti {
    color: var(--kulta);
}

.mk-aloitus__aaniteksti {
    font-size: 16px;
    color: #e8d6ac;
    margin-right: 4px;
}

.mk-aloitus__aanet > .mk-ikoni {
    width: 20px;
    height: 20px;
}

.mk-aloitus__aloita {
    min-width: 220px;
    min-height: 52px;
    margin-top: 8px;
    padding: 12px 30px;
}

.mk-aloitus__aloita .mk-nappi__teksti {
    font-size: 18px;
    letter-spacing: 0.6px;
}

.mk-aloitus__linkki {
    position: absolute;
    left: 52px;
    right: 52px;
    bottom: 42px;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    color: #d8c091;
}

.mk-aloitus__linkki .mk-nappi__teksti {
    font-size: 14px;
    -unity-text-align: middle-center;
}

.mk-aloitus__valintakortti {
    max-width: 520px;
    max-height: 86%;
}

.mk-aloitus__valintavieritys {
    flex-shrink: 1;
}

.mk-aloitus__kohteet {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
}

.mk-aloitus__kohde {
    width: 49%;
    flex-direction: row;
    justify-content: flex-start;
    align-items: center;
    min-height: 48px;
    margin-bottom: 6px;
    padding: 6px 8px;
    border-width: 1px;
    border-color: rgba(70, 51, 31, 0.3);
    border-radius: 6px;
    background-color: rgba(255, 252, 242, 0.45);
    color: var(--map-ink);
}

.mk-aloitus__kohde:active {
    background-color: rgba(255, 252, 242, 0.9);
    border-color: rgba(70, 51, 31, 0.6);
}

.mk-aloitus__lippu {
    width: 30px;
    height: 20px;
    margin-right: 8px;
    flex-shrink: 0;
    border-width: 0.5px;
    border-color: rgba(70, 51, 31, 0.35);
    -unity-background-scale-mode: scale-and-crop;
}

.mk-aloitus__kohdetekstit {
    flex-shrink: 1;
}

.mk-aloitus__kohdenimi {
    font-size: 15px;
    color: var(--map-ink);
}

.mk-aloitus__kohdemaa {
    font-size: 11px;
    color: rgba(70, 51, 31, 0.65);
}

.mk-aloitus__periaate {
    margin-bottom: 6px;
}

/* --- Matkan huipennus (webin #winner-dialog) ------------------------------------------- */

.mk-huipennus__merkki {
    font-size: 30px;
    color: #d9a13b;
    -unity-text-align: middle-center;
}

.mk-huipennus__otsikko {
    -unity-text-align: middle-center;
}

/* ◈-aarremerkki viivaikonina (Aloitusnakyma.Merkki). */
.mk-juliste__merkki.mk-ikoni {
    width: 13px;
    height: 13px;
    margin: 0 8px;
    color: rgba(70, 51, 31, 0.7);
    --mk-ikoni-viiva: 1.6;
}

.mk-huipennus__merkki.mk-ikoni {
    align-self: center;
    width: 34px;
    height: 34px;
    color: #d9a13b;
}

.mk-laukku__aarremerkki.mk-ikoni {
    width: 14px;
    height: 14px;
    margin-right: 8px;
    color: #d9a13b;
}

/* Laukun Varusteet (linssit) — webin .passport-card .linssi-valikko: pyöreät
   64 px:n varustekuvat ruudukossa, "Ei linssiä" vaalealla pohjalla, päällä
   olevalle messinkirengas, esikatsellulle kevyt rengas; keskeneräiset omalla
   rivillään 44 px ja himmeinä. Tietolohko keskitetty, Aktivoi-nappi alla. */
.mk-laukku__linssit {
    padding: 6px 0 3px 0;
    border-bottom-width: 1.5px;
    border-color: rgba(70, 51, 31, 0.28);
}

.mk-laukku__linssit--kesken {
    padding-top: 3px;
    border-top-width: 1px;
    border-bottom-width: 0;
    border-color: rgba(70, 51, 31, 0.18);
}

.mk-laukku__linssisolu {
    align-items: center;
    justify-content: center;
}

.mk-laukku__linssi {
    width: 64px;
    height: 64px;
    min-height: 64px;
    padding: 0;
    border-width: 0;
    border-color: rgba(122, 85, 20, 0.9);
    border-radius: 32px;
    background-color: rgba(0, 0, 0, 0);
    color: #46331f;
    overflow: hidden;
}

.mk-laukku__linssi > .mk-ikoni {
    width: 34px;
    height: 34px;
    margin-right: 0;
    --mk-ikoni-viiva: 1.6;
}

.mk-laukku__linssikuva {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    border-radius: 32px;
    -unity-background-scale-mode: scale-and-crop;
}

.mk-laukku__linssi--ei {
    border-width: 1.5px;
    border-color: rgba(94, 74, 47, 0.55);
    background-color: rgba(252, 241, 212, 0.55);
}

.mk-laukku__linssi--ei > .mk-ikoni {
    width: 30px;
    height: 30px;
}

.mk-laukku__linssi:active {
    background-color: rgba(252, 241, 212, 0.9);
}

.mk-laukku__linssi.mk-esikatselu {
    border-width: 1.5px;
    border-color: rgba(122, 85, 20, 0.55);
}

.mk-laukku__linssi.mk-paalla {
    border-width: 2.5px;
    border-color: rgba(122, 85, 20, 0.9);
}

.mk-laukku__linssi--ei.mk-paalla {
    background-color: rgba(252, 241, 212, 0.9);
}

.mk-laukku__linssi--kesken {
    width: 44px;
    height: 44px;
    min-height: 44px;
    border-radius: 22px;
    opacity: 0.62;
}

.mk-laukku__linssi--kesken .mk-laukku__linssikuva {
    border-radius: 22px;
}

.mk-laukku__linssi--kesken > .mk-ikoni {
    width: 24px;
    height: 24px;
}

.mk-laukku__linssi--kesken.mk-esikatselu,
.mk-laukku__linssi--kesken.mk-paalla {
    opacity: 0.85;
}

.mk-laukku__linssitiedot {
    align-items: center;
    padding-top: 10px;
    opacity: 1;
    translate: 0 0;
    transition-property: opacity, translate;
    transition-duration: 0.22s;
    transition-timing-function: ease-out;
}

.mk-laukku__linssitiedot.mk-vaihtui {
    opacity: 0;
    translate: 0 3px;
    transition-duration: 0s;
}

.mk-laukku__linssinimi {
    margin-bottom: 3px;
    font-size: 13.5px;
    letter-spacing: 0.6px;
    color: #46331f;
    -unity-text-align: middle-center;
}

.mk-laukku__linssilyhyt {
    font-size: 13px;
    color: rgba(70, 51, 31, 0.85);
    white-space: normal;
    -unity-text-align: middle-center;
}

.mk-laukku__aktivoi {
    min-width: 136px;
    min-height: 44px;
    margin: 11px 0 2px 0;
    padding: 5px 19px;
    border-color: rgba(122, 85, 20, 0.65);
    border-radius: 8px;
    background-color: rgba(250, 238, 208, 0.7);
    color: #7a5514;
}

.mk-laukku__aktivoi:active {
    background-color: rgba(255, 250, 238, 0.9);
    color: #9c6f1e;
}

.mk-laukku__aktivoi .mk-nappi__teksti {
    font-size: 12.5px;
    letter-spacing: 1.9px;
    -unity-text-align: middle-center;
}

.mk-laukku__aktivoi.mk-pois {
    background-color: rgba(236, 222, 196, 0.5);
    color: rgba(70, 51, 31, 0.85);
}

.mk-pudotus__versionappi {
    min-height: 28px;
    padding: 0;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
}

.mk-kehittaja__virhe {
    color: #9a2b21;
}

/* --- laukun galleriat, minipopup ja pikkuseloste (Galleriat.cs, Minipopup.cs) ---------- */

/* Laukun osion otsikko + i-nappi (web #aarni-otsikko). */
.mk-laukku__osiorivi {
    flex-direction: row;
    align-items: center;
}

.mk-laukku__osiorivi .mk-laukku__osio {
    margin-right: 0;
}

/* web button.seloste-nappi: pieni i-ympyrä otsikon perässä. */
.mk-seloste-nappi {
    width: 18px;
    height: 18px;
    min-height: 18px;
    margin: 0 0 0 6px;
    padding: 0;
    border-width: 1px;
    border-color: var(--accent);
    border-radius: 9px;
    background-color: rgba(0, 0, 0, 0);
    color: var(--accent);
}

.mk-seloste-nappi .mk-nappi__teksti {
    font-size: 11px;
    -unity-text-align: middle-center;
}

.mk-seloste-nappi.mk-auki {
    background-color: var(--accent);
    color: var(--panel);
}

.mk-pikkuseloste {
    position: absolute;
    max-width: 304px;
    padding: 10px 26px 10px 12px;
    border-width: 1px;
    border-color: rgba(217, 161, 59, 0.45);
    border-radius: 8px;
    color: var(--map-ink);
}

.mk-pikkuseloste__teksti {
    font-size: 13px;
    white-space: normal;
}

.mk-pikkuseloste__sulje {
    position: absolute;
    top: 2px;
    right: 2px;
    width: 24px;
    height: 24px;
    min-height: 24px;
    padding: 0;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    color: var(--map-ink-soft);
}

.mk-pikkuseloste__sulje .mk-nappi__teksti {
    font-size: 16px;
    -unity-text-align: middle-center;
}

/* web .minipopup-kehys / -kortti */
.mk-minipopup {
    background-color: rgba(14, 9, 4, 0.45);
}

.mk-minipopup__kehys {
    width: 100%;
    max-width: 384px;
    max-height: 66%;
    padding: 11px 13px 14px 13px;
    border-width: 1px;
    border-color: rgba(122, 85, 20, 0.32);
    border-radius: 12px;
    color: #211d18;
    scale: 0.97 0.97;
    transition-property: scale;
    transition-duration: 0.2s;
    transition-timing-function: ease-out;
}

.mk-minipopup.mk-auki .mk-minipopup__kehys {
    scale: 1 1;
}

.mk-minipopup__ylarivi {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 8px;
}

.mk-minipopup__otsikko {
    font-size: 17.5px;
    letter-spacing: 0.9px;
    color: #46331f;
}

.mk-minipopup__sulje {
    min-height: 0;
    padding: 0 6px;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    color: rgba(70, 51, 31, 0.75);
}

.mk-minipopup__sulje .mk-nappi__teksti {
    font-size: 20px;
}

.mk-minipopup__vieritys {
    flex-shrink: 1;
}

.mk-minipopup__teksti {
    margin-bottom: 8px;
    font-size: 14.5px;
    white-space: normal;
}

/* TIETÄJÄN TIE (web .tietaja-galleria-*) */
.mk-tietaja__ylarivi {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    margin-bottom: 11px;
}

.mk-tietaja__selitys {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 136px;
    margin-right: 14px;
    font-size: 14.4px;
    white-space: normal;
}

.mk-tietaja__nykyinen {
    flex-direction: column;
    align-items: center;
    flex-shrink: 0;
}

.mk-tietaja__nykykuva {
    width: 144px;
    height: 144px;
    border-radius: 72px;
    border-width: 2px;
    border-color: rgba(122, 85, 20, 0.6);
    background-color: rgba(255, 255, 255, 0.35);
    -unity-background-scale-mode: scale-and-crop;
}

.mk-tietaja__nykynimi {
    margin-top: 5px;
    font-size: 12.5px;
    color: #46331f;
    -unity-text-align: upper-center;
}

.mk-tietaja__kohta {
    align-items: center;
    padding: 5px 3px;
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0);
    border-radius: 8px;
}

.mk-tietaja__kohta.mk-valittu {
    border-color: rgba(122, 85, 20, 0.55);
    background-color: rgba(217, 161, 59, 0.18);
}

.mk-tietaja__kohta--saavuttamaton {
    opacity: 0.45;
}

.mk-tietaja__kuva {
    width: 54px;
    height: 54px;
    margin-bottom: 2px;
    border-radius: 27px;
    border-width: 1px;
    border-color: rgba(122, 85, 20, 0.5);
    background-color: rgba(255, 255, 255, 0.35);
    -unity-background-scale-mode: scale-and-crop;
}

.mk-tietaja__nimi {
    font-size: 11px;
    color: #46331f;
    white-space: normal;
    -unity-text-align: upper-center;
}

.mk-tietaja__raja {
    font-size: 10.5px;
    color: rgba(70, 51, 31, 0.7);
}

/* JULISTEGALLERIA (web .julistegalleria-*) */
.mk-galleria-huntu {
    background-color: rgba(26, 18, 8, 0.28);
}

.mk-galleria {
    width: 94%;
    max-width: 760px;
    max-height: 88%;
    padding: 10px 14px 16px 14px;
    border-width: 1px;
    border-color: rgba(60, 44, 26, 0.35);
    border-radius: 3px;
    background-color: #f8f3e6;
    color: rgba(60, 44, 26, 0.92);
}

.mk-galleria__yla {
    flex-direction: row;
    align-items: center;
    margin-bottom: 6px;
    padding: 4px 0 6px 0;
    border-bottom-width: 1px;
    border-color: rgba(60, 44, 26, 0.22);
}

.mk-galleria__otsikko {
    margin-right: 8px;
    font-size: 16px;
    letter-spacing: 1.6px;
    color: rgba(60, 44, 26, 0.92);
}

.mk-galleria__luku {
    font-size: 13px;
    color: rgba(60, 44, 26, 0.65);
}

.mk-galleria__rasti {
    min-height: 0;
    margin-left: auto;
    padding: 0 5px;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    color: rgba(60, 44, 26, 0.7);
}

.mk-galleria__rasti .mk-nappi__teksti {
    font-size: 22px;
}

.mk-galleria__vieritys {
    flex-shrink: 1;
}

.mk-galleria__ryhma {
    margin: 10px 0 6px 0;
    font-size: 12px;
    letter-spacing: 1.1px;
    color: rgba(60, 44, 26, 0.7);
}

.mk-galleria__vedos {
    flex-direction: column;
    align-items: stretch;
    justify-content: flex-start;
    min-height: 0;
    padding: 0;
    border-width: 0;
    border-radius: 0;
    background-color: rgba(0, 0, 0, 0);
}

.mk-galleria__kuva {
    border-width: 1px;
    border-color: rgba(60, 44, 26, 0.6);
    -unity-background-scale-mode: scale-and-crop;
}

.mk-galleria__nimi {
    margin-top: 4px;
    font-size: 10px;
    letter-spacing: 0.3px;
    white-space: normal;
    -unity-text-align: upper-center;
    color: rgba(60, 44, 26, 0.8);
}

.mk-galleria__vedos--lukossa {
    align-items: center;
    justify-content: center;
}

.mk-galleria__kysymys {
    font-size: 15px;
    color: rgba(60, 44, 26, 0.92);
}

.mk-katkokehys {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    color: rgba(60, 44, 26, 0.4);
}

.mk-galleria__kuva .mk-katkokehys {
    display: none;
}

.mk-galleria__vedos--kuvaton .mk-galleria__kuva {
    border-width: 0;
}

.mk-galleria__vedos--kuvaton .mk-galleria__kuva .mk-katkokehys {
    display: flex;
}

/* --- SÄÄGRAAFI (Saagraafi.cs; web css .vuosisaa, .vuosisaa-kortti, .opas-saagraafi) ------ */
/* Korkeus asetetaan koodissa leveydestä (viewBox 300×176); fonttikoot skaalautuvat. */
.mk-saa {
    width: 100%;
    flex-shrink: 0;
    background-color: rgba(255, 250, 238, 0.65);
    border-width: 1px;
    border-color: rgba(70, 51, 31, 0.35);
    border-radius: 6px;
    overflow: hidden;
}

.mk-saa__akseli,
.mk-saa__arvo {
    position: absolute;
    margin: 0;
    padding: 0;
    white-space: nowrap;
    font-size: 8.5px;
    color: rgba(70, 51, 31, 0.8);
}

.mk-saa__kuluva {
    color: #7a5514;
    -unity-font-style: bold;
}

/* Ääripäiden lukemat: halo pitää luvut luettavina palkkien päällä (web paint-order: stroke). */
.mk-saa__arvo {
    color: #8a5a12;
    -unity-font-style: bold;
    text-shadow: 0 0 2px rgba(245, 240, 226, 0.95);
}

.mk-saa__arvo--sade {
    color: #4c6478;
}

/* Iso näkymä minipopupissa: webin sääkortti on enintään 480 px leveä. */
.mk-saa__popup {
    max-width: 480px;
}

.mk-saa__luonnehdinta {
    margin: 10px 0 0 0;
    font-size: 13.8px;
    white-space: normal;
    color: #2d2010;
}

.mk-saa__selite {
    margin: 8px 0 0 0;
    font-size: 11px;
    white-space: normal;
    color: rgba(70, 51, 31, 0.75);
}

/* Oppaan pieni kuvaaja (web .opas-saagraafi 15rem) ja kuvateksti. */
.mk-saa__kelluke {
    width: 240px;
    max-width: 100%;
    margin: 2px 0 10px 0;
}

.mk-saa__kelluke-teksti {
    margin: 5px 0 0 0;
    font-size: 10.2px;
    letter-spacing: 0.2px;
    white-space: normal;
    color: rgba(58, 42, 21, 0.7);
}

/* --- maalehden etusivu: korkokartta kaupunkipisteineen (web .maakartta-*) -------------- */

.mk-lehti__maakartta {
    margin: 4px 0 4px 0;
    border-width: 1px;
    border-color: rgba(70, 51, 31, 0.4);
    border-radius: 2px;
}

.mk-lehti__maakarttakuva {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    -unity-background-scale-mode: stretch-to-fill;
}

.mk-lehti__maapiste {
    position: absolute;
    width: 9px;
    height: 9px;
    margin-left: -4.5px;
    margin-top: -4.5px;
    border-width: 1.5px;
    border-color: #f7efdc;
    border-radius: 5px;
    background-color: #2c2318;
    overflow: visible;
}

.mk-lehti__maapiste--paa {
    width: 12px;
    height: 12px;
    margin-left: -6px;
    margin-top: -6px;
    border-color: #2c2318;
    border-radius: 6px;
    background-color: #c69e52;
}

.mk-lehti__maapistenimi {
    position: absolute;
    left: 12px;
    top: -6px;
    padding: 0 3px;
    border-radius: 2px;
    background-color: rgba(247, 240, 222, 0.72);
    font-size: 11px;
    white-space: nowrap;
    color: #2c2318;
}

.mk-lehti__maapistenimi--vasen {
    left: auto;
    right: 12px;
}

/* --- lipun tarina (Lippuikkuna.cs; web .lippu-ikkuna) ------------------------------------- */

.mk-lippu__iso {
    height: 180px;
    border-width: 1px;
    border-color: rgba(70, 51, 31, 0.35);
    -unity-background-scale-mode: scale-to-fit;
}

.mk-lippu__valinta {
    margin: 4px 0 10px 0;
    font-size: 11px;
    letter-spacing: 1.6px;
    -unity-text-align: upper-center;
    color: rgba(70, 51, 31, 0.65);
}

.mk-lippu__symbolit {
    margin-bottom: 10px;
    padding: 8px 10px;
    border-left-width: 3px;
    border-left-color: rgba(70, 51, 31, 0.4);
    background-color: rgba(120, 96, 60, 0.06);
}

.mk-lippu__symboli {
    margin-bottom: 3px;
    font-size: 14px;
    white-space: normal;
}

.mk-lippu__versiotyhdys {
    margin: 10px 0 8px 0;
    font-size: 11px;
    letter-spacing: 1.8px;
    color: #46331f;
}

.mk-lippu__versio {
    flex-direction: column;
    align-items: stretch;
    min-height: 0;
    padding: 0;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
}

.mk-lippu__versiokuva {
    height: 58px;
    border-width: 1px;
    border-color: rgba(70, 51, 31, 0.35);
    -unity-background-scale-mode: scale-to-fit;
}

.mk-lippu__versionimi {
    margin-top: 3px;
    font-size: 10.5px;
    white-space: normal;
    -unity-text-align: upper-center;
    color: #46331f;
}

.mk-aloitus__periaatelinkki {
    align-self: flex-start;
    margin-top: 8px;
}

.mk-aloitus__oikeudet {
    margin-top: 10px;
    font-size: 11px;
    color: rgba(70, 51, 31, 0.6);
}

/* --- pieni liike (PieniLiike.cs; web .pallolauta-liike) ------------------------------------ */

.mk-liike {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    overflow: hidden;
}

.mk-liike__savy {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    opacity: 0;
    transition-property: opacity, background-color;
    transition-duration: 2s;
}

/* Kortin lukija (KortinLukija.cs, web .lukija-otsikkorivi > button.lukija-nappi): kaiutin ilman
 * taustaa, luennan aikana kultainen, mykistettynä himmeä ja vinoviiva (Pulu.uss mk-kaiutin__vinoviiva). */
.mk-lukija {
    width: 34px;
    height: 34px;
    min-height: 34px;
    padding: 0;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    color: #46331f;
    justify-content: center;
    overflow: visible;
}

.mk-lukija > .mk-ikoni {
    width: 21px;
    height: 21px;
    margin-right: 0;
}

.mk-lukija.mk-lukee {
    color: #a8741a;
}

.mk-lukija.mk-mykistetty {
    color: rgba(70, 51, 31, 0.5);
}

.mk-lukija > .mk-kaiutin__vinoviiva {
    left: 16px;
    top: 6px;
}

/* Mitä uutta / Peli päivittyi (MitaUutta.cs, web .muutokset-lista li: versio lihavoituna, teksti perään). */
.mk-muutos {
    flex-direction: row;
    align-items: flex-start;
    margin-bottom: 8px;
}

.mk-muutos__versio {
    min-width: 58px;
    max-width: 96px;
    white-space: normal;
    margin-right: 8px;
    font-size: 14px;
    color: #46331f;
}

.mk-muutos__teksti {
    flex-shrink: 1;
    flex-grow: 1;
    font-size: 15px;
    white-space: normal;
    color: #3a2a1a;
}

/* --- REAKTIOT (Reaktiot.cs; web .reaktiorivi, .reaktionappi, .reaktio-*) ------------------- */

.mk-reaktiot {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    margin-top: 9px;
}

/* Noston loppurivillä "Lue lisää aiheesta" -napin rinnalla, oikeaan reunaan (web .leipa-loppurivi). */
.mk-reaktiot--loppu {
    margin: 4px 0 0 auto;
}

/* Väliotsikon päässä (web .reaktiot-otsikko): pienempi, ei kuittausta. */
.mk-reaktiot--otsikko {
    flex-shrink: 0;
    margin: 0 0 0 auto;
}

.mk-reaktionappi {
    min-width: 30px;
    min-height: 30px;
    margin: 0 6px 0 0;
    padding: 3px 4px;
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0);
    border-radius: 15px;
    background-color: rgba(0, 0, 0, 0);
    color: rgba(70, 51, 31, 0.5);
    transition-property: color, border-color, background-color;
    transition-duration: 0.14s;
}

.mk-reaktionappi:active {
    background-color: rgba(156, 107, 23, 0.1);
}

.mk-reaktionappi > .mk-ikoni {
    width: 17px;
    height: 17px;
    margin-right: 0;
    --mk-ikoni-viiva: 1.5;
    transition-property: scale, rotate;
    transition-duration: 0.19s;
    transition-timing-function: ease-out;
}

.mk-reaktionappi--oma {
    color: #7a5514;
    border-color: rgba(122, 85, 20, 0.45);
    background-color: rgba(156, 107, 23, 0.1);
}

/* Web reaktio-poks: ikoni pullahtaa hetkeksi. */
.mk-reaktionappi--poks {
    color: #7a5514;
}

.mk-reaktionappi--poks > .mk-ikoni {
    scale: 1.28 1.28;
    rotate: -8deg;
}

.mk-reaktiot--otsikko .mk-reaktionappi {
    min-width: 26px;
    min-height: 26px;
    padding: 1px 3px;
}

.mk-reaktiot--otsikko .mk-reaktionappi > .mk-ikoni {
    width: 16px;
    height: 16px;
    --mk-ikoni-viiva: 1.75;
}

.mk-reaktiot__luku {
    margin-left: 3px;
    font-size: 10.5px;
}

.mk-reaktiot__kuittaus {
    display: none;
    font-size: 11px;
    letter-spacing: 0.6px;
    color: rgba(70, 51, 31, 0.72);
}

.mk-reaktiot--otsikko .mk-reaktiot__kuittaus {
    display: none;
}

/* Minipopupit: "Mikä oli vialla?" ja virheilmoitus (web .minipopup-reaktio*). */
.mk-minipopup__kehys.mk-minipopup--reaktio {
    max-width: 480px;
}

.mk-minipopup__kehys.mk-minipopup--reaktio-kysymys {
    max-width: 352px;
}

.mk-reaktio__ohje {
    margin-bottom: 9px;
    font-size: 13.5px;
    white-space: normal;
    color: rgba(50, 36, 22, 0.9);
}

.mk-reaktio__vaihtoehto {
    justify-content: flex-start;
    min-height: 0;
    margin: 0 0 6px 0;
    padding: 6px 11px;
    border-color: rgba(70, 51, 31, 0.35);
    border-radius: 6px;
    background-color: rgba(255, 252, 244, 0.7);
    color: rgba(50, 36, 22, 0.92);
}

.mk-reaktio__vaihtoehto:active,
.mk-reaktio__nappi:active {
    background-color: rgba(156, 107, 23, 0.14);
}

.mk-reaktio__vaihtoehto .mk-nappi__teksti {
    font-size: 13px;
}

.mk-reaktio__kentta {
    margin: 0 0 8px 0;
}

.mk-reaktio__kentta > .unity-base-text-field__input {
    min-height: 64px;
    padding: 6px 8px;
    border-width: 1px;
    border-color: rgba(70, 51, 31, 0.32);
    border-radius: 4px;
    background-color: rgba(255, 252, 244, 0.75);
    color: rgba(50, 36, 22, 0.94);
    font-size: 13px;
    white-space: normal;
}

.mk-reaktio__livia {
    margin-bottom: 8px;
    font-size: 13px;
    white-space: normal;
    color: rgba(70, 51, 31, 0.85);
}

.mk-reaktio__napit {
    flex-direction: row;
}

.mk-reaktio__nappi {
    min-height: 0;
    margin: 0 6px 0 0;
    padding: 4px 11px;
    border-color: rgba(70, 51, 31, 0.35);
    border-radius: 12px;
    background-color: rgba(255, 252, 244, 0.7);
    color: rgba(50, 36, 22, 0.92);
}

.mk-reaktio__nappi .mk-nappi__teksti {
    font-size: 12.5px;
}

/* --- palaute ja ehdotukset (PalauteLomake.cs, Kuvavinkki.cs, ProOsio.cs) --------------------
 * Web css/styles.css .periaate-palaute, -kentta, -rasti, -nimio, -huomio, -ehdotus, .pro-rasti-rivi,
 * .pro-ulos ja .kuvavinkki-oikeudet pergamentilla. USS-erot: katkoviivareuna yhtenäisenä (ei
 * dashed-reunaa), checkbox piirretty ruutuna (ei selaimen omaa), select = DropdownField. */

.mk-palaute {
    margin-top: 20px;
    padding-top: 14px;
    border-top-width: 1px;
    border-color: rgba(122, 85, 20, 0.35);
}

.mk-palaute__osio {
    margin-top: 18px;
    padding-top: 12px;
    border-top-width: 1px;
    border-color: rgba(122, 85, 20, 0.35);
}

.mk-palaute__valiotsikko {
    margin-top: 16px;
    margin-bottom: 4px;
    font-size: 12.5px;
    letter-spacing: 1.5px;
    white-space: normal;
    color: #8a6a2c;
}

.mk-palaute__valiotsikko--alku {
    margin-top: 0;
}

.mk-palaute__teksti {
    margin-bottom: 8px;
    font-size: 15px;
    white-space: normal;
    color: var(--map-ink);
}

.mk-palaute__nimio {
    margin-top: 11px;
    font-size: 13px;
    white-space: normal;
    color: #6d5a3c;
}

.mk-palaute__huomio {
    margin-top: 8px;
    font-size: 12.5px;
    white-space: normal;
    color: #6d5a3c;
}

.mk-palaute__kursiivi {
    -unity-font-style: italic;
}

/* Kentät (.periaate-kentta): vaalea paperi, ohut ruskea reuna. */
.mk-palaute__kentta {
    margin: 10px 0 0 0;
}

.mk-palaute__kentta > .unity-base-text-field__input {
    min-height: 40px;
    padding: 9px 11px;
    border-width: 1px;
    border-radius: 8px;
    border-color: rgba(122, 85, 20, 0.45);
    background-color: rgba(255, 252, 240, 0.7);
    font-size: 14.5px;
    color: var(--map-ink);
}

.mk-palaute__kentta--iso > .unity-base-text-field__input {
    min-height: 96px;
    white-space: normal;
    -unity-text-align: upper-left;
}

.mk-palaute__kentta:focus > .unity-base-text-field__input {
    border-color: rgba(176, 138, 60, 0.95);
    background-color: rgba(255, 252, 240, 0.9);
}

/* Rasti (.periaate-rasti): ruutu + teksti, koko rivi napautettava. */
.mk-palaute__rasti {
    flex-direction: row;
    align-items: flex-start;
    margin-top: 10px;
    min-height: 30px;
}

.mk-palaute__ruutu {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
    margin-top: 1px;
    align-items: center;
    justify-content: center;
    border-width: 1px;
    border-radius: 4px;
    border-color: rgba(122, 85, 20, 0.6);
    background-color: rgba(255, 252, 240, 0.8);
}

.mk-palaute__ruksi {
    width: 10px;
    height: 10px;
    border-radius: 2px;
    background-color: var(--map-ink);
    opacity: 0;
}

.mk-palaute__rasti.mk-valittu .mk-palaute__ruksi {
    opacity: 1;
}

.mk-palaute__rastiteksti {
    flex-shrink: 1;
    margin-left: 9px;
    font-size: 13px;
    white-space: normal;
    color: #6d5a3c;
}

/* Pro-hakurasti ja i (.pro-rasti-rivi). */
.mk-palaute__prorivi {
    flex-direction: row;
    align-items: center;
    margin-top: 10px;
}

.mk-palaute__prorivi > .mk-palaute__rasti {
    flex-shrink: 1;
    margin-top: 0;
    align-items: center;
}

.mk-palaute__seloste {
    margin-left: 8px;
}

/* Lähetysnappi (button.primary.periaate-laheta): koko leveys. */
.mk-palaute__laheta {
    margin-top: 12px;
    align-self: stretch;
}

/* Kuvan valinta ja toissijainen nappi paperilla (.pro-ulos). */
.mk-palaute__kuvanappi,
.mk-palaute__toissijainen {
    min-height: 38px;
    margin-top: 6px;
    padding: 6px 12px;
    border-color: rgba(122, 85, 20, 0.45);
    background-color: rgba(255, 252, 240, 0.7);
    color: #6d5a3c;
}

.mk-palaute__kuvanappi {
    align-self: flex-start;
}

.mk-palaute__toissijainen {
    margin-top: 12px;
    align-self: stretch;
}

.mk-palaute__kuvanappi:active,
.mk-palaute__toissijainen:active {
    background-color: rgba(122, 85, 20, 0.12);
}

.mk-palaute__kuvanappi .mk-nappi__teksti,
.mk-palaute__toissijainen .mk-nappi__teksti {
    font-size: 13.5px;
}

/* Väkänen (details > summary). */
.mk-palaute__vakanappi {
    justify-content: flex-start;
    min-height: 36px;
    padding: 4px 0;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    color: #8a6a2c;
}

.mk-palaute__vakanappi:active {
    background-color: rgba(122, 85, 20, 0.08);
}

.mk-palaute__vakanen {
    margin-right: 8px;
    font-size: 16px;
    color: #8a6a2c;
    transition-property: rotate;
    transition-duration: 0.2s;
}

.mk-palaute__vakanappi.mk-auki .mk-palaute__vakanen {
    rotate: 90deg;
}

.mk-palaute__vakaotsikko {
    flex-shrink: 1;
    font-size: 12.5px;
    letter-spacing: 1.5px;
    white-space: normal;
    color: #8a6a2c;
}

/* Kuvan oikeudet omana ryhmänään (.kuvavinkki-oikeudet). */
.mk-palaute__oikeudet {
    margin: 10px 0;
    padding: 8px 10px;
    border-width: 1px;
    border-radius: 6px;
    border-color: rgba(70, 51, 31, 0.22);
    background-color: rgba(70, 51, 31, 0.04);
}

/* Käyttölupa ja lisenssi (select). */
.mk-palaute__valinta {
    margin: 6px 0 0 0;
}

.mk-palaute__valinta > .unity-base-popup-field__input {
    min-height: 40px;
    padding: 8px 11px;
    border-width: 1px;
    border-radius: 8px;
    border-color: rgba(122, 85, 20, 0.45);
    background-color: rgba(255, 252, 240, 0.7);
    color: var(--map-ink);
}

.mk-palaute__valinta .unity-base-popup-field__text {
    font-size: 14px;
    white-space: normal;
    flex-shrink: 1;
    color: var(--map-ink);
}

.mk-palaute__valinta .unity-base-popup-field__arrow {
    -unity-background-image-tint-color: var(--map-ink);
}

/* Kuvasuurennoksen reaktiorivi keskellä paperin alla (web .reaktiot-suurennos). */
.mk-reaktiot--suurennos {
    justify-content: center;
    margin-top: 3px;
}

/* Lue lisää -artikkeli (WikiIkkuna.cs; web #wiki-dialog .wiki-card, .wiki-p, .wiki-h2/-h3,
 * .arrival-kuvakotelo, .wiki-source): pergamenttikortti, kuva nuolineen ja laskurineen,
 * kappaleet ja lähderivi linkkeineen. */
.mk-wiki {
    width: 92%;
    max-width: 640px;
}

.mk-wiki__ylarivi {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    flex-shrink: 0;
}

.mk-wiki__otsikko {
    flex-shrink: 1;
    white-space: normal;
}

.mk-wiki__kuvakotelo {
    margin: 4px 0 6px 0;
}

.mk-wiki__kuva {
    height: 220px;
    border-radius: 6px;
    background-color: #14100c;
    -unity-background-scale-mode: scale-to-fit;
}

.mk-wiki__nuoli {
    position: absolute;
    top: 42%;
    width: 36px;
    height: 36px;
    min-height: 36px;
    border-radius: 18px;
    border-width: 0;
    background-color: rgba(20, 16, 10, 0.55);
}

.mk-wiki__nuoli .mk-nappi__teksti {
    font-size: 22px;
    -unity-text-align: middle-center;
    color: #f1e6d0;
}

.mk-wiki__nuoli--edellinen {
    left: 6px;
}

.mk-wiki__nuoli--seuraava {
    right: 6px;
}

.mk-wiki__laskuri {
    position: absolute;
    right: 8px;
    bottom: 6px;
    padding: 1px 6px;
    border-radius: 8px;
    background-color: rgba(20, 16, 10, 0.6);
    font-size: 11px;
    color: #f1e6d0;
}

.mk-wiki__kuvateksti {
    margin-bottom: 6px;
    font-size: 12.5px;
    white-space: normal;
    color: #5a4a33;
}

.mk-wiki__p {
    margin-bottom: 9px;
    font-size: 15px;
    white-space: normal;
    color: #2b2116;
}

.mk-wiki__h2 {
    margin: 8px 0 5px 0;
    font-size: 17px;
    white-space: normal;
    color: #3a2812;
}

.mk-wiki__h3 {
    margin: 6px 0 4px 0;
    font-size: 15.5px;
    white-space: normal;
    color: #3a2812;
}

.mk-wiki__lahderivi {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    margin-top: 4px;
}

.mk-wiki__lahde {
    font-size: 12px;
    white-space: normal;
    color: #5a4a33;
}

.mk-wiki__linkki {
    min-height: 28px;
    padding: 0;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
}

.mk-wiki__linkki .mk-nappi__teksti {
    font-size: 12px;
    color: #7a5514;
}

/* --- Lukijaääni (Tyohuone.cs LukijaaaniIkkuna, web #puhe-dialog) ------------------------- */
.mk-lukijaaani {
    width: 520px;
    max-width: 94%;
}

.mk-lukijaaani__nimi {
    margin: 8px 0 4px 2px;
    font-size: 13px;
    color: var(--muted);
}

.mk-lukijaaani__ohje {
    margin: 0;
}

.mk-lukijaaani__ohje > .unity-base-text-field__input {
    min-height: 72px;
    white-space: normal;
}

.mk-lukijaaani__oletus {
    margin: 4px 2px 8px 2px;
    font-size: 12px;
    white-space: normal;
    color: var(--muted);
}


/* Löydös 23: lennon ajaksi UI-kerrokset häipyvät (UiNakymat.LentoPiilo); paluu hieman hitaammin. */
.mk-lentosiirtyma {
    transition-property: opacity;
    transition-duration: 0.8s;
    transition-timing-function: ease-in-out;
}

.mk-lentosiirtyma.mk-lentopiilo {
    opacity: 0;
    transition-duration: 0.6s;
}
