/* LEHTI (Natiivi-UI): kaupunki- ja maalehti — webin .dialog.lehti.arkki (css/styles.css). */

.mk-lehti__peite {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(14, 9, 4, 0.34);
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.22s;
}

.mk-lehti__peite.mk-auki {
    opacity: 1;
}

.mk-lehti {
    width: 100%;
    max-width: 960px;
    height: 100%;
    padding: 10px 0 0 0;
    background-color: #f5f0e2;
    color: rgba(58, 42, 26, 0.95);
    overflow: hidden;
}

/* Tarttuva otsikkorivi (web .dialog.arkki #arrival-city ja .wiki-kategoria .aihe-nimi): sivun oma otsikko,
 * ☰ vasemmalla ja 🔊 oikealla. Nimiö (etusivu) ilman viivoja, aihe-nimi 3 px:n viivalla yllä ja 1 px alla. */
.mk-lehti__ylaosa {
    flex-shrink: 0;
    padding: 6px 15px 0 15px;
}

.mk-lehti__ylarivi {
    flex-direction: row;
    align-items: center;
    min-height: 44px;
}

.mk-lehti__ylaosa--aihe .mk-lehti__ylarivi {
    padding: 6.7px 0 5.4px 0;
    border-top-width: 3px;
    border-bottom-width: 1px;
    border-top-color: rgba(70, 51, 31, 0.85);
    border-bottom-color: rgba(70, 51, 31, 0.55);
}

.mk-lehti__ylanimirivi {
    flex-grow: 1;
    flex-shrink: 1;
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.mk-lehti__ylanimi {
    flex-shrink: 1;
    font-size: 23.2px;
    letter-spacing: 1.4px;
    white-space: normal;
    color: rgba(70, 51, 31, 0.92);
    -unity-text-align: middle-center;
}

.mk-lehti__ylaosa--nimio .mk-lehti__ylanimi {
    letter-spacing: 3.5px;
    color: #16130f;
}

.mk-lehti__ylaosa--nimio .mk-lehti__nimioyla {
    -unity-text-align: middle-center;
    margin-bottom: 1.6px;
}

.mk-lehti__ikoninappi {
    width: 40px;
    height: 40px;
    min-height: 40px;
    padding: 0;
    border-width: 0;
    border-radius: 6px;
    background-color: rgba(0, 0, 0, 0);
    color: #46331f;
    justify-content: center;
}

.mk-lehti__ikoninappi > .mk-ikoni {
    margin-right: 0;
    width: 20px;
    height: 20px;
}

.mk-lehti__ikoninappi.mk-valittu {
    background-color: rgba(217, 161, 59, 0.3);
}

.mk-lehti__sivupaikka {
    flex-grow: 1;
    flex-shrink: 1;
    overflow: hidden;
}

.mk-lehti__sivu {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
}

/* Sivun reunus (web --arkki-reunus: puhelimessa 0,95rem, ≥ 700 px 2,2rem). Luokka sisältösäiliöön koodista:
 * Unity 6:n ScrollView'ssä viewportin ja sivun välissä on content-and-vertical-scroll-container, joten
 * lapsivalitsin ei osunut ja teksti alkoi ruudun reunasta (pariteetti 24.9. rivi 5). */
.mk-lehti__sisalto {
    padding: 18px 15.2px 28px 15.2px;
}

.mk-lehti--levea .mk-lehti__sisalto {
    padding-left: 35.2px;
    padding-right: 35.2px;
}

.mk-lehti__sivu--liuku {
    transition-property: translate, opacity;
    transition-duration: 0.3s;
    transition-timing-function: ease-in-out;
}

/* --- masto ------------------------------------------------------------------ */

.mk-lehti__masto {
    align-items: center;
    margin-bottom: 2px;
}

.mk-lehti__nimioyla {
    font-size: 9.5px;
    letter-spacing: 3.3px;
    color: rgba(70, 51, 31, 0.7);
}

.mk-lehti__nimio {
    font-size: 38px;
    letter-spacing: 4px;
    color: #16130f;
    -unity-text-align: middle-center;
    white-space: normal;
    margin: 2px 0 4px 0;
}

.mk-lehti__paivays {
    align-self: stretch;
    justify-content: center;
    margin: 0 0 13.6px 0;
    padding: 3.8px 0;
    border-top-width: 3px;
    border-bottom-width: 1px;
    border-top-color: rgba(70, 51, 31, 0.75);
    border-bottom-color: rgba(70, 51, 31, 0.5);
}

.mk-lehti__paivaysteksti {
    font-size: 11.2px;
    letter-spacing: 1.8px;
    -unity-text-align: middle-center;
    color: rgba(70, 51, 31, 0.85);
}

/* Web @media (max-width: 699px) liitelinkin kanssa: päivä vasemmalla, linkki oikealla. */
.mk-lehti__paivays--vali {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.mk-lehti__paivays--vali .mk-lehti__paivaysteksti {
    -unity-text-align: middle-left;
}

.mk-lehti__paivays--keski .mk-lehti__maalinkki {
    position: absolute;
    right: 0;
    top: 2px;
}

/* --- aihe ja teksti ------------------------------------------------------------- */

.mk-lehti__aihe {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin: 4px 0 12px 0;
    padding: 6px 0;
    border-top-width: 3px;
    border-bottom-width: 1px;
    border-top-color: rgba(70, 51, 31, 0.75);
    border-bottom-color: rgba(70, 51, 31, 0.45);
}

.mk-lehti__aiheteksti {
    flex-shrink: 1;
    font-size: 21px;
    letter-spacing: 1.2px;
    color: #16130f;
    -unity-text-align: middle-center;
    white-space: normal;
}

.mk-lehti__lippu {
    width: 30px;
    height: 20px;
    margin-left: 10px;
    border-width: 0.5px;
    border-color: rgba(70, 51, 31, 0.35);
    -unity-background-scale-mode: scale-and-crop;
}

.mk-lehti__johdanto {
    /* Web .johdanto: Iowan kursiivi 16,32 px, rgba(70, 51, 31, 0,9), alaväli 17,6. */
    font-size: 16.32px;
    white-space: normal;
    margin-bottom: 17.6px;
    color: rgba(70, 51, 31, 0.9);
}

.mk-lehti__esittely,
.mk-lehti__leipa {
    font-size: 16px;
    white-space: normal;
    margin-bottom: 10px;
    color: rgba(58, 42, 26, 0.95);
}

/* Web #arrival-intro p: American Typewriter 16 px #5a4326. */
.mk-lehti__esittely {
    color: #5a4326;
}

/* Web .teksti (aihesivun nosto): Iowan 16,32 px #211d18. */
.mk-lehti__teksti {
    font-size: 16.32px;
    white-space: normal;
    margin-bottom: 8px;
    color: #211d18;
}

/* Anfangi (web ::first-letter: American Typewriter 700, 3,1 em, rgba(70, 51, 31, 0,9)); koko ja paikka koodista. */
.mk-lehti__anfangi {
    position: absolute;
    left: 0;
    top: 0;
    margin: 0;
    padding: 0;
    color: rgba(70, 51, 31, 0.9);
    -unity-text-align: upper-left;
    white-space: nowrap;
}

.mk-lehti__osasto {
    font-size: 11px;
    letter-spacing: 2.2px;
    color: #7a5514;
    margin: 6px 0 8px 0;
}

.mk-lehti__nosto {
    margin-bottom: 18px;
    padding-bottom: 12px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(70, 51, 31, 0.18);
}

/* Web .wiki-nosto h3: --font-type (American Typewriter) 700, 0,98rem, letter-spacing 0,02em, alaväli 0,45rem
 * (pariteetti 24.9. rivi 5: natiivissa oli leipätekstin lihava 19 px). */
.mk-lehti__nosto-otsikkorivi {
    flex-direction: row;
    align-items: flex-end;
    margin-bottom: 7.2px;
}

.mk-lehti__nosto-otsikko {
    flex-grow: 1;
    flex-shrink: 1;
    font-size: 15.7px;
    letter-spacing: 0.3px;
    white-space: normal;
    color: #16130f;
}

.mk-lehti__aika {
    margin-left: 10px;
    font-size: 12px;
    color: rgba(70, 51, 31, 0.7);
}

.mk-lehti__nostoloppu {
    flex-direction: row;
    flex-wrap: wrap;
}

.mk-lehti__linkki {
    min-height: 32px;
    margin: 4px 12px 0 0;
    padding: 0;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    color: #7a5514;
}

.mk-lehti__linkki .mk-nappi__teksti {
    font-size: 13px;
}

/* E9 (web .wiki-btn): 0,78rem, välistys 0,05em, #7a5514, pisteviiva rgba(122,85,20,.45) 4 px tekstin alla. */
.mk-lehti__wiki {
    align-self: flex-start;
    min-height: 0;
    margin-top: 6.4px;
    padding: 1.6px 0;
}

.mk-lehti__wiki .mk-nappi__teksti {
    font-size: 12.48px;
    letter-spacing: 0.62px;
}

.mk-lehti__wikiviiva {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -2.4px;
    height: 1px;
    color: rgba(122, 85, 20, 0.45);
}

/* --- kuvat ---------------------------------------------------------------------- */

.mk-lehti__kuvakehys {
    margin: 2px 0 6px 0;
    border-width: 3px;
    border-color: #f7efdc;
    background-color: rgba(70, 51, 31, 0.08);
    overflow: hidden;
}

.mk-lehti__kuva {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.mk-lehti__paakuva .mk-lehti__kuva {
    -unity-background-scale-mode: scale-and-crop;
}

.mk-lehti__kuvateksti {
    font-size: 13px;
    white-space: normal;
    color: rgba(33, 29, 24, 0.78);
    margin-bottom: 2px;
}

.mk-lehti__lahde {
    font-size: 10.5px;
    white-space: normal;
    color: rgba(70, 51, 31, 0.6);
    margin-bottom: 8px;
}

.mk-lehti__kuvasarja {
    margin-bottom: 10px;
}

.mk-lehti__kuvarivi {
    flex-direction: row;
    justify-content: space-between;
    margin: 6px 0 14px 0;
}

.mk-lehti__kuvasolu {
    width: 49%;
}

/* --- matkailijalle, listat, maaosasto --------------------------------------------- */

.mk-lehti__matkailijalle {
    margin-top: 8px;
    padding: 12px 14px;
    border-width: 1px;
    border-color: rgba(122, 85, 20, 0.35);
    background-color: rgba(214, 190, 140, 0.18);
}

.mk-lehti__lista {
    margin-bottom: 14px;
}

.mk-lehti__listarivi {
    flex-direction: row;
    align-items: flex-start;
    margin-bottom: 10px;
}

.mk-lehti__listakuva {
    width: 96px;
    margin-right: 10px;
    flex-shrink: 0;
}

.mk-lehti__listatekstit {
    flex-grow: 1;
    flex-shrink: 1;
}

.mk-lehti__listanimi {
    font-size: 15.5px;
    white-space: normal;
    color: #16130f;
}

.mk-lehti__listateksti {
    font-size: 14px;
    white-space: normal;
    color: rgba(58, 42, 26, 0.9);
}

/* --- maan perustiedot (web .maa-tunnusluvut, .maa-tunnus*, .maa-palkki, .maa-tervehdykset) -------
 * Almanakan rivi: ikoni, arvo, pisteviivajohdin ja sijoitus; kirjasinkoko 0,95rem = 15,2 px. */

.mk-maa__luvut {
    margin-top: 7.2px;
    padding: 0 8.8px 6.4px 8.8px;
    background-color: rgba(120, 96, 60, 0.05);
    color: #4a3c28;
    font-size: 15.2px;
}

/* Web border: 3px double → kaksi 1 px:n viivaa 1 px:n välein. */
.mk-maa__tuplaviiva {
    height: 3px;
    margin: 0 -8.8px 7.2px -8.8px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-color: rgba(70, 51, 31, 0.55);
}

.mk-maa__tuplaviiva--ala {
    margin: 7.2px -8.8px 0 -8.8px;
}

.mk-maa__otsake {
    width: 100%;
    margin-bottom: 2.4px;
    font-size: 10.56px;
    letter-spacing: 2.5px;
    color: rgba(70, 51, 31, 0.55);
}

.mk-maa__ruudukko {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
}

.mk-maa__tunnus {
    flex-direction: row;
    align-items: center;
    width: 100%;
    min-width: 0;
    padding: 1.6px 0;
    margin-bottom: 1.6px;
    font-size: 15.2px;
}

.mk-maa__ruudukko--kaksi > .mk-maa__tunnus {
    width: 48%;
}

.mk-maa__ikoni {
    flex-shrink: 0;
    width: 18.2px;
    height: 18.2px;
    margin-right: 6.8px;
    color: rgba(70, 51, 31, 0.85);
    --mk-ikoni-viiva: 1.5;
}

.mk-maa__arvo {
    flex-shrink: 0;
    min-width: 116px;
    margin-right: 6.8px;
}

.mk-maa__arvoteksti {
    font-size: 15.2px;
    white-space: nowrap;
    color: #4a3c28;
}

.mk-maa__alleviiva {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 3px;
}

.mk-maa__alleviiva > * {
    flex-grow: 1;
    font-size: 11px;
    color: rgba(74, 60, 40, 0.8);
}

.mk-maa__palkki {
    flex-shrink: 0;
    width: 55px;
    height: 10px;
    margin-right: 6.8px;
    border-width: 1px;
    border-color: rgba(70, 51, 31, 0.6);
    background-color: rgba(255, 252, 244, 0.5);
}

.mk-maa__johdin {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 9.6px;
    height: 7.6px;
    margin-top: 6px;
    margin-right: 6.8px;
    font-size: 15.2px;
    color: rgba(70, 51, 31, 0.5);
}

.mk-maa__sija {
    flex-shrink: 0;
    font-size: 12.2px;
    letter-spacing: 0.24px;
    white-space: nowrap;
    color: rgba(70, 51, 31, 0.62);
}

.mk-maa__tervehdykset {
    margin-bottom: 13.6px;
    padding: 6.4px 8.8px 0 8.8px;
    background-color: rgba(120, 96, 60, 0.05);
    border-top-width: 1px;
    border-top-color: rgba(70, 51, 31, 0.22);
    color: #4a3c28;
}

.mk-maa__tervehdysrivi {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
}

.mk-maa__tervehdys {
    flex-direction: row;
    align-items: center;
    margin: 2.4px 21.6px 2.4px 0;
}

.mk-maa__tervehdysteksti {
    font-size: 16.7px;
    color: #4a3c28;
}

.mk-maa__tervehdyslippu {
    height: 16px;
    margin-left: 5.3px;
    border-width: 1px;
    border-color: rgba(70, 51, 31, 0.45);
    border-radius: 1px;
    -unity-background-scale-mode: stretch-to-fill;
}

.mk-maa__osuus {
    margin-left: 5.3px;
    font-size: 11.9px;
}

/* Maan pääkirjoitus (web .dialog.lehti #arrival-maa-intro: 1,02rem, riviväli 1,62, #2d2010). */
.mk-maa__esittely .mk-lehti__esittely {
    font-size: 16.3px;
    color: #2d2010;
}

/* --- minitehtävä (webin .fokusvirta-visa lehdessä) --------------------------------- */

.mk-lehti__tehtava {
    margin-top: 20px;
    padding: 12px 15px 13px 15px;
    border-width: 3px;
    border-color: rgba(60, 44, 26, 0.6);
    background-color: rgba(214, 190, 140, 0.22);
}

.mk-lehti__tehtavaotsake {
    font-size: 10.5px;
    letter-spacing: 3px;
    color: rgba(70, 51, 31, 0.8);
    margin-bottom: 6px;
}

.mk-lehti__kysymys {
    font-size: 16.5px;
    white-space: normal;
    color: #211d18;
    margin-bottom: 4px;
}

.mk-lehti__tehtavavihje {
    font-size: 13px;
    -unity-font-style: italic;
    white-space: normal;
    color: rgba(33, 29, 24, 0.65);
    margin-bottom: 6px;
}

.mk-lehti__tehtavatulos {
    margin-top: 11px;
    padding: 8px 11px;
    border-left-width: 4px;
    border-left-color: rgba(60, 44, 26, 0.55);
    background-color: rgba(60, 44, 26, 0.07);
    font-size: 15px;
    white-space: normal;
    color: #211d18;
}

.mk-lehti__tehtavatulos.mk-oikein {
    border-left-color: rgba(74, 124, 58, 0.9);
    background-color: rgba(106, 158, 84, 0.2);
}

.mk-lehti__tehtavatulos.mk-vaarin {
    border-left-color: rgba(74, 124, 58, 0.85);
    background-color: rgba(106, 158, 84, 0.1);
}

/* Palkintojuliste tehtävälaatikon kyljessä (web .minitehtava-palkinnollinen, .juliste-palkinto). */
.mk-lehti__tehtavarunko {
    flex-direction: row;
    align-items: flex-start;
}

.mk-lehti__tehtavapalsta {
    flex-grow: 1;
    flex-shrink: 1;
}

.mk-lehti__julistepalkinto {
    width: 110px;
    flex-shrink: 0;
    margin: 2px 0 10px 12px;
    align-items: stretch;
}

.mk-lehti__julistekuva {
    height: 165px;
    border-width: 1px;
    border-color: rgba(60, 44, 26, 0.55);
    -unity-background-scale-mode: scale-to-fit;
    opacity: 0.5;
    -unity-background-image-tint-color: rgb(200, 190, 175);
    transition-property: opacity, -unity-background-image-tint-color;
    transition-duration: 0.26s;
}

.mk-lehti__julistepalkinto.mk-voitettu .mk-lehti__julistekuva {
    opacity: 1;
    border-color: rgba(60, 44, 26, 0.8);
    -unity-background-image-tint-color: rgb(255, 255, 255);
}

.mk-lehti__julistemerkki {
    margin-top: 5px;
    font-size: 9px;
    letter-spacing: 2.2px;
    -unity-text-align: upper-center;
    color: rgba(60, 44, 26, 0.72);
}

.mk-lehti__julistepalkinto.mk-voitettu .mk-lehti__julistemerkki {
    color: rgba(60, 44, 26, 0.95);
}

.mk-lehti__lunastus {
    min-height: 44px;
    margin-top: 8px;
    border-width: 1px;
    border-color: rgba(60, 44, 26, 0.65);
    border-radius: 4px;
    background-color: rgba(255, 253, 245, 0.9);
    color: #211d18;
}

.mk-lehti__lunastus .mk-nappi__teksti {
    font-size: 15.5px;
}

/* --- alapalkki ja sisällys ------------------------------------------------------------ */

.mk-lehti__alapalkki {
    flex-direction: column;
    flex-shrink: 0;
    padding: 8px 14px 14px 14px;
    border-top-width: 1px;
    border-top-color: rgba(70, 51, 31, 0.25);
}

/* Poistu vasemmalla, eteenpäin vievä oikealla (omistaja 8.8.2026). */
.mk-lehti__navi {
    flex-direction: row;
    align-items: stretch;
}

.mk-lehti__poistu {
    min-height: 40px;
    margin-right: auto;
    padding: 4px 12px;
    border-width: 1px;
    border-color: rgba(70, 51, 31, 0.3);
    border-radius: 3px;
    background-color: rgba(0, 0, 0, 0);
    color: rgba(70, 51, 31, 0.55);
}

.mk-lehti__poistu .mk-nappi__teksti {
    font-size: 13px;
}

.mk-lehti__selaus {
    flex-direction: column;
    flex-shrink: 1;
    min-height: 40px;
    margin-left: 8px;
    padding: 4px 12px;
    border-width: 1px;
    border-color: rgba(70, 51, 31, 0.45);
    border-radius: 3px;
    background-color: rgba(255, 252, 242, 0.5);
    color: #46331f;
}

.mk-lehti__selaus--seuraava {
    background-color: rgba(217, 161, 59, 0.22);
    border-color: rgba(122, 85, 20, 0.6);
}

.mk-lehti__selaus--sisallys {
    flex-direction: row;
    margin-left: 0;
    margin-right: auto;
    padding: 4px 11px;
}

.mk-lehti__selaus--sisallys > .mk-ikoni {
    width: 18px;
    height: 18px;
    margin-right: 0;
}

.mk-lehti__selaussuunta {
    font-size: 13px;
    -unity-text-align: middle-center;
}

.mk-lehti__selausaihe {
    max-width: 150px;
    font-size: 10.5px;
    opacity: 0.72;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    -unity-text-align: middle-center;
}

/* Tehtävänappi (web #arrival-yes, primary) täysleveänä rivinä alapalkin alla. */
.mk-lehti__tehtavanappi {
    min-height: 0;
    margin-top: 8px;
    padding: 7px 13px;
    border-width: 1px;
    border-color: rgba(122, 85, 20, 0.6);
    border-radius: 10px;
    color: #2a1a08;
}

.mk-lehti__tehtavanappi .mk-nappi__teksti {
    font-size: 14px;
}

.mk-lehti__tehtavanappi--pois {
    opacity: 0.55;
    -unity-background-image-tint-color: rgb(170, 170, 170);
}

/* "Maa-liite" kaupunkilehden viimeisellä sivulla (web .maa-liite-nappi). */
.mk-lehti__liite {
    min-height: 0;
    margin-top: 8px;
    padding: 7px 13px;
    border-width: 1px;
    border-color: rgba(70, 51, 31, 0.45);
    border-radius: 10px;
    background-color: rgba(255, 252, 242, 0.5);
    color: #46331f;
}

.mk-lehti__liite .mk-nappi__teksti {
    font-size: 13px;
}

/* Sisällyslevy (web .sisallys-levy, .sisallys-levy.ylhaalla, .sisallys, .sisallys-rivi; 1rem = 16 px). */
.mk-lehti__sisallys {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    max-height: 76%;
    padding: 12px 17.6px 16px 17.6px;
    overflow: hidden;
    background-color: rgba(247, 240, 224, 0.98);
    border-top-width: 1px;
    border-color: rgba(70, 51, 31, 0.35);
    border-top-left-radius: 11.2px;
    border-top-right-radius: 11.2px;
}

.mk-lehti__sisallys--ylhaalla {
    top: 0;
    bottom: auto;
    padding-top: 18.4px;
    border-top-width: 0;
    border-bottom-width: 1px;
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-left-radius: 11.2px;
    border-bottom-right-radius: 11.2px;
}

.mk-lehti__sisallysyla {
    flex-direction: row;
    flex-shrink: 0;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 6.4px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(70, 51, 31, 0.35);
}

.mk-lehti__sisallysotsikko {
    font-size: 13.76px;
    letter-spacing: 2.2px;
    color: #46331f;
}

.mk-lehti__sisallyssulje {
    min-width: 44px;
    min-height: 28px;
    margin: -8px -8px -8px 0;
    padding: 0 4.8px;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    color: rgba(70, 51, 31, 0.75);
    -unity-text-align: middle-right;
}

.mk-lehti__sisallyssulje .mk-nappi__teksti {
    font-size: 22.4px;
}

.mk-lehti__sisallysvieritys {
    flex-shrink: 1;
    margin-top: 9.6px;
}

.mk-lehti__sisallyslista {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
}

.mk-lehti__sisallysrivi {
    flex-direction: row;
    align-items: flex-start;
    justify-content: flex-start;
    width: 100%;
    min-height: 44px;
    margin-bottom: 8.8px;
    padding: 8px 8.8px;
    border-width: 1px;
    border-color: rgba(70, 51, 31, 0.22);
    border-radius: 6px;
    background-color: rgba(255, 252, 244, 0.55);
}

.mk-lehti__sisallyslista--kaksi > .mk-lehti__sisallysrivi {
    width: 48.5%;
}

.mk-lehti__sisallyskuva {
    flex-shrink: 0;
    width: 52px;
    height: 52px;
    margin-right: 9.6px;
    border-width: 1px;
    border-color: rgba(70, 51, 31, 0.28);
    background-color: rgba(70, 51, 31, 0.06);
    -unity-background-scale-mode: scale-and-crop;
}

.mk-lehti__sisallysteksti {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}

.mk-lehti__sisallysrivinimi {
    margin-bottom: 2.4px;
    font-size: 13.44px;
    letter-spacing: 0.54px;
    white-space: normal;
    color: #46331f;
}

.mk-lehti__sisallysingressi {
    font-size: 13.12px;
    white-space: normal;
    color: rgba(70, 51, 31, 0.78);
}

.mk-lehti__sisallyspaluurivi {
    flex-direction: row;
    flex-shrink: 0;
    justify-content: flex-end;
    margin-top: 8.8px;
    padding-top: 8.8px;
    border-top-width: 1px;
    border-top-color: rgba(70, 51, 31, 0.35);
}

/* Web .dialog button: vaalea pergamentti, ohut ruskea reuna, epäsäännöllinen pyöristys. */
.mk-lehti__sisallyspaluu {
    flex-direction: row;
    align-items: center;
    min-height: 46px;
    padding: 8px 14.4px;
    border-width: 1px;
    border-color: rgba(70, 51, 31, 0.55);
    border-top-left-radius: 14px;
    border-top-right-radius: 12px;
    border-bottom-right-radius: 12px;
    border-bottom-left-radius: 14px;
    background-color: rgba(255, 255, 255, 0.35);
    color: #46331f;
}

.mk-lehti__sisallyspaluu > .mk-ikoni {
    width: 16.8px;
    height: 16.8px;
    margin-right: 8px;
    --mk-ikoni-viiva: 1.6;
}

.mk-lehti__sisallyspaluu .mk-nappi__teksti {
    font-size: 16px;
}

.mk-suurennos {
    position: absolute;
}

/* --- nähtävyysarkki ja turistiopas (Nahtavyysarkki.cs; web .nahtavyys-arkki, .opas-*) ---- */

.mk-nahtavyys__peite {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(14, 9, 4, 0.34);
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.22s;
}

.mk-nahtavyys__peite.mk-auki {
    opacity: 1;
}

.mk-nahtavyys {
    flex-shrink: 1;
    max-height: 100%;
    padding: 19px 18px 16px 18px;
    border-width: 1px;
    border-color: rgba(70, 51, 31, 0.3);
    border-radius: 3px;
    background-color: #f5f0e2;
    color: rgba(58, 42, 26, 0.95);
}

.mk-nahtavyys__yla {
    flex-shrink: 0;
}

.mk-nahtavyys__aika {
    margin-bottom: 2px;
    font-size: 11.5px;
    letter-spacing: 2.5px;
    color: rgba(70, 51, 31, 0.72);
}

.mk-nahtavyys__otsikkorivi {
    flex-direction: row;
    align-items: center;
    margin-bottom: 11px;
}

.mk-nahtavyys__otsikko {
    flex-shrink: 1;
    font-size: 24px;
    white-space: normal;
    color: #3a2a1a;
}

.mk-nahtavyys__kaiutin {
    width: 40px;
    height: 40px;
    min-height: 40px;
    margin-left: 6px;
    padding: 0;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    color: rgba(70, 51, 31, 0.62);
    justify-content: center;
}

.mk-nahtavyys__kaiutin > .mk-ikoni {
    width: 22px;
    height: 22px;
    margin-right: 0;
}

.mk-nahtavyys__kaiutin.mk-valittu {
    color: #a8741a;
}

.mk-nahtavyys__vieritys {
    flex-shrink: 1;
}

.mk-nahtavyys__kappale {
    margin-bottom: 13px;
    font-size: 16px;
    white-space: normal;
}

.mk-nahtavyys__lainaus {
    margin: 17px 0 18px 0;
    padding: 2px 0 2px 14px;
    border-left-width: 3px;
    border-left-color: rgba(70, 51, 31, 0.4);
}

.mk-nahtavyys__lainausteksti {
    font-size: 17px;
    white-space: normal;
}

.mk-nahtavyys__lainauslahde {
    margin-top: 5px;
    font-size: 11.8px;
    white-space: normal;
    color: rgba(70, 51, 31, 0.72);
}

.mk-nahtavyys__kuvalohko {
    align-self: center;
    margin-bottom: 16px;
}

.mk-nahtavyys__kuvakehys {
    border-radius: 4px;
    overflow: hidden;
    background-color: rgba(70, 51, 31, 0.08);
}

.mk-nahtavyys__kuva {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    -unity-background-scale-mode: scale-and-crop;
}

.mk-nahtavyys__kuvateksti {
    margin-top: 5px;
}

.mk-nahtavyys__selite {
    font-size: 14px;
    white-space: normal;
}

.mk-nahtavyys__kuvalahde {
    margin-top: 2px;
    font-size: 10px;
    white-space: normal;
    color: rgba(70, 51, 31, 0.66);
}

.mk-nahtavyys__lahderivi {
    margin-top: 10px;
    font-size: 11.5px;
    letter-spacing: 0.8px;
    white-space: normal;
    color: rgba(70, 51, 31, 0.66);
}

.mk-nahtavyys__wiki {
    align-self: flex-start;
    min-height: 40px;
    margin-top: 10px;
    padding: 6px 14px;
    border-width: 1px;
    border-color: rgba(70, 51, 31, 0.45);
    border-radius: 3px;
    background-color: rgba(255, 252, 242, 0.5);
    color: #46331f;
}

.mk-nahtavyys__napit {
    flex-direction: row;
    justify-content: flex-end;
    flex-shrink: 0;
    padding-top: 10px;
}

.mk-nahtavyys__sulje {
    min-width: 120px;
}

/* Opas (web .opas-arkki): oma paletti, iso otsikko aksenttivärillä. */
.mk-nahtavyys--opas {
    background-color: #f8efdc;
    color: #3a2a15;
    padding-top: 10px;
}

.mk-nahtavyys--opas .mk-nahtavyys__otsikko {
    font-size: 36px;
    letter-spacing: -0.3px;
    color: #a53a22;
}

.mk-nahtavyys--opas.mk-nahtavyys--levea .mk-nahtavyys__otsikko {
    font-size: 44px;
}

.mk-nahtavyys--opas .mk-nahtavyys__kaiutin > .mk-ikoni {
    width: 24px;
    height: 24px;
}

.mk-nahtavyys--opas .mk-nahtavyys__lahderivi,
.mk-nahtavyys--opas .mk-nahtavyys__aika {
    color: #6d5942;
}

.mk-opas__ingressi {
    margin-bottom: 18px;
    padding-bottom: 14px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(165, 58, 34, 0.3);
    font-size: 19.8px;
    white-space: normal;
    color: #3a2a15;
}

.mk-opas__jakso {
    margin-bottom: 22px;
}

.mk-opas__valiotsikko {
    margin-bottom: 8px;
    padding-bottom: 4px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(165, 58, 34, 0.3);
    font-size: 12px;
    letter-spacing: 2.6px;
    color: #a53a22;
}

.mk-opas__rinnakkain {
    flex-direction: row;
    align-items: flex-start;
}

.mk-opas__pino {
    flex-direction: column;
}

.mk-opas__palsta {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
}

.mk-opas__sivupalsta {
    width: 256px;
    flex-shrink: 0;
    margin-left: 20px;
}

.mk-opas__sivupalsta--kuva {
    width: 40%;
}

.mk-opas__kainalo {
    margin: 3px 0 14px 0;
    border-width: 1px;
    border-color: rgba(58, 42, 21, 0.22);
    border-radius: 3px;
    overflow: hidden;
}

.mk-opas__vyo {
    padding: 9px 11px 10px 11px;
}

.mk-opas__vyo--lammin {
    background-color: #f6ddc8;
}

.mk-opas__vyo--viilea {
    background-color: #e0eae7;
}

.mk-opas__vyootsikko {
    margin-bottom: 5px;
    font-size: 11px;
    letter-spacing: 2px;
    color: #6d5942;
}

.mk-opas__vyorivi {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    min-height: 0;
    padding: 5px 0;
    border-width: 0;
    border-top-width: 1px;
    border-top-color: rgba(58, 42, 21, 0.13);
    border-radius: 0;
    background-color: rgba(0, 0, 0, 0);
}

.mk-opas__vyorivi--eka {
    border-top-width: 0;
}

.mk-opas__vyonimi {
    flex-shrink: 1;
    font-size: 12.8px;
    white-space: normal;
    color: #3a2a15;
}

.mk-opas__vyonappi .mk-opas__vyonimi {
    border-bottom-width: 1px;
    border-bottom-color: rgba(58, 42, 21, 0.3);
}

.mk-opas__vyonappi.mk-auki .mk-opas__vyonimi {
    color: #a53a22;
}

.mk-opas__tahdet {
    flex-shrink: 0;
    margin-left: 8px;
    font-size: 12.8px;
    color: #7f570b;
}

.mk-opas__nosto {
    margin: 24px 0;
    padding: 14px 10px;
    border-top-width: 3px;
    border-bottom-width: 3px;
    border-color: #a53a22;
}

.mk-opas__nostoteksti {
    font-size: 21px;
    white-space: normal;
    -unity-text-align: middle-center;
    color: #a53a22;
}

.mk-opas__laatikko {
    margin: 21px 0;
    padding: 14px 16px 15px 16px;
    border-width: 1px;
    border-left-width: 5px;
    border-color: rgba(58, 42, 21, 0.18);
    border-left-color: #a53a22;
    border-radius: 3px;
    background-color: #f2e5c8;
}

.mk-opas__laatikkootsikko {
    margin-bottom: 9px;
    font-size: 12.8px;
    letter-spacing: 2.6px;
    color: #a53a22;
}

.mk-opas__saagraafi {
    width: 240px;
    flex-shrink: 0;
    margin-left: 16px;
}

.mk-opas__pino > .mk-opas__saagraafi {
    width: 100%;
    max-width: 320px;
    align-self: center;
    margin: 0 0 13px 0;
}

.mk-opas__parasaika {
    margin-bottom: 10px;
    font-size: 16px;
    white-space: normal;
    color: #3a2a15;
}

.mk-opas__kausi {
    flex-direction: row;
    margin-bottom: 6px;
}

.mk-opas__kausi--pino {
    flex-direction: column;
}

.mk-opas__kausinimi {
    width: 120px;
    flex-shrink: 0;
    margin-right: 14px;
}

.mk-opas__kausi--pino .mk-opas__kausinimi {
    width: auto;
    margin-right: 0;
}

.mk-opas__kausisana {
    font-size: 13px;
    color: #3a2a15;
}

.mk-opas__kausikk {
    font-size: 11.5px;
    opacity: 0.7;
    color: #3a2a15;
}

.mk-opas__kausitiedot {
    flex-grow: 1;
    flex-shrink: 1;
}

.mk-opas__kausilampo {
    font-size: 13.8px;
    color: #1d5a5e;
}

.mk-opas__kausikuvaus {
    font-size: 15px;
    white-space: normal;
    color: #3a2a15;
}

.mk-opas__suunnittele {
    border-left-color: #1d5a5e;
}

.mk-opas__suunnittele .mk-opas__laatikkootsikko {
    color: #1d5a5e;
}

.mk-opas__linkki {
    align-self: flex-start;
    min-height: 0;
    margin-bottom: 6px;
    padding: 2px 0;
    border-width: 0;
    border-bottom-width: 1px;
    border-bottom-color: #1d5a5e;
    border-radius: 0;
    background-color: rgba(0, 0, 0, 0);
    color: #1d5a5e;
}

.mk-opas__linkki .mk-nappi__teksti {
    font-size: 14.4px;
}

/* Matkailijalle-lohkon sisäänkäynnit oppaaseen (web .opas-nauha-kotelo, .opas-lue-lisaa). */
.mk-lehti__opaskotelo {
    position: absolute;
    top: 0;
    right: 0;
    width: 173px;
    height: 173px;
    overflow: hidden;
}

.mk-lehti__opasnauha {
    position: absolute;
    top: 46px;
    right: -115px;
    width: 352px;
    min-height: 0;
    padding: 8px 0;
    border-width: 0;
    border-radius: 0;
    background-color: #b3775f;
    color: #f2e4d0;
    rotate: 45deg;
}

.mk-lehti__opasnauha .mk-nappi__teksti {
    font-size: 11.2px;
    letter-spacing: 1.8px;
    -unity-text-align: middle-center;
}

.mk-lehti__opaslinkki {
    align-self: flex-start;
    min-height: 0;
    margin-top: 2px;
    padding: 0;
    border-width: 0;
    border-bottom-width: 1px;
    border-bottom-color: #1c6f6b;
    border-radius: 0;
    background-color: rgba(0, 0, 0, 0);
    color: #1c6f6b;
}

.mk-lehti__opaslinkki .mk-nappi__teksti {
    font-size: 15px;
}

/* --- Maa numeroina (MaaNumeroina.cs): webin .maakayrat, .maakayra-*, .pyramidi-* ja
 * .numeroina-ingressi (css/styles.css). Muste + kulta kuten säägraafissa. ------------------ */

/* Otsikko kuten muiden aihesivujen (web h3.aihe-nimi, natiivissa .mk-lehti__aihe). */
.mk-numerot__otsikko {
    margin: 4px 0 12px 0;
    padding: 6px 0;
    border-top-width: 3px;
    border-bottom-width: 1px;
    border-top-color: rgba(70, 51, 31, 0.75);
    border-bottom-color: rgba(70, 51, 31, 0.45);
}

.mk-numerot__otsikkoteksti {
    font-size: 21px;
    letter-spacing: 1.2px;
    color: #16130f;
    -unity-text-align: middle-center;
    white-space: normal;
}

/* Yleisluonnehdinta isolla ennen käyriä (web 1.18rem). */
.mk-numerot__ingressi {
    font-size: 19px;
    white-space: normal;
    margin: 3px 0 6px 0;
    color: #211d18;
}

.mk-numerot__johdanto,
.mk-numerot__tila {
    font-size: 16px;
    white-space: normal;
    margin: 0 0 14px 0;
    color: rgba(70, 51, 31, 0.9);
}

.mk-numerot__ristikko {
    margin: 5px 0 6px 0;
}

.mk-numerot__lohko-otsikko {
    margin: 0 0 5px 0;
    font-size: 12.5px;
    white-space: normal;
    color: #211d18;
}

.mk-numerot__kuvio {
    width: 100%;
    flex-shrink: 0;
    background-color: rgba(255, 250, 238, 0.65);
    border-width: 1px;
    border-color: rgba(70, 51, 31, 0.35);
    border-radius: 6px;
    overflow: hidden;
}

/* Akselitekstit: koko asetetaan koodista viewBoxin skaalan mukaan (8,5 / 7,5 yksikköä). */
.mk-numerot__akseli {
    position: absolute;
    margin: 0;
    padding: 0;
    white-space: nowrap;
    color: rgba(70, 51, 31, 0.8);
}

.mk-numerot__ennusteteksti {
    color: rgba(164, 105, 28, 0.75);
}

.mk-numerot__silloinvuosi {
    color: rgba(138, 97, 20, 0.9);
}

.mk-numerot__ika {
    color: rgba(70, 51, 31, 0.65);
}

/* Tulkintalause käyrän alla: ingressin ääni pienempänä. */
.mk-numerot__tulkinta {
    margin: 5px 0 0 0;
    font-size: 14px;
    white-space: normal;
    color: rgba(33, 29, 24, 0.88);
}

/* "Silloin ja nyt" — isoisän päiväkirjan ääni käyrän alla. */
.mk-numerot__silloin {
    margin: 4px 0 0 0;
    font-size: 13px;
    white-space: normal;
    color: rgba(138, 97, 20, 0.95);
}

.mk-numerot__vdem {
    margin: 4px 0 0 0;
    font-size: 14px;
    white-space: normal;
    color: rgba(33, 29, 24, 0.88);
}

.mk-numerot__lahde {
    margin: 11px 0 8px 0;
    font-size: 11.5px;
    white-space: normal;
    color: rgba(70, 51, 31, 0.68);
}

/* --- Fokustehtävät (web css/fokusvirta.css .fokus-tehtava, .fokus-pulla; LehtiFokus.cs) ----- */

/* Nimilaatta ("AARTEEN AVAUS" / "JULISTE") ja vihjerivi keskitettynä yhtenä paalina. */
.mk-fokus__otsake {
    -unity-text-align: upper-center;
}

.mk-fokus__vihje {
    margin: -2px 0 9px 0;
    font-size: 13px;
    white-space: normal;
    -unity-text-align: upper-center;
    color: rgba(60, 44, 26, 0.72);
}

.mk-fokus__vaihtoehdot {
    margin-top: 4px;
}

/* Pullatarjous on laatikon jälkikirjoitus: katkoviiva erottaa sen vastaamisesta. */
.mk-fokus__pulla {
    margin-top: 13px;
    padding-top: 10px;
    border-top-width: 1px;
    border-top-color: rgba(60, 44, 26, 0.38);
}

.mk-fokus__pullanappi {
    min-height: 44px;
    padding: 8px 17px;
    border-width: 1px;
    border-color: rgba(60, 44, 26, 0.6);
    border-radius: 4px;
    background-color: rgba(255, 253, 245, 0.72);
    color: #211d18;
}

.mk-fokus__pullanappi .mk-nappi__teksti {
    font-size: 15px;
    white-space: normal;
    -unity-text-align: middle-center;
}

.mk-fokus__pullanappi:hover {
    background-color: #fffdf5;
    border-color: rgba(60, 44, 26, 0.85);
}

/* Varmistus on eri nappi kuin tarjous: umpireuna ja lämmin kulta. */
.mk-fokus__pullanappi--varmistus,
.mk-fokus__pullanappi--varmistus:hover {
    border-color: rgba(122, 85, 20, 0.75);
    background-color: #e6b650;
    color: #2c1e07;
}

.mk-fokus__pullanappi--varmistus .mk-nappi__teksti {
    -unity-font-style: bold;
}

/* Tyhjä kassa: nappi näkyy mutta ei ota napautusta vastaan. */
.mk-fokus__pullanappi--koyha,
.mk-fokus__pullanappi--koyha:hover {
    border-color: rgba(60, 44, 26, 0.35);
    background-color: rgba(0, 0, 0, 0);
    color: rgba(33, 29, 24, 0.55);
}

.mk-fokus__pullahuomio,
.mk-fokus__pullatehty {
    margin-top: 7px;
    font-size: 13px;
    white-space: normal;
    -unity-text-align: upper-center;
    color: rgba(60, 44, 26, 0.72);
}

.mk-fokus__pullatehty {
    margin-top: 0;
}

/* Nähtävyysarkin ☰-valikko ja ‹ › -nuolet (web .nahtavyys-valikko-nappi, .nahtavyys-nuoli). */
.mk-nahtavyys__valikkonappi {
    position: absolute;
    top: 9px;
    right: 10px;
    width: 34px;
    height: 34px;
    min-height: 34px;
    padding: 0;
    border-width: 1px;
    border-color: rgba(70, 51, 31, 0.35);
    border-radius: 6px;
    background-color: rgba(246, 231, 198, 0.9);
    color: #46331f;
    justify-content: center;
}

.mk-nahtavyys__valikkonappi > .mk-ikoni {
    width: 17px;
    height: 17px;
    margin-right: 0;
}

.mk-nahtavyys__valikko {
    position: absolute;
    top: 46px;
    right: 10px;
    width: 300px;
    max-width: 80%;
    max-height: 60%;
    padding: 4px 0;
    border-width: 1px;
    border-color: rgba(70, 51, 31, 0.3);
    border-radius: 8px;
    background-color: #f5f0e2;
}

.mk-nahtavyys__valikkovieritys {
    flex-shrink: 1;
}

.mk-nahtavyys__valikkorivi {
    flex-direction: row;
    justify-content: flex-start;
    align-items: center;
    min-height: 0;
    padding: 7px 10px;
    border-width: 0;
    border-radius: 0;
    background-color: rgba(0, 0, 0, 0);
    color: #3a2a1a;
}

.mk-nahtavyys__valikkorivi.mk-valittu {
    background-color: rgba(70, 51, 31, 0.12);
}

.mk-nahtavyys__valikkonumero {
    width: 22px;
    height: 22px;
    margin-right: 8px;
    border-width: 1.5px;
    border-color: #2c2318;
    border-radius: 11px;
    background-color: #f3e2b8;
    font-size: 11px;
    -unity-text-align: middle-center;
    color: #2c2318;
}

.mk-nahtavyys__valikkonimi {
    flex-shrink: 1;
    font-size: 14.7px;
    white-space: normal;
}

.mk-nahtavyys__nuoli {
    position: absolute;
    top: 50%;
    width: 32px;
    height: 32px;
    min-height: 32px;
    margin-top: -16px;
    padding: 0;
    border-width: 1px;
    border-color: rgba(70, 51, 31, 0.35);
    border-radius: 16px;
    background-color: rgba(246, 231, 198, 0.9);
    color: #46331f;
}

.mk-nahtavyys__nuoli .mk-nappi__teksti {
    font-size: 18px;
    -unity-text-align: middle-center;
}

.mk-nahtavyys__nuoli--vasen {
    left: 4px;
}

.mk-nahtavyys__nuoli--oikea {
    right: 4px;
}

/* Listaryhmän otsikko ja sen pieni reaktionappi samalla rivillä (web h4.vinkki-ryhma + .reaktiot-otsikko). */
.mk-lehti__osastorivi {
    flex-direction: row;
    align-items: center;
}

/* Maston liitelinkki ja sää-rivi (web .maa-linkki, button.lehti-saa). */
.mk-lehti__maalinkki {
    min-height: 0;
    margin-left: 8px;
    padding: 1.6px 0;
    border-width: 0 0 1px 0;
    border-radius: 0;
    background-color: rgba(0, 0, 0, 0);
    border-color: rgba(70, 51, 31, 0.45);
    color: rgba(70, 51, 31, 0.85);
}

.mk-lehti__maalinkki .mk-nappi__teksti {
    font-size: 11.2px;
    letter-spacing: 1.6px;
    color: rgba(70, 51, 31, 0.85);
}

.mk-lehti__saa {
    flex-direction: row;
    align-items: center;
    align-self: center;
    min-height: 26px;
    margin: -7.2px 0 11.2px 0;
    padding: 2.4px 4.8px;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    color: #46331f;
}

.mk-lehti__saa > .mk-ikoni {
    width: 18px;
    height: 18px;
    margin-right: 6px;
}

.mk-lehti__saateksti {
    font-size: 12.5px;
    letter-spacing: 0.5px;
    white-space: normal;
    color: rgba(70, 51, 31, 0.9);
}

.mk-lehti__saavihje {
    margin-left: 6.4px;
    font-size: 10.9px;
    letter-spacing: 1.1px;
    color: rgba(122, 85, 20, 0.95);
}

/* Maan uutiset (web .arrival-uutiset, .uutinen-rivi, .uutinen-kortti). */
.mk-uutiset {
    margin-top: 14px;
    padding-top: 8px;
    border-top-width: 1px;
    border-color: rgba(70, 51, 31, 0.3);
}

.mk-uutiset__nimio {
    margin-bottom: 6px;
    font-size: 11.5px;
    letter-spacing: 1px;
    color: rgba(70, 51, 31, 0.75);
}

.mk-uutiset__rivi {
    flex-direction: row;
    align-items: flex-start;
    margin-bottom: 8px;
    padding: 4px 0;
    background-color: rgba(0, 0, 0, 0);
    color: #211d18;
}

.mk-uutiset__pikkukuva {
    width: 64px;
    height: 48px;
    margin-right: 8px;
    flex-shrink: 0;
    border-radius: 4px;
    -unity-background-scale-mode: scale-and-crop;
}

.mk-uutiset__tekstit {
    flex-grow: 1;
    flex-shrink: 1;
}

.mk-uutiset__otsikko {
    font-size: 14px;
    white-space: normal;
}

.mk-uutiset__suomeksi {
    margin-top: 2px;
    font-size: 12.5px;
    -unity-font-style: italic;
    color: rgba(70, 51, 31, 0.75);
    white-space: normal;
}

.mk-uutinen__ylarivi {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 4px;
}

.mk-uutinen__paivays {
    font-size: 12px;
    color: rgba(70, 51, 31, 0.7);
}

.mk-uutinen__kaanna {
    min-height: 28px;
    padding: 2px 10px;
    border-width: 1px;
    border-color: rgba(122, 85, 20, 0.5);
    border-radius: 14px;
    background-color: rgba(255, 250, 238, 0.7);
    color: #7a5514;
}

.mk-uutinen__masto {
    font-size: 12px;
    letter-spacing: 1.5px;
    color: #7a5514;
}

.mk-uutinen__otsikko {
    margin: 4px 0 8px 0;
    font-size: 17px;
    white-space: normal;
}

.mk-uutinen__kuva {
    height: 180px;
    margin-bottom: 8px;
    -unity-background-scale-mode: scale-and-crop;
}

.mk-uutinen__kappale {
    margin-bottom: 8px;
    font-size: 14px;
    white-space: normal;
}

/* Mediarivi (web .maa-media, .kulttuuri-kuuntele, .aani-puoli, .vanha-kuuntele, .aani-lahde):
   maan radio, kielinäyte ja vanha tallenne. Pari rinnakkain, kapealla ruudulla allekkain (web ≤ 520 px). */
.mk-lehti__media {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: flex-start;
    margin: 10px 0 4px 0;
}

.mk-lehti__aanipuoli {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 220px;
    min-width: 0;
    margin: 0 9px 8px 0;
}

.mk-lehti__aanirooli {
    margin-bottom: 3px;
    font-size: 10.5px;
    letter-spacing: 2px;
    color: rgba(70, 51, 31, 0.8);
}

.mk-lehti__kuuntele {
    flex-direction: row;
    align-items: center;
    align-self: flex-start;
    max-width: 100%;
    min-height: 34px;
    margin: 0;
    padding: 5px 11px;
    border-width: 1px;
    border-color: rgba(70, 51, 31, 0.45);
    border-radius: 8px;
    background-color: rgba(255, 250, 238, 0.9);
    color: #46331f;
}

.mk-lehti__aanipuoli .mk-lehti__kuuntele {
    align-self: stretch;
}

.mk-lehti__kuuntele--soi {
    background-color: rgba(234, 184, 78, 0.28);
}

.mk-lehti__kuuntele--vanha {
    background-color: rgba(244, 233, 210, 0.75);
    border-color: rgba(70, 51, 31, 0.35);
}

.mk-lehti__kuuntele--vanha.mk-lehti__kuuntele--soi {
    background-color: rgba(234, 184, 78, 0.28);
}

.mk-lehti__kuuntele-merkki {
    flex-shrink: 0;
    width: 15px;
    height: 15px;
    margin-right: 6px;
    --mk-ikoni-viiva: 1.7;
    color: #46331f;
}

.mk-lehti__kuuntele-nimi {
    flex-shrink: 1;
    min-width: 0;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    font-size: 12.5px;
    color: #46331f;
}

.mk-lehti__kuuntele-vuosi,
.mk-lehti__kuuntele-aika {
    flex-shrink: 0;
    margin-left: 6px;
    font-size: 11.5px;
    color: rgba(70, 51, 31, 0.75);
}

.mk-lehti__live {
    flex-direction: row;
    flex-shrink: 0;
    align-items: center;
    margin-left: 6px;
}

.mk-lehti__live-piste {
    width: 7px;
    height: 7px;
    margin-right: 4px;
    border-radius: 4px;
    background-color: #c4321f;
}

.mk-lehti__live-teksti {
    font-size: 9.5px;
    letter-spacing: 1.5px;
    color: #a3281c;
}

.mk-lehti__kuuntele-lahde {
    margin-top: 3px;
    font-size: 10px;
    white-space: normal;
    color: rgba(90, 74, 51, 0.8);
}

/* Noston kuuntelu- ja musiikkinapit (web .kulttuuri-kuuntele, .kulttuuri-musiikkilinkki) otsikon alla. */
.mk-lehti__nostomedia {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    margin: 2px 0 8px 0;
}

.mk-lehti__nostomedia > .mk-lehti__kuuntele {
    margin: 0 8px 6px 0;
}

.mk-lehti__musiikkilinkki {
    flex-direction: row;
    align-items: center;
    min-height: 32px;
    margin: 0 10px 6px 0;
    padding: 0;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    color: #7a5514;
}

.mk-lehti__musiikkilinkki > .mk-ikoni {
    width: 13px;
    height: 13px;
    margin-right: 4px;
    color: #7a5514;
}

.mk-lehti__musiikkilinkki .mk-nappi__teksti {
    font-size: 12.5px;
    color: #7a5514;
}

/* ── TYÖHUONE KEHITTÄJÄN LIITTEINÄ (Tyohuone.cs; web .kehittajalehti-rivi, .raamattu-kentta, .tuore-chip,
   .poimintavienti-*, .periaate-teksti/-huomio). Vain kehittäjätilassa. */
.mk-tyohuone__periaate {
    font-size: 15px;
    white-space: normal;
    margin-bottom: 8px;
    color: rgba(58, 42, 26, 0.95);
}

.mk-tyohuone__huomio {
    font-size: 12.5px;
    white-space: normal;
    margin-top: 8px;
    color: #6d5a3c;
}

.mk-tyohuone__rivit {
    margin-top: 4px;
}

.mk-tyohuone__rivi {
    flex-direction: row;
    align-items: flex-start;
    justify-content: flex-start;
    min-height: 0;
    margin-top: 6px;
    padding: 8px 10px;
    border-width: 1px;
    border-radius: 10px;
    border-color: rgba(198, 158, 82, 0.45);
    background-color: rgba(255, 252, 244, 0.5);
    color: rgba(58, 42, 26, 0.95);
}

.mk-tyohuone__rivi > .mk-ikoni {
    width: 18px;
    height: 18px;
    margin: 2px 9px 0 0;
    color: #7a5514;
}

.mk-tyohuone__riviteksti {
    flex-shrink: 1;
    flex-grow: 1;
}

.mk-tyohuone__rivinimi {
    font-size: 15.5px;
    color: rgba(58, 42, 26, 0.95);
}

.mk-tyohuone__riviselite {
    margin-top: 2px;
    font-size: 12px;
    white-space: normal;
    color: rgba(70, 51, 31, 0.7);
}

.mk-tyohuone__tagi {
    align-self: flex-start;
    margin: -4px 0 10px 0;
    padding: 2px 9px;
    border-radius: 10px;
    font-size: 11px;
    letter-spacing: 1px;
}

.mk-tyohuone__tagi--valmis {
    background-color: #e2efdc;
    color: #2c5e2a;
}

.mk-tyohuone__tagi--kesken {
    background-color: #f7ecd2;
    color: #7a5a12;
}

/* Raamatun kenttä näyttää lepotilassa leipätekstiltä; kohdistettu saa hennon kehyksen (web raamattu-kentta). */
.mk-tyohuone__kentta {
    margin: 0 0 6px 0;
}

.mk-tyohuone__kentta > .unity-base-text-field__input {
    padding: 4px 6px;
    border-width: 1px;
    border-radius: 6px;
    border-color: rgba(0, 0, 0, 0);
    background-color: rgba(0, 0, 0, 0);
    font-size: 15.5px;
    white-space: normal;
    -unity-text-align: upper-left;
    color: rgba(58, 42, 26, 0.95);
}

.mk-tyohuone__kentta:focus > .unity-base-text-field__input {
    border-color: rgba(198, 158, 82, 0.6);
    background-color: rgba(255, 252, 240, 0.7);
}

.mk-tyohuone__lahetys,
.mk-tyohuone__napit {
    align-items: flex-start;
    margin-top: 14px;
}

.mk-tyohuone__napit {
    flex-direction: row;
}

.mk-tyohuone__nappi {
    min-height: 36px;
    margin: 0 8px 6px 0;
    padding: 0 14px;
    border-width: 1px;
    border-radius: 8px;
    border-color: rgba(122, 85, 20, 0.55);
    background-color: rgba(255, 252, 240, 0.7);
    color: #7a5514;
}

.mk-tyohuone__nappi .mk-nappi__teksti {
    font-size: 13.5px;
    color: #7a5514;
}

.mk-tyohuone__tulos {
    font-size: 12.5px;
    white-space: normal;
    color: rgba(70, 51, 31, 0.7);
}

.mk-tyohuone__tuoreet {
    margin-bottom: 14px;
}

.mk-tyohuone__tuoreetrivi {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    margin-bottom: 6px;
}

.mk-tyohuone__tuoreetotsikko {
    margin-right: 6px;
    font-size: 11px;
    letter-spacing: 0.6px;
    color: rgba(70, 51, 31, 0.7);
}

.mk-tyohuone__chip {
    margin: 2px 5px 2px 0;
    padding: 2px 9px;
    border-radius: 11px;
    font-size: 13px;
}

.mk-tyohuone__chip--valmis {
    background-color: #e2efdc;
    color: #2c5e2a;
}

.mk-tyohuone__chip--tyossa {
    background-color: #f7ecd2;
    color: #7a5a12;
}

.mk-tyohuone__vientiavain {
    margin: 11px 0 3px 0;
    font-size: 11.5px;
    letter-spacing: 0.6px;
    color: rgba(58, 42, 26, 0.95);
}

.mk-tyohuone__vientipari {
    margin-bottom: 2px;
    font-size: 13.5px;
    white-space: normal;
    color: rgba(58, 42, 26, 0.95);
}

.mk-tyohuone__lohko {
    margin-top: 12px;
    padding: 9px;
    border-width: 1px;
    border-radius: 6px;
    border-color: rgba(70, 51, 31, 0.25);
    background-color: rgba(255, 252, 244, 0.7);
    font-size: 11.5px;
    white-space: normal;
    color: rgba(58, 42, 26, 0.95);
}

/* Musiikkisivu (web .mus-rivi, .mus-tila, .mus-polku, .mus-sfx). */
.mk-tyohuone__raita {
    margin-bottom: 14px;
    padding-bottom: 10px;
    border-bottom-width: 1px;
    border-color: rgba(70, 51, 31, 0.15);
}

.mk-tyohuone__raitanimi {
    flex-direction: row;
    align-items: center;
    margin-bottom: 3px;
}

.mk-tyohuone__raitatila {
    margin-left: 8px;
    font-size: 11.5px;
    color: rgba(70, 51, 31, 0.6);
}

.mk-tyohuone__raitatila--olemassa {
    color: #2c5e2a;
}

.mk-tyohuone__raitatila--puuttuu {
    color: #8a2c1c;
}

.mk-tyohuone__polku {
    font-size: 10.5px;
    white-space: normal;
    color: rgba(70, 51, 31, 0.6);
}

.mk-tyohuone__sfx {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 6px;
}

/* Pikataulu (web .tk-vieri, .tk-taulu): rivit sarakkeina, vaakavieritys kapealla ruudulla. */
.mk-tyohuone__taulu {
    margin: 6px 0 12px 0;
}

.mk-tyohuone__taulurunko {
    min-width: 560px;
    border-top-width: 1px;
    border-color: rgba(70, 51, 31, 0.25);
}

.mk-tyohuone__taulurivi {
    flex-direction: row;
    border-bottom-width: 1px;
    border-color: rgba(70, 51, 31, 0.15);
}

.mk-tyohuone__taulurivi--otsikko {
    background-color: rgba(122, 85, 20, 0.08);
}

.mk-tyohuone__solu {
    padding: 5px 7px;
    font-size: 13px;
    white-space: normal;
    color: rgba(58, 42, 26, 0.95);
}

.mk-tyohuone__solu--nimi {
    width: 170px;
    flex-shrink: 0;
}

.mk-tyohuone__solu--toinen {
    width: 150px;
    flex-shrink: 0;
}

.mk-tyohuone__solu--muu {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    min-width: 200px;
}

.mk-tyohuone__taulurivi--otsikko > .mk-tyohuone__solu {
    font-size: 11.5px;
    letter-spacing: 0.4px;
}

/* ── TILASTOT (Tilastot.cs; web .tk-taulu, .tk-nimi, .tk-num, .tk-valmis/-kesken/-puuttuu, .tk-kiintio). */
.mk-tilastot__ohjaus {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    margin-bottom: 10px;
}

.mk-tilastot__ohjausnimi {
    margin: 0 6px 0 0;
    font-size: 11px;
    letter-spacing: 0.6px;
    color: rgba(70, 51, 31, 0.7);
}

.mk-tilastot__vipu {
    flex-direction: row;
    margin-right: 14px;
}

.mk-tilastot__vipunappi {
    min-height: 30px;
    margin: 2px 4px 2px 0;
    padding: 0 10px;
    border-width: 1px;
    border-radius: 15px;
    border-color: rgba(122, 85, 20, 0.4);
    background-color: rgba(255, 252, 240, 0.6);
}

.mk-tilastot__vipunappi .mk-nappi__teksti {
    font-size: 12px;
    color: rgba(70, 51, 31, 0.8);
}

.mk-tilastot__vipunappi.mk-valittu {
    border-color: rgba(176, 138, 60, 0.95);
    background-color: rgba(217, 161, 59, 0.25);
}

.mk-tilastot__vieri {
    margin-bottom: 10px;
}

.mk-tilastot__taulu {
    border-top-width: 1px;
    border-color: rgba(70, 51, 31, 0.2);
}

.mk-tilastot__rivi {
    flex-direction: row;
    align-items: stretch;
    justify-content: flex-start;
    min-height: 0;
    margin: 0;
    padding: 0;
    border-width: 0;
    border-bottom-width: 1px;
    border-radius: 0;
    border-color: rgba(70, 51, 31, 0.12);
    background-color: rgba(0, 0, 0, 0);
}

.mk-tilastot__rivi--otsikko {
    background-color: #f0e6cd;
}

.mk-tilastot__rivi--manner {
    background-color: rgba(217, 161, 59, 0.1);
}

.mk-tilastot__rivi--maa {
    background-color: rgba(217, 161, 59, 0.04);
}

.mk-tilastot__nimi {
    flex-shrink: 0;
    width: 200px;
    padding: 5px 7px;
    font-size: 12px;
    color: rgba(58, 42, 26, 0.95);
}

.mk-tilastot__nimi--maa {
    padding-left: 18px;
}

.mk-tilastot__nimi--kaupunki {
    padding-left: 34px;
}

.mk-tilastot__nimi--tuore-valmis {
    background-color: #e2efdc;
}

.mk-tilastot__nimi--tuore-tyossa {
    background-color: #f7ecd2;
}

.mk-tilastot__nimirivi {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
}

.mk-tilastot__nuoli {
    margin-right: 4px;
    font-size: 11px;
    color: rgba(70, 51, 31, 0.6);
}

.mk-auki .mk-tilastot__nuoli {
    rotate: 90deg;
}

.mk-tilastot__nimiteksti {
    flex-shrink: 1;
    font-size: 13px;
    white-space: normal;
    color: rgba(58, 42, 26, 0.95);
}

.mk-tilastot__osuus {
    margin-left: 6px;
    font-size: 10.5px;
    color: rgba(70, 51, 31, 0.7);
}

.mk-tilastot__lisa {
    margin-top: 2px;
    font-size: 10px;
    white-space: normal;
    color: rgba(70, 51, 31, 0.62);
}

.mk-tilastot__palkki {
    height: 3px;
    margin-top: 3px;
    border-radius: 2px;
    background-color: rgba(70, 51, 31, 0.14);
    overflow: hidden;
}

.mk-tilastot__palkkitayte {
    height: 100%;
    background-color: #8fb886;
}

.mk-tilastot__tuoremerkki {
    margin-left: 5px;
    padding: 1px 6px;
    border-radius: 8px;
    font-size: 9.5px;
    background-color: rgba(255, 255, 255, 0.65);
}

.mk-tilastot__kaikki {
    min-height: 22px;
    margin-left: 6px;
    padding: 0 6px;
    border-width: 1px;
    border-radius: 11px;
    border-color: rgba(122, 85, 20, 0.35);
    background-color: rgba(255, 252, 240, 0.6);
}

.mk-tilastot__kaikki .mk-nappi__teksti {
    font-size: 10px;
    color: #7a5514;
}

.mk-tilastot__num {
    flex-shrink: 0;
    width: 58px;
    padding: 5px 3px;
    font-size: 11px;
    -unity-text-align: middle-center;
    color: rgba(58, 42, 26, 0.9);
}

.mk-tilastot__num--valmis {
    background-color: #e2efdc;
    color: #2c5e2a;
}

.mk-tilastot__num--kesken {
    background-color: #f7ecd2;
    color: #7a5a12;
}

.mk-tilastot__num--puuttuu {
    color: rgba(70, 51, 31, 0.45);
}

.mk-tilastot__num--tyhja {
    color: rgba(70, 51, 31, 0.28);
}

.mk-tilastot__taulu--luvut .mk-tilastot__num {
    width: 80px;
}

.mk-tilastot__lapset {
    flex-shrink: 0;
}

.mk-tilastot__kiintiot {
    margin: 6px 0 12px 0;
}

.mk-tilastot__kiintio {
    margin-bottom: 10px;
}

.mk-tilastot__kiintio--tyhja {
    opacity: 0.5;
}

.mk-tilastot__kiintiorivi {
    flex-direction: row;
    justify-content: space-between;
    margin-bottom: 3px;
}

.mk-tilastot__kiintionimi,
.mk-tilastot__kiintioarvo {
    font-size: 12px;
    color: rgba(58, 42, 26, 0.9);
}

.mk-tilastot__kiintioura {
    height: 8px;
    border-radius: 4px;
    background-color: rgba(70, 51, 31, 0.12);
    overflow: hidden;
}

.mk-tilastot__kiintiotayte {
    height: 100%;
    width: 0;
}

.mk-tilastot__kiintiotayte--vihrea {
    background-color: #8fb886;
}

.mk-tilastot__kiintiotayte--keltainen {
    background-color: #d9b44a;
}

.mk-tilastot__kiintiotayte--punainen {
    background-color: #c0533a;
}
