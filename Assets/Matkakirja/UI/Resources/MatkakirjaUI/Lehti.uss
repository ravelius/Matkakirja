/* LEHTI (Natiivi-UI): kaupunki- ja maalehti — webin .dialog.lehti.arkki (css/styles.css). */

.mk-lehti__peite {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(14, 9, 4, 0.34);
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.22s;
}

.mk-lehti__peite.mk-auki {
    opacity: 1;
}

.mk-lehti {
    width: 100%;
    max-width: 960px;
    height: 100%;
    padding: 10px 0 0 0;
    background-color: #f5f0e2;
    color: rgba(58, 42, 26, 0.95);
    overflow: hidden;
}

.mk-lehti__ylarivi {
    flex-direction: row;
    align-items: center;
    padding: 4px 14px 6px 14px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(70, 51, 31, 0.25);
    flex-shrink: 0;
}

.mk-lehti__ylanimi {
    flex-grow: 1;
    font-size: 12px;
    letter-spacing: 2px;
    color: rgba(70, 51, 31, 0.8);
    -unity-text-align: middle-center;
}

.mk-lehti__ikoninappi {
    width: 40px;
    height: 36px;
    min-height: 36px;
    padding: 0;
    border-width: 0;
    border-radius: 6px;
    background-color: rgba(0, 0, 0, 0);
    color: #46331f;
    justify-content: center;
}

.mk-lehti__ikoninappi > .mk-ikoni {
    margin-right: 0;
    width: 20px;
    height: 20px;
}

.mk-lehti__ikoninappi.mk-valittu {
    background-color: rgba(217, 161, 59, 0.3);
}

.mk-lehti__sivupaikka {
    flex-grow: 1;
    flex-shrink: 1;
    overflow: hidden;
}

.mk-lehti__sivu {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
}

.mk-lehti__sivu > .unity-scroll-view__content-viewport > .unity-scroll-view__content-container {
    padding: 18px 26px 28px 26px;
}

.mk-lehti__sivu--liuku {
    transition-property: translate, opacity;
    transition-duration: 0.3s;
    transition-timing-function: ease-in-out;
}

/* --- masto ------------------------------------------------------------------ */

.mk-lehti__masto {
    align-items: center;
    margin-bottom: 14px;
}

.mk-lehti__nimioyla {
    font-size: 9.5px;
    letter-spacing: 3.3px;
    color: rgba(70, 51, 31, 0.7);
}

.mk-lehti__nimio {
    font-size: 38px;
    letter-spacing: 4px;
    color: #16130f;
    -unity-text-align: middle-center;
    white-space: normal;
    margin: 2px 0 4px 0;
}

.mk-lehti__paivays {
    align-self: stretch;
    padding: 4px 0;
    border-top-width: 3px;
    border-bottom-width: 1px;
    border-top-color: rgba(70, 51, 31, 0.75);
    border-bottom-color: rgba(70, 51, 31, 0.5);
}

.mk-lehti__paivaysteksti {
    font-size: 11px;
    letter-spacing: 1.8px;
    -unity-text-align: middle-center;
    color: #46331f;
}

/* --- aihe ja teksti ------------------------------------------------------------- */

.mk-lehti__aihe {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin: 4px 0 12px 0;
    padding: 6px 0;
    border-top-width: 3px;
    border-bottom-width: 1px;
    border-top-color: rgba(70, 51, 31, 0.75);
    border-bottom-color: rgba(70, 51, 31, 0.45);
}

.mk-lehti__aiheteksti {
    flex-shrink: 1;
    font-size: 21px;
    letter-spacing: 1.2px;
    color: #16130f;
    -unity-text-align: middle-center;
    white-space: normal;
}

.mk-lehti__lippu {
    width: 30px;
    height: 20px;
    margin-left: 10px;
    border-width: 0.5px;
    border-color: rgba(70, 51, 31, 0.35);
    -unity-background-scale-mode: scale-and-crop;
}

.mk-lehti__johdanto {
    font-size: 16px;
    white-space: normal;
    margin-bottom: 16px;
    color: rgba(58, 42, 26, 0.9);
}

.mk-lehti__esittely,
.mk-lehti__leipa {
    font-size: 16px;
    white-space: normal;
    margin-bottom: 10px;
    color: rgba(58, 42, 26, 0.95);
}

.mk-lehti__osasto {
    font-size: 11px;
    letter-spacing: 2.2px;
    color: #7a5514;
    margin: 6px 0 8px 0;
}

.mk-lehti__nosto {
    margin-bottom: 18px;
    padding-bottom: 12px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(70, 51, 31, 0.18);
}

.mk-lehti__nosto-otsikkorivi {
    flex-direction: row;
    align-items: flex-end;
    margin-bottom: 8px;
}

.mk-lehti__nosto-otsikko {
    flex-grow: 1;
    flex-shrink: 1;
    font-size: 19px;
    white-space: normal;
    color: #16130f;
}

.mk-lehti__aika {
    margin-left: 10px;
    font-size: 12px;
    color: rgba(70, 51, 31, 0.7);
}

.mk-lehti__nostoloppu {
    flex-direction: row;
    flex-wrap: wrap;
}

.mk-lehti__linkki {
    min-height: 32px;
    margin: 4px 12px 0 0;
    padding: 0;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    color: #7a5514;
}

.mk-lehti__linkki .mk-nappi__teksti {
    font-size: 13px;
}

/* --- kuvat ---------------------------------------------------------------------- */

.mk-lehti__kuvakehys {
    margin: 2px 0 6px 0;
    border-width: 3px;
    border-color: #f7efdc;
    background-color: rgba(70, 51, 31, 0.08);
    overflow: hidden;
}

.mk-lehti__kuva {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.mk-lehti__paakuva .mk-lehti__kuva {
    -unity-background-scale-mode: scale-and-crop;
}

.mk-lehti__kuvateksti {
    font-size: 13px;
    white-space: normal;
    color: rgba(33, 29, 24, 0.78);
    margin-bottom: 2px;
}

.mk-lehti__lahde {
    font-size: 10.5px;
    white-space: normal;
    color: rgba(70, 51, 31, 0.6);
    margin-bottom: 8px;
}

.mk-lehti__kuvasarja {
    margin-bottom: 10px;
}

.mk-lehti__kuvarivi {
    flex-direction: row;
    justify-content: space-between;
    margin: 6px 0 14px 0;
}

.mk-lehti__kuvasolu {
    width: 49%;
}

/* --- matkailijalle, listat, maaosasto --------------------------------------------- */

.mk-lehti__matkailijalle {
    margin-top: 8px;
    padding: 12px 14px;
    border-width: 1px;
    border-color: rgba(122, 85, 20, 0.35);
    background-color: rgba(214, 190, 140, 0.18);
}

.mk-lehti__lista {
    margin-bottom: 14px;
}

.mk-lehti__listarivi {
    flex-direction: row;
    align-items: flex-start;
    margin-bottom: 10px;
}

.mk-lehti__listakuva {
    width: 96px;
    margin-right: 10px;
    flex-shrink: 0;
}

.mk-lehti__listatekstit {
    flex-grow: 1;
    flex-shrink: 1;
}

.mk-lehti__listanimi {
    font-size: 15.5px;
    white-space: normal;
    color: #16130f;
}

.mk-lehti__listateksti {
    font-size: 14px;
    white-space: normal;
    color: rgba(58, 42, 26, 0.9);
}

.mk-lehti__maaosasto {
    margin-bottom: 16px;
    padding: 10px 12px;
    border-width: 1px;
    border-color: rgba(70, 51, 31, 0.3);
    background-color: rgba(255, 252, 242, 0.45);
}

.mk-lehti__tunnusrivi {
    flex-direction: row;
    justify-content: space-between;
    padding: 3px 0;
    border-bottom-width: 1px;
    border-bottom-color: rgba(70, 51, 31, 0.12);
}

.mk-lehti__tunnusnimi {
    font-size: 12.5px;
    color: rgba(70, 51, 31, 0.8);
}

.mk-lehti__tunnusarvo {
    font-size: 14px;
    color: #16130f;
    -unity-text-align: middle-right;
}

.mk-lehti__tervehdys {
    margin-top: 8px;
    font-size: 14px;
    white-space: normal;
}

/* --- minitehtävä (webin .fokusvirta-visa lehdessä) --------------------------------- */

.mk-lehti__tehtava {
    margin-top: 20px;
    padding: 12px 15px 13px 15px;
    border-width: 3px;
    border-color: rgba(60, 44, 26, 0.6);
    background-color: rgba(214, 190, 140, 0.22);
}

.mk-lehti__tehtavaotsake {
    font-size: 10.5px;
    letter-spacing: 3px;
    color: rgba(70, 51, 31, 0.8);
    margin-bottom: 6px;
}

.mk-lehti__kysymys {
    font-size: 16.5px;
    white-space: normal;
    color: #211d18;
    margin-bottom: 4px;
}

.mk-lehti__tehtavavihje {
    font-size: 13px;
    -unity-font-style: italic;
    white-space: normal;
    color: rgba(33, 29, 24, 0.65);
    margin-bottom: 6px;
}

.mk-lehti__tehtavatulos {
    margin-top: 11px;
    padding: 8px 11px;
    border-left-width: 4px;
    border-left-color: rgba(60, 44, 26, 0.55);
    background-color: rgba(60, 44, 26, 0.07);
    font-size: 15px;
    white-space: normal;
    color: #211d18;
}

.mk-lehti__tehtavatulos.mk-oikein {
    border-left-color: rgba(74, 124, 58, 0.9);
    background-color: rgba(106, 158, 84, 0.2);
}

.mk-lehti__tehtavatulos.mk-vaarin {
    border-left-color: rgba(74, 124, 58, 0.85);
    background-color: rgba(106, 158, 84, 0.1);
}

/* Palkintojuliste tehtävälaatikon kyljessä (web .minitehtava-palkinnollinen, .juliste-palkinto). */
.mk-lehti__tehtavarunko {
    flex-direction: row;
    align-items: flex-start;
}

.mk-lehti__tehtavapalsta {
    flex-grow: 1;
    flex-shrink: 1;
}

.mk-lehti__julistepalkinto {
    width: 110px;
    flex-shrink: 0;
    margin: 2px 0 10px 12px;
    align-items: stretch;
}

.mk-lehti__julistekuva {
    height: 165px;
    border-width: 1px;
    border-color: rgba(60, 44, 26, 0.55);
    -unity-background-scale-mode: scale-to-fit;
    opacity: 0.5;
    -unity-background-image-tint-color: rgb(200, 190, 175);
    transition-property: opacity, -unity-background-image-tint-color;
    transition-duration: 0.26s;
}

.mk-lehti__julistepalkinto.mk-voitettu .mk-lehti__julistekuva {
    opacity: 1;
    border-color: rgba(60, 44, 26, 0.8);
    -unity-background-image-tint-color: rgb(255, 255, 255);
}

.mk-lehti__julistemerkki {
    margin-top: 5px;
    font-size: 9px;
    letter-spacing: 2.2px;
    -unity-text-align: upper-center;
    color: rgba(60, 44, 26, 0.72);
}

.mk-lehti__julistepalkinto.mk-voitettu .mk-lehti__julistemerkki {
    color: rgba(60, 44, 26, 0.95);
}

.mk-lehti__lunastus {
    min-height: 44px;
    margin-top: 8px;
    border-width: 1px;
    border-color: rgba(60, 44, 26, 0.65);
    border-radius: 4px;
    background-color: rgba(255, 253, 245, 0.9);
    color: #211d18;
}

.mk-lehti__lunastus .mk-nappi__teksti {
    font-size: 15.5px;
}

/* --- alapalkki ja sisällys ------------------------------------------------------------ */

.mk-lehti__alapalkki {
    flex-direction: column;
    flex-shrink: 0;
    padding: 8px 14px 14px 14px;
    border-top-width: 1px;
    border-top-color: rgba(70, 51, 31, 0.25);
}

/* Poistu vasemmalla, eteenpäin vievä oikealla (omistaja 8.8.2026). */
.mk-lehti__navi {
    flex-direction: row;
    align-items: stretch;
}

.mk-lehti__poistu {
    min-height: 40px;
    margin-right: auto;
    padding: 4px 12px;
    border-width: 1px;
    border-color: rgba(70, 51, 31, 0.3);
    border-radius: 3px;
    background-color: rgba(0, 0, 0, 0);
    color: rgba(70, 51, 31, 0.55);
}

.mk-lehti__poistu .mk-nappi__teksti {
    font-size: 13px;
}

.mk-lehti__selaus {
    flex-direction: column;
    flex-shrink: 1;
    min-height: 40px;
    margin-left: 8px;
    padding: 4px 12px;
    border-width: 1px;
    border-color: rgba(70, 51, 31, 0.45);
    border-radius: 3px;
    background-color: rgba(255, 252, 242, 0.5);
    color: #46331f;
}

.mk-lehti__selaus--seuraava {
    background-color: rgba(217, 161, 59, 0.22);
    border-color: rgba(122, 85, 20, 0.6);
}

.mk-lehti__selaus--sisallys {
    flex-direction: row;
    margin-left: 0;
    margin-right: auto;
    padding: 4px 11px;
}

.mk-lehti__selaus--sisallys > .mk-ikoni {
    width: 18px;
    height: 18px;
    margin-right: 0;
}

.mk-lehti__selaussuunta {
    font-size: 13px;
    -unity-text-align: middle-center;
}

.mk-lehti__selausaihe {
    max-width: 150px;
    font-size: 10.5px;
    opacity: 0.72;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    -unity-text-align: middle-center;
}

/* Tehtävänappi (web #arrival-yes, primary) täysleveänä rivinä alapalkin alla. */
.mk-lehti__tehtavanappi {
    min-height: 0;
    margin-top: 8px;
    padding: 7px 13px;
    border-width: 1px;
    border-color: rgba(122, 85, 20, 0.6);
    border-radius: 10px;
    color: #2a1a08;
}

.mk-lehti__tehtavanappi .mk-nappi__teksti {
    font-size: 14px;
}

.mk-lehti__tehtavanappi--pois {
    opacity: 0.55;
    -unity-background-image-tint-color: rgb(170, 170, 170);
}

/* "Maa-liite" kaupunkilehden viimeisellä sivulla (web .maa-liite-nappi). */
.mk-lehti__liite {
    min-height: 0;
    margin-top: 8px;
    padding: 7px 13px;
    border-width: 1px;
    border-color: rgba(70, 51, 31, 0.45);
    border-radius: 10px;
    background-color: rgba(255, 252, 242, 0.5);
    color: #46331f;
}

.mk-lehti__liite .mk-nappi__teksti {
    font-size: 13px;
}

.mk-lehti__sisallys {
    position: absolute;
    top: 52px;
    left: 10px;
    width: 340px;
    max-width: 92%;
    max-height: 80%;
    padding: 10px 12px;
    border-width: 1px;
    border-color: rgba(70, 51, 31, 0.4);
    background-color: #f7efdc;
}

.mk-lehti__sisallysyla {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 6px;
}

.mk-lehti__sisallysotsikko {
    font-size: 12px;
    letter-spacing: 2px;
    color: #46331f;
}

.mk-lehti__sisallysvieritys {
    flex-shrink: 1;
}

.mk-lehti__sisallysrivi {
    justify-content: flex-start;
    min-height: 44px;
    margin-bottom: 4px;
    padding: 6px 8px;
    border-width: 0;
    border-radius: 4px;
    background-color: rgba(0, 0, 0, 0);
    color: #211d18;
}

.mk-lehti__sisallysrivi.mk-valittu {
    background-color: rgba(217, 161, 59, 0.2);
}

.mk-suurennos {
    position: absolute;
}

/* --- nähtävyysarkki ja turistiopas (Nahtavyysarkki.cs; web .nahtavyys-arkki, .opas-*) ---- */

.mk-nahtavyys__peite {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(14, 9, 4, 0.34);
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.22s;
}

.mk-nahtavyys__peite.mk-auki {
    opacity: 1;
}

.mk-nahtavyys {
    flex-shrink: 1;
    max-height: 100%;
    padding: 19px 18px 16px 18px;
    border-width: 1px;
    border-color: rgba(70, 51, 31, 0.3);
    border-radius: 3px;
    background-color: #f5f0e2;
    color: rgba(58, 42, 26, 0.95);
}

.mk-nahtavyys__yla {
    flex-shrink: 0;
}

.mk-nahtavyys__aika {
    margin-bottom: 2px;
    font-size: 11.5px;
    letter-spacing: 2.5px;
    color: rgba(70, 51, 31, 0.72);
}

.mk-nahtavyys__otsikkorivi {
    flex-direction: row;
    align-items: center;
    margin-bottom: 11px;
}

.mk-nahtavyys__otsikko {
    flex-shrink: 1;
    font-size: 24px;
    white-space: normal;
    color: #3a2a1a;
}

.mk-nahtavyys__kaiutin {
    width: 40px;
    height: 40px;
    min-height: 40px;
    margin-left: 6px;
    padding: 0;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    color: rgba(70, 51, 31, 0.62);
    justify-content: center;
}

.mk-nahtavyys__kaiutin > .mk-ikoni {
    width: 22px;
    height: 22px;
    margin-right: 0;
}

.mk-nahtavyys__kaiutin.mk-valittu {
    color: #a8741a;
}

.mk-nahtavyys__vieritys {
    flex-shrink: 1;
}

.mk-nahtavyys__kappale {
    margin-bottom: 13px;
    font-size: 16px;
    white-space: normal;
}

.mk-nahtavyys__lainaus {
    margin: 17px 0 18px 0;
    padding: 2px 0 2px 14px;
    border-left-width: 3px;
    border-left-color: rgba(70, 51, 31, 0.4);
}

.mk-nahtavyys__lainausteksti {
    font-size: 17px;
    white-space: normal;
}

.mk-nahtavyys__lainauslahde {
    margin-top: 5px;
    font-size: 11.8px;
    white-space: normal;
    color: rgba(70, 51, 31, 0.72);
}

.mk-nahtavyys__kuvalohko {
    align-self: center;
    margin-bottom: 16px;
}

.mk-nahtavyys__kuvakehys {
    border-radius: 4px;
    overflow: hidden;
    background-color: rgba(70, 51, 31, 0.08);
}

.mk-nahtavyys__kuva {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    -unity-background-scale-mode: scale-and-crop;
}

.mk-nahtavyys__kuvateksti {
    margin-top: 5px;
}

.mk-nahtavyys__selite {
    font-size: 14px;
    white-space: normal;
}

.mk-nahtavyys__kuvalahde {
    margin-top: 2px;
    font-size: 10px;
    white-space: normal;
    color: rgba(70, 51, 31, 0.66);
}

.mk-nahtavyys__lahderivi {
    margin-top: 10px;
    font-size: 11.5px;
    letter-spacing: 0.8px;
    white-space: normal;
    color: rgba(70, 51, 31, 0.66);
}

.mk-nahtavyys__wiki {
    align-self: flex-start;
    min-height: 40px;
    margin-top: 10px;
    padding: 6px 14px;
    border-width: 1px;
    border-color: rgba(70, 51, 31, 0.45);
    border-radius: 3px;
    background-color: rgba(255, 252, 242, 0.5);
    color: #46331f;
}

.mk-nahtavyys__napit {
    flex-direction: row;
    justify-content: flex-end;
    flex-shrink: 0;
    padding-top: 10px;
}

.mk-nahtavyys__sulje {
    min-width: 120px;
}

/* Opas (web .opas-arkki): oma paletti, iso otsikko aksenttivärillä. */
.mk-nahtavyys--opas {
    background-color: #f8efdc;
    color: #3a2a15;
    padding-top: 10px;
}

.mk-nahtavyys--opas .mk-nahtavyys__otsikko {
    font-size: 36px;
    letter-spacing: -0.3px;
    color: #a53a22;
}

.mk-nahtavyys--opas.mk-nahtavyys--levea .mk-nahtavyys__otsikko {
    font-size: 44px;
}

.mk-nahtavyys--opas .mk-nahtavyys__kaiutin > .mk-ikoni {
    width: 24px;
    height: 24px;
}

.mk-nahtavyys--opas .mk-nahtavyys__lahderivi,
.mk-nahtavyys--opas .mk-nahtavyys__aika {
    color: #6d5942;
}

.mk-opas__ingressi {
    margin-bottom: 18px;
    padding-bottom: 14px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(165, 58, 34, 0.3);
    font-size: 19.8px;
    white-space: normal;
    color: #3a2a15;
}

.mk-opas__jakso {
    margin-bottom: 22px;
}

.mk-opas__valiotsikko {
    margin-bottom: 8px;
    padding-bottom: 4px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(165, 58, 34, 0.3);
    font-size: 12px;
    letter-spacing: 2.6px;
    color: #a53a22;
}

.mk-opas__rinnakkain {
    flex-direction: row;
    align-items: flex-start;
}

.mk-opas__pino {
    flex-direction: column;
}

.mk-opas__palsta {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
}

.mk-opas__sivupalsta {
    width: 256px;
    flex-shrink: 0;
    margin-left: 20px;
}

.mk-opas__sivupalsta--kuva {
    width: 40%;
}

.mk-opas__kainalo {
    margin: 3px 0 14px 0;
    border-width: 1px;
    border-color: rgba(58, 42, 21, 0.22);
    border-radius: 3px;
    overflow: hidden;
}

.mk-opas__vyo {
    padding: 9px 11px 10px 11px;
}

.mk-opas__vyo--lammin {
    background-color: #f6ddc8;
}

.mk-opas__vyo--viilea {
    background-color: #e0eae7;
}

.mk-opas__vyootsikko {
    margin-bottom: 5px;
    font-size: 11px;
    letter-spacing: 2px;
    color: #6d5942;
}

.mk-opas__vyorivi {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    min-height: 0;
    padding: 5px 0;
    border-width: 0;
    border-top-width: 1px;
    border-top-color: rgba(58, 42, 21, 0.13);
    border-radius: 0;
    background-color: rgba(0, 0, 0, 0);
}

.mk-opas__vyorivi--eka {
    border-top-width: 0;
}

.mk-opas__vyonimi {
    flex-shrink: 1;
    font-size: 12.8px;
    white-space: normal;
    color: #3a2a15;
}

.mk-opas__vyonappi .mk-opas__vyonimi {
    border-bottom-width: 1px;
    border-bottom-color: rgba(58, 42, 21, 0.3);
}

.mk-opas__vyonappi.mk-auki .mk-opas__vyonimi {
    color: #a53a22;
}

.mk-opas__tahdet {
    flex-shrink: 0;
    margin-left: 8px;
    font-size: 12.8px;
    color: #7f570b;
}

.mk-opas__nosto {
    margin: 24px 0;
    padding: 14px 10px;
    border-top-width: 3px;
    border-bottom-width: 3px;
    border-color: #a53a22;
}

.mk-opas__nostoteksti {
    font-size: 21px;
    white-space: normal;
    -unity-text-align: middle-center;
    color: #a53a22;
}

.mk-opas__laatikko {
    margin: 21px 0;
    padding: 14px 16px 15px 16px;
    border-width: 1px;
    border-left-width: 5px;
    border-color: rgba(58, 42, 21, 0.18);
    border-left-color: #a53a22;
    border-radius: 3px;
    background-color: #f2e5c8;
}

.mk-opas__laatikkootsikko {
    margin-bottom: 9px;
    font-size: 12.8px;
    letter-spacing: 2.6px;
    color: #a53a22;
}

.mk-opas__saagraafi {
    width: 240px;
    flex-shrink: 0;
    margin-left: 16px;
}

.mk-opas__pino > .mk-opas__saagraafi {
    width: 100%;
    max-width: 320px;
    align-self: center;
    margin: 0 0 13px 0;
}

.mk-opas__parasaika {
    margin-bottom: 10px;
    font-size: 16px;
    white-space: normal;
    color: #3a2a15;
}

.mk-opas__kausi {
    flex-direction: row;
    margin-bottom: 6px;
}

.mk-opas__kausi--pino {
    flex-direction: column;
}

.mk-opas__kausinimi {
    width: 120px;
    flex-shrink: 0;
    margin-right: 14px;
}

.mk-opas__kausi--pino .mk-opas__kausinimi {
    width: auto;
    margin-right: 0;
}

.mk-opas__kausisana {
    font-size: 13px;
    color: #3a2a15;
}

.mk-opas__kausikk {
    font-size: 11.5px;
    opacity: 0.7;
    color: #3a2a15;
}

.mk-opas__kausitiedot {
    flex-grow: 1;
    flex-shrink: 1;
}

.mk-opas__kausilampo {
    font-size: 13.8px;
    color: #1d5a5e;
}

.mk-opas__kausikuvaus {
    font-size: 15px;
    white-space: normal;
    color: #3a2a15;
}

.mk-opas__suunnittele {
    border-left-color: #1d5a5e;
}

.mk-opas__suunnittele .mk-opas__laatikkootsikko {
    color: #1d5a5e;
}

.mk-opas__linkki {
    align-self: flex-start;
    min-height: 0;
    margin-bottom: 6px;
    padding: 2px 0;
    border-width: 0;
    border-bottom-width: 1px;
    border-bottom-color: #1d5a5e;
    border-radius: 0;
    background-color: rgba(0, 0, 0, 0);
    color: #1d5a5e;
}

.mk-opas__linkki .mk-nappi__teksti {
    font-size: 14.4px;
}

/* Matkailijalle-lohkon sisäänkäynnit oppaaseen (web .opas-nauha-kotelo, .opas-lue-lisaa). */
.mk-lehti__opaskotelo {
    position: absolute;
    top: 0;
    right: 0;
    width: 173px;
    height: 173px;
    overflow: hidden;
}

.mk-lehti__opasnauha {
    position: absolute;
    top: 46px;
    right: -115px;
    width: 352px;
    min-height: 0;
    padding: 8px 0;
    border-width: 0;
    border-radius: 0;
    background-color: #b3775f;
    color: #f2e4d0;
    rotate: 45deg;
}

.mk-lehti__opasnauha .mk-nappi__teksti {
    font-size: 11.2px;
    letter-spacing: 1.8px;
    -unity-text-align: middle-center;
}

.mk-lehti__opaslinkki {
    align-self: flex-start;
    min-height: 0;
    margin-top: 2px;
    padding: 0;
    border-width: 0;
    border-bottom-width: 1px;
    border-bottom-color: #1c6f6b;
    border-radius: 0;
    background-color: rgba(0, 0, 0, 0);
    color: #1c6f6b;
}

.mk-lehti__opaslinkki .mk-nappi__teksti {
    font-size: 15px;
}

/* --- Maa numeroina (MaaNumeroina.cs): webin .maakayrat, .maakayra-*, .pyramidi-* ja
 * .numeroina-ingressi (css/styles.css). Muste + kulta kuten säägraafissa. ------------------ */

/* Otsikko kuten muiden aihesivujen (web h3.aihe-nimi, natiivissa .mk-lehti__aihe). */
.mk-numerot__otsikko {
    margin: 4px 0 12px 0;
    padding: 6px 0;
    border-top-width: 3px;
    border-bottom-width: 1px;
    border-top-color: rgba(70, 51, 31, 0.75);
    border-bottom-color: rgba(70, 51, 31, 0.45);
}

.mk-numerot__otsikkoteksti {
    font-size: 21px;
    letter-spacing: 1.2px;
    color: #16130f;
    -unity-text-align: middle-center;
    white-space: normal;
}

/* Yleisluonnehdinta isolla ennen käyriä (web 1.18rem). */
.mk-numerot__ingressi {
    font-size: 19px;
    white-space: normal;
    margin: 3px 0 6px 0;
    color: #211d18;
}

.mk-numerot__johdanto,
.mk-numerot__tila {
    font-size: 16px;
    white-space: normal;
    margin: 0 0 14px 0;
    color: rgba(70, 51, 31, 0.9);
}

.mk-numerot__ristikko {
    margin: 5px 0 6px 0;
}

.mk-numerot__lohko-otsikko {
    margin: 0 0 5px 0;
    font-size: 12.5px;
    white-space: normal;
    color: #211d18;
}

.mk-numerot__kuvio {
    width: 100%;
    flex-shrink: 0;
    background-color: rgba(255, 250, 238, 0.65);
    border-width: 1px;
    border-color: rgba(70, 51, 31, 0.35);
    border-radius: 6px;
    overflow: hidden;
}

/* Akselitekstit: koko asetetaan koodista viewBoxin skaalan mukaan (8,5 / 7,5 yksikköä). */
.mk-numerot__akseli {
    position: absolute;
    margin: 0;
    padding: 0;
    white-space: nowrap;
    color: rgba(70, 51, 31, 0.8);
}

.mk-numerot__ennusteteksti {
    color: rgba(164, 105, 28, 0.75);
}

.mk-numerot__silloinvuosi {
    color: rgba(138, 97, 20, 0.9);
}

.mk-numerot__ika {
    color: rgba(70, 51, 31, 0.65);
}

/* Tulkintalause käyrän alla: ingressin ääni pienempänä. */
.mk-numerot__tulkinta {
    margin: 5px 0 0 0;
    font-size: 14px;
    white-space: normal;
    color: rgba(33, 29, 24, 0.88);
}

/* "Silloin ja nyt" — isoisän päiväkirjan ääni käyrän alla. */
.mk-numerot__silloin {
    margin: 4px 0 0 0;
    font-size: 13px;
    white-space: normal;
    color: rgba(138, 97, 20, 0.95);
}

.mk-numerot__vdem {
    margin: 4px 0 0 0;
    font-size: 14px;
    white-space: normal;
    color: rgba(33, 29, 24, 0.88);
}

.mk-numerot__lahde {
    margin: 11px 0 8px 0;
    font-size: 11.5px;
    white-space: normal;
    color: rgba(70, 51, 31, 0.68);
}

/* --- Fokustehtävät (web css/fokusvirta.css .fokus-tehtava, .fokus-pulla; LehtiFokus.cs) ----- */

/* Nimilaatta ("AARTEEN AVAUS" / "JULISTE") ja vihjerivi keskitettynä yhtenä paalina. */
.mk-fokus__otsake {
    -unity-text-align: upper-center;
}

.mk-fokus__vihje {
    margin: -2px 0 9px 0;
    font-size: 13px;
    white-space: normal;
    -unity-text-align: upper-center;
    color: rgba(60, 44, 26, 0.72);
}

.mk-fokus__vaihtoehdot {
    margin-top: 4px;
}

/* Pullatarjous on laatikon jälkikirjoitus: katkoviiva erottaa sen vastaamisesta. */
.mk-fokus__pulla {
    margin-top: 13px;
    padding-top: 10px;
    border-top-width: 1px;
    border-top-color: rgba(60, 44, 26, 0.38);
}

.mk-fokus__pullanappi {
    min-height: 44px;
    padding: 8px 17px;
    border-width: 1px;
    border-color: rgba(60, 44, 26, 0.6);
    border-radius: 4px;
    background-color: rgba(255, 253, 245, 0.72);
    color: #211d18;
}

.mk-fokus__pullanappi .mk-nappi__teksti {
    font-size: 15px;
    white-space: normal;
    -unity-text-align: middle-center;
}

.mk-fokus__pullanappi:hover {
    background-color: #fffdf5;
    border-color: rgba(60, 44, 26, 0.85);
}

/* Varmistus on eri nappi kuin tarjous: umpireuna ja lämmin kulta. */
.mk-fokus__pullanappi--varmistus,
.mk-fokus__pullanappi--varmistus:hover {
    border-color: rgba(122, 85, 20, 0.75);
    background-color: #e6b650;
    color: #2c1e07;
}

.mk-fokus__pullanappi--varmistus .mk-nappi__teksti {
    -unity-font-style: bold;
}

/* Tyhjä kassa: nappi näkyy mutta ei ota napautusta vastaan. */
.mk-fokus__pullanappi--koyha,
.mk-fokus__pullanappi--koyha:hover {
    border-color: rgba(60, 44, 26, 0.35);
    background-color: rgba(0, 0, 0, 0);
    color: rgba(33, 29, 24, 0.55);
}

.mk-fokus__pullahuomio,
.mk-fokus__pullatehty {
    margin-top: 7px;
    font-size: 13px;
    white-space: normal;
    -unity-text-align: upper-center;
    color: rgba(60, 44, 26, 0.72);
}

.mk-fokus__pullatehty {
    margin-top: 0;

/* Nähtävyysarkin ☰-valikko ja ‹ › -nuolet (web .nahtavyys-valikko-nappi, .nahtavyys-nuoli). */
.mk-nahtavyys__valikkonappi {
    position: absolute;
    top: 9px;
    right: 10px;
    width: 34px;
    height: 34px;
    min-height: 34px;
    padding: 0;
    border-width: 1px;
    border-color: rgba(70, 51, 31, 0.35);
    border-radius: 6px;
    background-color: rgba(246, 231, 198, 0.9);
    color: #46331f;
    justify-content: center;
}

.mk-nahtavyys__valikkonappi > .mk-ikoni {
    width: 17px;
    height: 17px;
    margin-right: 0;
}

.mk-nahtavyys__valikko {
    position: absolute;
    top: 46px;
    right: 10px;
    width: 300px;
    max-width: 80%;
    max-height: 60%;
    padding: 4px 0;
    border-width: 1px;
    border-color: rgba(70, 51, 31, 0.3);
    border-radius: 8px;
    background-color: #f5f0e2;
}

.mk-nahtavyys__valikkovieritys {
    flex-shrink: 1;
}

.mk-nahtavyys__valikkorivi {
    flex-direction: row;
    justify-content: flex-start;
    align-items: center;
    min-height: 0;
    padding: 7px 10px;
    border-width: 0;
    border-radius: 0;
    background-color: rgba(0, 0, 0, 0);
    color: #3a2a1a;
}

.mk-nahtavyys__valikkorivi.mk-valittu {
    background-color: rgba(70, 51, 31, 0.12);
}

.mk-nahtavyys__valikkonumero {
    width: 22px;
    height: 22px;
    margin-right: 8px;
    border-width: 1.5px;
    border-color: #2c2318;
    border-radius: 11px;
    background-color: #f3e2b8;
    font-size: 11px;
    -unity-text-align: middle-center;
    color: #2c2318;
}

.mk-nahtavyys__valikkonimi {
    flex-shrink: 1;
    font-size: 14.7px;
    white-space: normal;
}

.mk-nahtavyys__nuoli {
    position: absolute;
    top: 50%;
    width: 32px;
    height: 32px;
    min-height: 32px;
    margin-top: -16px;
    padding: 0;
    border-width: 1px;
    border-color: rgba(70, 51, 31, 0.35);
    border-radius: 16px;
    background-color: rgba(246, 231, 198, 0.9);
    color: #46331f;
}

.mk-nahtavyys__nuoli .mk-nappi__teksti {
    font-size: 18px;
    -unity-text-align: middle-center;
}

.mk-nahtavyys__nuoli--vasen {
    left: 4px;
}

.mk-nahtavyys__nuoli--oikea {
    right: 4px;
}
