.tk-teema-paperi {
    --tk-pinta: var(--tk-paperi-pinta);
    --tk-pergamentti: var(--tk-paperi-pergamentti);
    --tk-muste: var(--tk-paperi-muste);
    --tk-muste-pehmea: var(--tk-paperi-muste-pehmea);
    --tk-korostus: var(--tk-paperi-korostus);
    --tk-reunus: var(--tk-paperi-reunus);
    --tk-toiminto: var(--tk-paperi-toiminto);
}
