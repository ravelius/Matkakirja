/* NOSTOKORTTI-pohja: vetokahva ja toimintorivi — Pohja.Vetokahva, Nostokortti
 * Siirretty sellaisenaan (UI-pohjien tyylijako 2.10.2026, web #3820 css/pohjat/…): järjestys Matkakirja.tss:ssä. */

/* Vetokahvan osuma-alue (Pohja.cs Vetokahva, Nostokortti kahvaAlue): koko leveys, 16 pt kortin yläpuolelta kortin täytteen
 * (22 pt) loppuun; kortin sisällä veto mitataan lisäksi 28 pt:n kaistalta (osuma-ala 44 pt, savuke 110). */
.mk-vetokahva {
    position: absolute;
    top: -16px;
    left: 0;
    right: 0;
    height: 38px;
}

.mk-vetokahva > .mk-nosto__kahva {
    top: 24px;
}

/* NOSTOKORTTI-pohjan toimintorivi (kohdekortti, omistaja 1.10.2026 kokeiluun): kiinteä alarivi Kysy · Visa · Kierros · Lehti,
   napit 38 pt (TOIMINTO-tyyppi; Lehti ensisijainen kulta), sisältö vierii sen alla. */
.mk-nosto--toiminnot {
    padding-bottom: 62px;
}

.mk-nosto__toiminnot {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    flex-direction: row;
    padding: var(--tk-vali-s) var(--tk-vali-m) var(--tk-vali-m) var(--tk-vali-m);
    border-top-width: 1px;
    border-color: var(--tk-paperi-reunus);
    background-color: var(--tk-paperi-pinta);
    border-bottom-left-radius: var(--tk-kulma-kortti);
    border-bottom-right-radius: var(--tk-kulma-kortti);
}

.mk-nosto__toiminto {
    flex-grow: 1;
    flex-basis: 0;
    min-height: var(--tk-nappi-korkeus);
    margin: 0 3px;
    padding: 0 4px;
    border-radius: var(--tk-kulma-nappi);
    border-color: var(--tk-paperi-reunus);
    background-color: initial; /* läpinäkyvä (oletus), ei mk-nappin paneeliväriä */
    color: var(--tk-paperi-muste);
    font-size: var(--tk-koko-apuri);
}

.mk-nosto__toiminto.mk-nappi--kulta {
    background-color: var(--tk-paperi-toiminto);
    border-color: var(--accent-dark);
}

/* NOSTOKORTIN VIDEOPELIMUUNNELMA (omistaja 11.10.2026 Päätoimittajan kautta, juna 182; tyylikirja teemat.videopeli,
   NOSTOKORTTI.teemat): kimmeltävä sininen tausta merkitsee kohdetta, joka on sekä nähtävyys että pelattava videopeli
   (ensimmäisenä Olavinlinna). Teksti vaalealla, Pelaa-nappi kultainen (toiminto). Kimmel = hillitty vaalea juova, joka kulkee
   kortin poikki vuorosuuntiin noin 4 s:n välein (Nostokortti.Kimmel); ei osumia. */
.mk-nosto--videopeli {
    background-color: var(--tk-videopeli-pinta);
    border-color: var(--tk-videopeli-reunus);
    color: var(--tk-videopeli-muste);
}

.mk-nosto--videopeli .mk-nosto__otsikko--kohde,
.mk-nosto--videopeli .mk-nosto__paivaysteksti,
.mk-nosto--videopeli .mk-nosto__kysyotsikko,
.mk-nosto--videopeli .mk-nosto__toiminto {
    color: var(--tk-videopeli-muste);
}

.mk-nosto--videopeli .mk-nosto__ylarivi,
.mk-nosto--videopeli .mk-nosto__lahde--linkki {
    color: var(--tk-videopeli-korostus);
}

.mk-nosto--videopeli .mk-nosto__nimio,
.mk-nosto--videopeli .mk-nosto__meta,
.mk-nosto--videopeli .mk-nosto__kuvateksti,
.mk-nosto--videopeli .mk-nosto__lahde {
    color: var(--tk-videopeli-muste-pehmea);
}

.mk-nosto--videopeli .mk-nosto__kahva {
    background-color: var(--tk-videopeli-reunus);
}

.mk-nosto--videopeli .mk-nosto__toiminnot {
    border-color: var(--tk-videopeli-reunus);
    background-color: var(--tk-videopeli-pinta);
}

.mk-nosto--videopeli .mk-nosto__toiminto {
    border-color: var(--tk-videopeli-reunus);
}

.mk-nosto--videopeli .mk-nosto__toiminto.mk-nappi--kulta {
    background-color: var(--tk-videopeli-toiminto);
    border-color: var(--accent-dark);
    color: var(--tk-paperi-muste);
}

.mk-nosto--videopeli .mk-nosto__lukija.mk-nosto__lukija--irti {
    background-color: var(--tk-videopeli-pinta);
}

/* Ylärivin selain ja lukija sinisellä (simuajot f6d9b3ab, 23afc880, d868ab8d: NOSTOT, AUTO ja kaiutin jäivät tummiksi):
 * nostoselain.uss:n säännöt (.mk-nostoselain .x, .mk-nosto__lukija .mk-lukija) ovat kahden luokan ja tulevat myöhemmin, joten
 * ylikirjoitus on yhtä luokkaa tarkempi. */
.mk-nosto--videopeli .mk-nostoselain .mk-nostoselain__askel,
.mk-nosto--videopeli .mk-nostoselain .mk-nostoselain__auto.mk-valittu,
.mk-nosto--videopeli .mk-nostoselain .mk-lukija.mk-nosto__pin,
.mk-nosto--videopeli .mk-nosto__lukija .mk-lukija,
.mk-nosto--videopeli .mk-nosto__lukija .mk-lukija.mk-lukee,
.mk-nosto--videopeli .mk-nosto__lukija .mk-lukija__valikkonappi.mk-valittu,
.mk-nosto--videopeli .mk-nostoselain .mk-nappi__teksti,
.mk-nosto--videopeli .mk-nostoselain .mk-ikoni {
    color: var(--tk-videopeli-muste);
}

.mk-nosto--videopeli .mk-nostoselain .mk-nostoselain__avaaja,
.mk-nosto--videopeli .mk-nostoselain .mk-nostoselain__auto,
.mk-nosto--videopeli .mk-nostoselain .mk-lukija.mk-nosto__pin.mk-valittu {
    color: var(--tk-videopeli-korostus);
}

.mk-nosto--videopeli .mk-nostoselain .mk-nostoselain__avaajaikoni,
.mk-nosto--videopeli .mk-nosto__lukija .mk-lukija__valikkonappi,
.mk-nosto--videopeli .mk-nosto__lukija .mk-lukija.mk-mykistetty {
    color: var(--tk-videopeli-muste-pehmea);
}

.mk-nosto--videopeli .mk-nostoselain .mk-nostoselain__sivu .mk-nosto__ylarivi-teksti,
.mk-nosto--videopeli .mk-nosto__ylarivi.mk-nosto__ylarivi--kategoria .mk-nosto__ylarivi-teksti,
.mk-nosto--videopeli .mk-nosto__ylarivi .mk-nosto__ylarivi-teksti {
    color: var(--tk-videopeli-korostus);
}

.mk-nosto--videopeli .mk-nostoselain .mk-nosto__ylarivi-symboli,
.mk-nosto--videopeli .mk-nosto__ylarivi.mk-nosto__ylarivi--kategoria .mk-nosto__ylarivi-symboli {
    -unity-background-image-tint-color: var(--tk-videopeli-korostus);
}

.mk-nosto__kimmelala {
    display: none;
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    overflow: hidden;
    border-radius: var(--tk-kulma-kortti);
}

.mk-nosto--videopeli .mk-nosto__kimmelala {
    display: flex;
}

.mk-nosto__kimmel {
    position: absolute;
    top: -20%;
    bottom: -20%;
    left: -45%;
    width: 30%;
    rotate: 16deg;
    background-color: var(--tk-videopeli-kimmel);
    transition-property: translate;
    transition-duration: 2400ms; /* ympäristöanimaatio: videopelinoston kimmel (omistaja 11.10.2026), ei käyttöliittymän siirtymä */
    transition-timing-function: ease-in-out;
}

.mk-nosto__kimmel--kulku {
    translate: 500% 0;
}
