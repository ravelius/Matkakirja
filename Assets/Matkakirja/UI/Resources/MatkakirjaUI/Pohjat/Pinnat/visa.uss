/* KORTTI-pinta: visa B — KysymysNakyma
 * Siirretty sellaisenaan (UI-pohjien tyylijako 2.10.2026, web #3820 css/pohjat/…): järjestys Matkakirja.tss:ssä. */

/* VISA KORTTI-POHJALLA, versio B (omistaja 1.10.2026, web #3807 css/pohjat.css "KORTTI/visa"; KysymysNakyma.Pohjalla).
 * Pohjan poikkeukset (tyylikirja pohjat._poikkeukset): tiimalasi kulmassa ja 50:50-napin hinta (80 p). Arvot tyylikirjasta. */
.mk-kysymys--pohja.mk-kysymys--levea {
    max-width: var(--tk-leveys-kortti);
}

.mk-kysymys--pohja .mk-kysymys__paa {
    margin-bottom: var(--tk-vali-s);
    padding-bottom: var(--tk-vali-s);
    border-color: var(--tk-paperi-reunus);
}

.mk-kysymys--pohja .mk-kysymys__leima {
    padding: 0;
    border-width: 0;
    rotate: 0deg;
    font-size: var(--tk-koko-kapiteeli);
    letter-spacing: 7.69px; /* web 0.12em */
    color: var(--tk-paperi-muste-pehmea);
}

.mk-kysymys--pohja .mk-kysymys__kaupunki {
    font-size: var(--tk-koko-kapiteeli);
    letter-spacing: 7.69px; /* web 0.12em */
    color: var(--tk-paperi-muste-pehmea);
}

.mk-kysymys--pohja .mk-kysymys__sekunnit {
    font-size: var(--tk-koko-apuri);
    color: var(--tk-paperi-muste);
}

.mk-kysymys--pohja .mk-kysymys__kehys,
.mk-kysymys--pohja .mk-kysymys__selite {
    font-size: var(--tk-koko-leipa);
    color: var(--tk-paperi-muste);
}

.mk-kysymys--pohja .mk-kysymys__kysymys {
    margin: var(--tk-vali-s) 0 var(--tk-vali-m) 0;
    font-size: var(--tk-koko-valiotsikko);
    color: var(--tk-paperi-muste);
}

.mk-kysymys--pohja .mk-kysymys__vaihtoehdot,
.mk-kysymys--pohja.mk-kysymys--levea .mk-kysymys__vaihtoehdot {
    flex-direction: column;
    flex-wrap: nowrap;
}

.mk-kysymys--pohja .mk-nappi.mk-kysymys__vaihtoehto,
.mk-kysymys--pohja.mk-kysymys--levea .mk-nappi.mk-kysymys__vaihtoehto,
.mk-kysymys--pohja .mk-kysymys__vaihtoehdot--tiivis > .mk-nappi.mk-kysymys__vaihtoehto {
    width: auto;
    min-height: var(--tk-nappi-korkeus);
    margin-bottom: var(--tk-vali-xs);
    padding: var(--tk-vali-xs) var(--tk-vali-m);
    border-color: var(--tk-paperi-reunus);
    border-radius: var(--tk-kulma-nappi);
    background-color: initial;
    rotate: 0deg;
}

.mk-kysymys--pohja .mk-nappi.mk-kysymys__vaihtoehto--pariton,
.mk-kysymys--pohja .mk-nappi.mk-kysymys__vaihtoehto--parillinen {
    rotate: 0deg;
}

.mk-kysymys--pohja .mk-kysymys__kirjain {
    width: auto;
    height: auto;
    margin-right: var(--tk-vali-s);
    border-width: 0;
    font-size: var(--tk-koko-apuri);
    color: var(--tk-paperi-muste-pehmea);
}

.mk-kysymys--pohja .mk-kysymys__vaihtoehtoteksti,
.mk-kysymys--pohja .mk-kysymys__vaihtoehdot--tiivis .mk-kysymys__vaihtoehtoteksti {
    font-size: var(--tk-koko-leipa);
    color: var(--tk-paperi-muste);
}

/* Tilavärin pohja omana kerroksenaan (KysymysNakyma: mk-kysymys__tilapohja), 16 % oikein ja 12 % väärin. */
.mk-kysymys__tilapohja {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    border-radius: var(--tk-kulma-nappi);
}

.mk-kysymys__vaihtoehto--oikea > .mk-kysymys__tilapohja {
    background-color: var(--tk-tila-onnistuminen);
    opacity: 0.16;
}

.mk-kysymys__vaihtoehto--vaara > .mk-kysymys__tilapohja {
    background-color: var(--tk-tila-virhe);
    opacity: 0.12;
}

.mk-kysymys--pohja .mk-nappi.mk-kysymys__vaihtoehto.mk-kysymys__vaihtoehto--oikea {
    border-color: var(--tk-tila-onnistuminen);
    background-color: initial;
}

.mk-kysymys--pohja .mk-nappi.mk-kysymys__vaihtoehto.mk-kysymys__vaihtoehto--vaara {
    border-color: var(--tk-tila-virhe);
    background-color: initial;
}

.mk-kysymys--pohja .mk-kysymys__vaihtoehto--oikea .mk-kysymys__kirjain,
.mk-kysymys--pohja .mk-kysymys__vaihtoehto--oikea .mk-kysymys__vaihtoehtoteksti {
    color: var(--tk-tila-onnistuminen);
}

.mk-kysymys--pohja .mk-kysymys__vaihtoehto--vaara .mk-kysymys__kirjain,
.mk-kysymys--pohja .mk-kysymys__vaihtoehto--vaara .mk-kysymys__vaihtoehtoteksti {
    color: var(--tk-tila-virhe);
}

/* Tulos ilman laatikkoa: tuomio ja vahva rivi tilavärillä, muu leipää. */
.mk-kysymys--pohja .mk-kysymys__tulos {
    margin: var(--tk-vali-m) 0 0 0;
    padding: 0;
    border-width: 0;
    border-radius: 0;
    background-color: initial;
}

.mk-kysymys--pohja .mk-kysymys__tuomio {
    font-size: var(--tk-koko-leipa);
    letter-spacing: 0;
}

.mk-kysymys--pohja .mk-kysymys__tulos--oikein .mk-kysymys__tuomio,
.mk-kysymys--pohja .mk-kysymys__tulos--oikein .mk-kysymys__vahva {
    color: var(--tk-tila-onnistuminen);
}

.mk-kysymys--pohja .mk-kysymys__tulos--vaarin .mk-kysymys__tuomio,
.mk-kysymys--pohja .mk-kysymys__tulos--vaarin .mk-kysymys__vahva {
    color: var(--tk-tila-virhe);
}

/* Napit: oljenkorret TOIMINTO, Jatka ja Aloita peli ensisijaisina (Aloita koko leveydeltä). */
.mk-kysymys--pohja .mk-kysymys__napit {
    margin-top: var(--tk-vali-m);
}

.mk-kysymys--pohja .mk-nappi.mk-kysymys__apu,
.mk-kysymys--pohja .mk-nappi.mk-kysymys__jatka {
    min-height: var(--tk-nappi-korkeus);
    padding: 0 var(--tk-vali-m);
    border-width: 1px;
    border-color: var(--tk-paperi-reunus);
    border-radius: var(--tk-kulma-nappi);
    background-color: initial;
    color: var(--tk-paperi-muste);
}

.mk-kysymys--pohja .mk-kysymys__apu .mk-nappi__teksti,
.mk-kysymys--pohja .mk-kysymys__jatka .mk-nappi__teksti {
    font-size: var(--tk-koko-apuri);
}

.mk-kysymys--pohja .mk-nappi.mk-kysymys__jatka {
    border-color: var(--tk-paperi-toiminto);
    background-color: var(--tk-paperi-toiminto);
}

.mk-kysymys--pohja .mk-kysymys__napit--keski > .mk-nappi.mk-kysymys__aloita {
    flex-grow: 1;
    min-width: 0;
    margin: var(--tk-vali-s) 0 var(--tk-vali-m) 0;
}
