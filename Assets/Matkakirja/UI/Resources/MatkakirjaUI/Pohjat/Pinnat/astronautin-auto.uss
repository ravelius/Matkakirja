/* ASTRONAUTIN KUVA: AUTO (Linssiseppä 2.10.2026; pinta Pohjat/auto.uss-pohjaosan päällä)
 * AUTO ASTRONAUTIN KUVASSA (omistaja 2.10.2026, web PR #3817 css/pohjat.css .tk-auto ja css/satelliitti.css .satelliitti-autokulma):
 * NOSTOKORTTI-pohjan osa AUTO. Kytkin "● AUTO" pillerinä ‹ ›:n ryhmässä keskellä (LASI-AVARUUS; päällä
 * toimintovärillä), TUMMA siirtolappu "Seuraava: <nimi> 3 s · Pysäytä" palkilla sen yläpuolella koko leveydellä. */
/* Päätoimittaja 2.10.: kytkin ‹ ›:n ryhmään keskelle ("AUTO ‹ ›"), ei vasempaan alakulmaan (osui pikkukuvanauhaan). */
.mk-astrokuva__autokulma {
    margin-right: var(--tk-vali-s);
    justify-content: center;
}

/* Ryhmä pystykeskelle (AUTO 38 pt, ‹ › 44 pt). */
.mk-astrokuva__kohteet {
    align-items: center;
}

.mk-astrokuva__auto {
    flex-direction: row;
    align-items: center;
    height: var(--tk-nappi-korkeus);
    min-height: var(--tk-nappi-korkeus);
    margin: 0;
    padding: 0 var(--tk-vali-m) 0 var(--tk-vali-m);
    border-width: 1px;
    border-radius: 19px; /* pilleri: puolet 38 pt:n korkeudesta (999 piirtyi UITK:ssa ellipsinä) */
    border-color: var(--tk-reunus);
    background-color: var(--tk-pinta);
    color: var(--tk-muste);
}

.mk-astrokuva__autopiste {
    width: var(--tk-vali-s);
    height: var(--tk-vali-s);
    margin-right: var(--tk-vali-xs);
    border-radius: 4px;
    background-color: var(--tk-muste);
    opacity: 0.45;
}

.mk-astrokuva__autoteksti {
    font-size: var(--tk-koko-apuri);
    letter-spacing: 6.4px; /* web 0.08em */
    color: var(--tk-muste);
}

.mk-astrokuva__auto.mk-valittu {
    border-color: var(--tk-toiminto);
    background-color: var(--tk-toiminto);
}

.mk-astrokuva__auto.mk-valittu .mk-astrokuva__autoteksti {
    color: var(--tk-paperi-muste);
}

.mk-astrokuva__auto.mk-valittu > .mk-astrokuva__autopiste {
    background-color: var(--tk-paperi-muste);
    opacity: 1;
}

.mk-astrokuva__autolappu {
    position: absolute;
    left: var(--tk-vali-m);
    right: var(--tk-vali-m);
    bottom: 68px; /* web calc(var(--tk-vali-m) * 2 + var(--tk-nappi-osuma)) */
    flex-direction: row;
    align-items: center;
    padding: var(--tk-vali-s) var(--tk-vali-s) var(--tk-vali-s) var(--tk-vali-l);
    border-width: 1px;
    border-radius: var(--tk-kulma-kortti);
    border-color: var(--tk-reunus);
    background-color: var(--tk-pinta);
    overflow: hidden;
}

.mk-astrokuva__autolapputeksti {
    flex-direction: row;
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    overflow: hidden;
}

.mk-astrokuva__autolappuohje,
.mk-astrokuva__autolappunimi {
    margin: 0 4px 0 0;
    padding: 0;
    font-size: var(--tk-koko-leipa);
    color: var(--tk-muste);
    -unity-text-overflow-position: end;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.mk-astrokuva__autolappunimi {
    flex-shrink: 1;
    overflow: hidden;
}

.mk-astrokuva__autolappuaika {
    margin: 0 var(--tk-vali-m) 0 var(--tk-vali-xs);
    padding: 0;
    font-size: var(--tk-koko-leipa);
    color: var(--tk-korostus);
}

.mk-astrokuva__autopysayta {
    height: var(--tk-nappi-korkeus);
    min-height: var(--tk-nappi-korkeus);
    margin: 0;
    padding: 0 var(--tk-vali-m) 0 var(--tk-vali-m);
    border-width: 1px;
    border-radius: var(--tk-kulma-nappi);
    border-color: var(--tk-toiminto);
    background-color: transparent;
    color: var(--tk-korostus);
    font-size: var(--tk-koko-apuri);
}

.mk-astrokuva__autopalkki {
    position: absolute;
    left: 0;
    bottom: 0;
    height: 3px;
    width: 0;
    background-color: var(--tk-toiminto);
}
