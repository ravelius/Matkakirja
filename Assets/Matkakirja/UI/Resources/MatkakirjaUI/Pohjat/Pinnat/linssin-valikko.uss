/* PANEELI (LASI)-pinta: linssin hampurilainen — LinssiValikko
 * Siirretty sellaisenaan (UI-pohjien tyylijako 2.10.2026, web #3820 css/pohjat/…): järjestys Matkakirja.tss:ssä. */

/* PANEELI (LASI): linssin hampurilainen (omistaja 1.10.2026, web #3810; LinssiValikko). Lasipinta ja -reunus, kulma kortti;
 * Poistu ja Aloita alusta TOIMINTO-riveinä 38 pt, viiva, kytkimet KYTKIN-riveinä (tila kapiteelina, päällä korostusvärillä). */
.mk-linssivalikko.mk-linssivalikko--pohja {
    min-width: 240px;
    padding: var(--tk-vali-s);
    border-color: var(--tk-lasi-reunus);
    border-radius: var(--tk-kulma-kortti);
    background-color: var(--tk-lasi-pinta);
}

.mk-linssivalikko--pohja .mk-linssivalikko__kohta {
    min-height: var(--tk-nappi-korkeus);
    margin: 0 0 var(--tk-vali-xs) 0;
    padding: 0 var(--tk-vali-m);
    border-radius: var(--tk-kulma-nappi);
    color: var(--tk-lasi-muste);
}

.mk-linssivalikko--pohja .mk-linssivalikko__komento {
    border-color: var(--tk-lasi-reunus);
}

.mk-linssivalikko--pohja .mk-linssivalikko__kohta .mk-nappi__teksti,
.mk-linssivalikko--pohja .mk-linssivalikko__nimi {
    font-size: var(--tk-koko-leipa);
    letter-spacing: 0;
    color: var(--tk-lasi-muste);
}

.mk-linssivalikko__viiva {
    height: 1px;
    margin: var(--tk-vali-xs) 0 var(--tk-vali-s) 0;
    background-color: var(--tk-lasi-reunus);
}

.mk-linssivalikko--pohja .mk-linssivalikko__tila {
    margin-left: var(--tk-vali-m);
    font-size: var(--tk-koko-kapiteeli);
    letter-spacing: 7.69px; /* web 0.12em */
    opacity: 1;
    color: var(--tk-lasi-muste-pehmea);
}

.mk-linssivalikko--pohja .mk-linssivalikko__kytkin.mk-valittu .mk-linssivalikko__tila {
    color: var(--tk-lasi-korostus);
}

/* LINNAN VALIKKO (omistaja 2.10.2026 klo 14.44, Natiivi-UI ohjausnappi-ehdotus.md kohta 8; LinnaValikko): sama LASI-lista,
 * lähteet vierityksenä apurikoossa, ja vasempaan yläkulmaan linnan pienoiskartta 120 × 58 pt (Linnanrakentajan kuva),
 * nykyinen huone 8 pt:n pisteenä (--tk-korostus, reunus 1,5 pt --tk-pinta, ei hehkua; teema tk-teema-lasi). */
.mk-linssivalikko--pohja .mk-linssivalikko__lahde {
    margin: 0 var(--tk-vali-m) var(--tk-vali-xs) var(--tk-vali-m);
    font-size: var(--tk-koko-apuri);
    white-space: normal;
    color: var(--tk-lasi-muste-pehmea);
}

/* Pienoiskartan ohjausryhmä vasempaan yläkulmaan (yläreuna ☰:n tasolla); kehys on .mk-ohjausnappi--iso. */
.mk-ohjausryhma.mk-minikartta-ryhma {
    right: auto;
    left: var(--tk-vali-s);
}

.mk-minikartta-ryhma > .mk-ohjausnappi {
    margin: 0;
}

.mk-minikartta {
    position: absolute;
    -unity-background-scale-mode: scale-to-fit;
}

.mk-minikartta__piste {
    position: absolute;
    width: 7px;
    height: 7px;
    margin-left: -3.5px;
    margin-top: -3.5px;
    border-width: 1.5px;
    border-radius: 3.5px;
    border-color: var(--tk-pinta);
    background-color: var(--tk-korostus);
}

/* ELÄVÄ OPAS NYKYAJASSA (omistaja 5.10.2026 klo 20.5x): sama LASI-lista ja oppaan kuvakortti harmaan lasin tokeneilla
 * (tk-teema-harmaa, OHJAUSNAPPI-pohjan oletus valokuvan ja 3D:n päällä); kirjasin Moderni koodista (OpasValikko). */
/* Luettavuus kaupunkikuvan päällä (Päätoimittaja 5.10. klo 21.1x): teeman peittävä pinta, ei läpikuultavaa lasia. */
.mk-linssivalikko.mk-linssivalikko--pohja.tk-teema-harmaa {
    border-color: var(--tk-reunus);
    background-color: var(--tk-pinta-peitto);
}

.tk-teema-harmaa.mk-linssivalikko--pohja .mk-linssivalikko__kohta,
.tk-teema-harmaa.mk-linssivalikko--pohja .mk-linssivalikko__kohta .mk-nappi__teksti,
.tk-teema-harmaa.mk-linssivalikko--pohja .mk-linssivalikko__nimi {
    color: var(--tk-muste);
}

.tk-teema-harmaa.mk-linssivalikko--pohja .mk-linssivalikko__komento {
    border-color: var(--tk-reunus);
}

.tk-teema-harmaa.mk-linssivalikko--pohja .mk-linssivalikko__tila,
.tk-teema-harmaa.mk-linssivalikko--pohja .mk-linssivalikko__lahde {
    color: var(--tk-muste-pehmea);
}

.tk-teema-harmaa.mk-linssivalikko--pohja .mk-linssivalikko__viiva {
    background-color: var(--tk-reunus);
}

.mk-nosto.tk-teema-harmaa {
    border-color: var(--tk-reunus);
    background-color: var(--tk-pinta);
}

.mk-nosto.tk-teema-harmaa .mk-nosto__havainne {
    color: var(--tk-muste);
}

/* OPPAAN KOHTEEN NIMILAPPU (omistaja 5.10.2026 klo 21.3x, juna 145): linnan NIMILAPPU-pohjan rakenne (lappu, pystyviiva, nasta)
 * harmaan lasin tokeneilla, kirjasin ModerniLihava koodista (OpasNimilappu). Paikka koodista joka ruudulla. */
.mk-opas-nimilappu {
    position: absolute;
    padding: 3px 8px 3px 8px;
    border-width: 1px;
    border-color: var(--tk-reunus);
    border-radius: var(--tk-kulma-pieni);
    background-color: var(--tk-pinta-peitto);
    color: var(--tk-korostus);
    font-size: var(--tk-koko-apuri);
    -unity-text-align: middle-center;
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.2s;
}

.mk-opas-nimilappu__viiva {
    position: absolute;
    width: 1.5px;
    background-color: var(--tk-korostus);
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.2s;
}

.mk-opas-nimilappu__nasta {
    position: absolute;
    width: 8px;
    height: 8px;
    border-width: 1px;
    border-color: var(--tk-pinta-peitto);
    border-radius: 4px;
    background-color: var(--tk-korostus);
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.2s;
}

.mk-opas-nimilappu--nakyy {
    opacity: 1;
}
