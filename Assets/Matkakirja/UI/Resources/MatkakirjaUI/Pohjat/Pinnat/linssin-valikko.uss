/* PANEELI (LASI)-pinta: linssin hampurilainen — LinssiValikko
 * Siirretty sellaisenaan (UI-pohjien tyylijako 2.10.2026, web #3820 css/pohjat/…): järjestys Matkakirja.tss:ssä. */

/* PANEELI (LASI): linssin hampurilainen (omistaja 1.10.2026, web #3810; LinssiValikko). Lasipinta ja -reunus, kulma kortti;
 * Poistu ja Aloita alusta TOIMINTO-riveinä 38 pt, viiva, kytkimet KYTKIN-riveinä (tila kapiteelina, päällä korostusvärillä). */
.mk-linssivalikko.mk-linssivalikko--pohja {
    min-width: 240px;
    padding: var(--tk-vali-s);
    border-color: var(--tk-lasi-reunus);
    border-radius: var(--tk-kulma-kortti);
    background-color: var(--tk-lasi-pinta);
}

.mk-linssivalikko--pohja .mk-linssivalikko__kohta {
    min-height: var(--tk-nappi-korkeus);
    margin: 0 0 var(--tk-vali-xs) 0;
    padding: 0 var(--tk-vali-m);
    border-radius: var(--tk-kulma-nappi);
    color: var(--tk-lasi-muste);
}

.mk-linssivalikko--pohja .mk-linssivalikko__komento {
    border-color: var(--tk-lasi-reunus);
}

.mk-linssivalikko--pohja .mk-linssivalikko__kohta .mk-nappi__teksti,
.mk-linssivalikko--pohja .mk-linssivalikko__nimi {
    font-size: var(--tk-koko-leipa);
    letter-spacing: 0;
    color: var(--tk-lasi-muste);
}

.mk-linssivalikko__viiva {
    height: 1px;
    margin: var(--tk-vali-xs) 0 var(--tk-vali-s) 0;
    background-color: var(--tk-lasi-reunus);
}

.mk-linssivalikko--pohja .mk-linssivalikko__tila {
    margin-left: var(--tk-vali-m);
    font-size: var(--tk-koko-kapiteeli);
    letter-spacing: 7.69px; /* web 0.12em */
    opacity: 1;
    color: var(--tk-lasi-muste-pehmea);
}

.mk-linssivalikko--pohja .mk-linssivalikko__kytkin.mk-valittu .mk-linssivalikko__tila {
    color: var(--tk-lasi-korostus);
}

/* LINNAN VALIKKO (omistaja 2.10.2026 klo 14.44, Natiivi-UI ohjausnappi-ehdotus.md kohta 8; LinnaValikko): sama LASI-lista,
 * lähteet vierityksenä apurikoossa, ja vasempaan yläkulmaan linnan pienoiskartta 120 × 58 pt (Linnanrakentajan kuva),
 * nykyinen huone 8 pt:n pisteenä (--tk-korostus, reunus 1,5 pt --tk-pinta, ei hehkua; teema tk-teema-lasi). */
.mk-linssivalikko--pohja .mk-linssivalikko__lahde {
    margin: 0 var(--tk-vali-m) var(--tk-vali-xs) var(--tk-vali-m);
    font-size: var(--tk-koko-apuri);
    white-space: normal;
    color: var(--tk-lasi-muste-pehmea);
}

/* Pienoiskartan ohjausryhmä vasempaan yläkulmaan (yläreuna ☰:n tasolla); kehys on .mk-ohjausnappi--iso. */
.mk-ohjausryhma.mk-minikartta-ryhma {
    right: auto;
    left: var(--tk-vali-s);
}

.mk-minikartta-ryhma > .mk-ohjausnappi {
    margin: 0;
}

.mk-minikartta {
    position: absolute;
    -unity-background-scale-mode: scale-to-fit;
}

.mk-minikartta__piste {
    position: absolute;
    width: 7px;
    height: 7px;
    margin-left: -3.5px;
    margin-top: -3.5px;
    border-width: 1.5px;
    border-radius: 3.5px;
    border-color: var(--tk-pinta);
    background-color: var(--tk-korostus);
}

/* ELÄVÄ OPAS NYKYAJASSA (omistaja 5.10.2026 klo 20.5x): sama LASI-lista ja oppaan kuvakortti harmaan lasin tokeneilla
 * (tk-teema-harmaa, OHJAUSNAPPI-pohjan oletus valokuvan ja 3D:n päällä); kirjasin Moderni koodista (OpasValikko). */
/* Luettavuus kaupunkikuvan päällä (Päätoimittaja 5.10. klo 21.1x): teeman peittävä pinta, ei läpikuultavaa lasia. */
.mk-linssivalikko.mk-linssivalikko--pohja.tk-teema-harmaa {
    border-color: var(--tk-reunus);
    background-color: var(--tk-pinta-peitto);
}

.tk-teema-harmaa.mk-linssivalikko--pohja .mk-linssivalikko__kohta,
.tk-teema-harmaa.mk-linssivalikko--pohja .mk-linssivalikko__kohta .mk-nappi__teksti,
.tk-teema-harmaa.mk-linssivalikko--pohja .mk-linssivalikko__nimi {
    color: var(--tk-muste);
}

.tk-teema-harmaa.mk-linssivalikko--pohja .mk-linssivalikko__komento {
    border-color: var(--tk-reunus);
}

/* LIVE-LAATIKKO (omistaja 8.10.2026 klo 09.1x, pallon säätila): ☾-listan ylin rivi omana korostettuna pyöristettynä
 * suorakulmiona; pois teeman toiminto-harmaa, päällä tila-live (oranssi). */
.tk-teema-harmaa.mk-linssivalikko--pohja .mk-linssivalikko__kohta.mk-linssivalikko__live {
    margin-bottom: var(--tk-vali-s);
    border-radius: var(--tk-kulma-nappi);
    background-color: var(--tk-toiminto);
}

.tk-teema-harmaa.mk-linssivalikko--pohja .mk-linssivalikko__kohta.mk-linssivalikko__live.mk-valittu {
    background-color: var(--tk-tila-live);
}

.tk-teema-harmaa.mk-linssivalikko--pohja .mk-linssivalikko__tila,
.tk-teema-harmaa.mk-linssivalikko--pohja .mk-linssivalikko__lahde {
    color: var(--tk-muste-pehmea);
}

.tk-teema-harmaa.mk-linssivalikko--pohja .mk-linssivalikko__viiva {
    background-color: var(--tk-reunus);
}

.mk-nosto.tk-teema-harmaa {
    border-color: var(--tk-reunus);
    background-color: var(--tk-pinta);
}

.mk-nosto.tk-teema-harmaa .mk-nosto__havainne {
    color: var(--tk-muste);
}

/* OPPAAN KOHTEEN NIMILAPPU (omistaja 5.10.2026 klo 21.3x, juna 145): linnan NIMILAPPU-pohjan rakenne (lappu, pystyviiva, nasta)
 * harmaan lasin tokeneilla, kirjasin ModerniLihava koodista (OpasNimilappu). Paikka koodista joka ruudulla. */
.mk-opas-nimilappu {
    position: absolute;
    padding: 3px 8px 3px 8px;
    border-width: 1px;
    border-color: var(--tk-reunus);
    border-radius: var(--tk-kulma-pieni);
    background-color: var(--tk-pinta-peitto);
    color: var(--tk-korostus);
    font-size: var(--tk-koko-apuri);
    -unity-text-align: middle-center;
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.2s;
}

.mk-opas-nimilappu__viiva {
    position: absolute;
    width: 1.5px;
    background-color: var(--tk-korostus);
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.2s;
}

.mk-opas-nimilappu__nasta {
    position: absolute;
    width: 8px;
    height: 8px;
    border-width: 1px;
    border-color: var(--tk-pinta-peitto);
    border-radius: 4px;
    background-color: var(--tk-korostus);
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.2s;
}

.mk-opas-nimilappu--nakyy {
    opacity: 1;
}

/* NYT-RIVI (Päätoimittaja 9.10.2026, loki #4288): sama nimilappu ilman viivaa ja nastaa vasempaan alakulmaan (NytRivi.cs);
 * näkyvissä --nakyy-luokalla Nimikyltin ajan, häivytys Nimikyltin omalla opasiteetilla. */
.mk-opas-nimilappu--nytrivi {
    left: var(--tk-vali-xl);
    bottom: var(--tk-vali-xl);
}

/* OPPAAN NELJÄ NAPPIA (omistaja 6.10.2026 klo 11.5x): Kysy, Liiku, mikrofoni ja näppäimistö keskellä alhaalla krediittien
 * yläpuolella. Pohja LIIKU-nappi (.mk-liiku__nappi, pyöristetty neliö), teema rivin tk-teema-harmaasta; teksti ja kuvake
 * keskitettyinä. VAIN --tk-*-tokenit. */
.mk-opas-napit {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 40px;
    flex-direction: row;
    justify-content: center;
    align-items: center;
    transition-property: opacity;
    transition-duration: 0.2s;
}

.mk-liiku__nappi.mk-opas-nappi {
    height: var(--tk-nappi-korkeus); /* omistaja 6.10. 19.5x: nappi.korkeus 38 pt */
    min-width: 88px;
    margin: 0 4px;
    padding: 0 14px;
    border-width: 1px;
    border-radius: var(--tk-kulma-nappi);
    border-color: var(--tk-reunus);
    background-color: var(--tk-pinta); /* omistaja 6.10. 16.3x: läpinäkyvämpi lasi (harmaan lasiteeman pinta, ei peittävä) */
    color: var(--tk-korostus);
    flex-direction: row;
    justify-content: center;
    align-items: center;
}

.mk-liiku__nappi.mk-opas-nappi:active,
.mk-liiku__nappi.mk-opas-nappi.mk-valittu {
    background-color: var(--tk-toiminto);
}

.mk-liiku__nappi.mk-opas-nappi--ikoni {
    min-width: var(--tk-nappi-korkeus);
    width: var(--tk-nappi-korkeus);
    padding: 0;
}

.mk-liiku__nappi.mk-opas-nappi > .mk-ikoni.mk-opas-nappi__ikoni {
    display: flex;
    width: 20px;
    height: 20px;
    flex-shrink: 0;
    align-self: center;
    margin-right: 0; /* .mk-nappi > .mk-ikoni 7 px siirsi mikin ja näppäimistön vasemmalle (stillit 154: ~3 pt) */
}

.mk-liiku__nappi.mk-opas-nappi .mk-nappi__teksti.mk-opas-nappi__teksti {
    margin: 0 0 0 var(--tk-vali-s);
    padding: 0;
    font-size: var(--tk-koko-leipa);
    letter-spacing: 0;
    text-shadow: none;
    color: var(--tk-korostus);
    -unity-text-align: middle-center;
}

/* Oppaan näppäimistö: Pulun syöttörivi lasiteemassa nappirivin yläpuolella, kirjoitus menee suoraan oppaalle. */
.mk-opas-kirjoitus {
    position: absolute;
    left: var(--tk-vali-m);
    right: var(--tk-vali-m);
    bottom: 92px;
    padding: 6px;
    border-width: 1px;
    border-radius: var(--tk-kulma-nappi);
    border-color: var(--tk-reunus);
    background-color: var(--tk-pinta-peitto);
}

/* OPPAAN ALOITUS ILMAN KARTTAA (omistaja 6.10.2026 13.4x; OpasValikko.aloitus): sama linssivalikko koko ruutuna TUMMALLA
 * teemalla (lasin muuttujat tumman teeman arvoiksi, tekstit vaaleina), kaksi saraketta: paikat ja suosikit (LINSSIRIVI).
 * Puhelimella pystyssä (--pino) paikat ylhäällä ja suosikit alla. */
.mk-linssivalikko.mk-linssivalikko--pohja.mk-opas-aloitus {
    --tk-lasi-pinta: var(--tk-tumma-pinta);
    --tk-lasi-muste: var(--tk-tumma-muste);
    --tk-lasi-muste-pehmea: var(--tk-tumma-muste-pehmea);
    --tk-lasi-reunus: var(--tk-tumma-reunus);
    --tk-lasi-korostus: var(--tk-tumma-korostus);
    position: absolute;
    flex-direction: row;
    max-width: none;
    border-width: 0;
    border-radius: 0;
    background-color: var(--tk-tumma-pinta);
}

/* Sama tarkkuus kuin yllä (kolme luokkaa + pino), muuten rivi voittaa (simu 16.08: puhelin jäi kahdelle sarakkeelle). */
.mk-linssivalikko.mk-linssivalikko--pohja.mk-opas-aloitus.mk-opas-aloitus--pino {
    flex-direction: column;
}

.mk-opas-aloitus__sarake {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    margin: 0 var(--tk-vali-s);
}

.mk-opas-aloitus--pino .mk-opas-aloitus__sarake {
    margin: 0 0 var(--tk-vali-m) 0;
}

.mk-opas-aloitus--pino .mk-opas-aloitus__sarake--paikat {
    flex-grow: 0;
    flex-basis: auto;
}

.mk-opas-aloitus__lista {
    flex-shrink: 1;
}

.mk-opas-aloitus .mk-linssivalitsin__valiotsikko,
.mk-opas-aloitus .mk-linssirivi__lyhyt {
    color: var(--tk-tumma-muste-pehmea);
}

.mk-opas-aloitus .mk-linssirivi__nimi {
    color: var(--tk-tumma-muste);
}

/* Oppaan listat harmaalla lasilla (omistaja 6.10. 16.3x): otsikot valkoisina, tarkennukset vaaleina mutta himmeämpinä. */
.tk-teema-harmaa.mk-linssivalikko--pohja .mk-linssirivi__nimi {
    color: var(--tk-harmaa-korostus);
}

.tk-teema-harmaa.mk-linssivalikko--pohja .mk-linssirivi__lyhyt,
.tk-teema-harmaa.mk-linssivalikko--pohja .mk-linssivalitsin__valiotsikko {
    color: var(--tk-harmaa-muste-pehmea);
}

/* Oppaan vapaa tila (juna 152): pieni tähtäin ruudun keskelle (katsepiste = keskikohdan maapiste, Mikä tämä on?). */
.mk-opas-tahtain {
    position: absolute;
    left: 50%;
    top: 50%;
    width: var(--tk-vali-xl);
    height: var(--tk-vali-xl);
    translate: -50% -50%;
    color: var(--tk-harmaa-korostus);
}

.mk-opas-tahtain > .mk-ikoni.mk-opas-tahtain__ikoni {
    width: 100%;
    height: 100%;
}

/* VÄKÄNEN (omistaja 6.10.2026 klo 19.5x, Päätoimittaja): neljä nappia OHJAUSNAPPI-väkäsen › alla vasemmassa reunassa; liuku
 * esiin väkäsestä oikealle --tk-kesto-liuku (240 ms), ikkuna leikkaa. Napit nappi.korkeus (38 pt) samalla keskilinjalla
 * tasavälein. Paikka ja korkeus koodista. VAIN --tk-*-tokenit. */
.mk-opas-napit.mk-opas-napit--vakanen {
    right: auto;
    justify-content: flex-start;
}

.mk-opas-napit--vakanen > .mk-ohjausnappi {
    margin: 0;
}

.mk-opas-napit__ikkuna {
    flex-direction: row;
    align-items: center;
    height: 100%;
    overflow: hidden;
}

.mk-opas-napit__liuku {
    flex-direction: row;
    align-items: center;
    padding-left: var(--tk-vali-xs);
    translate: -100% 0;
    opacity: 0;
    transition-property: translate, opacity;
    transition-duration: 0.24s, 0.24s; /* --tk-kesto-liuku */
}

.mk-opas-napit--auki .mk-opas-napit__liuku {
    translate: 0 0;
    opacity: 1;
}

/* Kuvanappi: OHJAUSNAPPI-iso ilman kehystä, kuva täyttää neliön kulma.nappi-pyöristyksellä; nipun kuvamäärä kulmassa. */
.mk-ohjausnappi.mk-ohjausnappi--iso.mk-ohjausnappi--kuva {
    margin: 0;
    padding: 0;
    border-width: 0;
    overflow: hidden;
}

.mk-ohjausnappi__kuva {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    -unity-background-scale-mode: scale-and-crop;
}

.mk-ohjausnappi--kuva > .mk-nosto__laskuri {
    right: var(--tk-vali-xs);
    bottom: var(--tk-vali-xs);
}

/* YÖ (omistaja 9.10.2026 "Tee vain niin"; Päätoimittaja): pallotilan ☰-, ☀- ja Kysy-listat yöllä olemassa olevalla tummalla
 * teemalla (tk-teema-tumma, kuten videopelien tummat kortit), päivällä harmaa ennallaan. OpasValikko vaihtaa teemaluokan
 * Saatila.Aika:n mukaan. Tummassa teemassa ei ole pinta-peittoa: pinta on jo peittävä. LIVE pois = teeman reunus, päällä tila-live. */
.mk-linssivalikko.mk-linssivalikko--pohja.tk-teema-tumma {
    border-color: var(--tk-reunus);
    background-color: var(--tk-pinta);
}

.tk-teema-tumma.mk-linssivalikko--pohja .mk-linssivalikko__kohta,
.tk-teema-tumma.mk-linssivalikko--pohja .mk-linssivalikko__kohta .mk-nappi__teksti,
.tk-teema-tumma.mk-linssivalikko--pohja .mk-linssivalikko__nimi {
    color: var(--tk-muste);
}

.tk-teema-tumma.mk-linssivalikko--pohja .mk-linssivalikko__komento {
    border-color: var(--tk-reunus);
}

.tk-teema-tumma.mk-linssivalikko--pohja .mk-linssivalikko__kohta.mk-linssivalikko__live {
    margin-bottom: var(--tk-vali-s);
    border-radius: var(--tk-kulma-nappi);
    background-color: var(--tk-reunus);
}

.tk-teema-tumma.mk-linssivalikko--pohja .mk-linssivalikko__kohta.mk-linssivalikko__live.mk-valittu {
    background-color: var(--tk-tila-live);
}

.tk-teema-tumma.mk-linssivalikko--pohja .mk-linssivalikko__tila,
.tk-teema-tumma.mk-linssivalikko--pohja .mk-linssivalikko__lahde,
.tk-teema-tumma.mk-linssivalikko--pohja .mk-linssivalitsin__valiotsikko {   /* KYSY OPPAALTA yöllä (UI-kuva-arkki 9.10.: oli tumma tummalla) */
    color: var(--tk-muste-pehmea);
}

.tk-teema-tumma.mk-linssivalikko--pohja .mk-linssivalikko__viiva {
    background-color: var(--tk-reunus);
}
