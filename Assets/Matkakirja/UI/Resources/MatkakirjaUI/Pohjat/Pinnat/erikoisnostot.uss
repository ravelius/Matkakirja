/* ERIKOISNOSTOT (pinta; omistaja 2.10.2026 klo 12.34, 16.4x ja 16.5x; web css/pohjat/erikoisnostot.css #3866, tyylikirja.json
 * pohjat.ERIKOISNOSTOT): koko ruudun läpinäkyvä kerros, jossa jokainen PÄÄ on karttaobjekti omassa karttapisteessään
 * (UI/Erikoisnostot.cs asettaa left/top). Osa PÄÄ: 3D-pää ja sen varjo paperilla läpinäkyvällä kankaalla (1,5 × pää = 96),
 * ilman kehystä; osuma ≥ 44; nimi vain VoiceOverille. VAIN --tk-*-tokenit. */
.mk-erikoisnostot {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.mk-erikoisnosto-paa {
    position: absolute;
    width: 96px;
    height: 96px;
    min-width: var(--tk-nappi-osuma);
    min-height: var(--tk-nappi-osuma);
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding: 0;
    border-width: 0;
}

/* Varjo ja pää samassa kehyksessä napin kokoisina (varjo ensin, pää päälle). */
.mk-erikoisnosto-paa__kuva {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    -unity-background-scale-mode: stretch-to-fill;
}

/* LAUTAPELINOSTO (omistaja 11.10.2026 PT:n kautta, juna 182; UI/Lautapelinostot.cs): pyöreä sininen videopelilevy pelin
 * viivaikonilla (tyylikirja teemat.videopeli), alla sininen hehkurengas (mk-nosto-merkki__hehku--videopeli, syke). */
.mk-lautapelinosto {
    width: 44px;
    height: 44px;
    background-color: initial;
    overflow: visible;
}

.mk-lautapelinosto__hehku {
    left: -26px;
    top: -26px;
    width: 96px;
    height: 96px;
}

.mk-lautapelinosto__levy {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    border-width: 1.5px;
    border-radius: 22px;
    border-color: var(--tk-videopeli-korostus);
    background-color: var(--tk-videopeli-pinta);
}

.mk-lautapelinosto__ikoni {
    width: 24px;
    height: 24px;
    color: var(--tk-videopeli-muste);
}
