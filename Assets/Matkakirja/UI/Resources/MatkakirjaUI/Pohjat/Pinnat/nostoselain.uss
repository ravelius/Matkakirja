/* NOSTOSELAIN (NOSTOKORTTI-osa) — Nostoselain
 * Siirretty sellaisenaan (UI-pohjien tyylijako 2.10.2026, web #3820 css/pohjat/…): järjestys Matkakirja.tss:ssä. */

/* NOSTOSELAIN ja AUTO (omistaja 1.10.2026, mallit 20 + 22 + 23; Nostoselain.cs): NOSTOKORTTI-pohjan osat tyylikirjan arvoilla.
 * Rivi ‹ [Nostot ▾] › vetokahvan alla (TOIMINTO-nappi), PANEELI (paperi) rivin alla, AUTO-pilleri lukijan rivillä ja
 * siirtolaskurin lappu (LASI) kortin alareunassa. */

/* Yksi ylärivi (omistaja 2.10.2026 klo 13.53 ja 17.5x): ‹ NOSTOT ▾ › ja kategoria vasemmalla, ≡ kaiutin AUTO oikealla, kaikki
 * HISTORIA-otsakkeen kokoisina ja kevyinä (rivillä myös .mk-nosto__ylarivi: kirjasin, harvennus ja väri periytyvät). */
.mk-nostoselain {
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    flex-shrink: 0;
    margin: var(--tk-vali-xs) 0 var(--tk-vali-s) 0;
}

.mk-nostoselain__askel {
    width: 32px; /* osuma-ala 44 pt Kosketusnappi-laajennuksella; tilaa kategorialle ja lukijalle samalla rivillä */
    min-height: var(--tk-nappi-osuma);
    padding: 0;
    border-width: 0;
    align-items: center;
    justify-content: center;
    background-color: initial;
    color: var(--tk-paperi-muste); /* sama kuin kaiutin (Päätoimittaja 20.0x: ‹ › olivat haaleat) */
}

/* ‹ › piirroksina ≡:n ja kaiuttimen kokoisina, keskellä rivin keskilinjaa (merkkinä › jäi 4 px alemmas). */
.mk-nostoselain__askel > .mk-ikoni {
    width: 20px;
    height: 20px;
    margin-right: 0;
}

/* NOSTOT ▾ ilman kehystä HISTORIA-tyylisenä tekstinä (omistaja 18.4x). */
.mk-nostoselain__avaaja {
    height: 26px;
    min-height: 26px;
    margin: 0;
    padding: 0 var(--tk-vali-xs);
    border-width: 0;
    border-radius: var(--tk-kulma-pieni);
    background-color: initial;
    color: var(--tk-paperi-korostus); /* sama kuin HISTORIA (.mk-nosto__ylarivi) */
}

/* Sivut yhtä leveinä (flex 1, perusta 0): keskiryhmä ‹ NOSTOT ▾ › AUTO keskellä, kategoria vasemmalla, ≡ ja kaiutin oikealla
 * (omistaja 2.10.2026 klo 18.4x). */
.mk-nostoselain__sivu {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    min-width: 0;
    flex-direction: row;
    align-items: center;
}

.mk-nostoselain__sivu--oikea {
    justify-content: flex-end;
    /* Optinen keskitys: ‹-piirros alkaa ~10 pt napin reunasta, AUTO:n kehys reunasta → ryhmä 5 pt vasemmalle, jotta
     * näkyvä ‹ … AUTO on rivin keskellä (Päätoimittaja 20.0x: ryhmä ~6 pt oikealla). */
    margin-left: 10px;
}

.mk-nostoselain__sivu > .mk-nosto__ylarivi {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    align-items: center;
    margin: 0;
}

.mk-nostoselain__sivu .mk-nosto__lukijapaikka {
    margin: 0;
}

.mk-nostoselain__sivu .mk-nosto__ylarivi-symboli {
    margin-right: var(--tk-vali-xs);
}

.mk-nostoselain__sivu .mk-nosto__ylarivi-teksti {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.mk-nostoselain--kapea .mk-nostoselain__sivu .mk-nosto__ylarivi-teksti {
    display: none;
}

/* Puhelimella keskiryhmä tiiviimmäksi, jotta ≡ ja kaiutin mahtuvat oikealle (osuma-ala pysyy 44 pt laajennuksella). */
.mk-nostoselain--kapea .mk-nostoselain__askel {
    width: 26px;
}

.mk-nostoselain__avaajaikoni {
    width: 16px;
    height: 16px;
    margin-left: var(--tk-vali-xs);
    color: var(--tk-paperi-muste-pehmea);
}

/* .mk-nappi > .mk-ikoni antoi ▾:lle 7 px oikean marginaalin: NOSTOT ▾ ei ollut ‹ ›:n keskellä (Päätoimittaja 20.0x). */
.mk-nostoselain__avaaja > .mk-nostoselain__avaajaikoni {
    /* ▾-piirroksen muste päättyy 11/16 laatikosta: oikea tyhjä 5 pt tasataan, jotta näkyvät välit N:n vasemmalla ja ▾:n
     * oikealla ovat samat (Päätoimittaja 20.1x: 13 vs 27 px @3x). */
    margin-right: -4.67px;
}

.mk-nostoselain__avaaja.mk-valittu {
    background-color: var(--tk-paperi-toiminto);
}

/* Ei kehystä (omistaja 17.5x, loki cc217e829): paneeli on kortin paperia, yläreunassa vain ohut viiva. */
.mk-nostoselain__paneeli {
    position: absolute;
    left: var(--tk-vali-s);
    right: var(--tk-vali-s);
    bottom: var(--tk-vali-s);
    padding: var(--tk-vali-s) var(--tk-vali-m) var(--tk-vali-s) var(--tk-vali-m);
    border-width: 0;
    border-top-width: 1px;
    border-color: var(--tk-paperi-reunus);
    border-radius: var(--tk-kulma-kortti);
    background-color: var(--tk-paperi-pinta);
    color: var(--tk-paperi-muste);
}

.mk-nostoselain__otsikko {
    margin-bottom: var(--tk-vali-s);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.mk-nostoselain__sirut {
    flex-shrink: 0;
    margin-bottom: var(--tk-vali-s);
}

.mk-nostoselain__sirurivi {
    flex-direction: row;
}

.mk-nostoselain__siru {
    min-height: 32px;
    margin-right: 6px;
    padding: 0 var(--tk-vali-m);
    border-color: var(--tk-paperi-reunus);
    border-radius: var(--tk-kulma-nappi); /* suodattimet pyöristettyinä suorakulmioina, ei kapseleita (omistaja 17.5x) */
    background-color: initial;
    color: var(--tk-paperi-muste);
}

.mk-nostoselain__siru > .mk-nappi__teksti {
    font-size: var(--tk-koko-apuri);
}

.mk-nostoselain__siru.mk-valittu {
    border-color: var(--tk-paperi-korostus);
    background-color: var(--tk-paperi-toiminto);
}

.mk-nostoselain__lista {
    flex-grow: 1;
    flex-shrink: 1;
}

/* Kehyksettömät rivit, jakoviiva välissä kuten valikko v2:ssa (omistaja 17.5x). */
.mk-nostoselain__rivi {
    min-height: var(--tk-nappi-osuma);
    margin: 0;
    padding: 0 var(--tk-vali-xs);
    justify-content: flex-start;
    border-width: 0;
    border-radius: 0;
    background-color: initial;
    color: var(--tk-paperi-muste);
}

.mk-nostoselain__rivi--viiva {
    border-top-width: 1px;
    border-color: var(--tk-paperi-reunus);
}

.mk-nostoselain__rivi--nykyinen {
    background-color: var(--tk-paperi-pergamentti);
}

.mk-nostoselain__rivi--luettu {
    opacity: 0.55;
}

.mk-nostoselain__nimi {
    flex-grow: 1;
    flex-shrink: 1;
    font-size: var(--tk-koko-apuri);
    overflow: hidden;
    text-overflow: ellipsis;
}

.mk-nostoselain__luettu {
    margin-left: var(--tk-vali-s);
    font-size: var(--tk-koko-apuri);
    color: var(--tk-paperi-korostus);
}

.mk-nostoselain__nuoli {
    margin-left: var(--tk-vali-s);
    font-size: var(--tk-koko-valiotsikko);
    color: var(--tk-paperi-muste-pehmea);
}

/* JUNA 153 (omistaja 6.10. 19.2x, Kronborg: "pakattu turhaan liian tiheään … kaikkien ylärivillä olevien elementtien korkeus
 * samaksi"): sulka vasempaan reunaan ja ‹ NOSTOT ▾ › heti sen viereen; oikealle AUTO, pin, ≡ ja kaiutin tasaväleillä. Kaikki
 * ylärivin elementit nappi.korkeus 38 pt, kuvakkeet nappi.ohjaus-kuvake 22 pt; AUTO päällä vaaleana kultana (kulta-kuulto). */
.mk-nostoselain__sivu.mk-nostoselain__sivu--vasen {
    flex-grow: 0;
    flex-basis: auto;
    margin-right: var(--tk-vali-xs);
}

.mk-nostoselain__sivu.mk-nostoselain__sivu--oikea {
    margin-left: 0;
}

.mk-nostoselain__sivu--oikea > .mk-nostoselain__auto,
.mk-nostoselain__sivu--oikea > .mk-lukija,
.mk-nostoselain__sivu--oikea > .mk-nosto__lukijapaikka {
    margin-left: var(--tk-vali-s);
    margin-right: 0;
}

.mk-nostoselain .mk-nostoselain__auto,
.mk-nostoselain .mk-nostoselain__avaaja {
    height: var(--tk-nappi-korkeus);
    min-height: var(--tk-nappi-korkeus);
}

.mk-nostoselain .mk-lukija.mk-nosto__pin {
    width: var(--tk-nappi-korkeus);
    height: var(--tk-nappi-korkeus);
    min-height: var(--tk-nappi-korkeus);
}

.mk-nostoselain .mk-lukija.mk-nosto__pin > .mk-ikoni,
.mk-nostoselain .mk-nosto__ylarivi-symboli {
    width: var(--tk-nappi-ohjaus-kuvake);
    height: var(--tk-nappi-ohjaus-kuvake);
}

/* Lukijan ≡ ja kaiutin (kortin päällä, paikkavaraus ylärivillä): sama 38 pt, väli kuten muilla, kuvakkeet 22 pt. */
.mk-nosto__lukija .mk-lukija,
.mk-nosto__lukija .mk-lukija__valikkonappi {
    width: var(--tk-nappi-korkeus);
    height: var(--tk-nappi-korkeus);
    min-height: var(--tk-nappi-korkeus);
}

.mk-nosto__lukija .mk-lukija__valikkonappi {
    margin-right: var(--tk-vali-s);
}

.mk-nosto__lukija .mk-lukija > .mk-ikoni,
.mk-nosto__lukija .mk-lukija__valikkoikoni {
    width: var(--tk-nappi-ohjaus-kuvake);
    height: var(--tk-nappi-ohjaus-kuvake);
}

/* JUNA 154 (omistaja 6.10. 20.4x–20.5x, Päätoimittaja: "liian levoton … osa mustalla ja osa toisella värillä"): ylärivi
 * rauhalliseksi vain tyylikirjan arvoilla.
 *   YKSI VÄRI: sulka, ‹ ›, NOSTOT ▾, AUTO, pin, ≡ ja kaiutin paperin musteella (--tk-paperi-muste); ei kultaa kuvakkeissa
 *   eikä tekstissä.
 *   AUTO: ei kehystä; päällä kulta-kuulto-tausta, tumma teksti ja pieni piste; pois päältä ei taustaa eikä pistettä;
 *   kulma.nappi, korkeus nappi.korkeus.
 *   VAHVISTUS: ‹ › ja ≡ viiva 2,1 (pinnin optinen paino); sulka, pin ja kaiutin optisesti samankorkuisiksi (muste ~15 pt).
 *   NOSTOT- ja AUTO-tekstin harvennus puoleen, ettei rivi näytä erilliseltä otsikolta. Ryhmien (‹ NOSTOT › | AUTO | pin ≡
 *   kaiutin) väli hieman isompi kuin ryhmän sisällä. Osuma-alat 44 pt (Kosketusnappi). */
.mk-nostoselain,
.mk-nostoselain .mk-nosto__ylarivi,
.mk-nostoselain .mk-nostoselain__askel,
.mk-nostoselain .mk-nostoselain__avaaja,
.mk-nostoselain .mk-nostoselain__avaajaikoni,
.mk-nostoselain .mk-nostoselain__auto,
.mk-nostoselain .mk-nostoselain__auto.mk-valittu,
.mk-nostoselain .mk-lukija.mk-nosto__pin,
.mk-nostoselain .mk-lukija.mk-nosto__pin.mk-valittu,
.mk-nosto__lukija .mk-lukija,
.mk-nosto__lukija .mk-lukija.mk-lukee,
.mk-nosto__lukija .mk-lukija__valikkonappi,
.mk-nosto__lukija .mk-lukija__valikkonappi.mk-valittu {
    color: var(--tk-paperi-muste);
}

.mk-nostoselain .mk-nosto__ylarivi-symboli {
    -unity-background-image-tint-color: var(--tk-paperi-muste);
    background-size: 15.7px 15.7px; /* sulan muste 94/96 → ~15,4 pt = pinnin muste (16,8/24 × 22) */
}

.mk-nostoselain .mk-lukija.mk-nosto__pin.mk-valittu {
    -unity-background-image-tint-color: var(--tk-paperi-muste);
}

.mk-nostoselain .mk-nostoselain__askel > .mk-ikoni {
    width: var(--tk-nappi-ohjaus-kuvake);
    height: var(--tk-nappi-ohjaus-kuvake);
    --mk-ikoni-viiva: 2.1;
}

.mk-nosto__lukija .mk-lukija__valikkoikoni {
    --mk-ikoni-viiva: 2;
}

/* Pin (stillit 154: viiva 4 px @3x vs ≡ 5 px): 2,0 tasaa painon. */
.mk-nostoselain .mk-lukija.mk-nosto__pin > .mk-ikoni {
    --mk-ikoni-viiva: 2;
}

/* Kaiutin (Päätoimittaja 21.0x: rivin suurin): 22 pt ja pinnin viiva 2,0, jottei se ole pinniä raskaampi. */
.mk-nosto__lukija .mk-lukija--kortti > .mk-kaiutin,
.mk-nosto__lukija .mk-lukija--kortti .mk-kaiutin__osa {
    width: var(--tk-nappi-ohjaus-kuvake);
    height: var(--tk-nappi-ohjaus-kuvake);
}

.mk-nosto__lukija .mk-lukija--kortti .mk-kaiutin__osa {
    --mk-ikoni-viiva: 2;
}

.mk-nostoselain .mk-nostoselain__avaaja > Label,
.mk-nostoselain .mk-nostoselain__autoteksti {
    letter-spacing: 6.98px; /* puolet .mk-nosto__ylarivi-harvennuksesta (13,97) */
}

.mk-nostoselain .mk-nostoselain__auto {
    border-width: 0;
    border-radius: var(--tk-kulma-nappi);
    background-color: initial;
}

.mk-nostoselain .mk-nostoselain__auto.mk-valittu {
    background-color: var(--kulta-kuulto);
}

.mk-nostoselain .mk-nostoselain__auto > .mk-nostoselain__autopiste {
    display: none;
}

/* Omistaja 6.10. 21.3x (k2-stillit): "Ota auto napista piste pois ja madalla vähän taustaväriä ja keskitä se auto tekstin
 * taakse": ei pistettä, tausta 26 pt (AUTO-pohjan alkuperäinen korkeus) keskellä riviä, sivuväli vali-m molemmin puolin.
 * Tila (8 pt) otetaan ›:n ja AUTO:n väliltä: ›-napin oma reunus antaa näkyvän välin. Osuma-ala 44 pt (Kosketusnappi). */
.mk-nostoselain .mk-nostoselain__auto.mk-valittu > .mk-nostoselain__autopiste {
    display: none;
}

.mk-nostoselain .mk-nostoselain__auto {
    height: 26px;
    min-height: 26px;
    align-self: center;
    padding: 0 var(--tk-vali-m);
    flex-shrink: 0;
}

.mk-nostoselain__sivu--oikea > .mk-nostoselain__auto {
    margin-left: 0;
}

.mk-nostoselain__sivu--oikea > .mk-nostoselain__auto {
    margin-right: var(--tk-vali-s);
}

/* LEVEYSBUDJETTI (omistaja TF 154 6.10. 22.x, iPadin vaakapaneeli "Noston yläpalkki vielä sekaisin": TEKNIIKKA-teksti vei tilan
 * ja › meni AUTO:n päälle): kategoria ylärivillä aina vain kuvakkeena (kuten pystykortissa); osat eivät kutistu; Nostoselain
 * tiivistää rivin portaittain, jos osat menisivät päällekkäin (tiivis1: askelnapit kapeat, tiivis2: harvennus pois ja pienemmät
 * välit). */
.mk-nostoselain .mk-nostoselain__sivu .mk-nosto__ylarivi-teksti {
    display: none;
}

.mk-nostoselain .mk-nostoselain__askel,
.mk-nostoselain .mk-nostoselain__avaaja,
.mk-nostoselain .mk-lukija.mk-nosto__pin,
.mk-nostoselain .mk-nosto__ylarivi-symboli {
    flex-shrink: 0;
}

.mk-nostoselain--tiivis1 .mk-nostoselain__askel {
    width: 26px;
}

.mk-nostoselain--tiivis2 .mk-nostoselain__avaaja > Label,
.mk-nostoselain--tiivis2 .mk-nostoselain__autoteksti {
    letter-spacing: 0;
}

.mk-nostoselain.mk-nostoselain--tiivis2 .mk-nostoselain__auto {
    padding: 0 var(--tk-vali-s);
}

.mk-nostoselain--tiivis2 .mk-nostoselain__sivu--oikea > .mk-nostoselain__auto,
.mk-nostoselain--tiivis2 .mk-nostoselain__sivu--oikea > .mk-lukija,
.mk-nostoselain--tiivis2 .mk-nostoselain__sivu--oikea > .mk-nosto__lukijapaikka {
    margin-right: 0;
    margin-left: var(--tk-vali-xs);
}

/* JUNA 155 (omistaja 6.10. 22.x): selaimen rivi ilman kategoriaa ~8 pt vetokahvan alle (kortin yläreuna 22 − 2 = 20; kahva
 * päättyy 13 pt:ssä); kategoria omana rivinään otsikon yläpuolella NOSTOT-tekstin tyylillä toissijaisella musteella,
 * otsikkoon ~5 pt. Sama asettelu kaikissa leveyksissä. */
.mk-nostoselain {
    margin-top: -2px;
}

.mk-nosto__ylarivi.mk-nosto__ylarivi--kategoria {
    flex-direction: row;
    align-items: center;
    margin: 0 0 5px 0;
    letter-spacing: 6.98px; /* NOSTOT-tekstin harvennus */
    color: var(--tk-paperi-muste-pehmea);
}

.mk-nosto__ylarivi--kategoria .mk-nosto__ylarivi-teksti {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.mk-nosto__ylarivi--kategoria .mk-nosto__ylarivi-symboli {
    -unity-background-image-tint-color: var(--tk-paperi-muste-pehmea);
}

/* Kolme oikeinta samalle keskilinjalle ja samaan näkyvään korkeuteen (omistaja 6.10. 22.x; Päätoimittajan mittaus @2x: pin 33 px
 * ja 2 pt muita ylempänä, ≡ 21 px, kaiutin 29 px). ≡ ja kaiutin piirretään paikkavarauksen kohdalle: varaus nappien korkuiseksi
 * (34 → 38), jolloin keskikohdat osuvat samaan viivaan. Pin 20 pt (muste ~14,5 pt), viiva 2,2 (sama näkyvä paksuus kuin 22 pt:n
 * 2,0); ≡ väljemmillä viivaväleillä (KortinLukija.ValikkoIkoni). */
.mk-nostoselain .mk-nosto__lukijapaikka {
    height: var(--tk-nappi-korkeus);
}

.mk-nostoselain .mk-lukija.mk-nosto__pin > .mk-ikoni {
    width: 20px;
    height: 20px;
    --mk-ikoni-viiva: 2.2;
}

.mk-nostoselain--tiivis3 .mk-nostoselain__avaaja > Label,
.mk-nostoselain--tiivis3 .mk-nostoselain__autoteksti {
    font-size: 9.25px; /* 85 % ylärivin 10,88:sta */
}
