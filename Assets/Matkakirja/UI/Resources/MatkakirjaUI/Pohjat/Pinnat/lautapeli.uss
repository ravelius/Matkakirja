/* LAUTAPELI (Siirtoseppä) — UI/Pelit
 * Siirretty sellaisenaan (UI-pohjien tyylijako 2.10.2026, web #3820 css/pohjat/…): järjestys Matkakirja.tss:ssä. */

/* LAUTAPELIN POHJA (omistaja 1.10.2026, Päätoimittajan loki b3e273d72; Mylly ensimmäisenä, UI/Pelit/MyllyNakyma.cs):
   PELI = KUVANÄKYMÄ (lauta kuvan paikalla, himmennys-kuva, ✕ 44 pt) + PANEELI (PAPERI-pergamentti 350 pt / KAPEA laudan alla);
   valinta ja tulos = KORTTI-pohja. Vain tyylikirjan muuttujat.
   Omistaja 2.10. klo 08.2x (Natiivi-UI:n arvot): lauta ilman taustaa (Blender-kuva reunoineen), tausta himmennys-kevyt +
   kartan kertakuvasumennus (UiNakymat.PaivitaKuvaSumea), pelin aikainen paneeli TUMMA; aloitus- ja tuloskortti paperia.
   Omistaja 2.10. klo 10.3x tumma liian tumma → lasi kokeiltu; klo 11.0x (loki 11.01) "pidetään alkuperäinen, mutta pehmennä
   kaikki elementit taustalla, myös tekstit": paneeli PAPERI (.tk-teema-paperi, pergamentti) ja taustan UI-kerrosten blur 4 pt
   (MyllyNakyma.Pehmenna); paneelin säännöt teeman muuttujilla, vertailu "ui mylly teema paperi|lasi|tumma". */
.mk-peli {
    background-color: var(--tk-himmennys-kevyt);
    padding: 0;
}

/* Kartan sumea pysäytyskuva omassa kerroksessaan (MyllyNakyma.PysaytysKerros), kuten .mk-suurennos__pysaytys mutta ilman
   omaa sävytystä: pehmennys = sumennus + .mk-peli-himmennys-kevyt. */
.mk-peli__pysaytys {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    -unity-background-scale-mode: scale-and-crop;
}

.mk-peli__lauta {
    position: absolute;
    background-color: initial;
}

/* ✕ on OHJAUSNAPPI (tumma teema, Pohjat/ohjausnappi.uss); täällä vain sijoitus. */
.mk-peli__sulje {
    position: absolute;
}

.mk-peli__paneeli {
    position: absolute;
    padding: var(--tk-vali-l);
    border-width: 1px;
    border-radius: var(--tk-kulma-kortti);
    border-color: var(--tk-reunus);
    background-color: var(--tk-pinta);
    color: var(--tk-muste);
}

/* Paperiteemassa (vertailu, "ui mylly teema paperi") alkuperäinen pergamentti. */
.mk-peli__paneeli.tk-teema-paperi {
    background-color: var(--tk-paperi-pergamentti);
}

.mk-peli__paneeli .mk-kortti__kapiteeli {
    color: var(--tk-muste-pehmea);
}

.mk-peli__paneeli .mk-nappi--toiminto {
    border-color: var(--tk-reunus);
    color: var(--tk-muste);
}

.mk-peli__vuoro {
    margin-bottom: var(--tk-vali-s);
    padding-left: var(--tk-vali-s);
    border-left-width: 4px;
    border-color: var(--tk-toiminto);
    font-size: var(--tk-koko-leipa);
    white-space: normal;
    color: var(--tk-muste);
}

.mk-peli__rivi {
    flex-direction: row;
    align-items: center;
    min-height: var(--tk-nappi-korkeus);
    border-top-width: 1px;
    border-color: var(--tk-reunus);
}

.mk-peli__rivi-nimi {
    flex-grow: 1;
    margin-left: var(--tk-vali-s);
    font-size: var(--tk-koko-leipa);
    color: var(--tk-muste);
}

.mk-peli__lukema {
    font-size: var(--tk-koko-kapiteeli);
    color: var(--tk-muste-pehmea);
}

.mk-peli__merkki {
    width: 16px;
    height: 16px;
    border-width: 2px;
    border-radius: var(--tk-kulma-pilleri);
    border-color: var(--tk-paperi-muste);
}

.mk-peli__merkki--vaalea {
    background-color: var(--tk-paperi-pinta);
}

.mk-peli__merkki--tumma {
    background-color: var(--tk-paperi-muste);
}

/* Tummalla paneelilla tumma merkki erottuu vain reunastaan (iPhone-kuva 2.10.: musta merkki katosi). */
.mk-peli__paneeli .mk-peli__merkki--tumma {
    border-color: var(--tk-muste-pehmea);
}

.mk-peli__ohje {
    margin-top: var(--tk-vali-xs);
    font-size: var(--tk-koko-apuri);
    white-space: normal;
    color: var(--tk-muste-pehmea);
}

.mk-peli__kortti .mk-kortti__alaotsikko {
    margin-bottom: var(--tk-vali-s);
}

.mk-peli__valiotsikko {
    margin: var(--tk-vali-m) 0 var(--tk-vali-xs) 0;
    font-size: var(--tk-koko-valiotsikko);
    color: var(--tk-paperi-korostus);
}

.mk-peli__kytkinryhma {
    flex-direction: row;
    margin-bottom: var(--tk-vali-s);
}

.mk-peli__kytkin {
    flex-grow: 1;
    flex-basis: 0;
    justify-content: center;
    min-height: var(--tk-nappi-korkeus);
    margin: 0;
    padding: 0 var(--tk-vali-s);
    border-width: 1px;
    border-radius: 0;
    border-color: var(--tk-paperi-reunus);
    background-color: initial;
    color: var(--tk-paperi-muste);
}

.mk-peli__kytkin > .mk-nappi__teksti {
    font-size: var(--tk-koko-leipa);
    -unity-text-align: middle-center;
    white-space: normal; /* savuke 1113: "Luostari 1200-l." ja "Viikinkilaiva n. 900" menivät päällekkäin iPhonella */
    padding: var(--tk-vali-xs) 0;
}

.mk-peli__kytkin:first-child {
    border-top-left-radius: var(--tk-kulma-nappi);
    border-bottom-left-radius: var(--tk-kulma-nappi);
}

.mk-peli__kytkin:last-child {
    border-top-right-radius: var(--tk-kulma-nappi);
    border-bottom-right-radius: var(--tk-kulma-nappi);
}

.mk-peli__kytkin.mk-valittu {
    background-color: var(--tk-paperi-toiminto);
}

.mk-peli__palkkio {
    font-size: var(--tk-koko-valiotsikko);
    color: var(--tk-paperi-korostus);
}

.mk-peli__kirjattu {
    margin-top: var(--tk-vali-s);
}

.mk-peli__historia {
    margin-top: var(--tk-vali-xs);
}

/* Lukittu lauta (ansaitaan voitoilla): himmeä KYTKIN, napautus näyttää ehdon apurivillä. */
.mk-peli__kytkin--lukittu {
    opacity: 0.6; /* savuke 1113: 0,45 oli liian haalea luettavaksi */
}

.mk-peli__ansaitut {
    margin-top: var(--tk-vali-s);
    color: var(--tk-paperi-korostus);
}
