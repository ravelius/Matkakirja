/* GALLERIA-pohja (tyylikirja pohjat.GALLERIA, omistaja 2.10.2026 klo 15.5x, web #3860 ja #3870 css/pohjat/galleria.css):
 * PANEELI paperi, otsikkorivi kapiteeli + laskuri ja ✕ OHJAUSNAPPI, osiot kapiteelina laskureineen, ruudukko
 * galleria.sarake / galleria.vali (Rakenne.Ruudukko), vedos kehyksellä ja nimi alla (enintään 2 riviä), lukossa ja kuvaton
 * reunus-kehys himmeällä pohjalla (Galleriat.Himmea). Leveys min(leveys.levea, ruutu − vali.xl) asetetaan C#:ssa.
 * Käyttäjät: Julisteet (Galleriat.cs Julistegalleria), sitten ISS-kameran ja astronauttien kuvat. VAIN --tk-*-tokenit. */
.mk-galleria-huntu {
    background-color: var(--tk-himmennys-kevyt);
}

.mk-galleria {
    max-height: var(--tk-peitto-laajennettu);
    padding: 0 var(--tk-vali-l) var(--tk-vali-l) var(--tk-vali-l);
    border-width: 1px;
    border-color: var(--tk-reunus);
    border-radius: var(--tk-kulma-kortti);
    background-color: var(--tk-pinta);
    color: var(--tk-muste);
}

/* Otsikkorivi ei kutistu (ikkunan max-height kutisti sen, ja 40 pt:n ✕ työntyi paneelin yläreunan yli; kuva 59029e81). */
.mk-galleria__yla {
    flex-direction: row;
    flex-shrink: 0;
    min-height: var(--tk-nappi-ohjaus);
    align-items: center;
    margin-bottom: var(--tk-vali-s);
    padding: var(--tk-vali-m) 0 var(--tk-vali-s) 0;
    border-bottom-width: 1px;
    border-color: var(--tk-reunus);
}

.mk-galleria__otsikko {
    margin-right: var(--tk-vali-s);
    font-size: var(--tk-koko-valiotsikko);
    letter-spacing: 10px; /* web 1.6px */
    color: var(--tk-muste);
}

/* Laskuri otsikon koossa ja harvennuksessa (web h2.tk-kapiteeli > span.tk-kokoelma__laskuri, vain sävy pehmeämpi). */
.mk-galleria__luku {
    font-size: var(--tk-koko-valiotsikko);
    letter-spacing: 10px;
    color: var(--tk-muste-pehmea);
}

.mk-galleria__yla .mk-ohjausnappi {
    margin-left: auto;
}

.mk-galleria__vieritys {
    flex-shrink: 1;
}

.mk-galleria__ryhma {
    margin: var(--tk-vali-s) 0 var(--tk-vali-s) 0;
    font-size: var(--tk-koko-kapiteeli);
    letter-spacing: 9.17px; /* web 1.1px */
    color: var(--tk-muste-pehmea);
}

.mk-galleria__vedos {
    flex-direction: column;
    align-items: stretch;
    justify-content: flex-start;
    min-height: 0;
    padding: 0;
    border-width: 0;
    border-radius: 0;
    background-color: initial;
}

.mk-galleria__kuva {
    border-width: 1px;
    border-color: var(--tk-muste-pehmea);
    -unity-background-scale-mode: scale-and-crop;
}

.mk-galleria__nimi {
    max-height: 30px; /* 2 riviä: koko-kapiteeli 12 × rivikorkeus 1,25 × 2 (web line-clamp 2) */
    overflow: hidden;
    margin-top: var(--tk-vali-xs);
    font-size: var(--tk-koko-kapiteeli);
    letter-spacing: 3px; /* web 0.3px */
    white-space: normal;
    -unity-text-align: upper-center;
    color: var(--tk-muste-pehmea);
}

/* Osioiden väli (web .tk-kokoelma__osio + .tk-kokoelma__osio: vali-m). */
.mk-galleria__ruudukko--vali {
    margin-bottom: var(--tk-vali-m);
}

/* Lukossa ja kuvaton: kehys reunus-värillä, pohja reunus 30 % (C# Galleriat.Himmea; web color-mix). */
.mk-galleria__vedos--lukossa .mk-galleria__kuva,
.mk-galleria__vedos--kuvaton .mk-galleria__kuva {
    border-color: var(--tk-reunus);
}
