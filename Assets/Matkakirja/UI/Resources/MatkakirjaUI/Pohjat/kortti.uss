/* KORTTI-pohja — Kortti(pohja: true)
 * Siirretty sellaisenaan (UI-pohjien tyylijako 2.10.2026, web #3820 css/pohjat/…): järjestys Matkakirja.tss:ssä. */

/* KORTTI-pohja (UI-pohjat, web #3793 .tk-kortti): paperipinta, pergamenttirengas 4 pt, ohut reunus, kulma 12; otsikko
   alaviivalla, kapiteeli, korostuskappale; napit TOIMINTO (ohut reunus) ja ensisijainen kulta, 38 pt. */
.mk-kortti-kehys--pohja {
    padding: 4px;
    border-radius: 16px;
    background-color: var(--tk-paperi-pergamentti);
}

.mk-kortti--pohja {
    padding: var(--tk-vali-l) var(--tk-vali-l) var(--tk-vali-m) var(--tk-vali-l);
    border-width: 1px;
    border-color: var(--tk-paperi-reunus);
    border-radius: var(--tk-kulma-kortti);
    background-color: var(--tk-paperi-pinta);
    color: var(--tk-paperi-muste);
}

.mk-kortti--pohja .mk-kortti__otsikko {
    margin-bottom: var(--tk-vali-s);
    padding-bottom: var(--tk-vali-xs);
    border-bottom-width: 1px;
    border-color: var(--tk-paperi-reunus);
}

.mk-kortti__kapiteeli {
    margin-bottom: var(--tk-vali-xs);
    font-size: var(--tk-koko-kapiteeli);
    letter-spacing: 7.69px; /* web 0.12em */
    color: var(--tk-paperi-muste-pehmea);
}

.mk-kortti--pohja .mk-kortti__teksti {
    margin-bottom: var(--tk-vali-s);
}

.mk-nappi--toiminto {
    min-height: var(--tk-nappi-korkeus);
    padding: 0 var(--tk-vali-m);
    border-color: var(--tk-paperi-reunus);
    background-color: initial; /* läpinäkyvä (oletus) */
    color: var(--tk-paperi-muste);
}

.mk-kortti--pohja .mk-nappi--kulta {
    min-height: var(--tk-nappi-korkeus);
    padding: 0 var(--tk-vali-m);
    background-color: var(--tk-paperi-toiminto);
}

/* KORTTI-pohja: napit pystyriviin, kun nimi ei mahdu vierekkäin (web #3798 .tk-napit--pysty). */
.mk-kortti__napit--pysty {
    flex-direction: column;
    align-items: stretch;
}

.mk-kortti__napit--pysty > .mk-nappi {
    margin-left: 0;
    margin-top: var(--tk-vali-s);
}

/* KORTTI-pohjan TUMMA variantti (omistaja 8.10.2026 klo 21.2x "A"; tyylikirja pohjat.KORTTI teemat paperi + tumma): vain
 * videopeleissä (seikkailun tietokortit), koska pimeässä pelissä kirkas paperi häikäisee; muualla kortit paperisina.
 * VAIN --tk-tumma-*-tokenit. */
.mk-kortti-kehys--pohja.mk-kortti-kehys--tumma {
    background-color: var(--tk-tumma-pinta);
}

.mk-kortti-kehys--tumma .mk-kortti--pohja {
    border-color: var(--tk-tumma-reunus);
    background-color: var(--tk-tumma-pinta);
    color: var(--tk-tumma-muste);
}

.mk-kortti-kehys--tumma .mk-kortti--pohja .mk-kortti__otsikko {
    border-color: var(--tk-tumma-reunus);
}

.mk-kortti-kehys--tumma .mk-kortti__kapiteeli {
    color: var(--tk-tumma-muste-pehmea);
}

.mk-kortti-kehys--tumma .mk-nappi--toiminto {
    border-color: var(--tk-tumma-reunus);
    color: var(--tk-tumma-muste);
}
