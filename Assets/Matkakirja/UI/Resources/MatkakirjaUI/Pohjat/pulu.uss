/* PULU-pohja, osa CHAT (web #3831 css/pohjat/pulu.css; tyylikirja pohjat.PULU teemat paperi, lasi, lasi-avaruus).
 * Teema isännältä: kartalla paperi (Pulu.uss), linssissä linssin lasi. Avaruuslasi (ISS, satelliitti, astronautin kamera)
 * on Pulu.uss:n .mk-chat--linssi; tämä tiedosto tuo LÄMPIMÄN LASIN (PuluChat.AvaaLinssissa teema "lasi", esim. Sokrates)
 * samaan rakenteeseen tyylikirjan lasitokeneilla. Ei ✕:ää: sulku Pulun napautuksella ja ohinapautuksella. */
.mk-chat.mk-chat--linssi.mk-chat--lasi {
    border-color: var(--tk-lasi-reunus);
    background-color: var(--tk-lasi-pinta);
    color: var(--tk-lasi-muste);
}

.mk-chat--lasi .mk-chat__viesti,
.mk-chat--lasi .mk-chat__livia,
.mk-chat--lasi .mk-chat__kentta {
    color: var(--tk-lasi-muste);
}

.mk-chat--lasi .mk-chat__pelaaja {
    background-color: var(--tk-lasi-pinta-peitto);
    color: var(--tk-lasi-muste);
}

.mk-chat--lasi .mk-chat__odottaa,
.mk-chat--lasi .mk-chat__paikkarivi {
    color: var(--tk-lasi-muste-pehmea);
}

.mk-chat--lasi .mk-chat__siru {
    border-color: var(--tk-lasi-reunus);
    background-color: initial;
    color: var(--tk-lasi-korostus);
}

.mk-chat--lasi .mk-chat__ikoninappi,
.mk-chat--lasi .mk-lukija,
.mk-chat--lasi .mk-chat__nappula,
.mk-chat--lasi .mk-chat__laheta {
    color: var(--tk-lasi-korostus);
    -unity-background-image-tint-color: var(--tk-korostus);
    color: var(--tk-korostus);
}

.mk-chat--lasi .mk-chat__nappula,
.mk-chat--lasi .mk-chat__kentta,
.mk-chat--lasi .mk-chat__laheta {
    background-color: initial;
    border-color: var(--tk-lasi-reunus);
}

.mk-chat--lasi .mk-chat__syote {
    border-color: var(--tk-lasi-reunus);
}

/* IRRALLINEN SIRURIVI (opas kevyeksi, omistaja 5.10.2026 Päätoimittajan kautta): samat sirut ilman chat-paneelia alareunan
 * keskellä; paneelin taustan sijaan jokaisella sirulla teeman lasipinta, jotta ne erottuvat kaupunkikuvan päällä. */
.mk-chat__sirut.mk-chat__sirut--irrallaan {
    position: absolute;
    left: var(--tk-vali-m);
    right: var(--tk-vali-m);
    bottom: 40px;
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    margin-bottom: 0;
    transition-property: opacity;
    transition-duration: 0.2s;
}

/* Teema rivin tk-teema-*-luokasta (elävä opas: harmaa lasi, omistaja 5.10.2026 klo 20.5x); vain --tk-*-tokenit. */
.mk-chat__sirut--irrallaan .mk-chat__siru {
    margin: 0 4px 6px 4px;
    border-color: var(--tk-reunus);
    background-color: var(--tk-pinta-peitto); /* peittävä: luettava punaisten kattojen päällä (Päätoimittaja 21.1x) */
    color: var(--tk-korostus);
}

.mk-chat__sirut--irrallaan .mk-chat__siru:active {
    background-color: var(--tk-toiminto);
}

.mk-chat__sirut--irrallaan .mk-chat__siru--ikoni {
    width: 34px;
    min-width: 34px;
    padding: 0;
    justify-content: center;
    align-items: center;
    -unity-background-image-tint-color: var(--tk-korostus);
    color: var(--tk-korostus);
}

/* PIN-KUVAKE JA PINNATTU PALKKI (omistaja 5.10.2026 klo 23.3x, uusi UI-pohja): pin-kuvake ikkunan ylärivillä rivin muiden
 * kuvakkeiden koossa, pinnattuna korostusvärillä; pinnatun ikkunan himmennys läpinäkyväksi (kartta liikkuu ohi). Palkki: yksi
 * rivi oikeaan yläreunaan nappien alle (paikka koodista), otsikko + tauko/jatka + ohut edistyminen (EDISTYMINEN-pohja).
 * Teema elementin tk-teema-*-luokasta; VAIN --tk-*-tokenit. */
.mk-chat__ikoninappi.mk-chat__pin.mk-valittu,
.mk-lukija.mk-nosto__pin.mk-valittu {
    color: var(--tk-paperi-korostus);
    -unity-background-image-tint-color: var(--tk-paperi-korostus);
    background-color: var(--tk-paperi-reunus);
}

.mk-lukija.mk-nosto__pin {
    margin-right: 2px;
}

.mk-himmennys.mk-himmennys--pin {
    background-color: initial;
}

.mk-pinpalkki {
    position: absolute;
    max-width: 260px;
    min-height: 40px;
    padding: 0 var(--tk-vali-s) 0 var(--tk-vali-m);
    border-width: 1px;
    border-color: var(--tk-reunus);
    border-radius: var(--tk-kulma-nappi);
    background-color: var(--tk-pinta);
    color: var(--tk-muste);
    justify-content: center;
}

/* Aina vaalea (omistaja 6.10. 23.0x: "muuttui jostain syystä tummaksi. Saisi olla aina vaalea"): palkki on nappi, ja
 * .mk-nappi:active värjäsi sen tummaksi (#43331f) painalluksen ajaksi tai jäi päälle; painallus vain pergamenttina. */
.mk-nappi.mk-pinpalkki:active {
    background-color: var(--tk-pergamentti);
}

/* Uuden pinnatun noston ensimmäinen kuva palkin alla 3 s (omistaja 6.10. 23.0x): palkin levyinen, ei kehystä eikä tekstiä. */
.mk-pinpalkki__kuva {
    position: absolute;
    border-radius: var(--tk-kulma-nappi);
    overflow: hidden;
    -unity-background-scale-mode: scale-and-crop;
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.2s; /* --tk-kesto-sulku */
}

.mk-pinpalkki__rivi {
    flex-direction: row;
    align-items: center;
}

.mk-pinpalkki__pin {
    width: 16px;
    height: 16px;
    margin-right: var(--tk-vali-s);
    color: var(--tk-korostus);
}

.mk-pinpalkki__otsikko {
    flex-shrink: 1;
    font-size: var(--tk-koko-apuri);
    color: var(--tk-muste);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.mk-pinpalkki__tauko {
    width: 34px;
    height: 34px;
    margin-left: var(--tk-vali-s);
    justify-content: center;
    align-items: center;
    background-color: initial;
    border-width: 0;
    color: var(--tk-korostus);
}

.mk-pinpalkki__edistyminen {
    position: absolute;
    left: var(--tk-vali-m);
    right: var(--tk-vali-m);
    bottom: 3px;
    height: 2px;
}
