/* OHJAUSNAPPI-pohja (tyylikirja pohjat.OHJAUSNAPPI, omistaja 2.10.2026 klo 14.16; web #3854): kaikki kuvakenapit yhtenäisiksi
 * neliöiksi pyöristetyin kulmin ja näkymän napit yhteen ohjausryhmään. Malli taikalasinappi (web #linssi-btn).
 *   näkyvä --tk-nappi-ohjaus (40) neliö, osuma-ala 44 pt (Kosketusnappi laajentaa), kulma --tk-kulma-nappi,
 *   kuvake --tk-nappi-ohjaus-kuvake (22) viivalla 1,75 (web VIIVA_IKONIT)
 *   ryhmä: vaakarivi oikeaan yläkulmaan turva-alueen sisään, väli --tk-vali-s; järjestys ‹ → näkymän toiminnot → ✕ viimeisenä
 *   teema elementin tk-teema-*-luokasta: harmaa (oletus valokuvan, 3D:n ja avaruuden päällä; omistaja 16.9.), paperi, lasi,
 *   lasi-avaruus. VAIN --tk-*-tokenit. */
.mk-ohjausryhma {
    position: absolute;
    top: var(--tk-vali-s);
    right: var(--tk-vali-s);
    flex-direction: row;
    align-items: center;
}

/* Seikkailu (Päätoimittaja 8.10.2026, Thiefin taso): ☰-ryhmä levossa himmeä kuten TAPPI (0,55); toimintonappi häivyttäen
 * (Rakenne.Nayta: mk-auki), häivytys kuten TAPPI. */
.mk-ohjausryhma.mk-ohjausryhma--lepo {
    opacity: 0.55;
    transition-property: opacity;
    transition-duration: 0.2s;
}

.mk-ohjausryhma.mk-ohjausryhma--haivytys {
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.2s;
}

.mk-ohjausryhma.mk-ohjausryhma--haivytys.mk-auki {
    opacity: 1;
}

/* Vasemman yläkulman ryhmä (oppaan vuorokaudenaika, omistaja 6.10. 18.5x). */
.mk-ohjausryhma.mk-ohjausryhma--vasen {
    right: auto;
    left: var(--tk-vali-s);
}

/* Pieni tilamerkki napin oikeassa alakulmassa (vuorokaudenajan "A" = automaattinen). */
.mk-ohjausnappi__merkki {
    position: absolute;
    right: var(--tk-vali-xs);
    bottom: 0;
    font-size: var(--tk-koko-kapiteeli);
    -unity-font-style: bold;
    color: var(--tk-muste);
}

.mk-ohjausnappi {
    width: var(--tk-nappi-ohjaus);
    height: var(--tk-nappi-ohjaus);
    min-height: var(--tk-nappi-ohjaus);
    margin: 0 0 0 var(--tk-vali-s);
    padding: 0;
    border-width: 1px;
    border-radius: var(--tk-kulma-nappi);
    border-color: var(--tk-reunus);
    background-color: var(--tk-pinta);
    color: var(--tk-muste);
    align-items: center;
    justify-content: center;
}

.mk-ohjausnappi > .mk-ikoni {
    width: var(--tk-nappi-ohjaus-kuvake);
    height: var(--tk-nappi-ohjaus-kuvake);
    margin-right: 0;
}

/* PALLON SÄÄTILA (omistaja 8.10.2026 klo 09.1x; tyylikirja pohjat.OHJAUSNAPPI.saakuvakkeet ja live). Sääkuvake ajan kuvakkeen
 * oikeassa alakulmassa (kuten tilamerkki), pieni; LIVE: vain teksti läpikuultavalla oranssilla pohjalla, koko ja kulma ennallaan. */
.mk-ohjausnappi > .mk-ohjausnappi__saa {
    position: absolute;
    right: 1px;
    bottom: 1px;
    width: 14px;
    height: 14px;
    margin-right: 0;
}

.mk-ohjausnappi.mk-ohjausnappi--live {
    background-color: var(--tk-tila-live-kuulto);
}

.mk-ohjausnappi__live {
    font-size: var(--tk-koko-kapiteeli);
    -unity-font-style: bold;
    letter-spacing: 6px; /* web 0.06em */
    color: var(--tk-korostus);
    -unity-text-outline-width: 0.6px;
    -unity-text-outline-color: var(--tk-himmennys-tumma);
    -unity-text-align: middle-center;
}

.mk-ohjausnappi:active {
    border-color: var(--tk-korostus);
    background-color: var(--tk-toiminto);
}

/* Iso koko kuvasisällölle (nappi.ohjaus-iso 56 pt; omistaja 2.10.2026 klo 17.4x: linnan pienoiskartta ☰-nappia isompana). */
.mk-ohjausnappi.mk-ohjausnappi--iso {
    width: var(--tk-nappi-ohjaus-iso);
    height: var(--tk-nappi-ohjaus-iso);
    min-height: var(--tk-nappi-ohjaus-iso);
    padding: var(--tk-vali-xs);
}

/* TAPPI (omistaja 5.10.2026 klo 21.3x, elävän oppaan kameraohjain; Päätoimittajan pohjaehdotus 21.3x): pyöreä lasi Ø 64 pt
 * alakulmassa, nuppi Ø 26 pt. Levossa himmeä (0,55), kosketuksessa täysin näkyvä; häivytys --tk-kesto-sulku, nupin paluu
 * 150 ms. Teema elementin tk-teema-*-luokasta (oppaassa harmaa). VAIN --tk-*-tokenit. Paikka ja alareuna koodista. */
.mk-tappi {
    position: absolute;
    width: 64px;
    height: 64px;
    border-width: 1px;
    border-color: var(--tk-reunus);
    border-radius: 32px;
    background-color: var(--tk-pinta);
    justify-content: center;
    align-items: center;
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.2s;
}

.mk-tappi--vasen {
    left: 12px;
}

.mk-tappi--oikea {
    right: 12px;
}

.mk-tappi.mk-tappi--nakyy {
    opacity: 0.55;
}

/* Seikkailu (Päätoimittaja 8.10.2026, Thiefin taso): tappi näkyy vain kosketuksessa, levossa näkymätön (osuma-ala pysyy). */
.mk-tappi.mk-tappi--nakyy.mk-tappi--vain-kosketus {
    opacity: 0;
}

.mk-tappi.mk-tappi--nakyy.mk-tappi--kosketus {
    opacity: 1;
}

.mk-tappi__nuppi {
    width: 26px;
    height: 26px;
    border-width: 1px;
    border-color: var(--tk-korostus);
    border-radius: 13px;
    background-color: var(--tk-pinta-peitto);
    justify-content: center;
    align-items: center;
}

.mk-tappi__nuppi--palaa {
    transition-property: translate;
    transition-duration: 0.15s;
}

.mk-tappi__ikoni {
    width: 14px;
    height: 14px;
    color: var(--tk-korostus);
}
