/* KUVANÄKYMÄ-pohja (web #3833 css/pohjat/kuvanakyma.css; tyylikirja pohjat.KUVANÄKYMÄ: teema TUMMA, sulku ✕, veto alas, Esc).
 * ✕ on LASI-teemaa (Natiivi-UI ja Päätoimittaja 2.10.2026): 44 pt, pyöreä, oikea yläkulma turva-alueen sisällä. Teema tulee
 * elementin tk-teema-*-luokasta (astronautin kamera ja ISS: tk-teema-lasi-avaruus; lämpimät linssit: tk-teema-lasi).
 * VAIN --tk-*-tokenit. */
.mk-kuvanakyma__sulku {
    position: absolute;
    top: var(--tk-vali-m);
    right: var(--tk-vali-m);
    width: var(--tk-nappi-osuma);
    height: var(--tk-nappi-osuma);
    min-height: var(--tk-nappi-osuma);
    margin: 0;
    padding: 0;
    border-width: 1px;
    border-color: var(--tk-reunus);
    border-radius: var(--tk-kulma-pilleri);
    background-color: var(--tk-pinta);
    color: var(--tk-muste);
}

.mk-kuvanakyma__sulku .mk-nappi__teksti {
    font-size: var(--tk-koko-valiotsikko);
    -unity-text-align: middle-center;
    color: var(--tk-muste);
}

.mk-kuvanakyma__sulku:active {
    border-color: var(--tk-korostus);
}
