/* LINSSIT (Natiivi-UI, 23.9.2026): linssivalitsin, odotuspeite, selitekortti,
 * astronautin kamera (avaus, kuvanäkymä, sumu), vertailu ja maatiedot sekä
 * aikajanojen esitykset. Lähteet: css/styles.css (.linssi-valikko,
 * .linssi-selite, .maa-pilleri, .vertailu-palkki), css/satelliitti.css
 * (.satelliitti-katselu, .satelliitti-selite, .satelliitti-nauha) ja
 * css/aikajana.css (.aikajana-ylarivi, .aikajana-kello, .aikajana-ilmio,
 * .aikajana-valinaytos, .aikajana-avaus-laatikko). Koodi: UI/Linssit/. */

/* --- taikalasit-nappi ja linssin sulku ------------------------------------ */

.mk-linssiNappi {
    position: absolute;
    right: 10px;
    width: 40px;
    height: 40px;
    min-height: 40px;
    padding: 0;
    border-radius: 12px;
    border-color: rgba(70, 51, 31, 0.35);
    background-color: rgba(239, 220, 180, 0.9);
    color: var(--map-ink);
}

.mk-linssiNappi:active {
    background-color: rgba(225, 204, 160, 0.95);
}

.mk-linssiNappi > .mk-ikoni {
    width: 22px;
    height: 22px;
    margin-right: 0;
    --mk-ikoni-viiva: 1.6;
}

/* Linssi päällä: kulta (web #linssi-btn.paalla). */
.mk-linssiNappi.mk-paalla {
    background-color: var(--panel);
    border-color: var(--accent);
    color: var(--accent);
}

.mk-linssiNappi.mk-valittu {
    background-color: var(--map-ink);
    color: #f5f0e2;
}

.mk-linssiSulje {
    position: absolute;
    min-height: 32px;
    height: 32px;
    padding: 0 12px 0 10px;
    border-radius: 16px;
    border-color: rgba(170, 170, 170, 0.9);
    background-color: rgba(60, 56, 50, 0.72);
    color: rgb(232, 228, 220);
}

.mk-linssiSulje:active {
    background-color: rgba(90, 84, 76, 0.85);
}

.mk-linssiSulje__risti {
    font-size: 15px;
    margin-right: 6px;
    color: rgb(232, 228, 220);
}

.mk-linssiSulje .mk-nappi__teksti {
    font-size: 13px;
    letter-spacing: 3.85px; /* web 0.5px */
}

/* Löydös 32: kutistunut pilleri = pyöreä ✕ (32 × 32). */
.mk-linssiSulje--risti {
    width: 32px;
    padding: 0;
    justify-content: center;
}

.mk-linssiSulje--risti .mk-linssiSulje__risti {
    margin-right: 0;
}

/* --- valitsinpaneeli (pergamentti) ----------------------------------------- */

.mk-linssivalitsin {
    position: absolute;
    right: 10px;
    width: 300px;
    max-width: 88%;
    max-height: 70%;
    padding: 8px 8px 10px 8px;
    border-radius: 10px;
    color: var(--map-ink);
    opacity: 0;
    translate: 0 -10px;
    scale: 1 0.9;
    transform-origin: top;
    transition-property: opacity, translate, scale;
    transition-duration: 0.18s, 0.22s, 0.22s;
    transition-timing-function: ease-out;
}

.mk-linssivalitsin.mk-auki {
    opacity: 1;
    translate: 0 0;
    scale: 1 1;
}

.mk-linssivalitsin__vieritys {
    flex-shrink: 1;
}

.mk-linssivalitsin__tyhja {
    padding: 10px 8px;
    font-size: 13px;
    color: var(--map-ink-soft);
    white-space: normal;
}

.mk-linssirivi {
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    min-height: 56px;
    margin: 2px 0;
    padding: 8px 10px;
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0);
    border-radius: 10px;
    background-color: rgba(0, 0, 0, 0);
    color: var(--map-ink);
}

.mk-linssirivi:active {
    background-color: rgba(70, 51, 31, 0.1);
}

.mk-linssirivi.mk-valittu {
    background-color: rgba(217, 161, 59, 0.2);
    border-color: rgba(138, 97, 20, 0.6);
}

.mk-linssirivi__ikoni {
    width: 34px;
    height: 34px;
    margin-right: 12px;
    padding: 5px;
    border-radius: 17px;
    border-width: 1px;
    border-color: rgba(70, 51, 31, 0.4);
    background-color: rgba(255, 250, 238, 0.55);
    color: var(--map-ink);
    --mk-ikoni-viiva: 1.6;
}

.mk-linssirivi.mk-valittu .mk-linssirivi__ikoni {
    border-color: var(--accent-dark);
    color: var(--accent-dark);
}

.mk-linssirivi__tekstit {
    flex-grow: 1;
    flex-shrink: 1;
    flex-direction: column;
}

.mk-linssirivi__nimirivi {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.mk-linssirivi__nimi {
    font-size: 16px;
    color: #3a2812;
}

.mk-linssirivi__tila {
    font-size: 11px;
    letter-spacing: 9.09px; /* web 1px */
    color: var(--accent-dark);
}

.mk-linssirivi__lyhyt {
    margin-top: 2px;
    font-size: 13px;
    white-space: normal;
    color: rgba(70, 51, 31, 0.85);
}

.mk-linssivalitsin__pois {
    margin-top: 8px;
    align-self: center;
}

.mk-linssivalitsin__pois .mk-nappi__teksti {
    font-size: 14px;
}

/* --- odotuspeite ---------------------------------------------------------- */

.mk-linssipeite {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(20, 16, 10, 0.96);
}

.mk-linssipeite--haipyy {
    transition-property: opacity;
    transition-duration: 0.32s;
    transition-timing-function: ease;
}

/* --- selitekortti (webin .linssi-selite) ----------------------------------- */

.mk-linssiselite {
    position: absolute;
    width: 240px;
    max-width: 52%;
    max-height: 46%;
    padding: 8px 10px;
    border-width: 1px;
    border-color: rgba(217, 161, 59, 0.45);
    border-radius: 12px;
    background-color: rgba(46, 33, 20, 0.88);
    color: var(--ink-light);
    opacity: 0;
    translate: 0 16px;
    scale: 0.97 0.97;
    transition-property: opacity, translate, scale;
    transition-duration: 0.32s;
    transition-timing-function: ease-out-back;
}

.mk-linssiselite.mk-auki {
    opacity: 1;
    translate: 0 0;
    scale: 1 1;
}

.mk-linssiselite.mk-pieni {
    width: auto;
    padding: 0;
}

.mk-linssiselite__nimi {
    min-height: 0;
    padding: 0;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    justify-content: flex-start;
}

.mk-linssiselite__nimi:active {
    background-color: rgba(0, 0, 0, 0);
    opacity: 0.8;
}

.mk-linssiselite.mk-pieni .mk-linssiselite__nimi {
    padding: 6px 10px;
}

.mk-linssiselite__otsikko {
    font-size: 12px;
    letter-spacing: 10px; /* web 1.2px */
    color: var(--accent);
    -unity-text-align: middle-left;
}

.mk-linssiselite__runko {
    margin-top: 6px;
    flex-shrink: 1;
}

.mk-linssiselite__vieritys {
    flex-shrink: 1;
}

.mk-linssiselite__rivi {
    flex-direction: row;
    align-items: center;
    margin-bottom: 3px;
}

.mk-linssiselite__lappu {
    width: 12px;
    height: 12px;
    margin-right: 6px;
    flex-shrink: 0;
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0.35);
    border-radius: 3px;
}

.mk-linssiselite__teksti {
    flex-shrink: 1;
    font-size: 12px;
    white-space: normal;
    color: var(--ink-light);
}

/* --- astronautin kamera: avaus --------------------------------------------- */

.mk-astroavaus {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgb(0, 0, 0);
}

.mk-astroavaus--haipyy {
    transition-property: opacity;
    transition-duration: 1.1s;
    transition-timing-function: ease;
}

.mk-astroavaus__otsikko {
    align-items: center;
    color: rgb(232, 237, 245);
}

.mk-astroavaus__otsikko--haipyy {
    transition-property: opacity;
    transition-duration: 0.7s;
    transition-timing-function: ease;
}

.mk-astroavaus__nimi {
    font-size: 17px;
    letter-spacing: 31.76px; /* web 5.4px */
    padding-left: 5.4px;
    color: rgb(232, 237, 245);
}

.mk-astroavaus__viiva {
    width: 51px;
    height: 1px;
    margin: 11px 0;
    background-color: rgba(232, 237, 245, 0.5);
}

.mk-astroavaus__lahde {
    font-size: 12.5px;
    letter-spacing: 12px; /* web 1.5px */
    color: rgba(232, 237, 245, 0.72);
}

/* --- astronautin kamera: avaruussumu -------------------------------------- */

.mk-astrosumu {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    overflow: hidden;
}

.mk-astrosumu__kalvo {
    position: absolute;
    top: -20%;
    left: -20%;
    right: -20%;
    bottom: -20%;
}

/* --- astronautin kamera: kuvanäkymä ---------------------------------------- */

.mk-astrokuva {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgb(4, 9, 7);
    color: rgb(223, 246, 232);
}

.mk-astrokuva__lava {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    overflow: hidden;
}

.mk-astrokuva__kuva {
    position: absolute;
    background-color: rgb(6, 13, 10);
    -unity-background-scale-mode: stretch-to-fill;
    transform-origin: center;
}

.mk-astrokuva__turva {
    position: absolute;
}

.mk-astrokuva__selite {
    position: absolute;
    left: 12px;
    top: 12px;
    right: 64px;
    max-width: 560px;
    padding: 8px 10px 6px 10px;
    border-width: 1px;
    border-color: rgba(93, 255, 168, 0.28);
    border-radius: 10px;
    background-color: rgba(6, 13, 10, 0.72);
    color: rgba(233, 250, 240, 0.92);
}

.mk-astrokuva__selite.mk-kiinni {
    padding: 5px 10px;
    background-color: rgba(6, 13, 10, 0.25);
    border-color: rgba(93, 255, 168, 0.12);
}

.mk-astrokuva__otsikko {
    font-size: 16px;
    white-space: normal;
    color: rgb(93, 255, 168);
}

.mk-astrokuva__selite.mk-kiinni .mk-astrokuva__otsikko {
    font-size: 13px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    opacity: 0.7;
}

.mk-astrokuva__runko {
    margin-top: 4px;
}

.mk-astrokuva__teksti {
    font-size: 13px;
    white-space: normal;
    color: rgba(233, 250, 240, 0.92);
}

.mk-astrokuva__vakasenRivi {
    flex-direction: row;
    justify-content: flex-end;
}

.mk-astrokuva__vakanen {
    width: 26px;
    height: 26px;
    min-height: 26px;
    padding: 0;
    border-radius: 13px;
    border-color: rgba(93, 255, 168, 0.35);
    background-color: rgba(6, 13, 10, 0.6);
    color: rgb(234, 255, 243);
    transition-property: rotate;
    transition-duration: 0.2s;
}

.mk-astrokuva__vakanen.mk-auki {
    rotate: 180deg;
}

.mk-astrokuva__vakanen .mk-nappi__teksti {
    font-size: 15px;
    -unity-text-align: middle-center;
    color: rgb(234, 255, 243);
}

.mk-astrokuva__lisatiedot {
    margin-top: 4px;
    padding-top: 6px;
    border-top-width: 1px;
    border-color: rgba(93, 255, 168, 0.18);
}

.mk-astrokuva__lisarivi {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 3px;
}

.mk-astrokuva__lisanimi {
    font-size: 12px;
    color: rgb(234, 255, 243);
}

.mk-astrokuva__lisaarvo {
    flex-shrink: 1;
    font-size: 12px;
    white-space: normal;
    color: rgba(223, 246, 232, 0.85);
}

.mk-astrokuva__sulku {
    position: absolute;
    top: 12px;
    right: 12px;
    width: 38px;
    height: 38px;
    min-height: 38px;
    padding: 0;
    border-radius: 19px;
    border-color: rgb(170, 170, 170);
    background-color: rgba(130, 130, 130, 0.42);
    color: rgb(224, 224, 224);
}

.mk-astrokuva__sulku:active {
    background-color: rgba(170, 170, 170, 0.55);
}

.mk-astrokuva__sulku .mk-nappi__teksti {
    font-size: 20px;
    -unity-text-align: middle-center;
    color: rgb(224, 224, 224);
}

.mk-astrokuva__nauha {
    position: absolute;
    left: 12px;
    bottom: 12px;
    max-width: 50%;
    flex-direction: row;
    flex-wrap: wrap;
}

.mk-astrokuva__pikku {
    width: 38px;
    height: 26px;
    min-height: 26px;
    margin: 0 4px 4px 0;
    padding: 0;
    border-radius: 4px;
    border-color: rgba(93, 255, 168, 0.3);
    background-color: rgba(6, 13, 10, 0.9);
    -unity-background-scale-mode: scale-and-crop;
}

.mk-astrokuva__pikku.mk-valittu {
    border-color: rgb(93, 255, 168);
    border-width: 2px;
}

.mk-astrokuva__pulu {
    position: absolute;
    right: 12px;
    bottom: 12px;
}

/* --- vertailu: alapalkki ja laput (webin .vertailu-palkki) ------------------ */

.mk-vertailupalkki {
    position: absolute;
    left: 8px;
    right: 8px;
    bottom: 10px;
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    padding: 5px 8px;
    border-width: 1px;
    border-color: rgba(70, 51, 31, 0.45);
    border-radius: 22px;
    background-color: rgba(247, 237, 216, 0.94);
    color: var(--map-ink);
}

.mk-vertailupalkki__ohje {
    margin: 6px 4px;
    font-size: 12.5px;
    white-space: normal;
    -unity-text-align: middle-center;
    color: rgba(70, 51, 31, 0.8);
}

.mk-vertailulappu {
    flex-direction: row;
    min-height: 30px;
    margin: 3px;
    padding: 3px 9px;
    border-color: rgba(70, 51, 31, 0.4);
    border-radius: 15px;
    background-color: rgba(255, 250, 238, 0.9);
    color: var(--map-ink);
}

.mk-vertailulappu:active {
    background-color: rgba(176, 58, 43, 0.12);
}

.mk-vertailulappu.mk-pois {
    opacity: 0.45;
}

.mk-vertailulappu__laatta {
    width: 11px;
    height: 11px;
    margin-right: 5px;
    border-width: 1px;
    border-color: rgba(70, 51, 31, 0.45);
    border-radius: 2px;
}

.mk-vertailulappu__nimi {
    font-size: 13px;
    color: var(--map-ink);
}

.mk-vertailupalkki__vertaa {
    min-height: 32px;
    margin: 3px 3px 3px 6px;
    padding: 3px 14px;
    border-radius: 16px;
}

/* --- vertailuarkki ----------------------------------------------------------- */

.mk-vertailuarkki {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    color: var(--map-ink);
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.25s;
}

.mk-vertailuarkki.mk-auki {
    opacity: 1;
}

.mk-vertailuarkki__sisus {
    flex-grow: 1;
    flex-direction: column;
}

.mk-vertailuarkki__otsikko {
    font-size: 23px;
    margin-bottom: 6px;
    color: #3a2812;
}

.mk-vertailuarkki__ylarivi {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    padding-bottom: 8px;
    margin-bottom: 8px;
    border-bottom-width: 1px;
    border-color: rgba(70, 51, 31, 0.45);
}

.mk-vertailuarkki__muuta {
    min-height: 32px;
    margin: 3px;
}

.mk-vertailuarkki__muuta .mk-nappi__teksti {
    font-size: 13px;
}

.mk-vertailuarkki__vieritys {
    flex-grow: 1;
    flex-shrink: 1;
}

.mk-vertailuarkki__kortit {
    flex-direction: row;
    flex-wrap: wrap;
}

.mk-vertailukortti {
    width: 46%;
    min-width: 150px;
    flex-grow: 1;
    margin: 4px;
    padding: 10px 12px;
    border-width: 1px;
    border-top-width: 4px;
    border-color: rgba(70, 51, 31, 0.35);
    border-radius: 8px;
    background-color: rgba(255, 250, 238, 0.55);
}

.mk-vertailukortti__yla {
    flex-direction: row;
    align-items: center;
    margin-bottom: 6px;
}

.mk-vertailukortti__lippu {
    margin-right: 8px;
    border-width: 1px;
    border-color: rgba(70, 51, 31, 0.4);
    border-radius: 2px;
}

.mk-vertailukortti__nimi {
    flex-shrink: 1;
    font-size: 17px;
    white-space: normal;
    color: #3a2812;
}

.mk-vertailukortti__rivi {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 3px 0;
    border-bottom-width: 1px;
    border-color: rgba(70, 51, 31, 0.15);
}

.mk-vertailukortti__nimio {
    font-size: 11px;
    letter-spacing: 9.09px; /* web 1px */
    color: var(--map-ink-soft);
}

.mk-vertailukortti__arvo {
    font-size: 14px;
    color: var(--map-ink);
}

.mk-vertailukortti__tyhja {
    font-size: 13px;
    color: var(--map-ink-soft);
}

/* --- maakyltti (webin .maa-pilleri) ------------------------------------------ */

/* Web .maa-pilleri: 0,8rem kirjoituskone versaalein, harvennus 0,1 em, padding 0 0,5em, kulma 6 px, tausta
 * rgba(244,231,202,.86); korkeus matkakirjan supistetun lapun mukaan (iPhonen kaupunkipilleri 36 px). */
.mk-maakyltti {
    position: absolute;
    flex-direction: row;
    align-items: center;
    height: 36px;
    min-height: 0;
    padding: 0 8px;
    border-width: 0;
    border-radius: 6px;
    background-color: rgba(244, 231, 202, 0.86);
    color: rgba(70, 51, 31, 0.92);
}

.mk-maakyltti:active {
    background-color: rgba(245, 231, 200, 0.97);
}

.mk-maakyltti__rivi {
    flex-direction: row;
    align-items: center;
}

.mk-maakyltti__lippu {
    margin-right: 7px;
    border-width: 1px;
    border-color: rgba(70, 51, 31, 0.4);
    border-radius: 2px;
}

.mk-maakyltti__nimi {
    font-size: 12.8px;
    letter-spacing: 10px; /* web 0.1em */
    color: rgba(70, 51, 31, 0.92);
}

.mk-maakyltti__lehti {
    margin-top: 2px;
    font-size: 12px;
    letter-spacing: 4.17px; /* web 0.5px */
    color: var(--accent-dark);
}

/* --- aikajanat: ylärivi, kello ja ohjaimet (webin .aikajana-ylarivi) --------- */

/* Palkki (web .aikajana.palkki .aikajana-ylarivi): Matkakirjan yläpalkin paikalla koko leveydeltä,
 * sama ruskea liukuväri (Kuviot.Ylapalkki) ja alareunan viiva; korkeus ja turva-alue AikajanaNakyma.Asettele. */
.mk-aikajana-ylarivi {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    flex-direction: row;
    align-items: center;
    border-bottom-width: 1px;
    border-color: rgba(217, 161, 59, 0.38);
    color: #f1e6d0;
    transition-property: opacity;
    transition-duration: 0s;
}

.mk-aikajana-ylarivi__otsikot {
    flex-grow: 0;
    flex-shrink: 1;
    min-width: 0;
    flex-direction: column;
    justify-content: center;
    margin-right: 6px;
    overflow: hidden;
}

.mk-aikajana-ylarivi__otsikko {
    font-size: 11.5px;
    letter-spacing: 10.43px; /* web 1.2px */
    color: #d9a13b;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.mk-aikajana-ylarivi__paikka {
    font-size: 14px;
    color: #e6d7bb;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.mk-aikajana-kello {
    flex-shrink: 0;
    flex-direction: row;
    align-items: flex-end;
    padding: 2px 6px;
    border-width: 1px;
    border-color: rgba(70, 51, 31, 0.5);
    border-radius: 6px;
    background-color: #2a1f16;
    color: #f3e6d0;
}

/* Luku (web .aikajana-kello font-size clamp(1.35rem, 3.4vw, 1.9rem): koko AikajanaNakymasta palkin leveydestä). */
.mk-aikajana-kello__luku {
    font-size: 24px;
    -unity-text-align: middle-right;
    white-space: nowrap;
}

/* Web .aikajana-kelloyksikko: 0,5 em, himmeä, luvun alalaitaan 0,3 em:n päähän. */
.mk-aikajana-kello__yksikko {
    font-size: 12px;
    margin-left: 7px;
    padding-bottom: 3px;
    letter-spacing: 2.5px; /* web 0.3px */
    opacity: 0.72;
    white-space: nowrap;
}

.mk-aikajana-kello.mk-tauolla {
    color: var(--accent);
}

.mk-aikajana-ohjaimet {
    flex-direction: row;
    flex-shrink: 0;
    align-items: center;
    margin-left: auto;
    padding-left: 6px;
}

/* Tauko / Jatka / Loppu tekstinä (web .aikajana-nappi, palkissa 36 px korkea). */
.mk-aikajana-nappi.mk-aikajana-nappi--teksti {
    width: auto;
    height: 36px;
    min-height: 36px;
    padding: 0 11px;
    margin-left: 6px;
    transition-property: border-color, background-color;
    transition-duration: 1.4s, 1.4s;
}

.mk-aikajana-nappi--teksti .mk-nappi__teksti {
    font-size: 13px;
    letter-spacing: 3.85px; /* web 0.5px */
}

/* Jatka hehkuu välinäytöksessä (web .aikajana-nappi.hehku): hento punainen, hitaasti sykkien. */
.mk-aikajana-nappi.mk-hehku {
    border-color: rgba(214, 96, 72, 0.9);
    background-color: rgba(214, 96, 72, 0.22);
}

/* Löydös 74: napit pelin yläpalkin ☰:n asussa (Matkakirja.uss .mk-ylapalkki .mk-ikoninappi: läpinäkyvä, reunus
 * #4b3826). Läpikuultava valkoinen vaaleni lineaarisessa väriavaruudessa harmaaksi. */
.mk-aikajana-nappi {
    width: 30px;
    height: 30px;
    min-height: 30px;
    margin-left: 3px;
    padding: 0;
    border-width: 1px;
    border-color: #4b3826;
    border-radius: 10px;
    background-color: rgba(0, 0, 0, 0);
    color: #f1e6d0;
}

.mk-aikajana-nappi:active {
    background-color: rgba(217, 161, 59, 0.22);
}

/* Saaririvi (AikajanaNakyma.AsetaSaaririvi): pelin ☰:n mitat 44 × 36 ja Tauko samankorkuisena. */
.mk-aikajana-ylarivi--saari .mk-aikajana-nappi {
    width: 44px;
    height: 36px;
    min-height: 36px;
    margin-left: 6px;
}

.mk-aikajana-ylarivi--saari .mk-aikajana-nappi.mk-aikajana-nappi--teksti {
    width: auto;
}

.mk-aikajana-nappi .mk-nappi__teksti {
    font-size: 13px;
    -unity-text-align: middle-center;
    color: #f1e6d0;
}

/* --- linssin hampurilaisvalikko (LinssiValikko.cs; webin css/aikajana.css
 * .aikajana-valikko-*): pudotus napin alle oikeaan reunaan, palkin ruskea
 * liukuväri (Kuviot.Ylapalkki), kullanväriset rivit, kytkimen tila vaalealla. */

.mk-linssivalikko__nappi > .mk-ikoni {
    width: 18px;
    height: 18px;
    --mk-ikoni-viiva: 2;
}

.mk-linssivalikko {
    position: absolute;
    flex-direction: column;
    min-width: 184px;
    max-width: 90%;
    padding: 5.6px;
    border-width: 1px;
    border-color: rgba(217, 161, 59, 0.38);
    border-radius: 10px;
}

.mk-linssivalikko__kohta {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    min-height: 40px;
    margin: 0 0 1.6px 0;
    padding: 7px 10px;
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0);
    border-radius: 8px;
    background-color: rgba(0, 0, 0, 0);
    color: #d9a13b;
}

.mk-linssivalikko__kohta:active {
    background-color: rgba(234, 184, 78, 0.12);
}

.mk-linssivalikko__kohta .mk-nappi__teksti,
.mk-linssivalikko__nimi {
    font-size: 13px;
    letter-spacing: 3.85px; /* web 0.5px */
    -unity-text-align: middle-left;
    color: #d9a13b;
    white-space: nowrap;
}

.mk-linssivalikko__tila {
    margin-left: 14px;
    font-size: 12px;
    letter-spacing: 5.83px; /* web 0.7px */
    color: #e6d7bb;
    opacity: 0.75;
}

.mk-linssivalikko__kytkin.mk-valittu .mk-linssivalikko__tila {
    opacity: 1;
    color: #f1e6d0;
}

/* --- aikajanat: paneeli (webin .aikajana-ilmio) ----------------------------- */

/* Tumma asu (web .aikajana-ilmio: --aikajana-paperi #201a14, --aikajana-reuna, teksti #f1e6d0). */
.mk-aikajana-paneeli {
    position: absolute;
    right: 10px;
    padding: 10px 12px;
    border-width: 1px;
    border-color: rgba(217, 161, 59, 0.38);
    border-radius: 12px;
    background-color: #201a14;
    color: #f1e6d0;
}

/* Havainnekuva (web .aikajana-ilmiokuva): paneelin kehys, tausta ja varjo pois, kuva reunoiltaan
 * karttaan häipyvänä (Valokeila), vuosi ◈ nimi kuvan alareunassa. */
.mk-aikajana-paneeli.mk-aikajana-paneeli--kuva {
    padding: 0;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
}

.mk-aikajana-havainne {
    width: 100%;
}

.mk-aikajana-havainne__kuva {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    opacity: 0;
    transition-property: opacity;
    transition-duration: 1.6s;
    -unity-background-scale-mode: stretch-to-fill;
}

.mk-aikajana-havainne__kuva.mk-esilla {
    opacity: 1;
}

.mk-aikajana-havainne__teksti {
    position: absolute;
    left: 6%;
    right: 6%;
    bottom: 4%;
    align-items: center;
}

.mk-aikajana-havainne__rivi {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
}

.mk-aikajana-havainne__otsikko {
    font-size: 16px;
    white-space: normal;
    -unity-text-align: middle-center;
    color: #d7bd88;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.9);
}

.mk-aikajana-havainne__erotin {
    width: 10px;
    height: 10px;
    margin: 0 7px;
    color: #d9a13b;
    --mk-ikoni-viiva: 1.8;
}

.mk-aikajana-havainne__kuvateksti {
    margin-top: 2px;
    font-size: 12.5px;
    white-space: normal;
    -unity-text-align: middle-center;
    color: #d7bd88;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.9);
}

.mk-aikajana-paneeli__kuva {
    height: 120px;
    margin: -4px -6px 8px -6px;
    border-radius: 6px;
    -unity-background-scale-mode: scale-and-crop;
}

.mk-aikajana-paneeli__vuosi {
    font-size: 11.5px;
    letter-spacing: 10.43px; /* web 1.2px */
    color: #6b4d1c;
}

.mk-aikajana-paneeli__otsikko {
    font-size: 18px;
    white-space: normal;
    color: #f1e6d0;
}

.mk-aikajana-paneeli__alarivi {
    margin-top: 2px;
    font-size: 13px;
    white-space: normal;
    color: #c9b58f;
}

.mk-aikajana-paneeli__teksti {
    margin-top: 6px;
    font-size: 14.4px;
    white-space: normal;
    color: #f1e6d0;
}

/* --- aikajanat: kertojan teksti, välinäytös, musta --------------------------- */

/* Web .aikajana-kertomusteksti: rivi keskellä, leveys min(34rem, 100vw − 2rem); alareuna aikaselaimen
 * yläpuolella (AikajanaNakyma.PaivitaAikaselain). Avauksessa (.keskella) min(40rem, 100vw − 3rem) keskellä ruutua. */
.mk-aikajana-kertomus {
    position: absolute;
    left: 16px;
    right: 16px;
    bottom: 14px;
    align-items: center;
}

.mk-aikajana-kertomus.mk-keskella {
    left: 24px;
    right: 24px;
    top: 50%;
    bottom: auto;
    translate: 0 -50%;
}

/* Web .aikajana-kertomusteksti-sisus: tumma läpikuultava laatikko, keskitetty teksti; osa häipyy 380 ms. */
.mk-aikajana-kertomus__laatikko {
    max-width: 544px;
    padding: 9.6px 14.4px;
    border-width: 1px;
    border-color: rgba(217, 161, 59, 0.38);
    border-radius: 4px;
    background-color: rgba(16, 12, 8, 0.72);
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.38s;
}

.mk-aikajana-kertomus__laatikko.mk-nakyy {
    opacity: 1;
}

.mk-aikajana-kertomus.mk-keskella .mk-aikajana-kertomus__laatikko {
    max-width: 640px;
    padding: 6.4px 9.6px;
    border-color: rgba(0, 0, 0, 0);
    background-color: rgba(0, 0, 0, 0);
}

.mk-aikajana-kertomus__teksti {
    align-self: center;
    font-size: 16.3px;
    white-space: normal;
    -unity-text-align: middle-center;
    color: #f1e6d0;
}

/* Web text-shadow: 0 2px 14px rgba(0,0,0,.95), 0 0 4px rgba(0,0,0,.8). UITK ottaa yhden varjon; toinen, tiivis
 * tumma kehä tekstin ympärillä ääriviivana (löydös 74 d2: teksti luki heikosti vaalean pallon päällä). */
.mk-aikajana-kertomus.mk-keskella .mk-aikajana-kertomus__teksti {
    font-size: 24px;
    color: #f7eeda;
    text-shadow: 0 2px 14px rgba(0, 0, 0, 0.95);
    -unity-text-outline-width: 0.8px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.6);
}

/* Web @media (max-width: 600px): avausteksti 1,25rem puhelimessa. */
.mk-aikajana-kertomus--kapea.mk-keskella .mk-aikajana-kertomus__teksti {
    font-size: 20px;
}

/* Välinäytös (web .aikajana-valinaytos-teksti): ei korttia, teksti kartan päällä varjolla; vaakanäytöllä
 * vasemmalla puoliskolla (left 5 %, top 52 %, enintään 46 %), pystyssä koko leveydeltä alempana. */
.mk-aikajana-valinaytos {
    position: absolute;
    left: 5%;
    top: 52%;
    max-width: 46%;
    translate: 0 -50%;
    transition-property: opacity;
    transition-duration: 0.42s;
}

.mk-aikajana-valinaytos.mk-pysty {
    left: 6%;
    right: 6%;
    top: 56%;
    max-width: none;
}

.mk-aikajana-valinaytos__otsikko {
    margin-bottom: 11px;
    font-size: 19px;
    white-space: normal;
    color: #f3dfae;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.9);
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.7s;
}

.mk-aikajana-valinaytos__rivi {
    margin-bottom: 7px;
    font-size: 16.5px;
    white-space: normal;
    color: #ddd0b6;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.9);
    opacity: 0;
    translate: 0 6px;
    transition-property: opacity, translate;
    transition-duration: 0.7s, 0.7s;
}

.mk-aikajana-valinaytos__otsikko.mk-esilla,
.mk-aikajana-valinaytos__rivi.mk-esilla {
    opacity: 1;
    translate: 0 0;
}

.mk-aikajana-musta {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgb(0, 0, 0);
    transition-property: opacity;
    transition-duration: 0s;
}

/* Ihmisen matkan aloituksen Ken Burns -tausta (AvausTausta; webin .aikajana-avaus-tausta). */
.mk-avaustausta {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    overflow: hidden;
    background-color: rgb(0, 0, 0);
    transition-property: opacity;
    transition-duration: 0s;
}

.mk-avaustausta__kuvat {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    transition-property: opacity;
}

/* inset: -8 %, jotta liike ei paljasta reunaa; cover; tummennus brightness(0.55). */
.mk-avaustausta__kuva {
    position: absolute;
    top: -8%;
    left: -8%;
    right: -8%;
    bottom: -8%;
    -unity-background-scale-mode: scale-and-crop;
    -unity-background-image-tint-color: rgb(140, 138, 134);
}

.mk-avaustausta__vinjetti {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
}

/* Esittely- ja loppulaatikko (webin .aikajana-avaus-laatikko ja -nappi). */
.mk-himmennys.mk-aikajana-laatikko {
    justify-content: center;
}

.mk-aikajana-laatikko__otsikko {
    font-size: 22px;
    letter-spacing: 4.55px; /* web 1px */
    color: #3a2812;
}

/* --- aloituslaatikko (linssipariteetti rivi 11; web css/aikajana.css .aikajana-avaus*) ------------------ */
.mk-aikajana-avaus {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    padding: 16px;
    background-color: rgba(0, 0, 0, 0.35);
}

/* Keksinnöt: täysmusta peite (web .aikajana-avaus.musta .aikajana-avaus-peite #000). */
.mk-aikajana-avaus--musta {
    background-color: #000;
}

/* Web .aikajana-avaus-kehys: min(31rem, 88 %). */
.mk-aikajana-avaus__kehys {
    width: 88%;
    max-width: 496px;
    flex-shrink: 0;
}

.mk-aikajana-avaus__paperi {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    -unity-background-scale-mode: stretch-to-fill;
}

/* Web padding: calc(2,4rem + 4,4 %) calc(2rem + 5,6 %) — prosentit leveydestä (≈ 326 px: 14 / 18 px). */
.mk-aikajana-avaus__laatikko {
    padding: 52px 50px 48px 50px;
    align-items: center;
}

/* Web .aikajana-avaus-otsikko: 1,46rem, 600, small-caps, 0,09 em (UITK em/100 → 9), #3a2812. */
.mk-aikajana-avaus__otsikko {
    font-size: 23.4px;
    letter-spacing: 9px;
    color: #3a2812;
    -unity-text-align: upper-center;
    white-space: normal;
    margin: 0;
}

/* Web ::after: 6rem × 2 px, liukuvärinen, margin 0,55rem auto 0; otsikon alamarginaali 0,85rem. */
.mk-aikajana-avaus__viiva {
    width: 96px;
    height: 2px;
    margin: 8.8px 0 13.6px 0;
    flex-direction: row;
    -unity-background-scale-mode: stretch-to-fill;
    background-size: 50% 100%;
    background-repeat: no-repeat no-repeat;
    background-position-x: left 0;
}

.mk-aikajana-avaus__viiva2 {
    position: absolute;
    left: 48px;
    width: 48px;
    top: 0;
    bottom: 0;
    -unity-background-scale-mode: stretch-to-fill;
}

.mk-aikajana-avaus__teksti {
    align-self: stretch;
    margin-bottom: 19.2px;
}

/* Web .aikajana-avaus-teksti: 0,98rem, rivi 1,58, vasen liehu, #2b2116. */
.mk-aikajana-avaus__kappale {
    font-size: 15.7px;
    color: #2b2116;
    -unity-text-align: upper-left;
    white-space: normal;
    margin: 0;
}

/* Web ::first-letter: 2,55 em, 600, #3a2812. */
.mk-aikajana-avaus__anfangi {
    color: #3a2812;
}

.mk-aikajana-avaus__napit {
    align-items: center;
}

/* Web .aikajana-lyhty: lämmin keila kummassakin yläkulmassa (keskus 17 % / 7 % laatikosta, joka on 98 % × 118 %). */
/* Lyhtyjen valo on paperin kokoinen ja jo rajattu repaleiseen reunaan (RepaleinenPergamentti); sijainti C#:ssa. */
.mk-aikajana-avaus__valo {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.mk-aikajana-avaus__lyhty {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    -unity-background-scale-mode: stretch-to-fill;
}

/* Web .aikajana-avaus-nappi: 44 px, padding 0,62rem 2,1rem, pilleri, reuna 1,5 px kulta, liukuväri (C#). */
.mk-aikajana-avausnappi {
    min-height: 44px;
    padding: 9.9px 33.6px;
    border-width: 1.5px;
    border-color: rgba(214, 168, 84, 0.92);
    border-radius: 22px;
    background-color: rgba(0, 0, 0, 0);
    -unity-background-scale-mode: stretch-to-fill;
    color: #f6e6c2;
}

.mk-aikajana-avausnappi:active {
    border-color: rgba(240, 198, 118, 1);
}

/* 1,06rem small-caps (C# Kapiteelit), 0,17 em (UITK 17). */
.mk-aikajana-avausnappi .mk-nappi__teksti {
    font-size: 17px;
    letter-spacing: 17px;
    color: #f6e6c2;
}

/* --- minipulun kysymyskortti (webin .satelliitti-pulukortti) ----------------- */

.mk-minipuluKortti {
    position: absolute;
    right: 12px;
    bottom: 80px;
    width: 320px;
    max-width: 92%;
    max-height: 62%;
    padding: 10px 12px 12px 12px;
    border-width: 1px;
    border-color: rgba(93, 255, 168, 0.28);
    border-radius: 12px;
    background-color: rgba(4, 12, 9, 0.9);
    color: #eafff3;
}

.mk-minipuluKortti__ylarivi {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    flex-shrink: 0;
}

.mk-minipuluKortti__otsikko {
    font-size: 13.5px;
    color: #5dffa8;
}

.mk-minipuluKortti__sulje {
    width: 28px;
    height: 28px;
    min-height: 28px;
    padding: 0;
    border-width: 1px;
    border-color: rgb(170, 170, 170);
    border-radius: 14px;
    background-color: rgba(130, 130, 130, 0.42);
    color: rgb(224, 224, 224);
}

.mk-minipuluKortti__sulje .mk-nappi__teksti {
    font-size: 16px;
    -unity-text-align: middle-center;
}

.mk-minipuluKortti__virta {
    flex-shrink: 1;
    margin-top: 8px;
}

.mk-minipuluKortti__ehdotukset {
    flex-direction: column;
}

.mk-minipuluKortti__kysymys {
    justify-content: flex-start;
    min-height: 34px;
    margin-bottom: 6px;
    padding: 7px 10px;
    border-width: 1px;
    border-color: rgba(93, 255, 168, 0.3);
    border-radius: 10px;
    background-color: rgba(10, 24, 18, 0.85);
    color: #eafff3;
}

.mk-minipuluKortti__kysymys:active,
.mk-minipuluKortti__kysymys.mk-valittu {
    border-color: #5dffa8;
    background-color: rgba(93, 255, 168, 0.18);
}

.mk-minipuluKortti__kysymysteksti {
    font-size: 14px;
    white-space: normal;
    flex-shrink: 1;
}

.mk-minipuluKortti__oma {
    align-self: flex-end;
    max-width: 88%;
    margin-bottom: 6px;
    padding: 6px 10px;
    border-width: 1px;
    border-color: rgba(93, 255, 168, 0.22);
    border-radius: 12px 12px 4px 12px;
    background-color: rgba(10, 24, 18, 0.9);
    font-size: 13px;
    white-space: normal;
}

.mk-minipuluKortti__vastaus {
    align-self: flex-start;
    max-width: 96%;
    margin-bottom: 6px;
    padding: 9px 11px;
    border-width: 1px;
    border-color: rgba(93, 255, 168, 0.35);
    border-radius: 12px 12px 12px 4px;
    background-color: rgba(18, 40, 30, 0.92);
    font-size: 14.5px;
    white-space: normal;
}

.mk-minipuluKortti__vastaus.mk-odottaa {
    opacity: 0.7;
}

.mk-minipuluKortti__syote {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    margin-top: 8px;
}

.mk-minipuluKortti__kentta {
    flex-grow: 1;
    flex-shrink: 1;
    margin: 0 6px 0 0;
    font-size: 15px;
}

.mk-minipuluKortti__kentta > .unity-base-text-field__input {
    min-height: 36px;
    padding: 4px 10px 4px 10px;
    border-width: 1px;
    border-color: rgba(93, 255, 168, 0.3);
    border-radius: 10px;
    background-color: rgba(10, 24, 18, 0.9);
    color: #eafff3;
}

.mk-minipuluKortti__laheta {
    width: 38px;
    height: 36px;
    min-height: 36px;
    padding: 0;
    border-width: 1px;
    border-color: rgba(93, 255, 168, 0.45);
    border-radius: 10px;
    background-color: rgba(93, 255, 168, 0.16);
    color: #5dffa8;
}

.mk-minipuluKortti__laheta .mk-nappi__teksti {
    font-size: 18px;
    -unity-text-align: middle-center;
}

/* Ikonit fonteista puuttuvien merkkien (◀ ⏸ ▶ ⌄) tilalla. */
.mk-aikajana-nappi > .mk-ikoni {
    width: 15px;
    height: 15px;
    margin-right: 0;
    color: #f1e6d0;
    --mk-ikoni-viiva: 2.2;
}

.mk-astrokuva__vakanen > .mk-ikoni {
    width: 16px;
    height: 16px;
    margin-right: 0;
    color: rgb(234, 255, 243);
    --mk-ikoni-viiva: 2;
}

.mk-minipuluKortti__laheta {
    justify-content: center;
}

.mk-minipuluKortti__laheta > .mk-ikoni {
    width: 17px;
    height: 17px;
    margin-right: 0;
    color: #5dffa8;
    --mk-ikoni-viiva: 2.1;
}

.mk-aikajana-nappi,
.mk-astrokuva__vakanen {
    justify-content: center;
}

/* ------------------------------------------------------------------------ *
 * MAAILMANRADIO (RadioNakyma.cs): webin css/radio.css. Puinen kotelo
 * alalaidassa, pistenäyttö tummalla lasilla, merkkivalo ja viritysasteikko.
 * Puu, paperi ja lasin liukuväri ovat tekstuureja (RadioNakyma), viivat ja
 * lamppu Painter2D:llä. Mitat: ≤ 700 px näyttö 324 × 54 ja kotelo kiinni
 * alareunassa; leveällä (.mk-radio--levea) 408 × 68 ja pyöristys 14 14 9 9.
 * ------------------------------------------------------------------------ */
.mk-radio {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    flex-direction: row;
    justify-content: center;
    opacity: 0;
    translate: 0 12px;
    transition-property: opacity, translate;
    transition-duration: 0.18s;
    transition-timing-function: ease;
}

.mk-radio.mk-auki {
    opacity: 1;
    translate: 0 0;
}

.mk-radio--levea {
    padding: 5px 6px 0 6px;
}

.mk-radio__kotelo {
    flex-grow: 1;
    max-width: 640px;
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    padding: 7.2px 8px;
    border-width: 1px 1px 0 1px;
    border-color: rgba(0, 0, 0, 0.5);
    border-top-color: rgba(217, 161, 59, 0.55);
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
}

.mk-radio--levea .mk-radio__kotelo {
    padding: 8px 9.6px;
    border-bottom-width: 1px;
    border-top-left-radius: 14px;
    border-top-right-radius: 14px;
    border-bottom-left-radius: 9px;
    border-bottom-right-radius: 9px;
}

/* Kotelon varjo kartalle (web box-shadow 0 -3px 14px). */
.mk-radio__varjo {
    position: absolute;
    left: 10px;
    right: 10px;
    top: -12px;
    height: 12px;
}

/* VU-mittari (web v267 .radio-mittari ≤ 800 px 80 × 57): kapealla keskiö vie koko rivin ja mittari on alla vasemmalla,
 * leveällä mittari on keskiön vasemmalla puolella ja kotelo levenee sen verran (web 780 → 880). */
.mk-radio__vu {
    flex-grow: 1;
}

.mk-radio--levea .mk-radio__kotelo {
    max-width: 640px;
    flex-wrap: nowrap;
}

.mk-radio__keskio {
    width: 100%;
    flex-direction: column;
    justify-content: center;
}

.mk-radio__nayttorivi {
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
}

/* RADIOUUDISTUS (build 12, Linssiseppä; suunnitelma luku 2): messinkikehykset kuvaputken 9-slicenä
 * (RadioNakyma.RadioPinnat). iPhone: VU 76 × 56, LCD-lasi 240 × 58 (näyttö 224 × 42), viivain 36;
 * iPad (.mk-radio--levea): VU 118 × 84, LCD-lasi 424 × 84 (näyttö 408 × 68), viivain 42. Lamppu on
 * keskellä LCD:n oikealle jäävää tilaa (omistaja 24.9. klo 20.0x). */
.mk-radio--pinnat .mk-radio__kotelo {
    padding: 12px 14px;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
}

.mk-radio--pinnat.mk-radio--levea .mk-radio__kotelo {
    padding: 14px;
}

.mk-radio__kehys {
    flex-shrink: 0;
    padding: 5px;
    border-radius: 6px;
}

.mk-radio__vukehys {
    width: 76px;
    height: 56px;
    margin-right: 10px;
    padding: 4px;
}

.mk-radio--levea .mk-radio__vukehys {
    width: 118px;
    height: 84px;
}

.mk-radio__lcdkehys {
    width: 240px;
    height: 58px;
    padding: 8px;
}

.mk-radio--levea .mk-radio__lcdkehys {
    width: 424px;
    height: 84px;
}

.mk-radio__lasipinta {
    position: absolute;
    left: 3px;
    top: 3px;
    right: 3px;
    bottom: 3px;
    border-radius: 3px;
}

.mk-radio__lamppualue {
    flex-grow: 1;
    align-self: stretch;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    min-width: 20px;
}

.mk-radio__asteikkokehys {
    height: 36px;
    margin-top: 8px;
    padding: 4px;
}

.mk-radio--levea .mk-radio__asteikkokehys {
    height: 42px;
    margin-top: 10px;
}

.mk-radio__naytto {
    flex-grow: 1;
    border-radius: 3px;
    background-color: #221204;
    overflow: hidden;
}

/* Sammuksissa: saturate(.55) brightness(.86); virheessä lasi punertaa. */
.mk-radio--hiljaa .mk-radio__naytto {
    background-color: #1d1006;
    -unity-background-image-tint-color: rgb(219, 219, 219);
}

.mk-radio--virhe .mk-radio__naytto {
    background-color: #3a1408;
}

.mk-radio__pisteet {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.mk-radio__lasikehys {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    border-width: 2px;
    border-color: rgba(24, 15, 6, 0.85);
    border-radius: 3px;
}

/* Merkkivalo: painettava 44 × 44, lamppu 22 (leveällä 26) keskellä; näkyvä
 * väli näyttöön .7rem kuten webissä. */
.mk-radio__lamppu {
    flex-shrink: 0;
    width: 36px;
    height: 36px;
}

.mk-radio--levea .mk-radio__lamppu {
    width: 44px;
    height: 44px;
}

.mk-radio__asteikko {
    flex-grow: 1;
    border-width: 1px;
    border-color: rgba(58, 42, 23, 0.5);
    border-radius: 2px;
    overflow: hidden;
}

.mk-radio__nauha {
    position: absolute;
    left: 6px;
    right: 6px;
    top: 0;
    bottom: 0;
    flex-direction: row;
}

.mk-radio__kaupunki {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    min-width: 0;
    padding: 3px 1px 0 1px;
    font-size: 7px;
    letter-spacing: 2px; /* web 0.14px */
    -unity-text-align: upper-center;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: clip;
    color: rgba(48, 33, 15, 0.82);
    text-shadow: 0 1px 0 rgba(255, 246, 220, 0.4);
    transition-property: color, opacity;
    transition-duration: 0.18s;
}

.mk-radio__kaupunki--keski {
    color: rgba(40, 27, 12, 0.95);
    letter-spacing: 1.75px; /* web 0.28px */
}

.mk-radio__kaupunki--kauka {
    color: rgba(40, 26, 10, 0.94);
    text-shadow: 0 1px 0 rgba(255, 247, 224, 0.55);
}

.mk-radio__kaupunki:active {
    color: #b03a2b;
}

.mk-radio--viritys .mk-radio__kaupunki {
    opacity: 0.55;
}

.mk-radio--viritys .mk-radio__kaupunki--keski {
    opacity: 0.8;
}

/* Viisari: punainen 1,5 px viiva ja paperinvärinen 1 px reunus. */
.mk-radio__viisari {
    position: absolute;
    left: 50%;
    top: 0;
    bottom: 0;
    width: 3.5px;
    margin-left: -1.75px;
    background-color: rgba(251, 241, 216, 0.85);
    transition-property: opacity;
    transition-duration: 0.18s;
}

.mk-radio__viisari-punainen {
    position: absolute;
    left: 1px;
    top: 0;
    bottom: 0;
    width: 1.5px;
    background-color: #b03a2b;
}

.mk-radio--hiljaa .mk-radio__viisari {
    opacity: 0.45;
}

/* Linkkiasema (hybridimalli 23.9.2026): nimi ja "Avaa aseman sivu". */
.mk-radio__linkki {
    display: none;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-top: 6px;
}

.mk-radio__linkkinimi {
    flex-shrink: 1;
    min-width: 0;
    margin-right: 8px;
    font-size: 13px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    color: #f3e6d0;
    text-shadow: 0 1px 1px rgba(0, 0, 0, 0.7);
}

.mk-radio__sivu {
    flex-shrink: 0;
    min-height: 32px;
    padding: 4px 12px;
    border-radius: 16px;
}

.mk-radio__sivu .mk-nappi__teksti {
    font-size: 12.5px;
}

/* --- vertailun maakäyrät (Maakayrakuva.cs): webin .maakayrat, .maakayra-otsikko,
 * .maakayra-lahde ja p.johdanto (css/styles.css). Kuvion kehys ja akselitekstit
 * ovat Maa numeroina -sivun (Lehti.uss .mk-numerot__kuvio / __akseli). ----------- */

.mk-vertailuarkki__kayrat {
    margin: 12px 4px 0 4px;
}

.mk-maakayrat {
    flex-direction: row;
    flex-wrap: wrap;
    margin: 5px 0 10px 0;
}

.mk-maakayrat__otsikko {
    margin: 0 0 5px 0;
    font-size: 12.5px;
    white-space: normal;
    color: #211d18;
}

.mk-maakayrat__tila {
    font-size: 16px;
    white-space: normal;
    margin: 4px 0 14px 0;
    color: rgba(70, 51, 31, 0.9);
}

.mk-maakayrat__lahde {
    margin: 0 0 8px 0;
    font-size: 11.5px;
    white-space: normal;
    color: rgba(70, 51, 31, 0.68);
}

/* Astronautin lisätietojen ulkolinkit (web .satelliitti-linkki). */
.mk-astrokuva__linkki {
    color: #e9c77b;
    border-bottom-width: 1px;
    border-color: rgba(233, 199, 123, 0.6);
}

/* Lapun kahva ohjaimissa (web .aikajana-kahva): "Nimi ▾", näkyy vain lapun ollessa piilossa. */
.mk-aikajana-kahva {
    width: auto;
    max-width: 180px;
    padding: 0 10px;
}

.mk-aikajana-kahva .mk-nappi__teksti {
    font-size: 12.5px;
    overflow: hidden;
    text-overflow: ellipsis;
}

/* --- Tiedeliite (web css/aikajana.css .tiedeliite-*, fokusnosto .looppi-*) --------------- */
.mk-aikajana-lue {
    align-self: flex-start;
    margin-top: 8px;
    min-height: 32px;
    padding: 2px 14px;
    border-width: 1px;
    border-color: rgba(217, 161, 59, 0.5);
    border-radius: 8px;
    background-color: rgba(217, 161, 59, 0.18);
    color: #f1e6d0;
}

.mk-aikajana-lue .mk-nappi__teksti {
    font-size: 13px;
    color: #f1e6d0;
}

.mk-tiedeliite__peite {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    padding: 16px;
    background-color: rgba(18, 12, 4, 0.3);
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.22s;
}

.mk-tiedeliite__peite.mk-auki {
    opacity: 1;
}

.mk-tiedeliite {
    width: 100%;
    max-width: 640px;
    max-height: 90%;
    padding: 11px 13px 10px 13px;
    border-width: 1px;
    border-color: rgba(122, 85, 20, 0.45);
    border-radius: 12px;
    background-color: #f6ecc6;
    color: #211d18;
}

.mk-tiedeliite__ylarivi {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    margin-bottom: 8px;
    padding-bottom: 5px;
    border-bottom-width: 3px;
    border-color: rgba(70, 51, 31, 0.75);
}

.mk-tiedeliite__reuna {
    flex-grow: 1;
    flex-basis: 0;
    flex-direction: row;
    align-items: center;
}

.mk-tiedeliite__reuna--oikea {
    justify-content: flex-end;
}

.mk-tiedeliite__nimiot {
    align-items: center;
}

.mk-tiedeliite__nimio {
    font-size: 15px;
    letter-spacing: 20px; /* web 3px */
}

.mk-tiedeliite__paikkarivi {
    font-size: 12px;
    color: rgba(70, 51, 31, 0.8);
}

.mk-tiedeliite__ikoninappi {
    width: 36px;
    height: 34px;
    padding: 0;
    justify-content: center;
    align-items: center;
    background-color: rgba(0, 0, 0, 0);
    color: #46331f;
}

.mk-tiedeliite__ikoninappi > .mk-ikoni {
    width: 20px;
    height: 20px;
    margin-right: 0;
}

.mk-tiedeliite__sulje {
    min-height: 34px;
    padding: 1px 6px;
    background-color: rgba(0, 0, 0, 0);
    color: #46331f;
}

.mk-tiedeliite__sulje .mk-nappi__teksti {
    font-size: 18px;
}

.mk-tiedeliite__sisallys {
    position: absolute;
    top: 58px;
    left: 10px;
    width: 260px;
    max-height: 70%;
    padding: 6px;
    border-width: 1px;
    border-color: rgba(122, 85, 20, 0.45);
    border-radius: 8px;
    background-color: #fbf4dc;
}

.mk-tiedeliite__sisallysrivi {
    flex-direction: row;
    align-items: center;
    min-height: 32px;
    padding: 2px 6px;
    background-color: rgba(0, 0, 0, 0);
    color: #211d18;
}

.mk-tiedeliite__sisallysrivi.mk-valittu {
    background-color: rgba(122, 85, 20, 0.14);
}

.mk-tiedeliite__sisallysvuosi {
    width: 64px;
    font-size: 12px;
    color: #7a5514;
}

.mk-tiedeliite__sisallysnimi {
    flex-shrink: 1;
    font-size: 13px;
    white-space: normal;
}

.mk-tiedeliite__vieritys {
    flex-shrink: 1;
}

.mk-tiedeliite__otsikko {
    font-size: 21px;
    white-space: normal;
    margin-bottom: 6px;
}

.mk-tiedeliite__henkilo {
    font-size: 11.5px;
    letter-spacing: 17.39px; /* web 2px */
    color: #7a5514;
    margin-bottom: 8px;
}

.mk-tiedeliite__ingressi {
    font-size: 15.5px;
    -unity-font-style: italic;
    white-space: normal;
    margin-bottom: 8px;
}

.mk-tiedeliite__palsta {
    flex-direction: row;
    align-items: flex-start;
}

.mk-tiedeliite__leipa {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
}

.mk-tiedeliite__kappale {
    font-size: 14.5px;
    white-space: normal;
    margin-bottom: 8px;
}

.mk-tiedeliite__kasvot {
    width: 34%;
    margin-left: 10px;
}

.mk-tiedeliite__kasvo {
    margin-bottom: 8px;
}

.mk-tiedeliite__kasvo > .mk-tiedeliite__kuva {
    height: 150px;
    border-width: 1px;
    border-color: rgba(70, 51, 31, 0.35);
    border-radius: 6px;
    background-color: #e6dcc3;
    -unity-background-scale-mode: scale-and-crop;
}

.mk-tiedeliite__ilmio,
.mk-tiedeliite__karuselli {
    margin: 4px 0 12px 0;
}

.mk-tiedeliite__ilmio > .mk-tiedeliite__kuva,
.mk-tiedeliite__kuva--karuselli {
    height: 240px;
    border-radius: 6px;
    background-color: #e6dcc3;
    -unity-background-scale-mode: scale-to-fit;
}

.mk-tiedeliite__kuvateksti {
    margin-top: 4px;
    font-size: 11.5px;
    color: rgba(33, 29, 24, 0.75);
    white-space: normal;
}

.mk-tiedeliite__karuselli-ikkuna {
    justify-content: center;
}

.mk-tiedeliite__karuselli-nuoli {
    position: absolute;
    top: 100px;
    left: 4px;
    width: 36px;
    height: 40px;
    border-radius: 18px;
    background-color: rgba(246, 236, 198, 0.85);
    color: #46331f;
}

.mk-tiedeliite__karuselli-nuoli--oikea {
    left: auto;
    right: 4px;
}

.mk-tiedeliite__karuselli-nuoli:disabled {
    opacity: 0.3;
}

.mk-tiedeliite__pisteet {
    flex-direction: row;
    justify-content: center;
    margin-top: 6px;
}

.mk-tiedeliite__piste {
    width: 10px;
    height: 10px;
    min-height: 10px;
    margin: 0 4px;
    padding: 0;
    border-radius: 5px;
    background-color: rgba(70, 51, 31, 0.25);
}

.mk-tiedeliite__piste.mk-valittu {
    background-color: #7a5514;
}

.mk-tiedeliite__keksija {
    margin-top: 8px;
    padding-top: 8px;
    border-top-width: 1px;
    border-color: rgba(70, 51, 31, 0.3);
}

.mk-tiedeliite__valiotsikko {
    font-size: 16px;
    margin-bottom: 6px;
}

.mk-tiedeliite__navi {
    flex-direction: row;
    justify-content: space-between;
    flex-shrink: 0;
    margin-top: 8px;
    padding-top: 6px;
    border-top-width: 1px;
    border-color: rgba(70, 51, 31, 0.3);
}

.mk-tiedeliite__navinappi {
    flex-shrink: 1;
    max-width: 49%;
    min-height: 34px;
    padding: 2px 8px;
    background-color: rgba(0, 0, 0, 0);
    color: #7a5514;
}

.mk-tiedeliite__navinappi .mk-nappi__teksti {
    font-size: 13px;
}

.mk-tiedeliite__navinappi:disabled {
    opacity: 0.45;
}

/* ------------------------------------------------------------------------ *
 * KEKSIJÄKARUSELLI (Keksijakaruselli.cs): web css/aikajana.css .aikajana-nauha ja
 * .aikajana-kortti. Kortti on tummaa paperia (#201a14) kultaisella hiusviivalla,
 * muotokuva 4:5 ja nimi kursiivilla; keskimmäisellä kultareuna. Paikka, mitta ja
 * himmeys tulevat koodista (translate, scale, opacity) 0,6 s siirtymällä.
 * ------------------------------------------------------------------------ */
.mk-karuselli {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 10px;
    overflow: hidden;
}

.mk-karuselli__kortti {
    position: absolute;
    left: 50%;
    bottom: 0;
    overflow: hidden;
    border-width: 1px;
    border-color: rgba(217, 161, 59, 0.38);
    border-radius: 10px;
    background-color: #201a14;
    transform-origin: center bottom;
    transition-property: translate, scale, opacity;
    transition-duration: 0.6s, 0.6s, 0.6s;
    transition-timing-function: ease-in-out-cubic, ease-in-out-cubic, ease-in-out-cubic;
}

.mk-karuselli--vedossa .mk-karuselli__kortti {
    transition-duration: 0s, 0s, 0s;
}

.mk-karuselli__kortti--nykyinen {
    border-width: 2px;
    border-color: rgba(217, 161, 59, 0.75);
}

.mk-karuselli__kortti--paalu {
    background-color: #2a2119;
}

.mk-karuselli__kuva {
    width: 100%;
    background-color: #2a2119;
    -unity-background-scale-mode: scale-and-crop;
}

.mk-karuselli__nimi {
    padding: 4px 6px 6px 6px;
    font-size: 11px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    color: #d9ccb4;
}

/* Ihmisen matkan löytökuva (web .aikajana-kertomuskuva): kehyksetön, reunoiltaan häipyvä
 * (Valokeila.HaeKertomuskuva), kasvaa 0,6 → 1 pisteestä ylöspäin pienellä ylityksellä. */
.mk-aikajana-kertomuskuva {
    position: absolute;
    -unity-background-scale-mode: stretch-to-fill;
    transform-origin: center bottom;
    scale: 0.6 0.6;
    opacity: 0;
    transition-property: scale, opacity;
    transition-duration: 0.5s, 0.4s;
    transition-timing-function: ease-out-back, ease;
}

.mk-aikajana-kertomuskuva.mk-esilla {
    scale: 1 1;
    opacity: 1;
}

/* ------------------------------------------------------------------------ *
 * AIKASELAIN (Aikaselain.cs): web css/aikajana.css .aikaselain. Tumma lasi
 * alalaidassa, viiva per jakso; korkeus ja aalto (viivan korkeus ja
 * läpinäkymättömyys) koodista, valittu kultainen. Vuosi valitun yllä.
 * ------------------------------------------------------------------------ */
.mk-aikaselain {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    border-top-width: 1px;
    border-color: rgba(217, 161, 59, 0.38);
    background-color: rgba(37, 27, 18, 0.82);
    transition-property: opacity;
    transition-duration: 0.5s;
}

.mk-aikaselain--vedossa {
    background-color: rgba(45, 33, 22, 0.88);
}

.mk-aikaselain__viivat {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 9px;
    height: 30px;
}

.mk-aikaselain--puhelin .mk-aikaselain__viivat {
    bottom: 6px;
    height: 26px;
}

.mk-aikaselain__viiva {
    position: absolute;
    bottom: 0;
    width: 2px;
    border-radius: 1px;
    translate: -50% 0;
    background-color: rgba(233, 214, 176, 0.62);
    transition-property: height, opacity, background-color;
    transition-duration: 0.24s, 0.24s, 0.24s;
}

.mk-aikaselain__viiva--valittu {
    width: 3px;
    background-color: #d9a13b;
}

.mk-aikaselain__vuosi {
    position: absolute;
    bottom: 41px;
    translate: -50% 0;
    font-size: 11px;
    letter-spacing: 6.36px; /* web 0.7px */
    white-space: nowrap;
    color: #f1e6d0;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.85);
    transition-property: left;
    transition-duration: 0.24s;
}

.mk-aikaselain--puhelin .mk-aikaselain__vuosi {
    bottom: 34px;
    font-size: 10px;
}

/* ------------------------------------------------------------------------ *
 * IHMISEN MATKAN NOSTOKORTTI (IhmisenNostokortti.cs): web css/ihmisen-tutkimus.css
 * .ihmisen-nostokortti. Tumma paperi palkin alla vasemmalla, enintään 384 px.
 * ------------------------------------------------------------------------ */
.mk-ihmisnosto {
    position: absolute;
    left: 18px;
    width: 384px;
    max-width: 90%;
    max-height: 72%;
    padding: 13px 16px 16px 16px;
    border-width: 1px;
    border-color: rgba(217, 161, 59, 0.38);
    border-radius: 12px;
    background-color: #201a14;
    color: #f1e6d0;
}

.mk-ihmisnosto__vieritys {
    flex-shrink: 1;
}

.mk-ihmisnosto__sulje {
    position: absolute;
    top: 6px;
    right: 6px;
    width: 30px;
    height: 30px;
    min-height: 30px;
    padding: 0;
    border-width: 1px;
    border-color: rgba(217, 161, 59, 0.3);
    border-radius: 15px;
    background-color: rgba(0, 0, 0, 0.25);
}

.mk-ihmisnosto__sulje .mk-nappi__teksti {
    font-size: 13px;
    -unity-text-align: middle-center;
    color: #e9dcc0;
}

.mk-ihmisnosto__ajoitus {
    flex-direction: row;
    align-items: center;
    padding-right: 32px;
}

.mk-ihmisnosto__pilkku {
    width: 9px;
    height: 9px;
    margin-right: 6px;
    border-radius: 5px;
    background-color: #d9a13b;
}

.mk-ihmisnosto__ajoitusteksti {
    font-size: 11.5px;
    letter-spacing: 8.7px; /* web 1px */
    color: #c9a15a;
}

.mk-ihmisnosto__otsikko {
    margin: 2px 32px 2px 0;
    font-size: 17px;
    white-space: normal;
    color: #f1e6d0;
}

.mk-ihmisnosto__paikka {
    margin-bottom: 8px;
    font-size: 12.5px;
    white-space: normal;
    color: #b9a888;
}

.mk-ihmisnosto__kuvat {
    flex-direction: row;
    margin: 6px 0 10px 0;
}

.mk-ihmisnosto__kuvakehys {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
    margin-right: 7px;
}

.mk-ihmisnosto__kuvakehys--esine {
    flex-grow: 0;
    flex-basis: 38%;
}

.mk-ihmisnosto__kuva {
    width: 100%;
    border-width: 1px;
    border-color: rgba(217, 161, 59, 0.3);
    border-radius: 6px;
    background-color: rgba(0, 0, 0, 0.2);
    -unity-background-scale-mode: scale-and-crop;
}

.mk-ihmisnosto__kuvakehys--aito .mk-ihmisnosto__kuva {
    -unity-background-scale-mode: scale-to-fit;
}

.mk-ihmisnosto__kuvateksti {
    margin-top: 3px;
    font-size: 10.5px;
    white-space: normal;
    color: #9b8b6e;
}

.mk-ihmisnosto__lahde {
    margin-bottom: 8px;
    font-size: 11px;
    white-space: normal;
    color: #857657;
}

.mk-ihmisnosto__lue {
    align-self: flex-start;
    min-height: 32px;
    margin-bottom: 10px;
    padding: 4px 12px;
    border-width: 1px;
    border-color: rgba(217, 161, 59, 0.55);
    border-radius: 8px;
    background-color: rgba(217, 161, 59, 0.12);
}

.mk-ihmisnosto__lue .mk-nappi__teksti {
    font-size: 12.5px;
    color: #e6c98a;
}

.mk-ihmisnosto__teksti {
    margin-bottom: 8px;
    font-size: 14.5px;
    white-space: normal;
    color: #eadcc0;
}

.mk-ihmisnosto__kysymykset {
    margin-top: 4px;
}

.mk-ihmisnosto__kysyotsikko {
    margin-bottom: 5px;
    font-size: 12.5px;
    color: #c9a15a;
}

.mk-ihmisnosto__kysymys {
    min-height: 32px;
    margin-bottom: 6px;
    padding: 5px 11px;
    border-width: 1px;
    border-color: rgba(217, 161, 59, 0.45);
    border-radius: 16px;
    background-color: rgba(0, 0, 0, 0);
}

.mk-ihmisnosto__kysymys .mk-nappi__teksti {
    font-size: 13px;
    white-space: normal;
    -unity-text-align: middle-left;
    color: #e6c98a;
}

.mk-ihmisnosto__kysymys--lahetetty {
    opacity: 0.55;
}

.mk-ihmisnosto__vastaus {
    margin: 6px 0 4px 0;
    padding: 8px 10px;
    border-radius: 8px;
    background-color: rgba(255, 255, 255, 0.06);
    font-size: 14px;
    white-space: normal;
    color: #f1e6d0;
}

.mk-ihmisnosto__vastauslahde {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
}

.mk-ihmisnosto__lahdeteksti {
    margin-right: 4px;
    font-size: 11.5px;
    color: #9b8b6e;
}

.mk-ihmisnosto__lahdelinkki {
    min-height: 24px;
    margin-right: 8px;
    padding: 0;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
}

.mk-ihmisnosto__lahdelinkki .mk-nappi__teksti {
    font-size: 11.5px;
    color: #c9a15a;
}

/* ------------------------------------------------------------------------ *
 * IHMISEN MATKAN TUTKIMUSVAIHE (IhmisenTutkimusNakyma.cs): web css/ihmisen-tutkimus.css.
 * Virtanapit palkissa (legendana himmeät), sykkivät nostopisteet ja vanalappu.
 * ------------------------------------------------------------------------ */
.mk-vananapit {
    flex-direction: row;
    flex-shrink: 1;
    align-items: center;
    min-width: 0;
    margin-left: auto;
    margin-right: auto;
    padding: 0 6px;
    overflow: hidden;
}

.mk-vananappi {
    flex-direction: row;
    flex-shrink: 0;
    align-items: center;
    min-height: 0;
    margin-right: 2px;
    padding: 4px 8px;
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0);
    border-radius: 8px;
    background-color: rgba(0, 0, 0, 0);
    transition-property: opacity, background-color, border-color;
    transition-duration: 0.3s, 0.2s, 0.2s;
}

.mk-vananappi.mk-valittu {
    border-color: rgba(233, 214, 176, 0.75);
    background-color: rgba(212, 175, 90, 0.22);
}

.mk-vananapit--legenda .mk-vananappi {
    opacity: 0.62;
}

.mk-vananappi__pilkku {
    width: 10px;
    height: 10px;
    margin-right: 6px;
    border-radius: 5px;
}

.mk-vananappi__nimi {
    font-size: 12.5px;
    white-space: nowrap;
    color: #e9dcc0;
}

.mk-ihmisnostot {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
}

.mk-ihmisnosto-piste {
    position: absolute;
    width: 34px;
    height: 34px;
    translate: -50% -50%;
    align-items: center;
    justify-content: center;
}

.mk-ihmisnosto-piste__syke {
    position: absolute;
    width: 14px;
    height: 14px;
    border-radius: 7px;
    opacity: 0.35;
    scale: 0.75 0.75;
    transition-property: opacity, scale;
    transition-duration: 1.3s, 1.3s;
    transition-timing-function: ease-in-out, ease-in-out;
}

.mk-ihmisnostot--syke .mk-ihmisnosto-piste__syke {
    opacity: 0.95;
    scale: 1.25 1.25;
}

.mk-ihmisnosto-piste__ydin {
    width: 5px;
    height: 5px;
    border-width: 1px;
    border-color: rgba(40, 26, 8, 0.65);
    border-radius: 3px;
}

.mk-vanalappu {
    position: absolute;
    left: 5%;
    right: 5%;
    bottom: 76px;
    max-width: 544px;
    align-self: center;
    padding: 11px 15px 13px 15px;
    border-width: 1px;
    border-color: rgba(120, 88, 34, 0.55);
    border-radius: 10px;
    color: #2a1f12;
}

.mk-vanalappu__otsikko {
    margin-bottom: 4px;
    font-size: 12.5px;
    letter-spacing: 11.2px; /* web 1.4px */
    color: #6b4d1c;
}

.mk-vanalappu__teksti {
    font-size: 14.5px;
    white-space: normal;
    color: #2a1f12;
}

/* Tiedeliitteen sisällys listana (web .tiedeliite-sisallys.lista) ja alkusanat. */
.mk-tiedeliite__sisallyspilkku {
    width: 9px;
    height: 9px;
    margin-right: 7px;
    border-radius: 5px;
    background-color: rgb(212, 175, 90);
}

.mk-tiedeliite__alkusanat {
    margin-bottom: 12px;
    font-size: 14px;
    white-space: normal;
    color: #5a4a33;
}

/* --- radion napit pallolla (RadioNapit, web .pallolauta-radionappi) --------- */
.mk-radionapit {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
}

.mk-radionappi {
    position: absolute;
    width: 44px;
    height: 44px;
}


.mk-radio--levea .mk-radio__keskio {
    width: auto;
    flex-grow: 1;
    flex-shrink: 1;
}

/* iPhonen ☰-valikko (omistaja 24.9.2026, löydös 20): sama pergamenttipaneeli, matala yläkaista, linssit ja
 * valikon rivit vievät koko korkeuden; rivit ohuen viivan jälkeen. */
.mk-linssivalitsin--valikko {
    width: 300px;
    max-height: 82%;
    padding: 4px 8px 8px 8px;
}

.mk-linssivalitsin--valikko .mk-selite__ylarivi {
    padding: 0 2px 2px 5.6px;
    margin-bottom: 2px;
}

.mk-linssivalitsin--valikko .mk-selite__sulje {
    height: 24px;
    min-height: 24px;
}

.mk-linssivalitsin__lisaosa {
    flex-direction: column;
    padding-bottom: 2px;
}

.mk-linssivalitsin__erotin {
    height: 1px;
    margin: 6px 4px;
    background-color: rgba(70, 51, 31, 0.25);
}

/* ☰-valikon yläosa (omistaja 24.9.2026 klo 13.3x): kaksi tiivistä nappiriviä — äänikytkimet ja
 * Uusi peli · Muut · Kehittäjä. Napit jakavat rivin tasan; kytkin päällä = kultareuna ja -täyttö. */
.mk-valikkorivi {
    flex-direction: row;
    margin: 2px 0;
}

.mk-valikkonappi {
    flex-grow: 1;
    flex-basis: 0;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    min-height: 34px;
    margin: 0 2px;
    padding: 3px 6px;
    border-width: 1px;
    border-color: rgba(70, 51, 31, 0.3);
    border-radius: 8px;
    background-color: rgba(255, 250, 238, 0.45);
    color: var(--map-ink);
}

.mk-valikkonappi:active {
    background-color: rgba(225, 204, 160, 0.7);
}

.mk-valikkonappi__ikoni {
    width: 16px;
    height: 16px;
    margin-right: 5px;
    flex-shrink: 0;
    --mk-ikoni-viiva: 1.6;
}

.mk-valikkonappi__nimi {
    font-size: 12.5px;
    color: #3a2812;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    flex-shrink: 1;
}

/* Äänikytkin: pois = himmeä, päällä = kultainen. */
.mk-valikkonappi--kytkin {
    opacity: 0.6;
}

.mk-valikkonappi--kytkin.mk-valittu {
    opacity: 1;
    border-color: #b07d1e;
    background-color: rgba(217, 161, 59, 0.22);
}

/* Muut-paneelin rivit: koko leveys, vasemmalle tasattu. */
.mk-linssivalitsin__muutlista {
    flex-direction: column;
}

.mk-valikkonappi--rivi {
    flex-grow: 0;
    flex-basis: auto;
    justify-content: flex-start;
    min-height: 40px;
    margin: 2px 0;
    padding: 6px 10px;
}

.mk-valikkonappi--rivi > .mk-valikkonappi__ikoni {
    width: 20px;
    height: 20px;
    margin-right: 10px;
}

.mk-valikkonappi--rivi > .mk-valikkonappi__nimi {
    font-size: 15px;
}

.mk-selite__sulje.mk-linssivalitsin__takaisin {
    width: auto;
    padding: 0 6px;
    font-size: 13px;
}

/* Valikon linssiosan väliotsikko viivan alla (pelin rivit yläpuolella). */
.mk-linssivalitsin__valiotsikko {
    margin: 2px 5.6px 4px 5.6px;
    -unity-text-align: middle-left;
}

/* Valitun radiomaston nimi (radiouudistus build 12, suunnitelma luku 4; mitattu hyväksytystä havainnekuvasta
   kaappaukset/radiouudistus-20260924/1-paakuva-ipad.jpg, 1024 pt): versaali serif, noin 15 pt, harvennus 1 pt,
   kerman täyttö #f3e9d2 ja tumma ääriviiva, hämärän kartan päällä. Webissä vastinetta ei ole (▶-napit). */
.mk-radio-mastonimi {
    position: absolute;
    font-size: 15px;
    letter-spacing: 6.67px; /* web 1px */
    color: #f3e9d2;
    -unity-text-outline-width: 0.8px;
    -unity-text-outline-color: #2a1c10;
    text-shadow: 0 1px 2px rgba(20, 12, 4, 0.8);
    white-space: nowrap;
}
