/* KARTAN KALUSTEET (Natiivi-UI, erä 4): kartuscha (webin maapaneeli, css/styles.css
 * ~27191–27870) ja karttaselite (~25710–26170). Pergamentin muste rgba(58,40,25,.92),
 * toissijainen rgba(74,52,33,…); kartalla kelluva teksti saa pergamenttihalon. */

/* --- kartuscha ---------------------------------------------------------- */

.mk-kartuscha {
    position: absolute;
    flex-direction: column;
    max-width: 92%;
    padding: 4px 8px 4px 8px;
    border-width: 0;
    border-radius: 2px;
    color: rgba(58, 40, 25, 0.92);
}

.mk-kartuscha.mk-auki {
    width: 100%;
    max-width: 460px;
    padding: 10px 14px 10px 14px;
    background-color: rgba(247, 239, 219, 0.94);
    border-width: 1px;
    border-color: rgba(74, 52, 33, 0.55);
}

.mk-kartuscha__sisus {
    flex-direction: column;
    padding: 4px 2px 8px 2px;
    margin-bottom: 6px;
    border-bottom-width: 1px;
    border-color: rgba(74, 52, 33, 0.22);
}

.mk-kartuscha__masto {
    flex-direction: column;
    align-items: flex-start;
    justify-content: flex-start;
    min-height: 0;
    padding: 0;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    color: rgba(58, 40, 25, 0.92);
}

.mk-kartuscha__masto:active {
    background-color: rgba(0, 0, 0, 0);
    opacity: 0.8;
}

.mk-kartuscha__nimirivi {
    flex-direction: row;
    align-items: center;
}

.mk-kartuscha__nimi {
    font-size: 24px;
    letter-spacing: 4.8px;
    text-shadow: 0 0 4px rgb(244, 232, 205);
}

.mk-kartuscha.mk-auki .mk-kartuscha__nimi,
.mk-kartuscha.mk-auki .mk-kartuscha__alarivi {
    text-shadow: 0 0 0 rgba(0, 0, 0, 0);
}

.mk-kartuscha__lippu {
    display: none;
    height: 18px;
    width: 27px;
    margin-right: 9px;
    border-width: 1px;
    border-color: rgba(74, 52, 33, 0.45);
    -unity-background-scale-mode: stretch-to-fill;
}

.mk-kartuscha.mk-auki .mk-kartuscha__lippu {
    display: flex;
}

.mk-kartuscha__viiva {
    height: 1px;
    align-self: stretch;
    margin: 3px 0 3px 0;
    background-color: rgba(74, 52, 33, 0.55);
}

.mk-kartuscha__alarivi {
    font-size: 14px;
    letter-spacing: 1.1px;
    color: rgba(74, 52, 33, 0.85);
    white-space: normal;
    text-shadow: 0 0 3px rgb(244, 232, 205);
}

.mk-kartuscha__aiheet {
    flex-direction: row;
    flex-wrap: wrap;
    margin-bottom: 8px;
}

.mk-kartuscha__aihe {
    min-height: 26px;
    padding: 2px 0 1px 0;
    margin: 0 12px 6px 0;
    border-width: 0;
    border-bottom-width: 1px;
    border-radius: 0;
    background-color: rgba(0, 0, 0, 0);
    color: rgba(58, 40, 25, 0.92);
}

.mk-kartuscha__aihe:active {
    background-color: rgba(74, 52, 33, 0.08);
}

.mk-kartuscha__aihe .mk-nappi__teksti {
    font-size: 12.5px;
    letter-spacing: 1.5px;
}

.mk-kartuscha__vuosi,
.mk-kartuscha__rivi {
    flex-direction: row;
    align-items: center;
    min-height: 20px;
}

.mk-kartuscha__nimike {
    width: 118px;
    flex-shrink: 0;
    font-size: 11px;
    letter-spacing: 1.4px;
    color: rgba(74, 52, 33, 0.75);
}

.mk-kartuscha__arvo {
    flex-shrink: 1;
    font-size: 12.5px;
    white-space: normal;
}

.mk-kartuscha__sija {
    display: none;
    margin-left: 8px;
    font-size: 10.5px;
    color: rgba(74, 52, 33, 0.6);
}

.mk-kartuscha__tilastot.mk-sijat-auki .mk-kartuscha__sija {
    display: flex;
}

.mk-kartuscha__nyt {
    font-size: 11px;
    -unity-font-style: italic;
    color: rgba(74, 52, 33, 0.7);
    margin: 6px 0 2px 0;
}

.mk-kartuscha__kielet {
    flex-direction: row;
    margin-top: 2px;
}

.mk-kartuscha__tervehdykset {
    flex-direction: column;
    flex-shrink: 1;
}

.mk-tervehdys {
    flex-direction: row;
    align-items: center;
    flex-wrap: wrap;
    min-height: 18px;
}

.mk-tervehdys__teksti {
    font-size: 12.5px;
    -unity-font-style: italic;
    margin-right: 6px;
}

.mk-tervehdys__lippu {
    height: 11px;
    width: 16px;
    margin-right: 5px;
    border-width: 0.5px;
    border-color: rgba(74, 52, 33, 0.4);
    -unity-background-scale-mode: stretch-to-fill;
}

.mk-tervehdys__kieli {
    font-size: 11px;
    color: rgba(74, 52, 33, 0.7);
}

/* --- karttaselite -------------------------------------------------------- */

.mk-seliteNappi {
    position: absolute;
    right: 10px;
    width: 40px;
    height: 40px;
    min-height: 40px;
    padding: 0;
    border-radius: 12px;
    border-color: rgba(70, 51, 31, 0.35);
    background-color: rgba(239, 220, 180, 0.9);
    color: var(--map-ink);
}

.mk-seliteNappi:active {
    background-color: rgba(225, 204, 160, 0.95);
}

.mk-seliteNappi.mk-valittu {
    background-color: var(--map-ink);
    color: #f5f0e2;
}

.mk-seliteNappi > .mk-ikoni {
    width: 20px;
    height: 20px;
    margin-right: 0;
    --mk-ikoni-viiva: 1.6;
}

.mk-selite {
    position: absolute;
    right: 10px;
    width: 240px;
    max-width: 78%;
    max-height: 60%;
    padding: 8px 8px 10px 8px;
    background-color: #f5f0e2;
    border-radius: 8px;
    color: var(--map-ink);
    opacity: 0;
    translate: 0 -10px;
    scale: 1 0.86;
    transform-origin: top;
    transition-property: opacity, translate, scale;
    transition-duration: 0.18s, 0.22s, 0.22s;
    transition-timing-function: ease-out;
}

.mk-selite.mk-auki {
    opacity: 1;
    translate: 0 0;
    scale: 1 1;
}

.mk-karhea-kehys {
    position: absolute;
    top: 1px;
    left: 1px;
    right: 1px;
    bottom: 1px;
    border-color: rgba(70, 51, 31, 0.78);
}

.mk-selite__ylarivi {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 0 2px 6px 8px;
}

.mk-selite__otsikko {
    font-size: 11px;
    letter-spacing: 2px;
    color: var(--map-ink);
    padding-bottom: 2px;
    border-bottom-width: 1px;
    border-color: rgba(70, 51, 31, 0.5);
}

.mk-selite__sulje {
    width: 32px;
    height: 32px;
    min-height: 32px;
    padding: 0;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    color: var(--map-ink);
}

.mk-selite__sulje:active {
    background-color: rgba(70, 51, 31, 0.1);
}

.mk-selite__sulje .mk-nappi__teksti {
    font-size: 16px;
    -unity-text-align: middle-center;
}

.mk-selite__vieritys {
    flex-shrink: 1;
}

.mk-selite__lista {
    position: relative;
}

.mk-selite-rivi {
    justify-content: flex-start;
    min-height: 36px;
    padding: 2px 10px 2px 6px;
    border-width: 0;
    border-radius: 6px;
    background-color: rgba(0, 0, 0, 0);
    color: var(--map-ink);
}

.mk-selite-rivi:active {
    background-color: rgba(70, 51, 31, 0.07);
}

.mk-selite-rivi.mk-tyhja {
    opacity: 0.45;
}

.mk-selite-rivi.mk-valittu .mk-selite-rivi__nimi {
    -unity-font-style: bold;
}

.mk-selite-rivi__merkki {
    flex-direction: row;
    align-items: center;
    width: 64px;
    flex-shrink: 0;
}

.mk-selite-rivi__vektori {
    width: 22px;
    height: 22px;
}

.mk-selite-rivi__symboli {
    position: absolute;
    left: 0;
    top: 0;
    width: 22px;
    height: 22px;
}

.mk-selite-rivi__rengas {
    color: #4b3a1c;
}

.mk-selite-rivi__kuva {
    width: 17px;
    height: 17px;
    margin-right: 3px;
    -unity-background-scale-mode: scale-to-fit;
}

.mk-selite-rivi__nimi {
    flex-grow: 1;
    font-size: 13.8px;
}

.mk-selite-rivi__luku {
    font-size: 12px;
    -unity-text-align: middle-right;
    min-width: 24px;
}

.mk-peukalo {
    position: absolute;
    right: 0;
    top: 0;
    width: 36px;
    border-width: 1px;
    border-color: rgba(70, 51, 31, 0.3);
    border-radius: 7px;
    align-items: center;
    justify-content: center;
    transition-property: translate;
    transition-duration: 0.12s;
}

.mk-peukalo.mk-vetaa {
    transition-duration: 0s;
}

.mk-peukalo__linssi {
    width: 25px;
    height: 25px;
    border-radius: 12.5px;
    border-width: 1px;
    border-color: rgba(70, 51, 31, 0.45);
    background-color: rgba(255, 252, 240, 0.9);
    align-items: center;
    justify-content: center;
}

.mk-peukalo__luku {
    font-size: 14px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: var(--map-ink);
}

/* --- Karttaselitteen välilehdet (webin .karttaselite-valilehti) --------------------- */

.mk-selite__valilehdet {
    flex-direction: row;
    flex-grow: 1;
}

.mk-selite__valilehti {
    min-height: 28px;
    padding: 3px 7px;
    margin-right: 4px;
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0);
    border-radius: 5px;
    background-color: rgba(0, 0, 0, 0);
    color: rgba(70, 51, 31, 0.7);
}

.mk-selite__valilehti .mk-nappi__teksti {
    font-size: 11px;
    letter-spacing: 1.3px;
}

.mk-selite__valilehti.mk-valittu {
    border-color: rgba(70, 51, 31, 0.3);
    background-color: rgba(255, 252, 242, 0.85);
    color: rgba(70, 51, 31, 0.96);
}

.mk-selite__paneeli {
    flex-shrink: 1;
    min-height: 0;
}

.mk-selite.mk-selite--maakunnat {
    width: 268px;
}

/* --- Maakunnat-välilehti (webin .maakunnat-*) ---------------------------------------- */

.mk-maakunnat {
    flex-shrink: 1;
    min-height: 0;
}

.mk-maakunnat__lista {
    position: relative;
}

.mk-maakunnat__tila {
    padding: 10px 8px;
    font-size: 12px;
    color: rgba(70, 51, 31, 0.7);
}

.mk-maakunnat__maa {
    flex-direction: row;
    justify-content: flex-start;
    align-items: center;
    min-height: 32px;
    padding: 4px 6px;
    border-width: 0;
    border-radius: 6px;
    background-color: rgba(0, 0, 0, 0);
    color: rgba(70, 51, 31, 0.92);
}

.mk-maakunnat__maa:active {
    background-color: rgba(70, 51, 31, 0.07);
}

.mk-maakunnat__nuoli {
    width: 14px;
    margin-right: 5px;
    font-size: 11px;
    -unity-text-align: middle-center;
    transition-property: rotate;
    transition-duration: 0.16s;
}

.mk-maakunnat__maa.mk-auki .mk-maakunnat__nuoli {
    rotate: 90deg;
}

.mk-maakunnat__maanimi {
    font-size: 11.5px;
    letter-spacing: 1.3px;
}

.mk-maakunnat__rivi {
    justify-content: flex-start;
    min-height: 34px;
    padding: 4px 42px 4px 24px;
    border-width: 0;
    border-radius: 6px;
    background-color: rgba(0, 0, 0, 0);
    color: rgba(70, 51, 31, 0.92);
}

.mk-maakunnat__rivi:active {
    background-color: rgba(70, 51, 31, 0.07);
}

.mk-maakunnat__rivi.mk-valittu {
    background-color: rgba(70, 51, 31, 0.1);
}

.mk-maakunnat__nimi {
    font-size: 13.8px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.mk-maakunnat__rivi.mk-valittu .mk-maakunnat__nimi {
    -unity-font-style: bold;
}

/* Tyhjä peukalo: sama pilleri kuin Nostot-välilehdellä, luvun paikka tyhjänä. */
.mk-peukalo--tyhja {
    border-color: rgba(70, 51, 31, 0.24);
}

.mk-maakunnat__luonnehdinta {
    flex-shrink: 0;
    margin: 4px 2px 0 2px;
    padding: 8px 8px 4px 8px;
    border-top-width: 1px;
    border-color: rgba(70, 51, 31, 0.18);
}

.mk-maakunnat__lnimi {
    font-size: 11px;
    letter-spacing: 1.3px;
    color: rgba(70, 51, 31, 0.75);
    margin-bottom: 4px;
}

.mk-maakunnat__lrivi {
    flex-direction: row;
    align-items: flex-start;
}

.mk-maakunnat__lteksti {
    flex-shrink: 1;
    flex-grow: 1;
    font-size: 13px;
    white-space: normal;
    color: rgba(70, 51, 31, 0.92);
}

.mk-maakunnat__lisaa {
    width: 30px;
    height: 30px;
    min-height: 30px;
    margin-left: 8px;
    padding: 0;
    flex-shrink: 0;
    border-width: 1px;
    border-color: rgba(122, 85, 20, 0.32);
    border-radius: 15px;
    background-color: rgba(255, 252, 242, 0.7);
    color: rgba(70, 51, 31, 0.85);
    align-items: center;
    justify-content: center;
}

.mk-maakunnat__lisaa:active {
    background-color: rgb(255, 252, 242);
}

.mk-maakunnat__lisaa > .mk-ikoni {
    width: 18px;
    height: 18px;
    --mk-ikoni-viiva: 1.8;
}

/* --- Maakunnan kortti (webin .maakunta-kortti) --------------------------------------- */

.mk-maakuntaKortti__kerros {
    background-color: rgba(18, 12, 4, 0.3);
}

.mk-maakuntaKortti {
    width: 100%;
    max-width: 480px;
    max-height: 86%;
    padding: 10px 12px 14px 12px;
    border-width: 1px;
    border-color: rgba(122, 85, 20, 0.32);
    border-radius: 12px;
    background-color: #f5f0e2;
    color: #211d18;
}

.mk-maakuntaKortti__sulje {
    position: absolute;
    top: 6px;
    right: 6px;
}

.mk-maakuntaKortti__sisalto {
    flex-shrink: 1;
}

.mk-maakuntaKortti__otsikko {
    font-size: 20px;
    margin: 4px 40px 10px 2px;
    white-space: normal;
    color: #211d18;
}

.mk-maakuntaKortti__kuvat {
    flex-direction: row;
    margin-bottom: 10px;
}

.mk-maakuntaKortti__kuva {
    flex-grow: 1;
    flex-basis: 0;
    margin-right: 6px;
}

.mk-maakuntaKortti__kuva--karuselli {
    flex-grow: 0;
    flex-basis: auto;
    width: 220px;
}

.mk-maakuntaKortti__kuvapinta {
    height: 150px;
    border-radius: 6px;
    background-color: rgba(70, 51, 31, 0.1);
    -unity-background-scale-mode: scale-and-crop;
}

.mk-maakuntaKortti__lahde {
    margin-top: 3px;
    font-size: 9.5px;
    white-space: normal;
    color: rgba(70, 51, 31, 0.7);
}

.mk-maakuntaKortti__teksti {
    font-size: 15px;
    white-space: normal;
    margin-bottom: 10px;
}

.mk-maakuntaKortti__kysymys {
    flex-direction: row;
    justify-content: flex-start;
    align-items: center;
    min-height: 36px;
    margin-top: 4px;
    padding: 6px 8px;
    border-width: 1px;
    border-color: rgba(122, 85, 20, 0.28);
    border-radius: 8px;
    background-color: rgba(255, 252, 242, 0.7);
    color: rgba(70, 51, 31, 0.95);
}

.mk-maakuntaKortti__kysymys.mk-auki {
    background-color: rgba(255, 252, 242, 1);
    border-color: rgba(122, 85, 20, 0.5);
}

.mk-maakuntaKortti__kysymys > .mk-ikoni {
    width: 20px;
    height: 20px;
    margin-right: 8px;
    flex-shrink: 0;
}

.mk-maakuntaKortti__kysymysteksti {
    flex-shrink: 1;
    font-size: 14px;
    white-space: normal;
}

.mk-maakuntaKortti__vastaus {
    margin: 6px 4px 4px 32px;
    font-size: 14px;
    white-space: normal;
    color: #211d18;
}

/* --- Offline-latauksen tila (OfflineTilaUi): pieni pilleri yläpalkin alla vasemmalla --- */

.mk-offlineTila {
    position: absolute;
    left: 12px;
    min-height: 30px;
    max-width: 70%;
    padding: 5px 12px 7px 12px;
    border-width: 1px;
    border-color: rgba(217, 161, 59, 0.55);
    border-radius: 15px;
    background-color: rgba(37, 27, 18, 0.9);
    color: var(--ink-light);
    overflow: hidden;
}

/* Yksi teksti kerrallaan matkakirjan lapun kanssa: ristihäivytys (OfflineTilaUi.Vuorottele). */
.mk-offlineTila {
    transition-property: opacity;
    transition-duration: 0.4s;
}

.mk-offlineTila--vaistyy {
    opacity: 0;
}

.mk-offlineTila:active {
    background-color: rgba(58, 42, 28, 0.95);
}

.mk-offlineTila.mk-verkoton {
    border-color: rgba(243, 230, 208, 0.35);
}

.mk-offlineTila__teksti {
    font-size: 12px;
    letter-spacing: 0.3px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.mk-offlineTila__palkki {
    position: absolute;
    left: 12px;
    right: 12px;
    bottom: 3px;
    height: 2px;
    border-radius: 1px;
    background-color: rgba(243, 230, 208, 0.18);
}

.mk-offlineTila__taytto {
    height: 100%;
    border-radius: 1px;
    background-color: var(--accent);
}

.mk-maakunnat__nuoli.mk-ikoni {
    width: 13px;
    height: 13px;
    margin-right: 6px;
    --mk-ikoni-viiva: 2.2;
}

/* --- Nostokortti (webin .fokusnosto-kortti, .fokuskohde-popup, skandaalin lisälehti) --- */

.mk-nosto__kerros {
    background-color: rgba(18, 12, 4, 0.3);
}

.mk-nosto {
    width: 100%;
    max-width: 544px;
    max-height: 88%;
    padding: 11px 13px 12px 13px;
    border-width: 1px;
    border-color: rgba(122, 85, 20, 0.32);
    border-radius: 12px;
    background-color: #f5f0e2;
    color: #211d18;
}

.mk-nosto--kohde {
    max-width: 384px;
}

.mk-nosto--looppi {
    max-width: 640px;
    background-color: #f6ecc6;
    border-color: rgba(122, 85, 20, 0.45);
}

.mk-nosto--esittely {
    max-width: 760px;
    padding: 8px;
}

.mk-nosto__sisus {
    flex-shrink: 1;
}

/* Kaiutin sulkuruksin vasemmalla puolella (web: otsikkorivin oikea reuna). */
.mk-nosto__lukija {
    position: absolute;
    top: 4px;
    right: 40px;
}

.mk-nosto__sulje {
    position: absolute;
    top: 4px;
    right: 4px;
    width: 34px;
    height: 34px;
    min-height: 34px;
    padding: 0;
    border-width: 0;
    border-radius: 6px;
    background-color: rgba(0, 0, 0, 0);
    color: #46331f;
}

.mk-nosto__sulje .mk-nappi__teksti {
    font-size: 20px;
    -unity-text-align: middle-center;
}

.mk-nosto__ylarivi {
    font-size: 11px;
    letter-spacing: 1.5px;
    color: #7a5514;
    margin: 2px 40px 6px 0;
}

.mk-nosto__nimio {
    font-size: 9.5px;
    letter-spacing: 3.3px;
    color: rgba(70, 51, 31, 0.7);
    -unity-text-align: middle-center;
}

.mk-nosto__paivays {
    margin: 4px 0 8px 0;
    padding: 4px 0;
    border-top-width: 3px;
    border-bottom-width: 1px;
    border-top-color: rgba(70, 51, 31, 0.75);
    border-bottom-color: rgba(70, 51, 31, 0.5);
}

.mk-nosto__paivaysteksti {
    font-size: 11px;
    letter-spacing: 1.8px;
    -unity-text-align: middle-center;
    white-space: normal;
    color: #46331f;
}

.mk-nosto__otsikko {
    font-size: 20px;
    white-space: normal;
    margin: 0 30px 6px 0;
    color: #16130f;
}

.mk-nosto--looppi .mk-nosto__otsikko {
    font-size: 26px;
    margin-right: 0;
}

.mk-nosto--kohde .mk-nosto__otsikko {
    font-size: 16.5px;
}

.mk-nosto__meta {
    font-size: 12px;
    color: rgba(33, 29, 24, 0.58);
    margin-bottom: 8px;
    white-space: normal;
}

.mk-nosto__ingressi {
    font-size: 16px;
    white-space: normal;
    margin-bottom: 8px;
    color: #2a231b;
}

.mk-nosto__teksti {
    font-size: 15.5px;
    white-space: normal;
    margin-bottom: 9px;
}

.mk-nosto__kuvasarja {
    margin: 4px 0 10px 0;
}

.mk-nosto__kuvakehys {
    border-radius: 6px;
    overflow: hidden;
    background-color: rgba(70, 51, 31, 0.1);
}

.mk-nosto__kuva {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.mk-nosto__kuvateksti {
    margin-top: 5px;
    font-size: 12.5px;
    white-space: normal;
    color: rgba(33, 29, 24, 0.78);
}

.mk-nosto__esittelyrivi {
    flex-direction: row;
    align-items: center;
    margin-top: 6px;
}

.mk-nosto__esittelyrivi .mk-nosto__kuvateksti {
    flex-grow: 1;
    flex-shrink: 1;
    margin: 0 10px 0 2px;
}

.mk-nosto__lisaa {
    min-height: 36px;
    padding: 6px 14px;
    border-width: 1px;
    border-color: rgba(122, 85, 20, 0.6);
    border-radius: 4px;
    background-color: rgba(214, 168, 62, 0.2);
    color: #6d4d12;
}

.mk-nosto__lisaa .mk-nappi__teksti {
    font-size: 13px;
    letter-spacing: 1.5px;
}

.mk-nosto__selaa {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 24%;
    border-width: 0;
    border-radius: 0;
    background-color: rgba(0, 0, 0, 0);
    color: rgba(255, 255, 255, 0.92);
}

.mk-nosto__selaa--vasen {
    left: 0;
    justify-content: flex-start;
    padding-left: 10px;
}

.mk-nosto__selaa--oikea {
    right: 0;
    justify-content: flex-end;
    padding-right: 10px;
}

.mk-nosto__selaa .mk-nappi__teksti {
    font-size: 34px;
    color: rgba(255, 255, 255, 0.92);
}

.mk-nosto__laskuri {
    position: absolute;
    right: 8px;
    bottom: 8px;
    padding: 2px 8px;
    border-radius: 10px;
    background-color: rgba(20, 14, 8, 0.6);
    color: #f3e6d0;
    font-size: 11px;
}

.mk-nosto__visa {
    margin: 8px 0 6px 0;
    padding: 10px 12px;
    border-width: 1px;
    border-color: rgba(122, 85, 20, 0.45);
    border-radius: 10px;
    background-color: rgba(255, 255, 255, 0.42);
}

.mk-nosto__visaotsikko {
    font-size: 11px;
    letter-spacing: 1.5px;
    color: #7a5514;
    margin-bottom: 4px;
}

.mk-nosto__visakysymys {
    font-size: 16px;
    white-space: normal;
    margin-bottom: 4px;
}

.mk-nosto__visavihje {
    font-size: 12.5px;
    -unity-font-style: italic;
    color: rgba(33, 29, 24, 0.65);
    white-space: normal;
    margin-bottom: 6px;
}

.mk-nosto__visanappi {
    justify-content: flex-start;
    min-height: 42px;
    margin-top: 5px;
    padding: 6px 10px;
    border-width: 1px;
    border-color: rgba(122, 85, 20, 0.35);
    border-radius: 8px;
    background-color: rgba(255, 255, 255, 0.62);
    color: #211d18;
}

.mk-nosto__visanappi .mk-nappi__teksti {
    white-space: normal;
    font-size: 14.5px;
}

.mk-nosto__visanappi.mk-oikein {
    border-color: #2f6b3a;
    background-color: rgba(47, 107, 58, 0.16);
}

.mk-nosto__visanappi.mk-vaarin {
    border-color: #9a2b21;
    background-color: rgba(154, 43, 33, 0.12);
}

.mk-nosto__visatulos {
    margin-top: 8px;
    font-size: 14.5px;
    white-space: normal;
    color: #9a2b21;
}

.mk-nosto__visatulos.mk-oikein {
    color: #2f6b3a;
}

.mk-nosto__palkkio {
    margin-top: 6px;
    padding-top: 8px;
    border-top-width: 1px;
    border-top-color: rgba(122, 85, 20, 0.28);
    font-size: 13.5px;
    color: #7a5514;
    white-space: normal;
}

.mk-nosto__kysyotsikko {
    margin: 10px 0 6px 0;
    font-size: 13px;
    color: #46331f;
}

.mk-nosto__kysymys {
    justify-content: flex-start;
    min-height: 38px;
    margin-bottom: 6px;
    padding: 6px 10px;
    border-width: 1px;
    border-color: rgba(122, 85, 20, 0.5);
    border-radius: 8px;
    background-color: rgba(236, 226, 200, 0.6);
    color: #46331f;
}

.mk-nosto__kysymys .mk-nappi__teksti,
.mk-nosto__kierros .mk-nappi__teksti {
    white-space: normal;
    font-size: 13.5px;
}

.mk-nosto__kierros {
    min-height: 44px;
    margin-top: 6px;
    border-width: 1px;
    border-color: rgba(122, 85, 20, 0.6);
    border-radius: 4px;
    background-color: rgba(214, 168, 62, 0.18);
    color: #6d4d12;
    justify-content: center;
}

.mk-nosto__suurennos {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    padding: 16px;
    background-color: rgba(18, 12, 4, 0.55);
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.22s;
}

.mk-nosto__suurennos.mk-auki {
    opacity: 1;
}

.mk-nosto__suurennoskehys {
    width: 100%;
    max-width: 640px;
    padding: 9px;
    border-width: 1px;
    border-color: rgba(58, 38, 16, 0.35);
    border-radius: 2px;
    background-color: #f8f3e6;
}

.mk-nosto__suurennoskuva {
    height: 420px;
    max-height: 60%;
    -unity-background-scale-mode: scale-to-fit;
}

.mk-nosto__suurennosteksti {
    margin-top: 8px;
    font-size: 14.5px;
    white-space: normal;
    color: #3a2610;
}

.mk-nosto__lahde {
    margin-top: 4px;
    font-size: 11.5px;
    white-space: normal;
    color: rgba(58, 38, 16, 0.7);
}

/* Täkynosto ja syvennys (web css/fokusnosto.css, fokusvirta.css) ja kohdekortin ihme ja
 * leikekirja (css/fokuskohteet.css). */

.mk-nosto__media {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    margin: 0 0 8px 0;
}

.mk-nosto__medianappi {
    min-height: 32px;
    margin: 0 5px 5px 0;
    padding: 4px 10px;
    border-width: 1px;
    border-color: rgba(122, 85, 20, 0.5);
    border-radius: 14px;
    background-color: rgba(255, 255, 255, 0.5);
    color: #6d4d12;
}

.mk-nosto__medianappi .mk-nappi__teksti {
    font-size: 12.5px;
}

.mk-nosto__valokuva {
    width: 62%;
    margin: 4px 0 10px 0;
}

.mk-nosto__liite {
    margin: 10px 0 4px 0;
    padding: 6px 7px 7px 7px;
    border-width: 1px;
    border-color: rgba(122, 85, 20, 0.34);
    border-radius: 3px;
    background-color: #efe7d3;
}

.mk-nosto__liiteotsake {
    margin-bottom: 6px;
    padding-bottom: 3px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(122, 85, 20, 0.26);
    color: rgba(94, 66, 16, 0.85);
    font-size: 10.5px;
    letter-spacing: 1.3px;
}

.mk-nosto__liitenappi {
    height: 210px;
    padding: 0;
    border-width: 1px;
    border-color: rgba(122, 85, 20, 0.3);
    border-radius: 0;
    background-color: #f7f2e4;
}

.mk-nosto__liitekuva {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.mk-nosto__liitetaite {
    position: absolute;
    background-color: rgba(122, 85, 20, 0.16);
}

.mk-nosto__liitetaite--pysty {
    top: 0;
    bottom: 0;
    left: 50%;
    width: 1px;
}

.mk-nosto__liitetaite--vaaka {
    left: 0;
    right: 0;
    top: 50%;
    height: 1px;
}

.mk-nosto__kohdenappi {
    justify-content: flex-start;
    min-height: 44px;
    margin-top: 10px;
    padding: 6px 3px;
    border-width: 0;
    border-top-width: 1px;
    border-top-color: rgba(122, 85, 20, 0.28);
    border-radius: 0;
    background-color: rgba(0, 0, 0, 0);
    color: #7a5514;
}

.mk-nosto__kohdenappi .mk-nappi__teksti {
    font-size: 15px;
    white-space: normal;
    color: #7a5514;
}

.mk-nosto__lunastus {
    min-height: 44px;
    margin-top: 8px;
    border-width: 1px;
    border-color: rgba(122, 85, 20, 0.4);
    border-radius: 8px;
    background-color: rgba(255, 255, 255, 0.62);
    color: #211d18;
}

.mk-nosto__lunastus .mk-nappi__teksti {
    font-size: 15px;
}

.mk-nosto__ihmenappi {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    margin: 0 0 11px 0;
    padding: 6px 12px;
    border-width: 1px;
    border-color: rgba(122, 85, 20, 0.6);
    border-radius: 4px;
    background-color: rgba(214, 168, 62, 0.2);
    color: #6d4d12;
}

.mk-nosto__ihmenappi .mk-nappi__teksti {
    font-size: 13.5px;
    letter-spacing: 1.4px;
}

.mk-nosto__ihmetahti {
    width: 24px;
    height: 24px;
    margin-right: 7px;
    color: #b8862b;
}

.mk-nosto__leikekirja {
    flex-direction: column;
    align-items: flex-start;
    min-height: 44px;
    margin: 10px 0 3px 0;
    padding: 7px 11px;
    border-width: 1px;
    border-color: rgba(122, 85, 20, 0.6);
    border-radius: 4px;
    background-color: rgba(214, 168, 62, 0.18);
    color: #211d18;
}

.mk-nosto__leikekirjaotsake {
    margin-bottom: 2px;
    font-size: 11px;
    letter-spacing: 1.5px;
    color: #6d4d12;
}

.mk-nosto__leikekirjaotsikko {
    font-size: 14.5px;
    white-space: normal;
    color: #211d18;
}

/* Matkakirjan ihmeen kulmanauha (PUNA, sinettivaha): vino kaista kuvan vasemmassa yläkulmassa.
 * Säiliö leikkaa kaistan; Nostokortti.SovitaNauha siirtää säiliön kuvan todelliseen kulmaan. */
.mk-ihmenauha {
    position: absolute;
    left: 0;
    top: 0;
    width: 124px;
    height: 124px;
    overflow: hidden;
}

.mk-ihmenauha__kaista {
    position: absolute;
    left: -45px;
    top: 36px;
    width: 180px;
    height: 20px;
    rotate: -45deg;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-color: rgba(30, 9, 8, 0.55);
    background-color: #8b3d38;
    color: #f6e7c6;
    font-size: 9.5px;
    letter-spacing: 1.2px;
    -unity-text-align: middle-center;
    white-space: nowrap;
}

/* --- noppa (UI/Noppa.cs; webin .die-layer, css/styles.css ~2103) ---------------- */
/* Kerros koko isän alueella, ei poimi kosketuksia. Kuutio, varjo ja silmät piirretään
 * koodissa (generateVisualContent), joten USS:ssä on vain asettelu ja häivytys. */

.mk-noppa,
.mk-noppa__pinta,
.mk-noppa__viivat {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

/* Uuteen kaupunkiin saavuttaessa noppa katoaa 0,42 s:ssa (die.js haivyta). Siirtymä on
 * vain tässä luokassa, jotta uusi heitto palauttaa nopan näkyviin heti. */
.mk-noppa--haipyy {
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.42s;
    transition-timing-function: ease;
}

/* --- tapahtumakupla (Leima.cs; web .event-toast.stamp) ------------------------------------ */

.mk-leimat {
    position: absolute;
    top: 16%;
    left: 0;
    right: 0;
    align-items: center;
}

.mk-leima {
    position: absolute;
    flex-direction: row;
    align-items: center;
    max-width: 80%;
    padding: 11px 18px;
    border-width: 1px;
    border-color: rgba(120, 168, 108, 0.55);
    border-radius: 14px;
    background-color: rgba(46, 33, 20, 0.88);
    color: var(--ink-light);
    opacity: 0;
    translate: 0 18px;
    scale: 0.92 0.92;
    transition-property: opacity, translate, scale;
    transition-duration: 0.28s;
    transition-timing-function: ease-out-back;
}

.mk-leima.mk-auki {
    opacity: 1;
    translate: 0 0;
    scale: 1 1;
}

.mk-leima--lahtee {
    opacity: 0;
    translate: 0 -14px;
    scale: 0.97 0.97;
    transition-duration: 0.3s;
    transition-timing-function: ease-in;
}

.mk-leima__ikoni {
    width: 26px;
    height: 26px;
    margin-right: 11px;
    color: var(--accent);
}

.mk-leima__tekstit {
    flex-shrink: 1;
}

.mk-leima__teksti {
    font-size: 16.8px;
    white-space: normal;
    color: var(--ink-light);
}

.mk-leima__ala {
    font-size: 13.6px;
    white-space: normal;
    color: var(--muted);
}

/* Kartuschan radio (web .maapaneeli-radio): merkkivalo ja pieni "radio" maston oikeassa laidassa,
 * vain avattuna ja vain maille, joilla on asema. Valo palaa soidessa ja vilkkuu kanavan haun ajan. */
.mk-kartuscha__radio {
    display: none;
    position: absolute;
    top: 0;
    right: 11px;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 0;
    padding: 2px 3px;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
}

.mk-kartuscha.mk-auki .mk-kartuscha__radio--asema {
    display: flex;
}

.mk-kartuscha__radiovalo {
    width: 11px;
    height: 11px;
    margin-bottom: 3px;
    border-width: 1px;
    border-color: rgba(74, 52, 33, 0.45);
    border-radius: 6px;
    background-color: rgba(120, 96, 78, 0.28);
}

.mk-lehti__kuuntele--soi .mk-kartuscha__radiovalo,
.mk-kartuscha__radio.mk-etsii.mk-vilkku .mk-kartuscha__radiovalo {
    border-color: rgba(150, 30, 22, 0.85);
    background-color: #d8342a;
}

.mk-kartuscha__radio.mk-etsii .mk-kartuscha__radiovalo {
    border-color: rgba(150, 30, 22, 0.85);
    background-color: rgba(120, 96, 78, 0.28);
}

.mk-kartuscha__radionimi {
    font-size: 9px;
    letter-spacing: 1px;
    color: rgba(74, 52, 33, 0.75);
    opacity: 0.72;
}
