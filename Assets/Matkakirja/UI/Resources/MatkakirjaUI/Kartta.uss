/* KARTAN KALUSTEET (Natiivi-UI, erä 4): kartuscha (webin maapaneeli, css/styles.css
 * ~27191–27870) ja karttaselite (~25710–26170). Pergamentin muste rgba(58,40,25,.92),
 * toissijainen rgba(74,52,33,…); kartalla kelluva teksti saa pergamenttihalon. */

/* --- kartuscha ---------------------------------------------------------- */

.mk-kartuscha {
    position: absolute;
    flex-direction: column;
    align-items: flex-start;
    max-width: 92%;
    /* Web .maapaneeli-kortti kiinni: täyte 0 (mitattu 24.9. b12 Pariisi: kortti x 20,2, oikea reuna 157,3, lapset
       saman levyisiä). 8 pt:n täyte vei oikean reunan Liikun nousurajan 162,5 yli, ja Liiku nousi kortin päälle. */
    padding: 0;
    border-width: 0;
    border-radius: var(--tk-kulma-hius);
    color: var(--map-ink-92);
}

/* Avattu (web .maapaneeli-kortti.valikko-auki): pergamentti, reuna ja varjo; puhelimessa vasen+oikea koodista,
 * tabletilla 40 % leveys. */
.mk-kartuscha.mk-auki {
    max-width: none;
    padding: 11.2px 13.6px 12px 13.6px;
    background-color: rgba(247, 239, 219, 0.94);
    border-width: 1px;
    border-color: var(--map-ink-55);
}

.mk-kartuscha--tabletti.mk-auki {
    width: 40%;
}

.mk-kartuscha__kehys {
    display: none;
    position: absolute;
    top: 4px;
    left: 4px;
    right: 4px;
    bottom: 4px;
    border-width: 1px;
    border-color: var(--map-ink-22);
}

.mk-kartuscha.mk-auki .mk-kartuscha__kehys {
    display: flex;
}

.mk-kartuscha__sisus {
    flex-direction: column;
    align-self: stretch;
    margin-top: 7.2px;
}

.mk-kartuscha__masto {
    flex-direction: column;
    align-items: flex-start;
    justify-content: flex-start;
    min-height: 0;
    padding: 0;
    border-width: 0;
    background-color: var(--lapinakyva);
    color: var(--map-ink-92);
}

.mk-kartuscha.mk-auki .mk-kartuscha__masto {
    align-self: stretch;
}

.mk-kartuscha__masto:active {
    background-color: var(--lapinakyva);
    opacity: 0.8;
}

.mk-kartuscha__nimirivi {
    flex-direction: row;
    /* Löydös 143: lippu ylimmän nimirivin tasalla (margin-top Kartuscha.TasaaNimirivi), ei kaksirivisen lohkon keskellä. */
    align-items: flex-start;
    flex-shrink: 1;
    max-width: 100%;
}

/* Web .maapaneeli-nimi-suomi: American Typewriter, puhelimessa 1,3rem / 0,16em, tabletilla 1,9rem / 0,2em. */
.mk-kartuscha__nimi {
    /* Löydös 143: pitkä nimi rivittyy sanavälistä kahdelle riville (ei katkaisua eikä ellipsiä). */
    flex-shrink: 1;
    white-space: normal;
    font-size: 20.8px;
    letter-spacing: 16.01px; /* web 3.33px */
    color: var(--map-ink-92);
    text-shadow: 0 0 4px rgb(244, 232, 205);
}

/* Löydös 141 (omistaja, build 16): pienennetty (kiinni oleva) kartussi oli iPadilla hieman liian iso, iPhonella
   koko hyvä. Kiinni-tilan tekstit × 0,88 (30,4 → 26,8 ja 16 → 14,1): noin kahdeksasosa pienempi on selvä mutta
   maltillinen ero (iPadin ruutu on 1,3–1,5 × iPhonen leveys), ja nimi pysyy iPhonen 20,8:aa selvästi isompana.
   Harvennus on em/100, joten se skaalautuu mukana. Avattu kortti pitää webin koon (ks. .mk-auki alla). */
.mk-kartuscha--tabletti .mk-kartuscha__nimi {
    font-size: 26.8px;
    letter-spacing: 20px; /* web 6.08px */
}

.mk-kartuscha--tabletti.mk-auki .mk-kartuscha__nimi {
    font-size: 30.4px;
}

.mk-kartuscha.mk-auki .mk-kartuscha__nimi,
.mk-kartuscha.mk-auki .mk-kartuscha__alarivi {
    text-shadow: 0 0 0 rgba(0, 0, 0, 0);
}

/* Lippu nimen perässä vain avattuna (web .maapaneeli-lippukuva: 1cap korkea, 0,34 em väli). */
.mk-kartuscha__lippu {
    display: none;
    height: 14px;
    width: 20px;
    margin-left: 4px;
    border-width: 1px;
    border-color: var(--map-ink-45);
    -unity-background-scale-mode: stretch-to-fill;
}

.mk-kartuscha--tabletti .mk-kartuscha__lippu {
    height: 20px;
    width: 30px;
    margin-left: 6px;
}

.mk-kartuscha.mk-auki .mk-kartuscha__lippu {
    display: flex;
}

.mk-kartuscha__viiva {
    height: 1px;
    align-self: stretch;
    margin: 3.5px 0 3.2px 0;
    background-color: var(--map-ink-55);
}

.mk-kartuscha__alarivi {
    font-size: 12.2px;
    letter-spacing: 7.38px; /* web 0.9px */
    color: var(--map-ink-90);
    white-space: normal;
    text-shadow: 0 0 3px rgb(244, 232, 205);
}

.mk-kartuscha--tabletti .mk-kartuscha__alarivi {
    font-size: 14.1px; /* löydös 141: 16 × 0,88 (alarivi näkyy vain kiinni) */
    letter-spacing: 8.12px; /* web 1.3px */
}

.mk-kartuscha.mk-auki .mk-kartuscha__alarivi {
    display: none;
}

/* Rivit (web .maapaneeli-rivit, avattuna otsikko 0,62rem ja arvo 0,7rem; sarakeväli 0,5rem). */
.mk-kartuscha__tilastot {
    flex-direction: column;
    margin-bottom: 4.8px;
}

.mk-kartuscha__vuosi,
.mk-kartuscha__rivi {
    flex-direction: row;
    align-items: center;
    min-height: 14.3px;
}

.mk-kartuscha__nimike {
    width: 78px;
    margin-right: 8px;
    flex-shrink: 0;
    font-size: 9.92px;
    letter-spacing: 8.97px; /* web 0.89px */
    color: var(--map-ink-70);
}

.mk-kartuscha__arvo {
    flex-shrink: 1;
    font-size: 11.2px;
    white-space: nowrap;
    color: var(--map-ink-92);
}

.mk-kartuscha__sija {
    display: none;
    margin-left: 4px;
    font-size: 10.56px;
    color: var(--map-ink-70);
}

.mk-kartuscha__tilastot.mk-sijat-auki .mk-kartuscha__sija {
    display: flex;
}

/* Löydös 142 (omistaja, build 16): vertailupalkki rivin oikeassa reunassa. Kiinteä raita (pisteviiva, sama muste kuin
   aiheiden alleviivauksissa), jonka päällä täyte = osuus ykkössijasta; palkit ovat samassa sarakkeessa radion kanssa.
   Kasvuanimaatio Kartuscha.AnimoiVertailut (scale-x, transform-origin vasen). */
.mk-kartuscha__vertailu {
    flex-shrink: 0;
    width: 56px;
    height: 3px;
    margin-left: auto;
}

.mk-kartuscha--tabletti .mk-kartuscha__vertailu {
    width: 72px;
}

.mk-kartuscha__vertailuraita {
    position: absolute;
    left: 0;
    right: 0;
    top: 1px;
    height: 1px;
    color: var(--map-ink-45);
}

.mk-kartuscha__vertailupalkki {
    position: absolute;
    left: 0;
    top: 0;
    height: 3px;
    background-color: var(--map-ink-62);
}

.mk-kartuscha__nyt {
    display: none;
}

.mk-kartuscha__kielet {
    flex-direction: row;
    align-items: flex-start;
    margin-top: 1.3px;
}

.mk-kartuscha__kielet > .mk-kartuscha__nimike {
    margin-top: 2px;
}

.mk-kartuscha__tervehdykset {
    flex-direction: column;
    flex-shrink: 1;
}

.mk-tervehdys {
    flex-direction: row;
    align-items: center;
    flex-wrap: wrap;
    min-height: 17px;
}

.mk-tervehdys__teksti {
    font-size: 12.32px;
    margin-right: 4px;
    color: var(--map-ink-92);
}

.mk-tervehdys__lippu {
    height: 10px;
    width: 14px;
    margin-right: 4px;
    border-width: 1px;
    border-color: var(--map-ink-45);
    -unity-background-scale-mode: stretch-to-fill;
}

.mk-tervehdys__kieli {
    font-size: 8.74px;
    letter-spacing: 1.95px; /* web 0.17px */
    color: var(--map-ink-62);
}

.mk-tervehdys__tarkenne {
    margin-left: 3px;
    font-size: 8.74px;
    color: var(--map-ink-60);
}

/* Aiheet (web .maapaneeli-otsikkorivi: flex-wrap, väli 0,3rem × 0,85rem; aihe 12 px, 0,12 em, pisteviiva). */
.mk-kartuscha__aiheet {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 5.6px;
}

.mk-kartuscha__aihe {
    flex-direction: column;
    align-items: flex-start;
    min-height: 16px;
    padding: 0;
    margin: 0 13.6px 4.8px 0;
    border-width: 0;
    border-radius: 0;
    background-color: var(--lapinakyva);
    color: var(--map-ink-90);
}

.mk-kartuscha__aihe:active {
    background-color: var(--map-ink-08);
}

.mk-kartuscha__aihe .mk-nappi__teksti {
    font-size: var(--tk-koko-kapiteeli);
    letter-spacing: 12px; /* web 1.44px */
}

.mk-kartuscha__aiheviiva {
    align-self: stretch;
    height: 1px;
    margin-top: 0;
    color: var(--map-ink-75);
}

/* --- Elävä kartta: kartussin muste (Kartuscha.Muste.cs) ------------------ */

/* Tutkimuspalkki (maakunnat, nostot) ja heränneet maakunnat avatun kortin ylimpänä, ohut viiva alla. */
.mk-kartuscha__muste {
    flex-direction: column;
    margin-bottom: 5.6px;
    padding-bottom: 4.8px;
    border-bottom-width: 1px;
    border-color: var(--map-ink-22);
}

.mk-kartuscha__maakunnat {
    flex-direction: column;
    margin-top: 3px;
}

.mk-kartuscha__mk {
    flex-direction: row;
    align-items: center;
    min-height: 27px;
}

/* Maakunnan pikkukuva leimana (löydös 115): kierto −2° levossa, herätyksessä 1,3 → 1 ja −6° → −2° (koodi). */
.mk-kartuscha__mkkuva {
    flex-shrink: 0;
    width: 22px;
    height: 22px;
    margin-right: 8px;
    border-width: 1px;
    border-color: var(--map-ink-60);
    background-color: var(--paper);
    -unity-background-scale-mode: scale-and-crop;
    rotate: -2deg;
}

/* Käsialanimi (Kirjasin.Kauno = Snell Roundhand, web --font-kauno). */
.mk-kartuscha__mknimi {
    flex-shrink: 1;
    overflow: hidden;
    white-space: nowrap;
    font-size: 17px;
    color: var(--overlay-card);
}

.mk-kartuscha__pisteet {
    flex-direction: row;
    flex-shrink: 0;
    align-items: center;
    margin-left: auto;
    padding-left: 8px;
}

/* Mustepisteet löydetyt/kaikki: täysi = mustetäplä, tyhjä = rengas. */
.mk-kartuscha__piste {
    width: 5px;
    height: 5px;
    margin-left: 2.5px;
    border-width: 1px;
    border-radius: 2.5px;
    border-color: var(--map-ink-70);
}

.mk-kartuscha__piste--taysi {
    background-color: var(--overlay-card);
}

.mk-kartuscha__pisteluku {
    font-size: 10.56px;
    color: var(--map-ink-85);
}

/* Käsialanimet kartalla (MaakuntanimetKartalla): nimi keskitetty maakunnan pisteeseen, kallistettu kuin kynällä
   kirjoitettu (video 10,4 s "Attika"); muste ja paperihehku kuten maiden nimillä (MaidenNimetKerros). */
.mk-maakuntanimet {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.mk-maakuntanimi {
    position: absolute;
    left: 0;
    top: 0;
}

.mk-maakuntanimi__teksti {
    position: absolute;
    translate: -50% -50%;
    rotate: -8deg;
    white-space: nowrap;
    -unity-text-align: middle-center;
    font-size: 24px;
    color: var(--overlay-card);
    text-shadow: 0 0 4px rgb(244, 232, 205);
}

/* --- karttaselite -------------------------------------------------------- */

.mk-seliteNappi {
    position: absolute;
    right: 10px;
    width: 40px;
    height: 40px;
    min-height: 40px;
    padding: 0;
    border-radius: var(--tk-kulma-kortti);
    border-color: var(--map-ink-35);
    background-color: var(--tk-kuulto-paper-90);
    color: var(--map-ink);
}

.mk-linssiNappi--vaistyy {
    opacity: 0;
}

.mk-seliteNappi:active {
    background-color: rgba(225, 204, 160, 0.95);
}

.mk-seliteNappi.mk-valittu {
    background-color: var(--map-ink);
    color: var(--tk-paperi-pinta);
}

.mk-seliteNappi > .mk-ikoni {
    width: 20px;
    height: 20px;
    margin-right: 0;
    --mk-ikoni-viiva: 1.6;
}

.mk-selite {
    position: absolute;
    right: 10px;
    width: 221px;
    max-width: 78%;
    max-height: 78%;
    padding: 5.6px;
    background-color: var(--tk-paperi-pinta);
    border-radius: var(--tk-kulma-keski);
    color: var(--map-ink);
    /* AVAUS JA SULKU ANIMOIDEN (omistaja 29.9.2026: "Voiko lapun aukeamisen ja sulkeutumisen animoida? Ja jatkossa myös
       kaikki vastaavat", Raamattu PR #3602): webin arvot (Siirtoseppä, mitattu WebKitissä): paikka sama, vain mittakaava
       0,92 ↔ 1 ja läpinäkyvyys; origo avanneen napin kulma (oikea yläkulma). Kiinni 200 ms cubic-bezier(0.4, 0, 1, 1)
       = UITK ease-in (0.42, 0, 1, 1); auki 220 ms (opacity 180 ms), webin cubic-bezier(0.22, 0.9, 0.24, 1) ja
       (0, 0, 0.2, 1) lähimpänä UITK:n valmiina kaarena ease-out-cubic (UITK ei tue omaa cubic-bezieriä). */
    opacity: 0;
    scale: 0.92 0.92;
    transform-origin: right top;
    transition-property: opacity, scale;
    transition-duration: 0.2s, 0.2s;
    transition-timing-function: ease-in, ease-in;
}

.mk-selite.mk-auki {
    opacity: 1;
    scale: 1 1;
    transition-duration: 0.18s, 0.22s;
    transition-timing-function: ease-out-cubic, ease-out-cubic;
}

.mk-karhea-kehys {
    position: absolute;
    top: 1px;
    left: 1px;
    right: 1px;
    bottom: 1px;
    border-color: var(--map-ink-78);
}

.mk-selite__ylarivi {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 2.4px 5.6px 6.4px 5.6px;
    margin-bottom: 3.2px;
    border-bottom-width: 1px;
    border-bottom-color: var(--map-ink-25);
}

.mk-selite__otsikko {
    font-size: 11px;
    letter-spacing: 18.18px; /* web 2px */
    color: var(--map-ink);
    padding-bottom: 2px;
    border-bottom-width: 1px;
    border-color: var(--map-ink-50);
}

.mk-selite__sulje {
    width: 32px;
    height: 28px;
    min-height: 28px;
    padding: 0;
    border-width: 0;
    background-color: var(--lapinakyva);
    color: var(--map-ink-70);
}

.mk-selite__sulje:active {
    background-color: var(--map-ink-10);
}

.mk-selite__sulje {
    align-items: center;
    justify-content: center;
}

.mk-selite__sulje .mk-nappi__teksti {
    font-size: 13.6px;
    -unity-text-align: middle-center;
}

/* E4 (web .karttaselite-sulje ✕ 0,85rem): risti ~9,5 px. */
.mk-selite__sulje .mk-ikoni {
    width: 20px;
    height: 20px;
    --mk-ikoni-viiva: 1.3;
}

.mk-selite__vieritys {
    flex-shrink: 1;
}

.mk-selite__lista {
    position: relative;
}

.mk-selite-rivi {
    justify-content: flex-start;
    align-items: center;
    min-height: 27px;
    padding: 4.8px 6.4px;
    margin-bottom: 1.6px;
    border-width: 0;
    border-radius: var(--tk-kulma-pieni);
    background-color: var(--lapinakyva);
    color: var(--map-ink-92);
}

.mk-selite-rivi:active {
    background-color: var(--map-ink-07);
}

.mk-selite-rivi.mk-tyhja {
    opacity: 0.45;
}

/* Web: valittu rivi kevyellä pohjalla, ei lihavointia. */
.mk-selite-rivi.mk-valittu {
    background-color: var(--map-ink-06);
}

.mk-selite-rivi__merkki {
    flex-direction: row;
    align-items: center;
    min-width: 22px;
    margin-right: 7px;
    flex-shrink: 0;
}

.mk-selite-rivi__vektori {
    width: 22px;
    height: 22px;
}

.mk-selite-rivi__symboli {
    position: absolute;
    left: 0;
    top: 0;
    width: 22px;
    height: 22px;
}

.mk-selite-rivi__rengas {
    color: var(--map-ink);
}

.mk-selite-rivi__kuva {
    width: 17px;
    height: 17px;
    margin-right: 3px;
    -unity-background-scale-mode: scale-to-fit;
}


.mk-selite-rivi__nimi {
    flex-grow: 1;
    font-size: 13.76px;
}

.mk-selite-rivi__luku {
    font-size: 11.84px;
    letter-spacing: 3.97px; /* web 0.47px */
    color: var(--map-ink-60);
    -unity-text-align: middle-right;
    min-width: 24px;
}

.mk-peukalo {
    position: absolute;
    right: 0;
    top: 0;
    width: 36px;
    border-width: 1px;
    border-color: var(--tk-paperi-reunus);
    border-radius: 7px;
    align-items: center;
    justify-content: center;
    transition-property: translate;
    transition-duration: 0.12s;
}

.mk-peukalo.mk-vetaa {
    transition-duration: 0s;
}

.mk-peukalo__linssi {
    width: 25px;
    height: 25px;
    border-radius: 12.5px;
    border-width: 1px;
    border-color: var(--map-ink-45);
    background-color: rgba(255, 252, 240, 0.9);
    align-items: center;
    justify-content: center;
}

.mk-peukalo__luku {
    font-size: var(--tk-koko-apuri);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: var(--map-ink);
}

/* --- Karttaselitteen välilehdet (webin .karttaselite-valilehti) --------------------- */

.mk-selite__valilehdet {
    flex-direction: row;
    flex-grow: 1;
}

.mk-selite__valilehti {
    min-height: 21px;
    padding: 3.2px 8px;
    margin-right: 4px;
    border-width: 1px;
    border-color: var(--lapinakyva);
    border-radius: 5px;
    background-color: var(--lapinakyva);
    color: var(--map-ink-70);
}

.mk-selite__valilehti .mk-nappi__teksti {
    font-size: 10.88px;
    letter-spacing: 8px; /* web 0.87px */
}

.mk-selite__valilehti.mk-valittu {
    border-color: var(--tk-paperi-reunus);
    background-color: rgba(255, 252, 242, 0.85);
    color: var(--map-ink-96);
}

.mk-selite__paneeli {
    flex-shrink: 1;
    min-height: 0;
}

/* Löydös 173 (omistaja 19.5x): Nostot/Maakunnat-paneeli kapeammaksi (≈ 62 % iPhonen leveydestä) ja korkeammaksi
 * (lähes alareunaan, Liikun yläpuolelle); peitto ≤ 45 % (250 × ~610 pt / 402 × 874 pt ≈ 43 %). */
.mk-selite.mk-selite--maakunnat {
    width: 250px;
    max-height: 78%;
}

.mk-maakunnat__valinnat {
    flex-direction: row;
}

.mk-maakunnat__valinnat > .mk-maakunnat__rivi {
    flex-grow: 1;
    flex-basis: 0;
    padding-right: 42px;
    padding-left: 12px;
}

.mk-maakunnat__valinnat > .mk-maakunnat__rivi--kaikki {
    padding-left: 24px;
    padding-right: 8px;
}

/* --- Maakunnat-välilehti (webin .maakunnat-*) ---------------------------------------- */

.mk-maakunnat {
    flex-shrink: 1;
    min-height: 0;
}

.mk-maakunnat__lista {
    position: relative;
}

.mk-maakunnat__tila {
    padding: 10px 8px;
    font-size: var(--tk-koko-kapiteeli);
    color: var(--map-ink-70);
}

.mk-maakunnat__maa {
    flex-direction: row;
    justify-content: flex-start;
    align-items: center;
    min-height: 32px;
    padding: 4px 6px;
    border-width: 0;
    border-radius: var(--tk-kulma-pieni);
    background-color: var(--lapinakyva);
    color: var(--map-ink-92);
}

.mk-maakunnat__maa:active {
    background-color: var(--map-ink-07);
}

.mk-maakunnat__nuoli {
    width: 14px;
    margin-right: 5px;
    font-size: 11px;
    -unity-text-align: middle-center;
    transition-property: rotate;
    transition-duration: 0.16s;
}

.mk-maakunnat__maa.mk-auki .mk-maakunnat__nuoli {
    rotate: 90deg;
}

.mk-maakunnat__maanimi {
    font-size: 11.5px;
    letter-spacing: 11.3px; /* web 1.3px */
}

.mk-maakunnat__rivi {
    justify-content: flex-start;
    min-height: 34px;
    padding: 4px 42px 4px 24px;
    border-width: 0;
    border-radius: var(--tk-kulma-pieni);
    background-color: var(--lapinakyva);
    color: var(--map-ink-92);
}

.mk-maakunnat__rivi:active {
    background-color: var(--map-ink-07);
}

.mk-maakunnat__rivi.mk-valittu {
    background-color: var(--map-ink-10);
}

.mk-maakunnat__nimi {
    font-size: 13.8px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.mk-maakunnat__rivi.mk-valittu .mk-maakunnat__nimi {
    -unity-font-style: bold;
}

/* Tyhjä peukalo: sama pilleri kuin Nostot-välilehdellä, luvun paikka tyhjänä. */
.mk-peukalo--tyhja {
    border-color: var(--map-ink-24);
}

/* Omistaja 28.9.2026 (kaappaus maakuntanosto-isommaksi-web.png): "mininosto" pohjaväri sama kuin nostokortin
   paperi (mk-nosto), ei kehystä (reunaviiva pois) — kaikilla laitteilla. Koko (~1,4 ×, fontit ja kuva suhteessa)
   vain tabletilla (Fablen korjaus 29.9.2026, iPhone-laitekuva: 300 pt:n paneelissa isonnus peitti liikaa karttaa
   ja rivitti tekstin kapeaksi) — ks. .mk-maakunnat--tabletti alempana; iPhonella koot tässä, aiemman kaltaiset. */
.mk-maakunnat__luonnehdinta {
    flex-shrink: 0;
    margin: 4px 2px 0 2px;
    padding: 8px 8px 4px 8px;
    border-width: 0;
    background-color: var(--tk-paperi-pinta);
}

.mk-maakunnat__lnimi {
    font-size: 11px;
    letter-spacing: 11.82px; /* web 1.3px */
    color: var(--map-ink-75);
    margin-bottom: 4px;
}

.mk-maakunnat__lrivi {
    flex-direction: row;
    align-items: flex-start;
}

/* Löydös 115: maakunnan pikkukuva mini-inforuudussa (4:3, rajattu). Ilman kehystä (28.9.2026), sama pohjaväri
   kuin nostokortin paperi (mk-nosto). */
.mk-maakunnat__lkuva {
    width: 64px;
    height: 48px;
    flex-shrink: 0;
    margin: 2px 8px 0 0;
    border-width: 0;
    border-radius: var(--tk-kulma-hius);
    background-color: var(--tk-paperi-pinta);
    -unity-background-scale-mode: scale-and-crop;
}

/* Löydös 170b: kuvan paikka ilman kuvaa — vaalea ruutu, pieni himmeä karttaikoni keskellä (ei koristeita). */
.mk-maakunnat__lkuva {
    align-items: center;
    justify-content: center;
}

.mk-maakunnat__lpaikka {
    width: 20px;
    height: 20px;
    opacity: 0.35;
    color: var(--map-ink);
    --mk-ikoni-viiva: 1.4;
}

.mk-maakunnat__lteksti {
    flex-shrink: 1;
    flex-grow: 1;
    font-size: var(--tk-koko-leipa); /* omistaja 6.10. 13.0x: sama koko kuin nostoissa (mk-nosto__teksti) */
    white-space: normal;
    color: var(--map-ink-92);
}

/* Tabletti (omistaja 29.9.2026): ~1,4 × isonnus vain iPadilla (mk-maakunnat--tabletti, Maakunnat.cs
   UiKerros.Tabletti-ehdolla); iPhonella yllä olevat, aiemman kaltaiset koot. */
.mk-maakunnat--tabletti .mk-maakunnat__luonnehdinta {
    padding: 11px 11px 8px 11px;
}

.mk-maakunnat--tabletti .mk-maakunnat__lnimi {
    font-size: 15px;
    letter-spacing: 16.25px; /* web 1.3px, sama suhde kuin ennen */
    margin-bottom: 5px;
}

.mk-maakunnat--tabletti .mk-maakunnat__lkuva {
    width: 88px;
    height: 66px;
    margin: 3px 11px 0 0;
}

.mk-maakunnat--tabletti .mk-maakunnat__lpaikka {
    width: 28px;
    height: 28px;
}

.mk-maakunnat--tabletti .mk-maakunnat__lteksti {
    font-size: var(--tk-koko-leipa);
}

.mk-maakunnat__lisaa {
    width: 30px;
    height: 30px;
    min-height: 30px;
    margin-left: 8px;
    padding: 0;
    flex-shrink: 0;
    border-width: 1px;
    border-color: var(--tk-kuulto-paperi-korostus-32);
    border-radius: 15px;
    background-color: rgba(255, 252, 242, 0.7);
    color: var(--map-ink-85);
    align-items: center;
    justify-content: center;
}

.mk-maakunnat__lisaa:active {
    background-color: var(--tk-paperi-pinta);
}

.mk-maakunnat__lisaa > .mk-ikoni {
    width: 18px;
    height: 18px;
    --mk-ikoni-viiva: 1.8;
}

/* --- Maakunnan kortti (webin .maakunta-kortti) --------------------------------------- */

/* Kortti avautuu kasvaen avanneen kohdan ("Lue lisää", kuva) suunnasta ja sulkeutuu samaa reittiä (omistaja 29.9.2026, webin
   arvot kuten .mk-selite yllä; origo koodista, MaakuntaKortti.Avaa). Himmennys erikseen taustavärinä: rgba(18,12,4) 0 → 0,3,
   sisään 220 ms, ulos 200 ms. Kerroksen oma opacity pysyy 1:nä, jottei se kerro kortin läpinäkyvyyttä. */
.mk-himmennys.mk-maakuntaKortti__kerros {
    opacity: 1;
    background-color: var(--lapinakyva);
    transition-property: background-color;
    transition-duration: 0.2s;
    transition-timing-function: ease-in;
}

.mk-himmennys.mk-maakuntaKortti__kerros.mk-auki {
    background-color: var(--tk-himmennys-kevyt);
    transition-duration: 0.22s;
    transition-timing-function: ease-out-cubic;
}

.mk-maakuntaKortti__kerros > .mk-maakuntaKortti {
    opacity: 0;
    scale: 0.92 0.92;
    transition-property: opacity, scale;
    transition-duration: 0.2s, 0.2s;
    transition-timing-function: ease-in, ease-in;
}

.mk-maakuntaKortti__kerros.mk-auki > .mk-maakuntaKortti {
    opacity: 1;
    scale: 1 1;
    transition-duration: 0.18s, 0.22s;
    transition-timing-function: ease-out-cubic, ease-out-cubic;
}

/* Löydös (omistaja 28.9.2026): koko, täyte, pohjaväri, reunus ja leveyslaskenta tulevat mk-nosto-luokasta
   (kortin elementillä on molemmat luokat, MaakuntaKortti.cs) — sama kuin nostokortti, ei omaa ulkoasua. */

.mk-maakuntaKortti__sulje {
    position: absolute;
    top: 6px;
    right: 6px;
}

.mk-maakuntaKortti__sisalto {
    flex-shrink: 1;
}

.mk-maakuntaKortti__otsikko {
    font-size: 20px;
    margin: 4px 40px 10px 2px;
    white-space: normal;
    color: var(--tk-paperi-muste);
}

.mk-maakuntaKortti__kuvat {
    margin: 4px 0 10px 0;
}

/* Omistajan kortti 30.9.2026 klo 22.5x: kuva nostokortin mitoilla (mk-nosto__kuvakehys, korkeus koodista), lähderivi alla. */
.mk-maakuntaKortti__kuvapaikka {
    flex-direction: column;
}

/* Minikartta tekstin oikealla (Lehtipalstat-kylkikuva, leveys ja paikka koodista), napautus suurentaa. */
.mk-maakuntaKortti__kartta {
    -unity-background-scale-mode: scale-to-fit;
    border-radius: 4px;
}

.mk-maakuntaKortti__karttatausta {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: var(--lapinakyva);
}

.mk-maakuntaKortti__karttaiso {
    position: absolute;
    -unity-background-scale-mode: scale-to-fit;
    background-color: var(--tk-paperi-pinta);
    border-radius: var(--tk-kulma-keski);
}

.mk-maakuntaKortti__lahde {
    margin-top: 3px;
    font-size: 9.5px;
    white-space: normal;
    color: var(--map-ink-70);
}

.mk-maakuntaKortti__teksti {
    font-size: 15.5px; /* sama kuin nostokortin mk-nosto__teksti */
    white-space: normal;
    margin-bottom: 10px;
}

.mk-maakuntaKortti__kysymys {
    flex-direction: row;
    justify-content: flex-start;
    align-items: center;
    min-height: 36px;
    margin-top: 4px;
    padding: 6px 8px;
    border-width: 1px;
    border-color: var(--tk-kuulto-paperi-korostus-28);
    border-radius: var(--tk-kulma-keski);
    background-color: rgba(255, 252, 242, 0.7);
    color: var(--map-ink-95);
}

.mk-maakuntaKortti__kysymys > .mk-ikoni {
    width: 20px;
    height: 20px;
    margin-right: 8px;
    flex-shrink: 0;
}

.mk-maakuntaKortti__kysymysteksti {
    flex-shrink: 1;
    font-size: var(--tk-koko-apuri);
    white-space: normal;
}

/* --- Offline-latauksen tila (OfflineTilaUi): pieni pilleri yläpalkin alla vasemmalla --- */

.mk-offlineTila {
    position: absolute;
    left: 12px;
    min-height: 30px;
    max-width: 70%;
    padding: 5px 12px 7px 12px;
    border-width: 1px;
    border-color: var(--tk-kuulto-accent-55);
    border-radius: var(--tk-kulma-nappi);
    background-color: var(--overlay-card);
    color: var(--ink-light);
    overflow: hidden;
}

/* Yksi teksti kerrallaan matkakirjan lapun kanssa: ristihäivytys (OfflineTilaUi.Vuorottele). */
.mk-offlineTila {
    transition-property: opacity;
    transition-duration: 0.22s; /* UI-siirtymä ≤ 250 ms (pohjavahti 8.10., oli 0.4s) */
}

.mk-offlineTila--vaistyy {
    opacity: 0;
}

.mk-offlineTila:active {
    background-color: var(--map-ink-95);
}

.mk-offlineTila.mk-verkoton {
    border-color: var(--tk-kuulto-ink-light-35);
}

.mk-offlineTila__teksti {
    font-size: var(--tk-koko-kapiteeli);
    letter-spacing: 2.5px; /* web 0.3px */
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.mk-offlineTila__palkki {
    position: absolute;
    left: 12px;
    right: 12px;
    bottom: 3px;
    height: 2px;
    border-radius: 1px;
    background-color: var(--tk-kuulto-ink-light-18);
}

.mk-offlineTila__taytto {
    height: 100%;
    border-radius: 1px;
    background-color: var(--accent);
}

.mk-maakunnat__nuoli.mk-ikoni {
    width: 13px;
    height: 13px;
    margin-right: 6px;
    --mk-ikoni-viiva: 2.2;
}

/* --- Nostokortti (webin .fokusnosto-kortti, .fokuskohde-popup, skandaalin lisälehti) --- */

.mk-nosto__kerros {
    background-color: var(--tk-himmennys-kevyt);
}

.mk-nosto {
    width: 100%;
    max-width: 544px; /* vara ennen ensimmäistä asettelua; leveys koodista (Nostokortti.Mitoita, löydökset 130/135) */
    max-height: 88%;
    /* NOSTOKORTTI-pohja (omistaja 1.10.2026): paikka ja korkeus koodista (Nostokortti.Pystypaikka), värit ja mitat
     * tyylikirjasta; yläreunassa vetokahvan tila (KAPEA). */
    padding: 22px var(--tk-vali-l) var(--tk-vali-l) var(--tk-vali-l);
    border-width: 1px;
    border-color: var(--tk-paperi-reunus);
    border-radius: var(--tk-kulma-kortti);
    background-color: var(--tk-paperi-pinta);
    color: var(--tk-paperi-muste);
}

/* Vetokahva (KAPEA): ylös laajentaa, alas sulkee; vyöhyke 28 pt kortin yläreunasta (Nostokortti.KahvaVyohyke). */
.mk-nosto__kahva {
    position: absolute;
    top: 8px;
    left: 50%;
    width: 36px;
    height: 5px;
    margin-left: -18px;
    border-radius: var(--tk-kulma-hius); /* EI OVAALEJA: kevyt suorakulmio (Päätoimittaja 8.10.) */
    background-color: var(--tk-paperi-reunus);
}

/* Löydös 135: kohde ja skandaali samaan kokoon kuin muut (leveys koodista, Nostokortti.Mitoita); skandaalilla vain tyyli. */
.mk-nosto--looppi {
    background-color: var(--kerma);
    border-color: var(--tk-kuulto-paperi-korostus-45);
}

.mk-nosto__sisus {
    flex-shrink: 1;
}

/* Löydös 133 (omistaja, build 16): ei ✕-nappia; kaiutin ylärivin oikeassa päässä (web: otsikkorivin oikea reuna).
   34 × 34 -nappi ei korota 16,3 pt:n riviä (negatiiviset pystymarginaalit). */
.mk-nosto__lukija {
    margin: -9px -6px -9px auto;
    flex-shrink: 0;
}

/* Napit näkyvät heti (omistaja 28.9.2026): ylärivillä paikkavaraus [valikko 30,4 + 1 + kaiutin 34] kaiuttimen
   marginaaleilla, napit kortissa sen kohdalla (Nostokortti.SijoitaLukija); vierittäessä paperipohja alle. */
.mk-nosto__lukijapaikka {
    width: 65.4px;
    height: 34px;
    margin: -9px -6px -9px auto;
    flex-shrink: 0;
}

.mk-nosto__lukija.mk-nosto__lukija--kiinni {
    position: absolute;
    margin: 0;
    border-radius: 17px;
}

.mk-nosto__lukija.mk-nosto__lukija--irti {
    background-color: var(--tk-kuulto-paperi-pinta-94);
}

.mk-nosto__ylarivi {
    /* Web .fokuskohde-ylarivi: American Typewriter 10,88 px, harvennus 1,52 px, #7a5514, alla 1,92 px.
       Löydös 133: oikealla ei enää ✕:n varausta (40 px). */
    font-size: 10.88px;
    letter-spacing: 13.97px; /* web 1.52px */
    color: var(--tk-paperi-korostus);
    margin: 2px 0 1.92px 0;
}

.mk-nosto__ylarivi-teksti {
    flex-shrink: 1;
    white-space: normal;
}

.mk-nosto__nimio {
    font-size: 9.5px;
    letter-spacing: 34.74px; /* web 3.3px */
    color: var(--map-ink-70);
    -unity-text-align: middle-center;
}

.mk-nosto__paivays {
    margin: 4px 0 8px 0;
    padding: 4px 0;
    border-top-width: 3px;
    border-bottom-width: 1px;
    border-top-color: var(--map-ink-75);
    border-bottom-color: var(--map-ink-50);
}

.mk-nosto__paivaysteksti {
    font-size: 11px;
    letter-spacing: 16.36px; /* web 1.8px */
    -unity-text-align: middle-center;
    white-space: normal;
    color: var(--map-ink);
}

.mk-nosto__otsikko {
    font-size: var(--tk-koko-otsikko);
    white-space: normal;
    margin: 0 0 6px 0; /* löydös 133: ei ✕:n varausta */
    color: var(--bg);
}

.mk-nosto__otsikko--kohde {
    font-size: var(--tk-koko-otsikko);
    margin: 0 0 7.2px 0; /* löydös 133: ei ✕:n varausta */
    color: var(--tk-paperi-muste);
}

.mk-nosto--looppi .mk-nosto__otsikko {
    font-size: var(--tk-koko-arkki);
    margin-right: 0;
}

.mk-nosto--kohde .mk-nosto__otsikko {
    font-size: 16.5px;
}

.mk-nosto__meta {
    font-size: var(--tk-koko-kapiteeli);
    color: var(--tk-kuulto-paperi-muste-58);
    margin-bottom: 8px;
    white-space: normal;
}

.mk-nosto__ingressi {
    font-size: var(--tk-koko-leipa);
    white-space: normal;
    margin-bottom: 8px;
    color: var(--panel);
}

.mk-nosto__teksti {
    font-size: var(--tk-koko-leipa);
    white-space: normal;
    margin-bottom: 9px;
}

.mk-nosto__kuvasarja {
    margin: 4px 0 10px 0;
}

.mk-nosto__kuvakehys {
    border-radius: var(--tk-kulma-pieni);
    overflow: hidden;
    background-color: var(--map-ink-10);
}

/* Löydös 130: kehys kuvan omassa muodossa korkeuskattoon asti; katetun kuvan sivuilla kortin paperi, ei sävyä. */
.mk-nosto__kuvakehys--ladattu {
    background-color: var(--lapinakyva);
}

.mk-nosto__kuva {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    -unity-background-scale-mode: scale-to-fit;
}

/* HERO 2:1 (NOSTOKORTTI-pohja): kuva täyttää kehyksen ja rajautuu. */
.mk-nosto__kuva--hero {
    -unity-background-scale-mode: scale-and-crop;
}

/* Web .nostokuva-selite (mitattu 24.9. b11): Iowan 13,44 px, rgba(33, 29, 24, 0.82), keskitetty, yllä 5,6 px.
   Väri läpinäkymättömänä (0,82 kortin #f5f0e2:n päällä sRGB:ssä = rgb(71, 67, 60)): projekti on lineaarisessa
   väriavaruudessa, ja alfa sekoittuu siellä vaaleammaksi (b11a mitattu 117 vs web 58, täysi #211d18 osui 33,29,24). */
.mk-nosto__kuvateksti {
    margin-top: 5.6px;
    font-size: var(--tk-koko-apuri);
    white-space: normal;
    color: var(--tk-paperi-muste-pehmea);
}

/* Kuvan alla keskitetty (web figcaption.nostokuva-selite text-align center). */
.mk-nosto__esittelyrivi .mk-nosto__kuvateksti,
.mk-nosto__kuvasarja > .mk-nosto__kuvateksti {
    -unity-text-align: upper-center;
}

.mk-nosto__esittelyrivi {
    flex-direction: column;
    align-items: center;
}

.mk-nosto__esittelyrivi .mk-nosto__kuvateksti {
    align-self: stretch;
}

/* Web .nostokuva-lisaa: 102 × 40, täyte 5,6/25,6, reuna 1 px rgba(122, 85, 20, 0.45), pyöristys 8, pohja
   rgba(250, 246, 235, 0.96); American Typewriter 13,76 px versaali, harvennus 1,1 px, rgb(92, 63, 14); yllä 8,8 px. */
.mk-nosto__lisaa {
    min-height: 40px;
    margin-top: 8.8px;
    margin-bottom: 1.6px;
    padding: 5.6px 25.6px;
    border-width: 1px;
    /* rgba(122, 85, 20, 0.45) ja rgba(250, 246, 235, 0.96) kortin päällä sRGB:ssä (lineaarinen alfa vaalentaisi). */
    border-color: var(--tk-tumma-muste-pehmea);
    border-radius: var(--tk-kulma-keski);
    background-color: var(--tk-paperi-pinta);
    color: rgb(92, 63, 14);
}

.mk-nosto__lisaa .mk-nappi__teksti {
    font-size: 13.76px;
    letter-spacing: 7.99px; /* web 1.1px */
    color: rgb(92, 63, 14);
}

.mk-nosto__selaa {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 24%;
    border-width: 0;
    border-radius: 0;
    background-color: var(--lapinakyva);
    color: var(--tk-kuulto-valkoinen-92);
}

.mk-nosto__selaa--vasen {
    left: 0;
    justify-content: flex-start;
    padding-left: 10px;
}

.mk-nosto__selaa--oikea {
    right: 0;
    justify-content: flex-end;
    padding-right: 10px;
}

.mk-nosto__selaa .mk-nappi__teksti {
    font-size: var(--tk-koko-nimio);
    color: var(--tk-kuulto-valkoinen-92);
}

/* Web .nostosarja-kuvalaskuri: American Typewriter 10,88 px, harvennus 0,44, #f6f0e0 pohjalla rgba(18, 12, 4, 0.55). */
.mk-nosto__laskuri {
    position: absolute;
    right: 8px;
    bottom: 8px;
    padding: 0.8px 6.4px;
    border-radius: var(--tk-kulma-pieni);
    background-color: var(--tk-kuulto-himmennys-tumma-55);
    color: var(--tk-paperi-pinta);
    font-size: 10.88px;
    letter-spacing: 4.04px; /* web 0.44px */
}

.mk-nosto__visa {
    margin: 8px 0 6px 0;
    padding: 10px 12px;
    border-width: 1px;
    border-color: var(--tk-kuulto-paperi-korostus-45);
    border-radius: var(--tk-kulma-nappi);
    background-color: var(--tk-kuulto-valkoinen-42);
}

.mk-nosto__visaotsikko {
    font-size: 11px;
    letter-spacing: 13.64px; /* web 1.5px */
    color: var(--tk-paperi-korostus);
    margin-bottom: 4px;
}

.mk-nosto__visakysymys {
    font-size: var(--tk-koko-leipa);
    white-space: normal;
    margin-bottom: 4px;
}

.mk-nosto__visavihje {
    font-size: 12.5px;
    -unity-font-style: italic;
    color: var(--tk-kuulto-paperi-muste-65);
    white-space: normal;
    margin-bottom: 6px;
}

.mk-nosto__visanappi {
    justify-content: flex-start;
    min-height: 42px;
    margin-top: 5px;
    padding: 6px 10px;
    border-width: 1px;
    border-color: var(--tk-kuulto-paperi-korostus-35);
    border-radius: var(--tk-kulma-keski);
    background-color: var(--tk-kuulto-valkoinen-62);
    color: var(--tk-paperi-muste);
}

.mk-nosto__visanappi .mk-nappi__teksti {
    white-space: normal;
    font-size: 14.5px;
}

.mk-nosto__visanappi.mk-oikein {
    border-color: var(--tk-tila-onnistuminen);
    background-color: var(--tk-kuulto-tila-onnistuminen-16);
}

.mk-nosto__visanappi.mk-vaarin {
    border-color: var(--tk-erikois-tila-6);
    background-color: var(--tk-erikois-tila-6-a12);
}

.mk-nosto__visatulos {
    margin-top: 8px;
    font-size: 14.5px;
    white-space: normal;
    color: var(--tk-erikois-muu-4);
}

.mk-nosto__visatulos.mk-oikein {
    color: var(--tk-tila-onnistuminen);
}

.mk-nosto__palkkio {
    margin-top: 6px;
    padding-top: 8px;
    border-top-width: 1px;
    border-top-color: var(--tk-kuulto-paperi-korostus-28);
    font-size: 13.5px;
    color: var(--tk-paperi-korostus);
    white-space: normal;
}

.mk-nosto__kysyotsikko {
    margin: 10px 0 6px 0;
    font-size: 13px;
    color: var(--map-ink);
}

.mk-nosto__kysymys {
    justify-content: flex-start;
    min-height: 38px;
    margin-bottom: 6px;
    padding: 6px 10px;
    border-width: 1px;
    border-color: var(--tk-kuulto-paperi-korostus-50);
    border-radius: var(--tk-kulma-keski);
    background-color: var(--tk-kuulto-tumma-muste-60);
    color: var(--map-ink);
}

.mk-nosto__kysymys .mk-nappi__teksti,
.mk-nosto__kierros .mk-nappi__teksti {
    white-space: normal;
    font-size: 13.5px;
}

.mk-nosto__kierros {
    min-height: 44px;
    margin-top: 6px;
    border-width: 1px;
    border-color: var(--tk-kuulto-paperi-korostus-60);
    border-radius: 4px;
    background-color: rgba(214, 168, 62, 0.18);
    color: var(--tk-paperi-korostus);
    justify-content: center;
}

.mk-nosto__suurennos {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    padding: 16px;
    background-color: var(--tk-kuulto-himmennys-tumma-55);
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.22s;
}

.mk-nosto__suurennos.mk-auki {
    opacity: 1;
}

.mk-nosto__suurennoskehys {
    width: 100%;
    max-width: 640px;
    padding: 9px;
    border-width: 1px;
    border-color: var(--map-ink-35);
    border-radius: var(--tk-kulma-hius);
    background-color: var(--tk-paperi-pinta);
}

.mk-nosto__suurennoskuva {
    height: 420px;
    max-height: 60%;
    -unity-background-scale-mode: scale-to-fit;
}

/* Löydös 102: täyttötila (Kuvasuurennos.Tayteen) mitoittaa kuvan ja kehyksen koodista. */
.mk-nosto__suurennos.mk-suurennos--tayteen {
    padding: 8px; /* web .fokuskohde-zoom 0.5rem */
}

.mk-suurennos--tayteen .mk-nosto__suurennoskehys {
    width: auto;
    max-width: none;
}

.mk-suurennos--tayteen .mk-nosto__suurennoskuva {
    max-height: none;
}

.mk-nosto__suurennosteksti {
    margin-top: 8px;
    font-size: 14.5px;
    white-space: normal;
    color: var(--map-ink);
}

.mk-nosto__lahde {
    margin-top: 4px;
    font-size: 11.5px;
    white-space: normal;
    color: var(--map-ink-72);
}

/* Lähderivi linkkinä (web .pollo-kuvalahde: pulun Wikipedia-kuva). */
.mk-nosto__lahde--linkki {
    color: var(--tk-paperi-korostus);
}

/* Täkynosto ja syvennys (web css/fokusnosto.css, fokusvirta.css) ja kohdekortin ihme ja
 * leikekirja (css/fokuskohteet.css). */

.mk-nosto__media {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    margin: 0 0 8px 0;
}

.mk-nosto__medianappi {
    min-height: 32px;
    margin: 0 5px 5px 0;
    padding: 4px 10px;
    border-width: 1px;
    border-color: var(--tk-kuulto-paperi-korostus-50);
    border-radius: var(--tk-kulma-nappi);
    background-color: var(--tk-kuulto-valkoinen-50);
    color: var(--tk-paperi-korostus);
}

.mk-nosto__medianappi .mk-nappi__teksti {
    font-size: 12.5px;
}

.mk-nosto__valokuva {
    width: 62%;
    margin: 4px 0 10px 0;
}

.mk-nosto__liite {
    margin: 10px 0 4px 0;
    padding: 6px 7px 7px 7px;
    border-width: 1px;
    border-color: var(--tk-kuulto-paperi-korostus-34);
    border-radius: 3px;
    background-color: var(--tk-tumma-muste);
}

.mk-nosto__liiteotsake {
    margin-bottom: 6px;
    padding-bottom: 3px;
    border-bottom-width: 1px;
    border-bottom-color: var(--tk-kuulto-paperi-korostus-26);
    color: rgba(94, 66, 16, 0.85);
    font-size: 10.5px;
    letter-spacing: 12.38px; /* web 1.3px */
}

.mk-nosto__liitenappi {
    height: 210px;
    padding: 0;
    border-width: 1px;
    border-color: var(--tk-kuulto-paperi-korostus-30);
    border-radius: 0;
    background-color: var(--tk-paperi-pinta);
}

.mk-nosto__liitekuva {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.mk-nosto__liitetaite {
    position: absolute;
    background-color: var(--map-ink-16);
}

.mk-nosto__liitetaite--pysty {
    top: 0;
    bottom: 0;
    left: 50%;
    width: 1px;
}

.mk-nosto__liitetaite--vaaka {
    left: 0;
    right: 0;
    top: 50%;
    height: 1px;
}

.mk-nosto__kohdenappi {
    justify-content: flex-start;
    min-height: 44px;
    margin-top: 10px;
    padding: 6px 3px;
    border-width: 0;
    border-top-width: 1px;
    border-top-color: var(--tk-kuulto-paperi-korostus-28);
    border-radius: 0;
    background-color: var(--lapinakyva);
    color: var(--tk-paperi-korostus);
}

.mk-nosto__kohdenappi .mk-nappi__teksti {
    font-size: 15px;
    white-space: normal;
    color: var(--tk-paperi-korostus);
}

.mk-nosto__lunastus {
    min-height: 44px;
    margin-top: 8px;
    border-width: 1px;
    border-color: var(--tk-kuulto-paperi-korostus-40);
    border-radius: var(--tk-kulma-keski);
    background-color: var(--tk-kuulto-valkoinen-62);
    color: var(--tk-paperi-muste);
}

.mk-nosto__lunastus .mk-nappi__teksti {
    font-size: 15px;
}

/* Säilyneen ihmekohteen nykykuva tekstin kyljessä (web .fokuskohde-teksti > .fokuskohde-nykykuva, omistaja
   27.9.2026; mitattu #3517 Chromiumissa): kuva 10 rem korkea ja rajattu (object-fit cover), napin reunus 1 px
   rgba(58, 38, 16, 0.22) ja kulmat 8 px; kuvateksti 0,68 rem, riviväli 1,4, marginaali 0,3 0,1 0,4 rem,
   rgba(33, 29, 24, 0.78). Värit läpinäkymättöminä kortin #f5f0e2:n päällä (sRGB). Leveyden ja paikan asettaa
   Lehtipalstat (mk-palstat__kylki). */
.mk-nosto__kuvakehys--nyky {
    border-width: 1px;
    border-color: rgb(204, 196, 180);
    border-radius: var(--tk-kulma-keski);
}

.mk-nosto__kuvakehys--nyky > .mk-nosto__kuva {
    -unity-background-scale-mode: scale-and-crop;
    border-radius: 7px;
}

.mk-nosto__nykyteksti {
    margin: 4.8px 1.6px 6.4px 1.6px;
    padding: 0;
    font-size: 10.88px;
    white-space: normal;
    color: rgb(80, 75, 68);
}

.mk-nosto__leikekirja {
    flex-direction: column;
    align-items: flex-start;
    min-height: 44px;
    margin: 10px 0 3px 0;
    padding: 7px 11px;
    border-width: 1px;
    border-color: var(--tk-kuulto-paperi-korostus-60);
    border-radius: 4px;
    background-color: rgba(214, 168, 62, 0.18);
    color: var(--tk-paperi-muste);
}

.mk-nosto__leikekirjaotsake {
    margin-bottom: 2px;
    font-size: 11px;
    letter-spacing: 13.64px; /* web 1.5px */
    color: var(--tk-paperi-korostus);
}

.mk-nosto__leikekirjaotsikko {
    font-size: 14.5px;
    white-space: normal;
    color: var(--tk-paperi-muste);
}

/* Matkakirjan ihmeen kulmanauha (PUNA, sinettivaha): vino kaista kuvan vasemmassa yläkulmassa.
 * Säiliö leikkaa kaistan; Nostokortti.SovitaNauha siirtää säiliön kuvan todelliseen kulmaan. */
.mk-ihmenauha {
    position: absolute;
    left: 0;
    top: 0;
    width: 124px;
    height: 124px;
    overflow: hidden;
}

.mk-ihmenauha__kaista {
    position: absolute;
    left: -45px;
    top: 36px;
    width: 180px;
    height: 20px;
    rotate: -45deg;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-color: var(--tk-erikois-ihme-1-a55);
    background-color: var(--tk-erikois-ihme-2);
    color: var(--paper);
    font-size: 9.5px;
    letter-spacing: 12.63px; /* web 1.2px */
    -unity-text-align: middle-center;
    white-space: nowrap;
}

/* --- noppa (UI/Noppa.cs; webin .die-layer, css/styles.css ~2103) ---------------- */
/* Kerros koko isän alueella, ei poimi kosketuksia. Kuutio, varjo ja silmät piirretään
 * koodissa (generateVisualContent), joten USS:ssä on vain asettelu ja häivytys. */

.mk-noppa,
.mk-noppa__pinta,
.mk-noppa__viivat {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

/* Uuteen kaupunkiin saavuttaessa noppa katoaa 0,42 s:ssa (die.js haivyta). Siirtymä on
 * vain tässä luokassa, jotta uusi heitto palauttaa nopan näkyviin heti. */
.mk-noppa--haipyy {
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.2s; /* UI-siirtymä ≤ 250 ms (pohjavahti 8.10., oli 0.42s) */
    transition-timing-function: ease;
}

/* --- tapahtumakupla (Leima.cs; web .event-toast.stamp) ------------------------------------ */

.mk-leimat {
    position: absolute;
    top: 16%;
    left: 0;
    right: 0;
    align-items: center;
}

.mk-leima {
    position: absolute;
    flex-direction: row;
    align-items: center;
    max-width: 80%;
    padding: 11px 18px;
    border-width: 1px;
    border-color: var(--tk-erikois-leima-2-a55);
    border-radius: 14px;
    background-color: var(--overlay-card);
    color: var(--ink-light);
    opacity: 0;
    translate: 0 18px;
    scale: 0.92 0.92;
    transition-property: opacity, translate, scale;
    transition-duration: 0.28s; /* ympäristöanimaatio (pohjavahdin poikkeus 8.10.) */
    transition-timing-function: ease-out-back;
}

.mk-leima.mk-auki {
    opacity: 1;
    translate: 0 0;
    scale: 1 1;
}

.mk-leima--lahtee {
    opacity: 0;
    translate: 0 -14px;
    scale: 0.97 0.97;
    transition-duration: 0.3s; /* ympäristöanimaatio (pohjavahdin poikkeus 8.10.) */
    transition-timing-function: ease-in;
}

.mk-leima__ikoni {
    width: 26px;
    height: 26px;
    margin-right: 11px;
    color: var(--accent);
}

.mk-leima__tekstit {
    flex-shrink: 1;
}

.mk-leima__teksti {
    font-size: 16.8px;
    white-space: normal;
    color: var(--ink-light);
}

.mk-leima__ala {
    font-size: 13.6px;
    white-space: normal;
    color: var(--muted);
}

/* Kartuschan radio (web .maapaneeli-radio): merkkivalo ja pieni "radio" maston oikeassa laidassa,
 * vain avattuna ja vain maille, joilla on asema. Valo palaa soidessa ja vilkkuu kanavan haun ajan. */
.mk-kartuscha__radio {
    display: none;
    position: absolute;
    top: 11.2px;
    right: 11.2px;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 0;
    padding: 2px 3px;
    border-width: 0;
    background-color: var(--lapinakyva);
}

.mk-kartuscha.mk-auki .mk-kartuscha__radio--asema {
    display: flex;
}

.mk-kartuscha__radiovalo {
    width: 11px;
    height: 11px;
    margin-bottom: 3px;
    border-width: 1px;
    border-color: var(--map-ink-45);
    border-radius: var(--tk-kulma-pieni);
    background-color: var(--map-ink-25);
}

.mk-lehti__kuuntele--soi .mk-kartuscha__radiovalo,
.mk-kartuscha__radio.mk-etsii.mk-vilkku .mk-kartuscha__radiovalo {
    border-color: var(--tk-erikois-kartuscha-1-a85);
    background-color: var(--tk-erikois-kartuscha-2);
}

.mk-kartuscha__radio.mk-etsii .mk-kartuscha__radiovalo {
    border-color: var(--tk-erikois-kartuscha-1-a85);
    background-color: var(--map-ink-25);
}

.mk-kartuscha__radionimi {
    font-size: 9px;
    letter-spacing: 11.11px; /* web 1px */
    color: var(--map-ink-75);
    opacity: 0.72;
}


/* --- nostomerkit kartalla (NostotKartalla; web .pallolauta-nosto, nostosym-*) ------------------- */

.mk-nostot {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

/* Merkin ankkuri on ikoniruudun keskipiste (translate = ruutupiste); koko, marginaalit ja nimiön paikka
 * lasketaan NostotKartalla.Hae/AsetaNimio-metodeissa webin kaavoilla (löydös 50). */
.mk-nosto-merkki {
    position: absolute;
    left: 0;
    top: 0;
    width: 11px;
    height: 11px;
}

.mk-nosto-merkki__symboli {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.mk-nosto-merkki__symboli--kuva {
    -unity-background-scale-mode: scale-to-fit;
}

.mk-nosto-merkki__kuvio {
    position: absolute;
    left: 2px;
    top: 2px;
    width: 16px;
    height: 16px;
}

.mk-nosto-merkki__symboli--piste .mk-nosto-merkki__kuvio {
    left: 1px;
    top: 1px;
    width: 18px;
    height: 18px;
}

/* Löydös 125 (web piirraNostosymMiniCanvas): pistemerkin harmaa häive 2,1 r ja vaalea sisus yhtenä kuvana
 * (Kartta/NostoHehku, peitot jo lineaarisina); musterengas päällä. Väri vain karttaselitteen valossa. */
.mk-nosto-merkki__hehku {
    -unity-background-scale-mode: stretch-to-fill;
}

/* Web .nostosym-mini rgba(58, 40, 25, 0,86): musterengas ja viivamerkin runko. Peitto lineaariseen sekoitukseen
 * korjattuna (NimiLadonta.LineaarinenAlfa pergamentilla: 0,86 → 0,95), kuten nimikerroksen värit. */
.mk-nosto-merkki__rengas {
    color: var(--panel-2);
    opacity: 0.95;
}

/* Web viivamerkit (vuori, aalto, salama, tassu, ruusu) musteella, ei aiheväriä. */
.mk-nosto-merkki__vektori {
    color: var(--panel-2);
    opacity: 0.95;
}

/* Web .nostosym-mini-ohut rgba(58, 40, 25, 0,52): aallon alempi veto (lineaarisena 0,72). */
.mk-nosto-merkki__vektori-ohut {
    color: var(--panel-2);
    opacity: 0.72;
}

/* Ryhmämerkki (web css .pallolauta-aihemerkki-pohja/-lautanen/-keha): levy r 3,4 px ilman sisäsymbolia. */
.mk-nosto-merkki__levy-pohja {
    color: var(--paper);
    opacity: 0.95;
}

.mk-nosto-merkki__levy-vari {
    opacity: 0.5;
}

.mk-nosto-merkki__levy-keha {
    color: var(--map-ink);
    opacity: 0.85;
    --mk-ikoni-viiva: 1.1;
}

/* Web .nostosym-nimio: --font-atlas (Liberation Serif) kursiivi, rgba(74, 52, 33, 0,92), ei haloa, ei harvennusta;
 * koko 11 × mitta (C#). Häivytys 180 ms (web KYLKIVAIHDON_HAIVYTYS_MS). Löydös 125: peitto lineaarisena 0,97 ja
 * SDF-reunan vahvistus samalla musteella asetetaan C#:ssa (NostotKartalla.AsetaMuste, NostoKerros.NimionReuna*). */
/* Nimiö häipyy ja palaa pehmeästi (omistaja 28.9.2026, TF 1.0.34: nostotekstit välkkyivät; web #3540: piilotus,
   paluu ja kyljen vaihto 220 ms ease-in-out). */
.mk-nosto-merkki__nimio {
    transition-property: opacity;
    transition-duration: 0.22s;
    transition-timing-function: ease-in-out;
    position: absolute;
    font-size: 8.5px;
    white-space: nowrap;
    padding: 0;
    margin: 0;
    color: var(--map-ink-96);
    opacity: 1;
    transition-property: opacity;
    transition-duration: 0.18s;
}

/* Web NOSTOSYM_TASO1_MUSTE rgba(46, 30, 14, 0,98) (lineaarisena 1,0). */
.mk-nosto-merkki__nimio--taso1 {
    color: var(--tk-lasi-pinta-peitto);
}

/* Web .nostosym-nimio-meri: versaali, harvennus 0,28 em (C#), rgba(120, 108, 84, 0,72) (merellä lineaarisena 0,8). */
.mk-nosto-merkki__nimio--meri {
    color: rgba(120, 108, 84, 0.8);
}

/* Viuhka (web .pallolauta-viuhka-pohja, VIUHKAN_POHJAN_VYOT): kehyksetön paperipohja, reuna pehmennetty
 * varjolla; rivit 30 px välein, symboli ja nimi. Avautuu 180 ms. */
.mk-nosto-viuhka {
    position: absolute;
    align-items: flex-start;
    transition-property: opacity, scale;
    transition-duration: 0.18s;
}

.mk-nosto-viuhka--vasen {
    align-items: flex-end;
}

.mk-nosto-viuhka__pohja {
    padding: 2px 10px;
    border-radius: var(--tk-kulma-pieni);
    background-color: var(--tk-kuulto-paper-82);
}

.mk-nosto-viuhka__rivi {
    flex-direction: row;
    align-items: center;
    height: 30px;
}

.mk-nosto-viuhka__nimi {
    margin-left: 4px;
    font-size: 13px;
    white-space: nowrap;
    color: var(--map-ink-92);
}

/* Lehtipalstat (web .lehtipalsta, css/styles.css @container 600 px): kaksi palstaa, väli 1,4 rem, vasen tasaus. */
.mk-palstat__mittari {
    position: absolute;
    visibility: hidden;
}

/* Kelluva kylkikuva (Lehtipalstat.LuoKylkikuvalla): left, top ja width koodissa. */
.mk-palstat__kylki {
    position: absolute;
}

.mk-palstat__vieri {
    flex-shrink: 0;
}

.mk-palstat--kaksi > .mk-palstat__sisus {
    flex-direction: row;
    align-items: flex-start;
}

.mk-palstat__palsta {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    min-width: 0;
}

.mk-palstat__palsta--oikea {
    margin-left: 22.4px;
}

.mk-palstat__anfangikappale {
    position: relative;
}

/* Web ::first-letter: American Typewriter 700, 3,1 em, rgba(70, 51, 31, 0.9) paperin #f5f0e2 päällä
   sRGB-yhdistelmänä (lineaarinen alfa vaalentaisi). */
.mk-palstat__anfangi {
    position: absolute;
    left: 0;
    padding: 0;
    margin: 0;
    color: var(--tk-paperi-muste-pehmea);
}

/* Lyhyt kuvateksti kotelona (Nostokortti.Kuvateksti): rivi rivittyy ja keskittyy kuten webin text-align center. */
.mk-nosto__kuvateksti--kotelo {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
}

.mk-nosto__kuvarivi {
    flex-shrink: 1;
    white-space: normal;
    -unity-text-align: upper-center;
}

/* Sanaväli Iowan 13,44 px (mitattu Chromiumissa 3,73 px). */
.mk-nosto__kuvasana--vali {
    margin-right: 3.73px;
}

/* Web .kuvateksti-havainne (mitattu 24.9. b12, fokusnosto.css ladattuna): American Typewriter 0,68 em = 9,14 px,
   versaali, harvennus 0,08 em = 0,73 px, täyte 0 / 3,2 px, reunus 1 px, pyöristys 3, vasemmalla 0,45 em = 4,11 px,
   korkeus 14,3. Värit sRGB-yhdistelminä kortin #f5f0e2:n päällä (lineaarinen väriavaruus vaalentaisi alfan):
   teksti rgba(70, 51, 31, 0.72) → rgb(119, 104, 86), reunus rgba(70, 51, 31, 0.28) → rgb(196, 187, 171). */
.mk-nosto__havainne {
    margin: 0 0 0 4.11px;
    padding: 0 3.2px;
    height: 14.3px;
    font-size: 9.14px;
    letter-spacing: 7.99px; /* web 0.73px */
    color: var(--sea-ink);
    border-width: 1px;
    border-color: rgb(196, 187, 171);
    border-radius: 3px;
    -unity-text-align: middle-center;
    white-space: nowrap;
}

/* Ylärivin aihesymboli (web .fokuskohde-ylarivi-symboli, mitattu 24.9. b12): 1,5 em = 16,3 pt, oikealla 0,4 em =
   4,35 pt, kaiverruskuva 14,1 pt keskellä (viewBox −12…12, kuva ±NOSTOSYM_R). Rivin korkeus = symbolin korkeus. */
.mk-nosto__ylarivi--rivi {
    flex-direction: row;
    align-items: center;
}

.mk-nosto__ylarivi-symboli {
    width: 16.3px;
    height: 16.3px;
    margin-right: 4.35px;
    flex-shrink: 0;
    background-size: 14.1px 14.1px;
    background-repeat: no-repeat;
    background-position-x: center;
    background-position-y: center;
}

/* Löydös 150 (omistaja build 16, Fablen linjaus A): noston kuva kokoruudulle — tumma tausta, ei kehystä, ei
 * kuvatekstiä eikä lähderiviä (138:n linja; tekijärivi jää korttiin), kuva reunasta reunaan (Kuvasuurennos.Kokoruutu). */
.mk-nosto__suurennos.mk-suurennos--kokoruutu {
    padding: 0;
    /* Löydös 132: tummennus 0,6, jotta sumennettu tausta näkyy (omistaja: pehmennetään ja tummennetaan). */
    background-color: var(--tk-kuulto-himmennys-tumma-60);
}

/* Ilman pysäytyskuvaa (elävä opas, Päätoimittaja 6.10.): tumma himmennys tokenista, ettei 3D-näkymä näy terävänä kuvan takana. */
.mk-nosto__suurennos.mk-suurennos--kokoruutu.mk-suurennos--ei-pysaytysta {
    background-color: var(--tk-himmennys-kuva);
}

/* Löydös 132: pallon pysäytyskuva kokoruudun taustana, tummennettuna sävyllä (lapsi piirtyy kerroksen värin päälle). */
.mk-suurennos__pysaytys {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    -unity-background-scale-mode: scale-and-crop;
    -unity-background-image-tint-color: rgb(102, 96, 88);
}

.mk-suurennos--kokoruutu .mk-nosto__suurennoskehys {
    width: auto;
    max-width: none;
    padding: 0;
    border-width: 0;
    border-radius: 0;
    background-color: var(--lapinakyva);
    background-image: none;
}

.mk-suurennos--kokoruutu .mk-nosto__suurennoskuva {
    max-height: none;
}

.mk-suurennos--kokoruutu .mk-nosto__suurennosteksti,
.mk-suurennos--kokoruutu .mk-nosto__lahde,
.mk-suurennos--kokoruutu .mk-reaktiot--suurennos {
    display: none;
}

/* Elävä opas (Päätoimittaja 6.10., CC BY): lähderivi näkyy kokoruudussakin kuvan alla, vaalea teksti tummalla. */
.mk-suurennos--kokoruutu.mk-suurennos--lahde-nakyy .mk-nosto__lahde {
    display: flex;
    margin: 6px 12px 0 12px;
    color: var(--tk-tumma-muste-pehmea);
    -unity-text-align: middle-center;
}

/* Elävä kartta, kohta 2: löytämättömän musteen jälki ja pääkohteen hehku merkin alla (MusteJaljet, NostotKartalla.AsetaMuste). */
.mk-nosto-merkki__jalki,
.mk-nosto-merkki__hehku {
    position: absolute;
    -unity-background-scale-mode: stretch-to-fill;
}

/* Maakuntakartta (omistaja 28.9. klo 17.1x): paneeli on pelkkä kuvausruutu, hieman isompi kuva ja teksti, silti kevyt. */
.mk-selite.mk-selite--karttatila {
    width: 300px;
    max-width: 86%;
    padding: 4px;
}

/* iPad: kuvausruutu isommaksi myös leveydeltään (1,4 × 300 px), jotta isonnettu teksti ei jää kapeaksi palstaksi. */
.mk-selite.mk-selite--karttatila.mk-selite--karttatila-tabletti {
    width: 420px;
}

/* Pohjaväri jo nostokortin paperi ja ei kehystä (mk-maakunnat__luonnehdinta, kaikilla laitteilla); käsin piirretty
   paneelikehys (KarheaKehys) piilotettu maakuntakarttatilassa (Karttaselite.cs) — se näkyi tummana reunana koko
   pienen kuvausruudun ympärillä (omistaja 29.9.2026, iPhone-laitekuva). */
.mk-maakunnat--kartta .mk-maakunnat__luonnehdinta {
    overflow: hidden; /* sisällön vaihdon kokoliuku (Tiivistys) ei vuoda laatikon yli */
    margin: 0;
    padding: 8px 8px 6px 8px;
}

.mk-maakunnat--kartta .mk-maakunnat__lnimi {
    font-size: var(--tk-koko-kapiteeli);
    margin-bottom: 6px;
    padding-right: 28px;
}

/* Lapun ✕ (omistaja 29.9.2026, mitat sovittu webin kanssa): sama ohut risti kuin karttaselitteen ✕ (ikoni 20, viiva 1,3,
   muste 70 %), ei taustaa eikä kehystä; keskipiste 20 pt yläreunasta ja 22 pt oikeasta reunasta (webin mitta, Siirtoseppä
   29.9.), osuma-ala 44 × 44. */
.mk-selite__sulje.mk-selite__lappusulje {
    position: absolute;
    top: -2px;
    right: 0;
    width: 44px;
    height: 44px;
    min-height: 44px;
    margin: 0;
}

.mk-selite__sulje.mk-selite__lappusulje:active {
    background-color: var(--lapinakyva);
}

.mk-maakunnat--kartta .mk-maakunnat__lkuva {
    width: 96px;
    height: 72px;
    margin: 2px 10px 0 0;
}

.mk-maakunnat--kartta .mk-maakunnat__lteksti {
    font-size: var(--tk-koko-leipa);
}

/* Tabletti + maakuntakartta (omistaja 29.9.2026): ~1,4 × isonnus vain iPadilla, sama suhde kuin perustilan
   tablettikoroissa yllä. iPhonella yllä olevat, aiemman kaltaiset koot. */
.mk-maakunnat--tabletti.mk-maakunnat--kartta .mk-maakunnat__luonnehdinta {
    padding: 11px 11px 8px 11px;
}

.mk-maakunnat--tabletti.mk-maakunnat--kartta .mk-maakunnat__lnimi {
    font-size: 17px;
    margin-bottom: 8px;
}

.mk-maakunnat--tabletti.mk-maakunnat--kartta .mk-maakunnat__lkuva {
    width: 132px;
    height: 99px;
    margin: 3px 14px 0 0;
}

.mk-maakunnat--tabletti.mk-maakunnat--kartta .mk-maakunnat__lteksti {
    font-size: var(--tk-koko-leipa);
}

.mk-maakunnat__ohje {
    color: var(--map-ink-70);
}
