/* KYSYMYSNÄKYMÄ (Natiivi-UI, erä 3): verkkopelin #quiz-dialog (css/styles.css
 * "--- tietovisa ---", .quiz-option, .quiz-result, .lifeline, tiimalasi,
 * .quiz-hint-text, .quiz-sketch, .quiz-photo).
 * Mitat puhelimen mukaan: styles.css:n @media (max-width: 560px) ja
 * (pointer: coarse) -säännöt (yksi sarake, isot vaihtoehtonapit).
 * USS:ssä ei ole elliptisiä kulmasäteitä (86px 14px 92px 12px / 12px 92px …),
 * joten käsin piirretty kulma tehdään kulmakohtaisilla säteillä; yliviivaus
 * (text-decoration) tulee koodista rich text -tagina <s>.
 */

:root {
    --mk-kysymys-muste: #3b2a18;
    --mk-kysymys-kaupunki: #7a6039;
    --mk-kysymys-oikea: #2f6b3f;
    --mk-kysymys-oikea-teksti: #21532f;
    --mk-kysymys-merkki: #b03a2b;
}

/* --- kortti ja himmennys ------------------------------------------------ */

.mk-kysymys {
    max-height: 100%;
}

.mk-kysymys > .mk-kortti {
    flex-shrink: 1;
    padding: 13px 14px 12px 14px;
}

.mk-kysymys__vieritys {
    flex-shrink: 1;
}

/* --- otsikkorivi (.quiz-head): leima, kaupunki ja tiimalasi --------------- */

.mk-kysymys__paa {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    margin-bottom: 10px;
    padding-bottom: 7px;
    border-bottom-width: 1px;
    border-color: rgba(70, 51, 31, 0.35);
}

.mk-kysymys__paateksti {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    min-height: 30px;
}

.mk-kysymys__leima {
    flex-shrink: 0;
    margin-right: 9px;
    padding: 3px 10px 2px 10px;
    border-width: 1px;
    border-radius: 12px;
    border-color: rgba(70, 51, 31, 0.55);
    font-size: 11px;
    letter-spacing: 18.18px; /* web 2px */
    color: var(--map-ink);
    rotate: -1.5deg;
}

.mk-kysymys__kaupunki {
    flex-shrink: 1;
    font-size: 14.4px;
    white-space: normal;
    color: var(--mk-kysymys-kaupunki);
}

/* --- tiimalasi (.quiz-timer, .hourglass, .quiz-seconds) ------------------- */

.mk-kysymys__aika {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    margin-left: 8px;
}

.mk-kysymys__tiimalasi {
    width: 30px;
    height: 46px;
    rotate: -1.5deg;
    transition-property: rotate;
    transition-duration: 0.7s;
    transition-timing-function: ease-in-out-cubic;
}

/* Uusi kysymys: lasi alkaa ylösalaisin ja kääntyy (hg-turn). */
.mk-kysymys__tiimalasi--ylosalaisin {
    rotate: 178.5deg;
    transition-duration: 0s;
}

.mk-kysymys__sekunnit {
    min-width: 26px;
    margin-left: 5px;
    font-size: 15.7px;
    -unity-text-align: middle-right;
    color: var(--mk-kysymys-kaupunki);
}

.mk-kysymys__aika--kiire .mk-kysymys__sekunnit {
    color: var(--mk-kysymys-merkki);
}

/* --- pulman luonnos (.quiz-sketch) ja selite (.quiz-selite) ---------------- */

.mk-luonnos {
    width: 100%;
    max-width: 340px;
    align-self: center;
    flex-shrink: 0;
    margin-bottom: 10px;
    color: var(--mk-kysymys-muste);
    overflow: hidden;
}

.mk-luonnos__teksti {
    position: absolute;
    width: 400px;
    -unity-text-align: upper-center;
    white-space: nowrap;
    color: var(--mk-kysymys-muste);
}

.mk-kysymys__selite {
    margin: -3px 0 8px 0;
    font-size: 12.8px;
    white-space: normal;
    opacity: 0.75;
    color: var(--map-ink);
}

/* --- valokuva ja lippu (.quiz-photo, #quiz-photo.quiz-lippu) --------------- */

.mk-kysymys__kuvakehys {
    flex-shrink: 0;
    margin: 3px 0 10px 0;
    border-width: 1px;
    border-color: rgba(70, 51, 31, 0.4);
    border-radius: 3px;
}

.mk-kysymys__kuva {
    height: 190px;
    border-width: 4px;
    border-color: #f7efdc;
    border-radius: 3px;
    background-color: rgba(70, 51, 31, 0.08);
    -unity-background-scale-mode: scale-and-crop;
}

.mk-kysymys__kuvakehys--lippu .mk-kysymys__kuva {
    height: 150px;
    border-width: 8px;
    border-color: rgba(252, 241, 212, 0.92);
    background-color: rgba(252, 241, 212, 0.92);
    -unity-background-scale-mode: scale-to-fit;
}

.mk-kysymys__kuvalahde {
    font-size: 10px;
    white-space: normal;
    color: rgba(70, 51, 31, 0.55);
    margin: -6px 0 9px 0;
}

/* --- kehys, kysymys ja vihje ---------------------------------------------- */

.mk-kysymys__kehys {
    font-size: 15px;
    white-space: normal;
    color: var(--mk-kysymys-kaupunki);
    margin-bottom: 6px;
}

.mk-kysymys__kysymys {
    font-size: 16.5px;
    white-space: normal;
    color: var(--map-ink);
    margin-bottom: 11px;
}

/* .quiz-hint-text: kynämerkki ja kursiivi paperilapulla */
.mk-kysymys__vihje {
    flex-direction: row;
    margin: -3px 0 12px 0;
    padding: 8px 12px;
    border-width: 1px;
    border-color: rgba(120, 90, 40, 0.5);
    border-top-left-radius: 12px;
    border-top-right-radius: 8px;
    border-bottom-right-radius: 13px;
    border-bottom-left-radius: 7px;
    background-color: rgba(240, 220, 170, 0.35);
}

.mk-kysymys__vihjemerkki {
    flex-shrink: 0;
    margin-right: 8px;
    font-size: 14.7px;
    opacity: 0.7;
    color: #6b5227;
}

.mk-kysymys__vihjeteksti {
    flex-shrink: 1;
    font-size: 14.7px;
    white-space: normal;
    color: #6b5227;
}

/* --- vaihtoehdot (.quiz-options, .quiz-option, .letter) -------------------- */

.mk-kysymys__vaihtoehdot {
    flex-direction: column;
    flex-shrink: 0;
}

.mk-nappi.mk-kysymys__vaihtoehto {
    flex-direction: row;
    justify-content: flex-start;
    align-items: center;
    min-height: 58px;
    margin-bottom: 7px;
    padding: 8px 12px 8px 11px;
    border-width: 1px;
    border-color: rgba(70, 51, 31, 0.55);
    border-top-left-radius: 14px;
    border-top-right-radius: 10px;
    border-bottom-right-radius: 16px;
    border-bottom-left-radius: 9px;
    background-color: rgba(255, 252, 243, 0.5);
    color: var(--map-ink);
    opacity: 1;
    translate: 0 0;
    transition-property: background-color, border-color, opacity, translate, rotate;
    transition-duration: 0.15s, 0.15s, 0.3s, 0.3s, 0.3s;
    transition-timing-function: ease-out;
}

.mk-nappi.mk-kysymys__vaihtoehto--pariton {
    rotate: -0.4deg;
}

.mk-nappi.mk-kysymys__vaihtoehto--parillinen {
    rotate: 0.4deg;
}

/* option-in: vaihtoehdot liukuvat esiin 70 ms porrastuksella */
.mk-nappi.mk-kysymys__vaihtoehto.mk-kysymys__vaihtoehto--tulossa {
    opacity: 0;
    translate: 0 10px;
    rotate: -1deg;
}

.mk-nappi.mk-kysymys__vaihtoehto:active {
    background-color: rgba(255, 255, 255, 0.85);
}

.mk-nappi.mk-kysymys__vaihtoehto:disabled {
    opacity: 1;
}

/* Leveä ruutu (yli 560 pt, iPad): web .dialog max-width 620px, .quiz-options 2 saraketta, gap 0.6rem. */
.mk-kysymys.mk-kysymys--levea {
    max-width: 620px;
}

.mk-kysymys--levea .mk-kysymys__vaihtoehdot {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
}

.mk-kysymys--levea .mk-nappi.mk-kysymys__vaihtoehto {
    width: 48.7%;
    margin-bottom: 9.6px;
}

.mk-kysymys__vaihtoehdot--tiivis > .mk-nappi.mk-kysymys__vaihtoehto {
    min-height: 48px;
    margin-bottom: 6px;
    padding: 6px 11px 6px 10px;
}

.mk-kysymys__kirjain {
    flex-shrink: 0;
    width: 30px;
    height: 30px;
    margin-right: 11px;
    border-width: 2px;
    border-radius: 15px;
    border-color: var(--map-ink);
    font-size: 15px;
    -unity-text-align: middle-center;
    color: var(--map-ink);
}

.mk-kysymys__vaihtoehtoteksti {
    flex-grow: 1;
    flex-shrink: 1;
    font-size: 16.3px;
    white-space: normal;
    color: var(--map-ink);
}

.mk-kysymys__vaihtoehdot--tiivis .mk-kysymys__vaihtoehtoteksti {
    font-size: 15px;
}

.mk-nappi.mk-kysymys__vaihtoehto.mk-kysymys__vaihtoehto--oikea {
    background-color: rgba(94, 158, 106, 0.32);
    border-color: var(--mk-kysymys-oikea);
}

.mk-kysymys__vaihtoehto--oikea .mk-kysymys__kirjain {
    border-color: var(--mk-kysymys-oikea);
    color: var(--mk-kysymys-oikea-teksti);
}

.mk-nappi.mk-kysymys__vaihtoehto.mk-kysymys__vaihtoehto--vaara {
    background-color: rgba(176, 58, 43, 0.22);
    border-color: var(--mk-kysymys-merkki);
}

/* 50:50:n poistama: haalea ja yliviivattu (.hidden-option) */
.mk-nappi.mk-kysymys__vaihtoehto.mk-kysymys__vaihtoehto--pois:disabled {
    opacity: 0.25;
}

/* .quiz-option.kuvallinen: valokuva vaihtoehdon yläosaan */
.mk-nappi.mk-kysymys__vaihtoehto--kuvallinen {
    flex-direction: column;
    align-items: stretch;
    padding-top: 8px;
}

.mk-kysymys__vaihtoehtokuva {
    height: 118px;
    margin-bottom: 7px;
    border-width: 1px;
    border-radius: 8px;
    border-color: rgba(70, 51, 31, 0.3);
    background-color: rgba(70, 51, 31, 0.08);
    -unity-background-scale-mode: scale-and-crop;
}

.mk-kysymys__vaihtoehtorivi {
    flex-direction: row;
    align-items: center;
}

.mk-kysymys__kuvalahteet {
    margin: 1px 0 4px 0;
    font-size: 10px;
    letter-spacing: 3px; /* web 0.3px */
    white-space: normal;
    color: rgba(70, 51, 31, 0.55);
}

/* --- tulos (.quiz-result, .quiz-verdict, .source-line) --------------------- */

.mk-kysymys__tulos {
    flex-shrink: 0;
    margin: 9px 0 2px 0;
    padding: 10px 13px;
    border-width: 1px;
    border-color: rgba(70, 51, 31, 0.45);
    border-top-left-radius: 14px;
    border-top-right-radius: 10px;
    border-bottom-right-radius: 15px;
    border-bottom-left-radius: 9px;
    background-color: rgba(255, 255, 255, 0.42);
}

.mk-kysymys__tulos--oikein {
    border-color: var(--mk-kysymys-oikea);
}

.mk-kysymys__tulos--vaarin {
    border-color: var(--mk-kysymys-merkki);
}

.mk-kysymys__tuomio {
    font-size: 22px;
    letter-spacing: 3.64px; /* web 0.8px */
    white-space: normal;
    color: var(--map-ink);
    margin-bottom: 4px;
}

.mk-kysymys__tulos--oikein .mk-kysymys__tuomio {
    color: var(--mk-kysymys-oikea-teksti);
}

.mk-kysymys__tulos--vaarin .mk-kysymys__tuomio {
    color: var(--mk-kysymys-merkki);
}

.mk-kysymys__vahva {
    font-size: 16.3px;
    white-space: normal;
    color: var(--map-ink);
    margin-bottom: 2px;
}

.mk-kysymys__fakta {
    font-size: 15.5px;
    white-space: normal;
    color: #6f5836;
    margin-top: 3px;
}

.mk-kysymys__lahde {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    margin-top: 6px;
}

.mk-kysymys__lahdeotsikko {
    margin-right: 5px;
    font-size: 10.9px;
    letter-spacing: 10.09px; /* web 1.1px */
    opacity: 0.75;
    color: var(--mk-kysymys-kaupunki);
}

.mk-kysymys__lahdeteksti {
    font-size: 12.5px;
    white-space: normal;
    color: var(--mk-kysymys-kaupunki);
}

.mk-kysymys__lahdelinkki {
    border-bottom-width: 1px;
    border-color: rgba(122, 96, 57, 0.6);
}

/* --- hetkellinen viesti ja napit (menu, .lifeline, .primary) ---------------- */

.mk-kysymys__viesti {
    flex-shrink: 0;
    margin-top: 7px;
    font-size: 14px;
    white-space: normal;
    -unity-text-align: middle-center;
    color: var(--mk-kysymys-merkki);
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.25s;
}

.mk-kysymys__viesti.mk-auki {
    opacity: 1;
}

.mk-kysymys__napit {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: flex-end;
    align-items: center;
    flex-shrink: 0;
    margin-top: 10px;
}

.mk-kysymys__napit > .mk-nappi {
    margin-left: 8px;
    margin-top: 4px;
}

.mk-kysymys__napit > .mk-kysymys__vihjenappi {
    margin-left: 0;
    margin-right: auto;
}

.mk-nappi.mk-kysymys__apu {
    min-height: 44px;
    padding: 6px 12px;
    border-width: 1px;
    border-color: rgba(70, 51, 31, 0.5);
    border-top-left-radius: 13px;
    border-top-right-radius: 9px;
    border-bottom-right-radius: 14px;
    border-bottom-left-radius: 8px;
    background-color: rgba(255, 252, 243, 0.42);
    color: var(--map-ink);
}

.mk-nappi.mk-kysymys__apu:active {
    background-color: rgba(255, 255, 255, 0.6);
}

.mk-nappi.mk-kysymys__apu:disabled {
    opacity: 0.4;
}

.mk-kysymys__apu .mk-nappi__teksti {
    font-size: 13.6px;
}

.mk-kysymys__apu > .mk-ikoni {
    width: 17px;
    height: 17px;
    margin-right: 6px;
    color: var(--map-ink);
}

/* .dialog button.primary: linear-gradient(#e9c169, #d3a03c), reuna #7a5a12 */
.mk-nappi.mk-kysymys__jatka {
    min-height: 46px;
    padding: 8px 18px;
    border-color: #7a5a12;
    border-top-left-radius: 14px;
    border-top-right-radius: 10px;
    border-bottom-right-radius: 15px;
    border-bottom-left-radius: 9px;
    color: #33240a;
}

.mk-kysymys__jatka .mk-nappi__teksti {
    font-size: 16px;
}

/* --- kohtaaminen (erä 4): .quiz-kohtaaminen-kuvio, .quiz-kohtaaminen,
 *     .quiz-varoitus, .quiz-aloita, .quiz.kysymysvaihe ---------------------- */

.mk-kysymys__muotokuva {
    flex-shrink: 0;
    margin: 2px 0 9px 0;
}

/* Iso kuva tervehdyssivulla: kuvasuhde säilyy (contain), katto ~41 % ruudusta. */
.mk-kysymys__muotokuvakuva {
    height: 220px;
    -unity-background-scale-mode: scale-to-fit;
}

/* Kysymyssivulla pieni pyöristetty neliö: muistutus siitä, kuka kysyy. */
.mk-kysymys__muotokuva--pieni {
    align-self: flex-start;
    margin: 0 0 7px 0;
}

.mk-kysymys__muotokuva--pieni > .mk-kysymys__muotokuvakuva {
    width: 104px;
    height: 104px;
    border-radius: 12px;
    border-width: 1px;
    border-color: rgba(52, 36, 16, 0.28);
    background-color: rgba(70, 51, 31, 0.08);
    -unity-background-scale-mode: scale-and-crop;
}

.mk-kysymys__muotokuvateksti {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: flex-end;
    margin-top: 5px;
}

.mk-kysymys__muotokuvaselite {
    margin-right: 6px;
    font-size: 12.8px;
    white-space: normal;
    color: rgba(58, 42, 22, 0.9);
}

.mk-kysymys__muotokuvalahde {
    font-size: 10px;
    letter-spacing: 3px; /* web 0.3px */
    color: rgba(70, 51, 31, 0.55);
}

.mk-kysymys__tervehdys {
    margin: 5px 0 9px 0;
    font-size: 15.2px;
    white-space: normal;
    color: rgba(58, 42, 22, 0.95);
}

.mk-kysymys__varoitus {
    flex-shrink: 0;
    margin: 6px 0 3px 0;
    padding: 7px 11px;
    border-left-width: 3px;
    border-color: rgba(150, 58, 34, 0.75);
    border-top-right-radius: 6px;
    border-bottom-right-radius: 6px;
    background-color: rgba(150, 58, 34, 0.08);
}

.mk-kysymys__varoitusteksti {
    font-size: 14.7px;
    white-space: normal;
    color: rgba(112, 42, 24, 0.95);
}

.mk-kysymys__napit--keski {
    justify-content: center;
}

.mk-kysymys__napit--keski > .mk-nappi {
    margin-left: 0;
}

.mk-nappi.mk-kysymys__aloita {
    min-width: 180px;
}

/* --- paljastus: löydön kuva, ohjeet ja repliikki (.quiz-result, aarreIkoni,
 *     .quiz-uusi-yritys, .kohtaaminen-repliikki) ------------------------------ */

.mk-kysymys__tulos--paljastus {
    flex-direction: row;
    align-items: flex-start;
}

.mk-kysymys__tulosrunko {
    flex-grow: 1;
    flex-shrink: 1;
}

.mk-laattaikoni {
    flex-shrink: 0;
    width: 56px;
    height: 56px;
    margin: 2px 10px 0 0;
}

/* Tarinallinen aarrekuva pyöreäksi rajattuna (.aarre-ikoni). */
.mk-laattaikoni__kuva {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    border-radius: 28px;
    border-width: 2px;
    border-color: rgba(70, 51, 31, 0.35);
    -unity-background-scale-mode: scale-and-crop;
}

.mk-laattaikoni__pollo {
    width: 56px;
    height: 56px;
    --mk-ikoni-viiva: 1.5;
}

.mk-kysymys__ohje {
    margin: 5px 0 2px 0;
    font-size: 14.4px;
    white-space: normal;
    color: rgba(112, 42, 24, 0.95);
}

.mk-kysymys__repliikki {
    margin-top: 5px;
    font-size: 14.7px;
    white-space: normal;
    color: var(--map-ink);
}

/* --- löydön fakta ja kätkökuva (erä 5: LoytoFakta, KatkoKuvaUrl; .katko-kuva) --- */

.mk-kysymys__loytofakta {
    margin: 2px 0 3px 0;
    font-size: 13.6px;
    white-space: normal;
    color: #6f5836;
}

.mk-kysymys__katko {
    align-self: center;
    width: 55%;
    max-width: 170px;
    height: 120px;
    margin: 9px 0 5px 0;
    -unity-background-scale-mode: scale-to-fit;
}

.mk-kysymys__vihjemerkki.mk-ikoni {
    width: 16px;
    height: 16px;
    --mk-ikoni-viiva: 1.6;
}

/* --- Aarteen paljastus (Paljastus.cs; webin .reveal-overlay, .reveal-*) ---------------- */

.mk-paljastus {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    padding: 20px;
    background-color: rgba(11, 8, 5, 0.97);
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.25s;
}

.mk-paljastus.mk-auki {
    opacity: 1;
}

.mk-paljastus--paikallis {
    padding: 0;
    background-color: #e6d8ae;
}

.mk-paljastus__scene {
    align-items: center;
    max-width: 480px;
    width: 100%;
}

.mk-paljastus__tunnus {
    align-items: center;
    margin-bottom: 14px;
    opacity: 0;
    translate: 0 -8px;
    transition-property: opacity, translate;
    transition-duration: 0.9s;
}

/* Kuva ja luettelon nimiö nousevat 0,42 s taustan jälkeen (web pohja/kuva .shown). */
.mk-paljastus.mk-kuva .mk-paljastus__tunnus {
    opacity: 1;
    translate: 0 0;
}

.mk-paljastus__otsake {
    font-size: 14px;
    letter-spacing: 25.71px; /* web 3.6px */
    color: #e8c98a;
}

.mk-paljastus__viiva {
    width: 58px;
    height: 1px;
    margin: 6px 0;
}

.mk-paljastus__alaotsake {
    font-size: 11.5px;
    letter-spacing: 20px; /* web 2.3px */
    color: #bda87e;
}

.mk-paljastus__kuvapaikka {
    width: 300px;
    height: 300px;
    max-width: 76%;
    align-items: center;
    justify-content: center;
    opacity: 0;
    scale: 0.86 0.86;
    transition-property: opacity, scale;
    transition-duration: 0.9s;
    transition-timing-function: ease-out;
}

.mk-paljastus.mk-kuva .mk-paljastus__kuvapaikka {
    opacity: 1;
    scale: 1 1;
}

.mk-paljastus__kuva {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    -unity-background-scale-mode: scale-to-fit;
}

/* Reunat häipyvät taustaan (webin mask-image). */
.mk-paljastus__reuna {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    -unity-background-image-tint-color: rgb(11, 8, 5);
}

.mk-paljastus--paikallis .mk-paljastus__reuna {
    -unity-background-image-tint-color: #e6d8ae;
}

.mk-paljastus__varaikoni {
    width: 55%;
    height: 55%;
}

.mk-paljastus__caption {
    align-items: center;
    margin-top: 12px;
    opacity: 0;
    translate: 0 10px;
    transition-property: opacity, translate;
    transition-duration: 0.35s;
}

.mk-paljastus.mk-nakyy .mk-paljastus__caption,
.mk-paljastus.mk-nakyy .mk-paljastus__loyto {
    opacity: 1;
    translate: 0 0;
}

.mk-paljastus__nimi {
    font-size: 20px;
    letter-spacing: 5px; /* web 1px */
    white-space: normal;
    -unity-text-align: middle-center;
    color: #f4e7ca;
}

.mk-paljastus__palkkio {
    margin-top: 3.2px;
    font-size: 15.68px;
    color: #d9c9a4;
}

/* HAVAINNEKUVA-merkki (web #3438 .kuvateksti-havainne.reveal-havainne): kirjoituskone 0,68 em = 10,88 px, versaali,
 * harvennus 0,08 em, täyte 0 / 0,35 em, reunus 1 px, pyöristys 3, oma rivi keskellä 0,55 em tekstien alla.
 * Tummalla rgba(217, 201, 164, .78) / reunus .35; paikallismallin vaalealla rgba(70, 51, 31, .72) / .28 — sRGB-yhdistelminä
 * taustojen rgb(11, 8, 5) ja #e6d8ae päällä (lineaarinen väriavaruus vaalentaisi alfan, vrt. Kartta.uss .mk-nosto__havainne). */
.mk-paljastus__havainne {
    align-self: center;
    margin-top: 5.98px;
    padding: 0 3.81px;
    height: 17px;
    font-size: 10.88px;
    letter-spacing: 9.53px; /* web 0.87px */
    color: rgb(172, 159, 129);
    border-width: 1px;
    border-color: rgb(83, 76, 61);
    border-radius: 3px;
    -unity-text-align: middle-center;
    white-space: nowrap;
}

.mk-paljastus--paikallis .mk-paljastus__havainne {
    color: rgb(115, 97, 71);
    border-color: rgb(185, 170, 134);
}

.mk-paljastus__fakta {
    margin-top: 11.2px;
    max-width: 432px;
    font-size: 15.68px;
    -unity-font-style: italic;
    white-space: normal;
    -unity-text-align: middle-center;
    color: #cbb992;
}

.mk-paljastus--paikallis .mk-paljastus__nimi {
    color: #2f2008;
}

.mk-paljastus--paikallis .mk-paljastus__palkkio {
    color: #574430;
}

/* Kaaren aarreteksti ja pöllön esittely (web .reveal-isoisa). */
.mk-paljastus__isoisa {
    margin-top: 26.9px;
    max-width: 416px;
    font-size: 16px;
    -unity-font-style: italic;
    white-space: normal;
    -unity-text-align: middle-center;
    color: #cbb992;
}

.mk-paljastus--paikallis .mk-paljastus__fakta,
.mk-paljastus--paikallis .mk-paljastus__isoisa {
    color: #443520;
}

.mk-paljastus__loyto {
    align-items: center;
    margin-top: 12px;
    opacity: 0;
    translate: 0 10px;
    transition-property: opacity, translate;
    transition-duration: 0.35s;
}

.mk-paljastus__arvo {
    font-size: 14px;
    letter-spacing: 15.71px; /* web 2.2px */
    color: #e0be7c;
    margin-bottom: 10px;
}

/* LÖYDETTY-leima (web .reveal-leima.tumma): lyödään isosta pienempään (leima-lyonti 0,4 s). */
.mk-paljastus__leima {
    align-items: center;
    padding: 4px 14px 3px 14px;
    border-width: 3px;
    border-color: #b8412e;
    border-radius: 6px;
    rotate: -14deg;
    opacity: 0;
    scale: 2.2 2.2;
    transition-property: opacity, scale;
    transition-duration: 0.4s;
    transition-timing-function: ease-out-back;
}

.mk-paljastus.mk-lyoty .mk-paljastus__leima {
    opacity: 0.82;
    scale: 1 1;
}

.mk-paljastus__leimateksti {
    font-size: 15px;
    letter-spacing: 20px; /* web 3px */
    -unity-text-align: middle-center;
    color: #e2664c;
}

.mk-paljastus__leimapvm {
    margin-top: 1px;
    font-size: 8.5px;
    letter-spacing: 29.41px; /* web 2.5px */
    -unity-text-align: middle-center;
    color: #e2664c;
}

.mk-paljastus__jatka {
    margin-top: 18px;
    min-height: 48px;
    padding: 10.88px 35.2px;
    border-width: 1px;
    border-color: rgba(228, 196, 128, 0.62);
    border-radius: 3px;
    background-color: rgba(214, 168, 62, 0.16);
    color: #f4e3b6;
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.4s;
}

/* Jatka matkaa näkyviin vasta, kun kortti odottaa pelaajaa (web .reveal-jatka.nakyy). */
.mk-paljastus.mk-jatka .mk-paljastus__jatka {
    opacity: 1;
}

/* Web .reveal-jatka: 14,72 px, letter-spacing 0,2 em (2,944) ja yhtä suuri text-indent. */
.mk-paljastus__jatka .mk-nappi__teksti {
    font-size: 14.72px;
    letter-spacing: 20px; /* web 2.944px */
    padding-left: 2.944px;
}

.mk-paljastus--paikallis .mk-paljastus__jatka {
    background-color: #3b2a12;
    border-color: rgba(228, 196, 128, 0.7);
}

/* --- kaveriapu (web css/sahke.css 3: .sahke-apukortti, .quiz-option.sahke-veikattu) ------- */

.mk-kysymys__apukortti {
    margin: 6px 0 10px 0;
    padding: 9px 11px;
    border-width: 1px;
    border-color: rgba(122, 85, 20, 0.45);
    border-radius: 7px;
    background-color: rgba(247, 242, 228, 0.5);
}

.mk-kysymys__apusaate {
    font-size: 14px;
    white-space: normal;
}

.mk-kysymys__apuveikkaus {
    margin-top: 5px;
    font-size: 15px;
    white-space: normal;
}

.mk-kysymys__apualarivi {
    margin-top: 5px;
    font-size: 12.5px;
    opacity: 0.8;
    white-space: normal;
}

.mk-kysymys__apunappi {
    align-self: flex-start;
    min-height: 36px;
    margin-top: 7px;
    padding: 4px 14px;
    border-width: 1px;
    border-color: rgba(122, 85, 20, 0.45);
    border-radius: 18px;
    background-color: rgba(255, 252, 242, 0.7);
    color: #46331f;
}

.mk-kysymys__vaihtoehto--veikattu {
    border-width: 2px;
    border-color: #8a6a1f;
}
