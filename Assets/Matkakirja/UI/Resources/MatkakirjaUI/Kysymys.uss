/* KYSYMYSNÄKYMÄ (Natiivi-UI, erä 3): verkkopelin #quiz-dialog (css/styles.css
 * "--- tietovisa ---", .quiz-option, .quiz-result, .lifeline, tiimalasi,
 * .quiz-hint-text, .quiz-sketch, .quiz-photo).
 * Mitat puhelimen mukaan: styles.css:n @media (max-width: 560px) ja
 * (pointer: coarse) -säännöt (yksi sarake, isot vaihtoehtonapit).
 * USS:ssä ei ole elliptisiä kulmasäteitä (86px 14px 92px 12px / 12px 92px …),
 * joten käsin piirretty kulma tehdään kulmakohtaisilla säteillä; yliviivaus
 * (text-decoration) tulee koodista rich text -tagina <s>.
 */

:root {
    --mk-kysymys-muste: #3b2a18;
    --mk-kysymys-kaupunki: #7a6039;
    --mk-kysymys-oikea: #2f6b3f;
    --mk-kysymys-oikea-teksti: #21532f;
    --mk-kysymys-merkki: #b03a2b;
}

/* --- kortti ja himmennys ------------------------------------------------ */

.mk-kysymys {
    max-height: 100%;
}

.mk-kysymys > .mk-kortti {
    flex-shrink: 1;
    padding: 13px 14px 12px 14px;
}

.mk-kysymys__vieritys {
    flex-shrink: 1;
}

/* --- otsikkorivi (.quiz-head): leima, kaupunki ja tiimalasi --------------- */

.mk-kysymys__paa {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    margin-bottom: 10px;
    padding-bottom: 7px;
    border-bottom-width: 1px;
    border-color: var(--map-ink-35);
}

.mk-kysymys__paateksti {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    min-height: 30px;
}

.mk-kysymys__leima {
    flex-shrink: 0;
    margin-right: 9px;
    padding: 3px 10px 2px 10px;
    border-width: 1px;
    border-radius: var(--tk-kulma-pieni);
    border-color: var(--map-ink-55);
    font-size: 11px;
    letter-spacing: 18.18px; /* web 2px */
    color: var(--map-ink);
    rotate: -1.5deg;
}

.mk-kysymys__kaupunki {
    flex-shrink: 1;
    font-size: var(--tk-koko-apuri);
    white-space: normal;
    color: var(--mk-kysymys-kaupunki);
}

/* --- tiimalasi (.quiz-timer, .hourglass, .quiz-seconds) ------------------- */

.mk-kysymys__aika {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    margin-left: 8px;
}

.mk-kysymys__tiimalasi {
    width: 30px;
    height: 46px;
    rotate: -1.5deg;
    transition-property: rotate;
    transition-duration: 0.7s; /* ympäristöanimaatio (pohjavahdin poikkeus 8.10.) */
    transition-timing-function: ease-in-out-cubic;
}

/* Uusi kysymys: lasi alkaa ylösalaisin ja kääntyy (hg-turn). */
.mk-kysymys__tiimalasi--ylosalaisin {
    rotate: 178.5deg;
    transition-duration: 0s;
}

.mk-kysymys__sekunnit {
    min-width: 26px;
    margin-left: 5px;
    font-size: var(--tk-koko-leipa);
    -unity-text-align: middle-right;
    color: var(--mk-kysymys-kaupunki);
}

.mk-kysymys__aika--kiire .mk-kysymys__sekunnit {
    color: var(--mk-kysymys-merkki);
}

/* --- pulman luonnos (.quiz-sketch) ja selite (.quiz-selite) ---------------- */

.mk-luonnos {
    width: 100%;
    max-width: 340px;
    align-self: center;
    flex-shrink: 0;
    margin-bottom: 10px;
    color: var(--mk-kysymys-muste);
    overflow: hidden;
}

.mk-luonnos__teksti {
    position: absolute;
    width: 400px;
    -unity-text-align: upper-center;
    white-space: nowrap;
    color: var(--mk-kysymys-muste);
}

.mk-kysymys__selite {
    margin: -3px 0 8px 0;
    font-size: 12.8px;
    white-space: normal;
    opacity: 0.75;
    color: var(--map-ink);
}

/* --- valokuva ja lippu (.quiz-photo, #quiz-photo.quiz-lippu) --------------- */

.mk-kysymys__kuvakehys {
    flex-shrink: 0;
    margin: 3px 0 10px 0;
    border-width: 1px;
    border-color: var(--map-ink-40);
    border-radius: var(--tk-kulma-hius);
}

.mk-kysymys__kuva {
    height: 190px;
    border-width: 4px;
    border-color: var(--tk-paperi-pinta);
    border-radius: var(--tk-kulma-hius);
    background-color: var(--map-ink-08);
    -unity-background-scale-mode: scale-and-crop;
}

.mk-kysymys__kuvakehys--lippu .mk-kysymys__kuva {
    height: 150px;
    border-width: 8px;
    border-color: var(--tk-kuulto-kerma-92);
    background-color: var(--tk-kuulto-kerma-92);
    -unity-background-scale-mode: scale-to-fit;
}

.mk-kysymys__kuvalahde {
    font-size: 10px; /* fonttipoikkeus: 10 px, lähin asteikon koko 12 px (ero 2 px näkyisi; Päätoimittaja 8.10.2026) */
    white-space: normal;
    color: var(--map-ink-55);
    margin: -6px 0 9px 0;
}

/* --- kehys, kysymys ja vihje ---------------------------------------------- */

.mk-kysymys__kehys {
    font-size: 15px;
    white-space: normal;
    color: var(--mk-kysymys-kaupunki);
    margin-bottom: 6px;
}

.mk-kysymys__kysymys {
    font-size: var(--tk-koko-leipa);
    white-space: normal;
    color: var(--map-ink);
    margin-bottom: 11px;
}

/* .quiz-hint-text: kynämerkki ja kursiivi paperilapulla */
.mk-kysymys__vihje {
    flex-direction: row;
    margin: -3px 0 12px 0;
    padding: 8px 12px;
    border-width: 1px;
    border-color: var(--tk-kuulto-paperi-korostus-50);
    border-top-left-radius: var(--tk-kulma-kortti);
    border-top-right-radius: var(--tk-kulma-keski);
    border-bottom-right-radius: var(--tk-kulma-kortti);
    border-bottom-left-radius: var(--tk-kulma-pieni);
    background-color: var(--tk-kuulto-paperi-pergamentti-35);
}

.mk-kysymys__vihjemerkki {
    flex-shrink: 0;
    margin-right: 8px;
    font-size: 14.7px;
    opacity: 0.7;
    color: var(--raja-muste);
}

.mk-kysymys__vihjeteksti {
    flex-shrink: 1;
    font-size: 14.7px;
    white-space: normal;
    color: var(--raja-muste);
}

/* --- vaihtoehdot (.quiz-options, .quiz-option, .letter) -------------------- */

.mk-kysymys__vaihtoehdot {
    flex-direction: column;
    flex-shrink: 0;
}

.mk-nappi.mk-kysymys__vaihtoehto {
    flex-direction: row;
    justify-content: flex-start;
    align-items: center;
    min-height: 58px;
    margin-bottom: 7px;
    padding: 8px 12px 8px 11px;
    border-width: 1px;
    border-color: var(--map-ink-55);
    border-top-left-radius: 14px;
    border-top-right-radius: var(--tk-kulma-nappi);
    border-bottom-right-radius: 16px;
    border-bottom-left-radius: var(--tk-kulma-keski);
    background-color: var(--tk-kuulto-paperi-pinta-50);
    color: var(--map-ink);
    opacity: 1;
    translate: 0 0;
    transition-property: background-color, border-color, opacity, translate, rotate;
    transition-duration: 0.15s, 0.15s, 0.22s, 0.22s, 0.22s; /* UI-siirtymä ≤ 250 ms (pohjavahti 8.10., oli 0.15s, 0.15s, 0.3s, 0.3s, 0.3s) */
    transition-timing-function: ease-out;
}

.mk-nappi.mk-kysymys__vaihtoehto--pariton {
    rotate: -0.4deg;
}

.mk-nappi.mk-kysymys__vaihtoehto--parillinen {
    rotate: 0.4deg;
}

/* option-in: vaihtoehdot liukuvat esiin 70 ms porrastuksella */
.mk-nappi.mk-kysymys__vaihtoehto.mk-kysymys__vaihtoehto--tulossa {
    opacity: 0;
    translate: 0 10px;
    rotate: -1deg;
}

.mk-nappi.mk-kysymys__vaihtoehto:active {
    background-color: var(--tk-kuulto-valkoinen-85);
}

.mk-nappi.mk-kysymys__vaihtoehto:disabled {
    opacity: 1;
}

/* Leveä ruutu (yli 560 pt, iPad): web .dialog max-width 620px, .quiz-options 2 saraketta, gap 0.6rem. */
.mk-kysymys.mk-kysymys--levea {
    max-width: 620px;
}

.mk-kysymys--levea .mk-kysymys__vaihtoehdot {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
}

.mk-kysymys--levea .mk-nappi.mk-kysymys__vaihtoehto {
    width: 48.7%;
    margin-bottom: 9.6px;
}

.mk-kysymys__vaihtoehdot--tiivis > .mk-nappi.mk-kysymys__vaihtoehto {
    min-height: 48px;
    margin-bottom: 6px;
    padding: 6px 11px 6px 10px;
}

.mk-kysymys__kirjain {
    flex-shrink: 0;
    width: 30px;
    height: 30px;
    margin-right: 11px;
    border-width: 2px;
    border-radius: 15px;
    border-color: var(--map-ink);
    font-size: 15px;
    -unity-text-align: middle-center;
    color: var(--map-ink);
}

.mk-kysymys__vaihtoehtoteksti {
    flex-grow: 1;
    flex-shrink: 1;
    font-size: var(--tk-koko-leipa);
    white-space: normal;
    color: var(--map-ink);
}

.mk-kysymys__vaihtoehdot--tiivis .mk-kysymys__vaihtoehtoteksti {
    font-size: 15px;
}

.mk-nappi.mk-kysymys__vaihtoehto.mk-kysymys__vaihtoehto--oikea {
    background-color: var(--tk-erikois-muu-6-a32);
    border-color: var(--mk-kysymys-oikea);
}

.mk-kysymys__vaihtoehto--oikea .mk-kysymys__kirjain {
    border-color: var(--mk-kysymys-oikea);
    color: var(--mk-kysymys-oikea-teksti);
}

.mk-nappi.mk-kysymys__vaihtoehto.mk-kysymys__vaihtoehto--vaara {
    background-color: var(--tk-kuulto-mark-22);
    border-color: var(--mk-kysymys-merkki);
}

/* 50:50:n poistama: haalea ja yliviivattu (.hidden-option) */
.mk-nappi.mk-kysymys__vaihtoehto.mk-kysymys__vaihtoehto--pois:disabled {
    opacity: 0.25;
}

/* .quiz-option.kuvallinen: valokuva vaihtoehdon yläosaan */
.mk-nappi.mk-kysymys__vaihtoehto--kuvallinen {
    flex-direction: column;
    align-items: stretch;
    padding-top: 8px;
}

.mk-kysymys__vaihtoehtokuva {
    height: 118px;
    margin-bottom: 7px;
    border-width: 1px;
    border-radius: var(--tk-kulma-keski);
    border-color: var(--tk-paperi-reunus);
    background-color: var(--map-ink-08);
    -unity-background-scale-mode: scale-and-crop;
}

.mk-kysymys__vaihtoehtorivi {
    flex-direction: row;
    align-items: center;
}

.mk-kysymys__kuvalahteet {
    margin: 1px 0 4px 0;
    font-size: 10px; /* fonttipoikkeus: 10 px, lähin asteikon koko 12 px (ero 2 px näkyisi; Päätoimittaja 8.10.2026) */
    letter-spacing: 3px; /* web 0.3px */
    white-space: normal;
    color: var(--map-ink-55);
}

/* --- tulos (.quiz-result, .quiz-verdict, .source-line) --------------------- */

.mk-kysymys__tulos {
    flex-shrink: 0;
    margin: 9px 0 2px 0;
    padding: 10px 13px;
    border-width: 1px;
    border-color: var(--map-ink-45);
    border-top-left-radius: 14px;
    border-top-right-radius: var(--tk-kulma-nappi);
    border-bottom-right-radius: 15px;
    border-bottom-left-radius: var(--tk-kulma-keski);
    background-color: var(--tk-kuulto-valkoinen-42);
}

.mk-kysymys__tulos--oikein {
    border-color: var(--mk-kysymys-oikea);
}

.mk-kysymys__tulos--vaarin {
    border-color: var(--mk-kysymys-merkki);
}

.mk-kysymys__tuomio {
    font-size: 22px;
    letter-spacing: 3.64px; /* web 0.8px */
    white-space: normal;
    color: var(--map-ink);
    margin-bottom: 4px;
}

.mk-kysymys__tulos--oikein .mk-kysymys__tuomio {
    color: var(--mk-kysymys-oikea-teksti);
}

.mk-kysymys__tulos--vaarin .mk-kysymys__tuomio {
    color: var(--mk-kysymys-merkki);
}

.mk-kysymys__vahva {
    font-size: var(--tk-koko-leipa);
    white-space: normal;
    color: var(--map-ink);
    margin-bottom: 2px;
}

.mk-kysymys__fakta {
    font-size: var(--tk-koko-leipa);
    white-space: normal;
    color: var(--raja-muste);
    margin-top: 3px;
}

.mk-kysymys__lahde {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    margin-top: 6px;
}

.mk-kysymys__lahdeotsikko {
    margin-right: 5px;
    font-size: 10.9px;
    letter-spacing: 10.09px; /* web 1.1px */
    opacity: 0.75;
    color: var(--mk-kysymys-kaupunki);
}

.mk-kysymys__lahdeteksti {
    font-size: var(--tk-koko-kapiteeli);
    white-space: normal;
    color: var(--mk-kysymys-kaupunki);
}

.mk-kysymys__lahdelinkki {
    border-bottom-width: 1px;
    border-color: var(--tk-kuulto-map-ink-soft-60);
}

/* --- hetkellinen viesti ja napit (menu, .lifeline, .primary) ---------------- */

.mk-kysymys__viesti {
    flex-shrink: 0;
    margin-top: 7px;
    font-size: var(--tk-koko-apuri);
    white-space: normal;
    -unity-text-align: middle-center;
    color: var(--mk-kysymys-merkki);
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.25s;
}

.mk-kysymys__viesti.mk-auki {
    opacity: 1;
}

.mk-kysymys__napit {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: flex-end;
    align-items: center;
    flex-shrink: 0;
    margin-top: 10px;
}

.mk-kysymys__napit > .mk-nappi {
    margin-left: 8px;
    margin-top: 4px;
}

.mk-kysymys__napit > .mk-kysymys__vihjenappi {
    margin-left: 0;
    margin-right: auto;
}

.mk-nappi.mk-kysymys__apu {
    min-height: 44px;
    padding: 6px 12px;
    border-width: 1px;
    border-color: var(--map-ink-50);
    border-top-left-radius: var(--tk-kulma-kortti);
    border-top-right-radius: var(--tk-kulma-keski);
    border-bottom-right-radius: 14px;
    border-bottom-left-radius: var(--tk-kulma-keski);
    background-color: var(--tk-kuulto-paperi-pinta-42);
    color: var(--map-ink);
}

.mk-nappi.mk-kysymys__apu:active {
    background-color: var(--tk-kuulto-valkoinen-60);
}

.mk-nappi.mk-kysymys__apu:disabled {
    opacity: 0.4;
}

.mk-kysymys__apu .mk-nappi__teksti {
    font-size: var(--tk-koko-apuri);
}

.mk-kysymys__apu > .mk-ikoni {
    width: 17px;
    height: 17px;
    margin-right: 6px;
    color: var(--map-ink);
}

/* .dialog button.primary: linear-gradient(#e9c169, #d3a03c), reuna #7a5a12 */
.mk-nappi.mk-kysymys__jatka {
    min-height: 46px;
    padding: 8px 18px;
    border-color: var(--tk-paperi-korostus);
    border-top-left-radius: 14px;
    border-top-right-radius: var(--tk-kulma-nappi);
    border-bottom-right-radius: 15px;
    border-bottom-left-radius: var(--tk-kulma-keski);
    color: var(--tk-lasi-pinta-peitto);
}

.mk-kysymys__jatka .mk-nappi__teksti {
    font-size: var(--tk-koko-leipa);
}

/* --- kohtaaminen (erä 4): .quiz-kohtaaminen-kuvio, .quiz-kohtaaminen,
 *     .quiz-varoitus, .quiz-aloita, .quiz.kysymysvaihe ---------------------- */

.mk-kysymys__muotokuva {
    flex-shrink: 0;
    margin: 2px 0 9px 0;
}

/* Iso kuva tervehdyssivulla: kuvasuhde säilyy (contain), katto ~41 % ruudusta. */
.mk-kysymys__muotokuvakuva {
    height: 220px;
    -unity-background-scale-mode: scale-to-fit;
}

/* Kysymyssivulla pieni pyöristetty neliö: muistutus siitä, kuka kysyy. */
.mk-kysymys__muotokuva--pieni {
    align-self: flex-start;
    margin: 0 0 7px 0;
}

.mk-kysymys__muotokuva--pieni > .mk-kysymys__muotokuvakuva {
    width: 104px;
    height: 104px;
    border-radius: var(--tk-kulma-kortti);
    border-width: 1px;
    border-color: var(--map-ink-30);
    background-color: var(--map-ink-08);
    -unity-background-scale-mode: scale-and-crop;
}

.mk-kysymys__muotokuvateksti {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: flex-end;
    margin-top: 5px;
}

.mk-kysymys__muotokuvaselite {
    margin-right: 6px;
    font-size: 12.8px;
    white-space: normal;
    color: var(--map-ink-90);
}

.mk-kysymys__muotokuvalahde {
    font-size: 10px; /* fonttipoikkeus: 10 px, lähin asteikon koko 12 px (ero 2 px näkyisi; Päätoimittaja 8.10.2026) */
    letter-spacing: 3px; /* web 0.3px */
    color: var(--map-ink-55);
}

.mk-kysymys__tervehdys {
    margin: 5px 0 9px 0;
    font-size: 15.2px;
    white-space: normal;
    color: var(--map-ink-95);
}

.mk-kysymys__varoitus {
    flex-shrink: 0;
    margin: 6px 0 3px 0;
    padding: 7px 11px;
    border-left-width: 3px;
    border-color: var(--tk-erikois-tila-5-a75);
    border-top-right-radius: var(--tk-kulma-pieni);
    border-bottom-right-radius: var(--tk-kulma-pieni);
    background-color: var(--map-ink-06);
}

.mk-kysymys__varoitusteksti {
    font-size: 14.7px;
    white-space: normal;
    color: var(--tk-erikois-tila-1-a95);
}

.mk-kysymys__napit--keski {
    justify-content: center;
}

.mk-kysymys__napit--keski > .mk-nappi {
    margin-left: 0;
}

.mk-nappi.mk-kysymys__aloita {
    min-width: 180px;
}

/* --- paljastus: löydön kuva, ohjeet ja repliikki (.quiz-result, aarreIkoni,
 *     .quiz-uusi-yritys, .kohtaaminen-repliikki) ------------------------------ */

.mk-kysymys__tulos--paljastus {
    flex-direction: row;
    align-items: flex-start;
}

.mk-kysymys__tulosrunko {
    flex-grow: 1;
    flex-shrink: 1;
}

.mk-laattaikoni {
    flex-shrink: 0;
    width: 56px;
    height: 56px;
    margin: 2px 10px 0 0;
}

/* Tarinallinen aarrekuva pyöreäksi rajattuna (.aarre-ikoni). */
.mk-laattaikoni__kuva {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    border-radius: 28px;
    border-width: 2px;
    border-color: var(--map-ink-35);
    -unity-background-scale-mode: scale-and-crop;
}

.mk-laattaikoni__pollo {
    width: 56px;
    height: 56px;
    --mk-ikoni-viiva: 1.5;
}

.mk-kysymys__ohje {
    margin: 5px 0 2px 0;
    font-size: var(--tk-koko-apuri);
    white-space: normal;
    color: var(--tk-erikois-muu-2-a95);
}

.mk-kysymys__repliikki {
    margin-top: 5px;
    font-size: 14.7px;
    white-space: normal;
    color: var(--map-ink);
}

/* --- löydön fakta ja kätkökuva (erä 5: LoytoFakta, KatkoKuvaUrl; .katko-kuva) --- */

.mk-kysymys__loytofakta {
    margin: 2px 0 3px 0;
    font-size: var(--tk-koko-apuri);
    white-space: normal;
    color: var(--raja-muste);
}

.mk-kysymys__katko {
    align-self: center;
    width: 55%;
    max-width: 170px;
    height: 120px;
    margin: 9px 0 5px 0;
    -unity-background-scale-mode: scale-to-fit;
}

.mk-kysymys__vihjemerkki.mk-ikoni {
    width: 16px;
    height: 16px;
    --mk-ikoni-viiva: 1.6;
}

/* --- Aarteen paljastus (Paljastus.cs; webin .reveal-overlay, .reveal-*) ---------------- */

.mk-paljastus {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    padding: 20px;
    background-color: var(--tk-himmennys-kuva);
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.25s;
}

.mk-paljastus.mk-auki {
    opacity: 1;
}

.mk-paljastus--paikallis {
    padding: 0;
    background-color: var(--tk-paperi-pergamentti);
}

.mk-paljastus__scene {
    align-items: center;
    max-width: 480px;
    width: 100%;
}

.mk-paljastus__tunnus {
    align-items: center;
    margin-bottom: 14px;
    opacity: 0;
    translate: 0 -8px;
    transition-property: opacity, translate;
    transition-duration: 0.9s; /* ympäristöanimaatio (pohjavahdin poikkeus 8.10.) */
}

/* Kuva ja luettelon nimiö nousevat 0,42 s taustan jälkeen (web pohja/kuva .shown). */
.mk-paljastus.mk-kuva .mk-paljastus__tunnus {
    opacity: 1;
    translate: 0 0;
}

.mk-paljastus__otsake {
    font-size: var(--tk-koko-apuri);
    letter-spacing: 25.71px; /* web 3.6px */
    color: var(--paper-dark);
}

.mk-paljastus__viiva {
    width: 58px;
    height: 1px;
    margin: 6px 0;
}

.mk-paljastus__alaotsake {
    font-size: var(--tk-koko-kapiteeli);
    letter-spacing: 20px; /* web 2.3px */
    color: var(--tk-tumma-muste-pehmea);
}

.mk-paljastus__kuvapaikka {
    width: 300px;
    height: 300px;
    max-width: 76%;
    align-items: center;
    justify-content: center;
    opacity: 0;
    scale: 0.86 0.86;
    transition-property: opacity, scale;
    transition-duration: 0.9s; /* ympäristöanimaatio (pohjavahdin poikkeus 8.10.) */
    transition-timing-function: ease-out;
}

.mk-paljastus.mk-kuva .mk-paljastus__kuvapaikka {
    opacity: 1;
    scale: 1 1;
}

.mk-paljastus__kuva {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    -unity-background-scale-mode: scale-to-fit;
}

/* Reunat häipyvät taustaan (webin mask-image). */
.mk-paljastus__reuna {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    -unity-background-image-tint-color: var(--tk-kuulto-himmennys-tumma-100);
}

.mk-paljastus--paikallis .mk-paljastus__reuna {
    -unity-background-image-tint-color: var(--tk-paperi-pergamentti);
}

.mk-paljastus__varaikoni {
    width: 55%;
    height: 55%;
}

.mk-paljastus__caption {
    align-items: center;
    margin-top: 12px;
    opacity: 0;
    translate: 0 10px;
    transition-property: opacity, translate;
    transition-duration: 0.35s; /* ympäristöanimaatio (pohjavahdin poikkeus 8.10.) */
}

.mk-paljastus.mk-nakyy .mk-paljastus__caption,
.mk-paljastus.mk-nakyy .mk-paljastus__loyto {
    opacity: 1;
    translate: 0 0;
}

.mk-paljastus__nimi {
    font-size: 20px;
    letter-spacing: 5px; /* web 1px */
    white-space: normal;
    -unity-text-align: middle-center;
    color: var(--tk-tumma-muste);
}

.mk-paljastus__palkkio {
    margin-top: 3.2px;
    font-size: var(--tk-koko-leipa);
    color: var(--tk-paperi-pergamentti);
}

.mk-paljastus__fakta {
    margin-top: 11.2px;
    max-width: 432px;
    font-size: var(--tk-koko-leipa);
    -unity-font-style: italic;
    white-space: normal;
    -unity-text-align: middle-center;
    color: var(--tk-tumma-muste-pehmea);
}

.mk-paljastus--paikallis .mk-paljastus__nimi {
    color: var(--tk-lasi-pinta-peitto);
}

.mk-paljastus--paikallis .mk-paljastus__palkkio {
    color: var(--tk-paperi-muste-pehmea);
}

/* Kaaren aarreteksti ja pöllön esittely (web .reveal-isoisa). */
.mk-paljastus__isoisa {
    margin-top: 26.9px;
    max-width: 416px;
    font-size: var(--tk-koko-leipa);
    -unity-font-style: italic;
    white-space: normal;
    -unity-text-align: middle-center;
    color: var(--tk-tumma-muste-pehmea);
}

.mk-paljastus--paikallis .mk-paljastus__fakta,
.mk-paljastus--paikallis .mk-paljastus__isoisa {
    color: var(--map-ink);
}

.mk-paljastus__loyto {
    align-items: center;
    margin-top: 12px;
    opacity: 0;
    translate: 0 10px;
    transition-property: opacity, translate;
    transition-duration: 0.35s; /* ympäristöanimaatio (pohjavahdin poikkeus 8.10.) */
}

.mk-paljastus__arvo {
    font-size: var(--tk-koko-apuri);
    letter-spacing: 15.71px; /* web 2.2px */
    color: var(--paper-dark);
    margin-bottom: 10px;
}

/* LÖYDETTY-leima (web .reveal-leima.tumma): lyödään isosta pienempään (leima-lyonti 0,4 s). */
.mk-paljastus__leima {
    align-items: center;
    padding: 4px 14px 3px 14px;
    border-width: 3px;
    border-color: var(--mark);
    border-radius: var(--tk-kulma-pieni);
    rotate: -14deg;
    opacity: 0;
    scale: 2.2 2.2;
    transition-property: opacity, scale;
    transition-duration: 0.4s; /* ympäristöanimaatio (pohjavahdin poikkeus 8.10.) */
    transition-timing-function: ease-out-back;
}

.mk-paljastus.mk-lyoty .mk-paljastus__leima {
    opacity: 0.82;
    scale: 1 1;
}

.mk-paljastus__leimateksti {
    font-size: 15px;
    letter-spacing: 20px; /* web 3px */
    -unity-text-align: middle-center;
    color: var(--tk-erikois-leima-3);
}

.mk-paljastus__leimapvm {
    margin-top: 1px;
    font-size: 8.5px; /* fonttipoikkeus: 8.5 px, lähin asteikon koko 12 px (ero 3.5 px näkyisi; Päätoimittaja 8.10.2026) */
    letter-spacing: 29.41px; /* web 2.5px */
    -unity-text-align: middle-center;
    color: var(--tk-erikois-leima-3);
}

.mk-paljastus__jatka {
    margin-top: 18px;
    min-height: 48px;
    padding: 10.88px 35.2px;
    border-width: 1px;
    border-color: var(--tk-kuulto-paper-dark-62);
    border-radius: var(--tk-kulma-hius);
    background-color: var(--tk-kuulto-accent-16);
    color: var(--paper);
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.4s; /* ympäristöanimaatio (pohjavahdin poikkeus 8.10.) */
}

/* Jatka matkaa näkyviin vasta, kun kortti odottaa pelaajaa (web .reveal-jatka.nakyy). */
.mk-paljastus.mk-jatka .mk-paljastus__jatka {
    opacity: 1;
}

/* Web .reveal-jatka: 14,72 px, letter-spacing 0,2 em (2,944) ja yhtä suuri text-indent. */
.mk-paljastus__jatka .mk-nappi__teksti {
    font-size: 14.72px;
    letter-spacing: 20px; /* web 2.944px */
    padding-left: 2.944px;
}

.mk-paljastus--paikallis .mk-paljastus__jatka {
    background-color: var(--map-ink);
    border-color: var(--tk-kuulto-paper-dark-70);
}

/* --- kaveriapu (web css/sahke.css 3: .sahke-apukortti, .quiz-option.sahke-veikattu) ------- */

.mk-kysymys__apukortti {
    margin: 6px 0 10px 0;
    padding: 9px 11px;
    border-width: 1px;
    border-color: var(--tk-kuulto-paperi-korostus-45);
    border-radius: var(--tk-kulma-pieni);
    background-color: var(--tk-kuulto-paperi-pinta-50);
}

.mk-kysymys__apusaate {
    font-size: var(--tk-koko-apuri);
    white-space: normal;
}

.mk-kysymys__apuveikkaus {
    margin-top: 5px;
    font-size: 15px;
    white-space: normal;
}

.mk-kysymys__apualarivi {
    margin-top: 5px;
    font-size: var(--tk-koko-kapiteeli);
    opacity: 0.8;
    white-space: normal;
}

.mk-kysymys__apunappi {
    align-self: flex-start;
    min-height: 36px;
    margin-top: 7px;
    padding: 4px 14px;
    border-width: 1px;
    border-color: var(--tk-kuulto-paperi-korostus-45);
    border-radius: var(--tk-kulma-nappi);
    background-color: var(--tk-kuulto-paperi-pinta-70);
    color: var(--map-ink);
}

.mk-kysymys__vaihtoehto--veikattu {
    border-width: 2px;
    border-color: var(--accent-dark);
}
