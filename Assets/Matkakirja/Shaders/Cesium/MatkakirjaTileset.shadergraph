{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "1b6d63988a2c46dc860d45e7b57c32aa",
    "m_Group": {
        "m_Id": ""
    },
    "m_Name": "VaraVari (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": 909.2000732421875,
            "y": 383.19994735717773,
            "width": 208.0,
            "height": 120.0
        }
    },
    "m_Slots": [
        {
            "m_Id": "748dc9cc52964c62b762eefd044c10eb"
        },
        {
            "m_Id": "ae0e6540121f4c9492ab073587681a9d"
        },
        {
            "m_Id": "470f458dc149414a92c0051c25a4c0a2"
        },
        {
            "m_Id": "e46da37748f047caab39958a3c93e5e4"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": false,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "VaraVari",
    "m_FunctionSource": "",
    "m_FunctionBody": "bool kelpaa = uv.x >= 0.0 && uv.x <= 1.0 && uv.y >= -0.01 && uv.y <= 1.01;\nfloat koodi = 64.0 + log2(max(length(ddx(uv)) + length(ddy(uv)), 1e-12));\n// NaN/inf-safe: a valid fallback must never look unavailable (the base map would show through).\nkoodi = (koodi > 1.0 && koodi < 127.0) ? koodi : 1.0;\nvari = kelpaa ? float4(nayte.rgb, koodi) : float4(0.0, 0.0, 0.0, 0.0);\nif (tila > 3.5 && tila < 4.5) vari = kelpaa ? float4(uv.x, uv.y, 0.0, koodi) : float4(1.0, 0.0, 0.0, 64.0);\n"
}

