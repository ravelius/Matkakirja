{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "f94a394dca404f52a545fc1dfd6e14c9",
    "m_Group": {
        "m_Id": ""
    },
    "m_Name": "LentoVaraUV (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": 159.2000732421875,
            "y": 383.19994735717773,
            "width": 208.0,
            "height": 120.0
        }
    },
    "m_Slots": [
        {
            "m_Id": "b5a670f149bf4a90a8290c1188449e06"
        },
        {
            "m_Id": "f02208b9f79b457591b4a72e03704315"
        },
        {
            "m_Id": "d3c75f6a2a064a91989183f0e7a76c82"
        },
        {
            "m_Id": "24ebfdfe3c3b45dc86e660a1d139e0dc"
        },
        {
            "m_Id": "af6de211d75a4d41962784434535feb3"
        },
        {
            "m_Id": "4e1358754c5246499f27f503631bac33"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": false,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "LentoVaraUV",
    "m_FunctionSource": "",
    "m_FunctionBody": "uv = float2(-1.0, -1.0);\nif (dot(nolla.xyz, nolla.xyz) > 0.5 && dot(akseli.xyz, akseli.xyz) > 0.5)\n{\n    float3 n = normalize(pos - keski.xyz);\n    float lat = asin(clamp(dot(n, akseli.xyz), -1.0, 1.0));\n    float lon = atan2(dot(n, ita.xyz), dot(n, nolla.xyz));\n    float la = clamp(lat, -1.4844222, 1.4844222);   // Web Mercator: 85.05 deg\n    uv = float2(lon * 0.15915494 + 0.5, log(tan(0.78539816 + la * 0.5)) * 0.15915494 + 0.5);\n}\n"
}

