# Peilikansio. Tänne noudetaan ämpärin sisältö peilausta varten ja
# tänne peilaustyökalu kirjoittaa. Satoja megatavuja kuvia ja ääniä —
# varasto on ämpäri, ei repo.
media/

# Wikipedian raaka-aineet, joista kortit kirjoitetaan käsin. Työkalu
# lataa nämä avuksi (--vain tekstit); valmis teksti menee paketteihin.
lahteet/

# Maastotekstien lainausten tarkistus lataa tänne kokonaiset
# lähdeteokset Gutenbergista ja arkistoista. Sadan teoksen tekstit —
# välimuisti, ei aineisto. Ks. tools/tarkista-lainaukset.mjs.
.lainausvalimuisti/

# dist/ EI ole täällä: yhden tiedoston versio on tarkoituksella repossa,
# jotta pelin voi ottaa mukaan levyllä ilman verkkoa.

# Kaupunkikarttojen SVG-välivaihe: työkalu rasteroi sen PNG:ksi, ja
# vain PNG on pelin aineistoa (tools/piirra-kaupunkikartta.mjs).
assets/kartat/*.svg

node_modules/
.DS_Store

# Vuorikuvien työaineisto: Commonsin ehdokaslistat ja niistä ladotut
# silmätarkistustaulut. Raaka-ainetta, ei pelin aineistoa — valmiit
# valinnat menevät js/packs/vuori-valokuvat.js:ään
# (tools/hae-vuorikuvat.mjs, tools/tee-kuvataulu.py).
tools/vuorikuva-aineisto/
tools/vuorikuva-taulut/

# iOS-kuoren käännöstulokset. Xcode-projekti syntyy ios/project.yml:stä
# (XcodeGen), joten sitä ei säilytetä repossa — konegeneroitu XML törmäisi
# joka mergessä. Ks. ios/OHJE.md.
ios/*.xcodeproj/
ios/build/
ios/kaannos.log
ios/DerivedData/
