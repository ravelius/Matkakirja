    "D1": {
      "url": "https://www.dpm.org.cn/explore/building/236442.html",
      "name": "Palatsimuseo: Yangxindian",
      "facts": "Etuhalli 36 x 12 m, kolme rakennejannetta molempiin suuntiin; sali, ita- ja lansikamarit, keskivaltaistuin ja plakaatti; itakamari valtaistuin katsoo lanteen."
    },
    "D2": {
      "url": "https://img.dpm.org.cn/Uploads/File/2023/07/19/u64b75fda11a18.pdf",
      "name": "Palatsimuseo: lansikamari, 2023, painetut sivut 123–124",
      "facts": "Lansikamari 10.15 x 11.5 m, etelan jakoseina 5.15 m eturaystaasta; itakaytava 2.14 m."
    },
    "D3": {
      "url": "https://www.dpm.org.cn/classify_detail/257945.html",
      "name": "Palatsimuseon luento 4.8.2022",
      "facts": "Sanxitang 2.1 x 6.0 x 2.1 m; etela- ja pohjoisosa, valiseinassa ikkuna, etelan kang."
    },
    "D4": {
      "url": "https://www.dpm.org.cn/Uploads/File/2022/01/14/u61e0e8410e833.pdf",
      "name": "Palatsimuseon tutkimus 2022, painetut sivut 91–92",
      "facts": "Pohjoisnuolelliset yleis- ja lansikamaripohjat; etelan ulokkeet ja pohjoisen yhteys; kaytetty huoneiden jarjestyksen, ei tarkkojen absoluuttisten paikkojen lahteena."
    },
    "D5": {
      "url": "https://www.dpm.org.cn/explore/building/236486.html",
      "name": "Palatsimuseo: Chuxiugong",
      "facts": "Viisi jannetta, etuveranta, keskusvaltaistuin/viisiosainen sermi; bambu-/magnoliapuu-lasiseinat, viinikoynnos-zhao; lansipaan makuuhuone ja tuulisermi."
    },
