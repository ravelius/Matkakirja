  "independentReviewTopThreeDifferences": [
    {
      "rank": 1,
      "difference": "Alajalkojen ja jalustan projektio leviää tavoitteen ulkopuolelle, erityisesti ilmakuvissa.",
      "views": [
        "K1",
        "K5",
        "K2",
        "K3",
        "K4"
      ],
      "strongestIn": [
        "K1",
        "K5",
        "K2"
      ],
      "observation": "K1:ssä ja K5:ssä maston kärki osuu lähelle tavoitetta, mutta mallin lähimmät jalkapäät ja jalustan alareuna jäävät selvästi tavoitetta alemmas ja sivujalat ulommas. K2:ssa molemmat ulommat jalat levittävät pohjaa tavoitetta leveämmäksi. K3:ssa ja K4:ssä pohjan sivureunojen ero näkyy pienempänä.",
      "visibleImpact": "Torni näyttää ilmakuvissa tavoitetta suuremmalta ja alhaalta levähtäneemmältä; tavoitteen ja mallin ääriviivojen välille jää alaneljännekseen selvä vyöhyke. Tämä on kuvatason havainto, ei näyttö fyysisen kokonaiskorkeuden virheestä.",
      "constraint": "Kamerat ovat tämän kierroksen hyväksytyt lähtökamerat. K5:n peittyvä maapiste on arvio, joten havainto ei yksin ratkaise, mikä osa erosta tulee pohjan muodosta, perspektiivistä tai tavoitteen epäjohdonmukaisuudesta. Havainto ei valtuuta kameran uudelleensovitusta."
    },
    {
      "rank": 2,
      "difference": "Alatasanteen kaide ja tasanteiden sekä yläkopin kerroksellinen rakenne ovat selvästi tavoitetta pelkistetymmät.",
      "views": [
        "K1",
        "K2",
        "K3",
        "K4",
        "K5"
      ],
      "strongestIn": [
        "K2",
        "K5"
      ],
      "observation": "K2:n tavoitteen alatasanteessa näkyy tiheä vinoristikkoinen kaide, tarkka ikkunajako ja uurteinen, kannatettu alapinta. Mallissa kaide on suuria avoimia X-kenttiä ja alapinta leveä sileä levy. Yläkopissa mallin korkea yhtenäinen pystylasitus korostuu suhteessa tavoitteen lyhyempään ikkunanauhaan ja selvemmin eroteltuun alaosaan. K5 vahvistaa kopin ja tasanteen sileän, vähädetaljisen ulkoasun.",
      "visibleImpact": "Tornin tunnistettavat tasannerakenteet lukevat mallissa yksinkertaisina, paksuina renkaina ja yläkoppi pitkänä lasiboksina. Läheltä katsottuna niiden arkkitehtuuri ei vielä vastaa tavoitteen rakennetta.",
      "constraint": "Alatasanne näkyy vertailuissa myös tavoitetta alempana. Generoitujen tavoitteiden tasannevirheitä ei saa kopioida: alatasanteen lattia 20 m ja ylätasanteen lattia 51 m pysyvät sitovina. Tämä huomio koskee muotoa ja detaljointia, ei lattioiden siirtämistä tavoitepikseleihin."
    },
    {
      "rank": 3,
      "difference": "Alarakennuksen julkisivu ja jalkojen koristeellinen kaaristo jäävät yleismuodoiksi.",
      "views": [
        "K2",
        "K1",
        "K5",
        "K3",
