  "acceptance_criteria": [
    {
      "id": "A1",
      "scope": "water",
      "criterion": "V8:ssa oma vesipinta näkyy W7-alueella yhtenäisenä tarkoitettuun rantaan asti; V7:n ilmakuvatekstuuri ei peitä sitä eikä vuorottele sen kanssa kameraliikkeessä. V6 toimii ulkonäön vertailuna, ei todisteena teknisestä syystä."
    },
    {
      "id": "A2",
      "scope": "platform",
      "criterion": "Kohdista vastaanottajan tarkoittama tasanne actualGLB/pipeline-tietoon. Vahvistetun pinnan näkyvyys, vaalea kivimateriaali, reunat ja portaat säilyvät samassa kamerassa; koko näkyvää L-tasannetta ei käsitellä puuttuvana."
    },
    {
      "id": "A3",
      "scope": "cut",
      "criterion": "Kun lähdegeometria vahvistaa CUT-L7/CUT-S7-alueiden kuuluvan omaan pihaan, V8:n normaaliin k3-kuvaan ei jää niitä vastaavia ilmakuvakaistaleita eikä piilotuskuvaan uusia tahattomia ilmakuvareikiä. Tarkoitukselliset aukot ja vallihauta säilytetään lähdegeometrian mukaan."
    },
    {
      "id": "A4",
      "scope": "boundary",
      "criterion": "K1:n normaalilla katseluetäisyydellä ei erotu suoraa pystyrajaa kiven koon, keskimääräisen sävyn tai kontrastin muutoksena. Lähikuvassa rajalla on yhteensopiva ladontamittakaava; ei kaksoissaumoja, venyneitä kiviä, sumennettua nauhaa tai ruutumaista häivytystä."
    },
    {
      "id": "A5",
      "scope": "paving preservation",
      "criterion": "K2:n ja liuku2:n V7-tyyppinen kivien luettavuus ja hillitty mosaiikki säilyvät pilotin sisäosassa. Muutos ei tuo näkyvää suurta toistoruutua tai uusia poikkeavia väriläiskiä."
    },
    {
      "id": "A6",
      "scope": "matched game comparison",
      "criterion": "V6/V7-korjatun lähdevertailun ja V8:n samat k1–k5-kamerat, lähikuva, 13/18-valot ja vastaavat piilotuskokeet; paikallinen maan/veden näkyvyys varmistetaan. Klo18 molempien tummaa valaistusta ei kompensoida globaalilla albedon nostolla."
    },
    {
      "id": "A7",
      "scope": "motion and device separately",
      "criterion": "Liukujen ajallinen välke, LOD-vaihdot sekä ruutuaika ja muisti mitataan erikseen; nämä kahdeksan stilliä eivät läpäise niitä. Fyysisen laitteen ja omistajan hyväksyntä erikseen."
    },
    {
